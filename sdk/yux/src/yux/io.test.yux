; 验证：append_file 接在已有内容后面
#Test
fn test_append_file() {
  let path String = "_yux_io_append.txt"
  try {
    write_file(&path, "ab")
  } catch e IoErr {
    _fail_io("write_ab", e)
  }
  try {
    append_file(&path, "cd")
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("append", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read_append", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "abcd")
}

; 验证：空内容写出后读回空串
#Test
fn test_write_read_empty() {
  let path String = "_yux_io_empty.txt"
