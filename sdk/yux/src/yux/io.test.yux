; yux.io：write/read/append 回合 + 缺文件 NotFound
; 路径 / 环境 / 目录。不调用 read_line（会堵 stdin）。临时文件名互不抢；失败路径可能留文件，gitignore 兜底。

use yux.io.*

fn _cleanup(path String&) {
  try {
    remove(path)
  } catch e IoErr {
  }
}

fn _fail_io(op String&, e IoErr) {
  match e {
    IoErr::Eof => fail("${op}: Eof")
    IoErr::NotFound => fail("${op}: NotFound")
    IoErr::AccessDenied => fail("${op}: AccessDenied")
    IoErr::InvalidUtf8 => fail("${op}: InvalidUtf8")
    IoErr::Other(code) => fail("${op}: Other(${code})")
  }
}

; 验证：write_file 后 read_file 读回 ASCII
#Test
fn test_write_read_roundtrip() {
  let path String = "_yux_io_rw.txt"
  try {
    write_file(&path, "hello")
  } catch e IoErr {
    _fail_io("write", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "hello")
}

; 验证：中文内容按 UTF-8 往返
#Test
fn test_write_read_chinese() {
  let path String = "_yux_io_zh.txt"
  try {
    write_file(&path, "你好")
  } catch e IoErr {
    _fail_io("write_zh", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read_zh", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "你好")
}

; 验证：append_file 接在已有内容后面
#Test
fn test_append_file() {
  let path String = "_yux_io_append.txt"
  try {
    write_file(&path, "ab")
  } catch e IoErr {
    _fail_io("write_ab", e)
  }
  try {
    append_file(&path, "cd")
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("append", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read_append", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "abcd")
}

; 验证：空内容写出后读回空串
#Test
fn test_write_read_empty() {
  let path String = "_yux_io_empty.txt"
  try {
    write_file(&path, "")
  } catch e IoErr {
    _fail_io("write_empty", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read_empty", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "")
}

; 验证：缺文件 → IoErr::NotFound
#Test
fn test_read_missing_not_found() {
  let path String = "_yux_io_no_such_file.txt"
  _cleanup(&path);
  try {
    let _s String = read_file(&path)
    fail("missing file should error");
  } catch e IoErr {
    match e {
      IoErr::NotFound => {
      }
      IoErr::Eof => fail("missing: Eof")
      IoErr::AccessDenied => fail("missing: AccessDenied")
      IoErr::InvalidUtf8 => fail("missing: InvalidUtf8")
      IoErr::Other(code) => fail("missing: Other(${code})")
    };
  }
}

; ==================== 路径 ====================

#Test
fn test_join_dirname() {
  assert_eq(join("a", "b"), "a\\b")
  assert_eq(join("a\\", "b"), "a\\b")
  assert_eq(join("a", "\\b"), "a\\b")
  assert_eq(join("", "b"), "b")
  assert_eq(join("a", ""), "a")
  assert_eq(dirname("a\\b\\c"), "a\\b")
  assert_eq(dirname("a"), ".")
  assert_eq(dirname("\\foo"), "\\")
  assert_eq(dirname("a\\"), ".")
}

; ==================== exists / remove / mkdir / list_dir / cwd / env ====================

#Test
fn test_exists_missing() {
  let path String = "_yux_io_exists_nope.txt"
  _cleanup(&path);
  assert_false(exists(&path))
}

#Test
fn test_cwd_nonempty() {
  try {
    let d String = cwd()
    assert_true(d.len() > 0)
  } catch e IoErr {
    _fail_io("cwd", e)
  }
}

#Test
fn test_env_path() {
  let v String? = env("PATH")
  assert_true(v.has())
  assert_true(v.get().len() > 0)
  let miss String? = env("YUX_NO_SUCH_ENV_VAR_ZXQ")
  assert_false(miss.has())
}

#Test
fn test_mkdir_list_remove() {
  let dir String = "_yux_io_dir"
  let file String = join(&dir, "a.txt")
  _cleanup(&file);
  _cleanup(&dir);
  try {
    mkdir(&dir)
  } catch e IoErr {
    _fail_io("mkdir", e)
  }
  assert_true(exists(&dir))
  try {
    write_file(&file, "x")
  } catch e IoErr {
    _cleanup(&file);
    _cleanup(&dir);
    _fail_io("write_in_dir", e)
  }
  let names Array<String> = try {
    list_dir(&dir)
  } catch e IoErr {
    _cleanup(&file);
    _cleanup(&dir);
    _fail_io("list_dir", e);
    []
  }
  #Mut let found bool = false
  for n in names {
    if n == "a.txt" {
      found = true
    }
  }
  _cleanup(&file);
  _cleanup(&dir);
  assert_true(found)
}

#Test
fn test_list_dir_missing() {
  let dir String = "_yux_io_dir_nope"
  _cleanup(&dir);
  try {
    list_dir(&dir);
    fail("missing dir should error")
  } catch e IoErr {
    match e {
      IoErr::NotFound => {
      }
      IoErr::Eof => fail("list missing: Eof")
      IoErr::AccessDenied => fail("list missing: AccessDenied")
      IoErr::InvalidUtf8 => fail("list missing: InvalidUtf8")
      IoErr::Other(code) => fail("list missing: Other(${code})")
    }
  }
}
