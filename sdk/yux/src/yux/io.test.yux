#Test
fn test_junction_roundtrip() {
  let dir String = "_yux_io_jn_dir"
  let link String = "_yux_io_jn_link"
  let file String = join(&dir, "x.txt")
  _cleanup_all(&link);
  _cleanup_all(&dir);
  try {
    mkdir(&dir)
    write_file(&file, "z")
    junction(&dir, &link)
  } catch e IoErr {
    _cleanup_all(&link);
    _cleanup_all(&dir);
    _fail_io("junction", e)
  }
  assert_true(is_dir(&link))
  assert_true(is_link(&link))
  let linkFile File = File::from(&link)
  let linkInfo FileInfo = try {
    linkFile.info()
  } catch e IoErr {
    _cleanup_all(&link)
    _cleanup_all(&dir)
    _fail_io("junction_info", e)
    ret;
  }
  _expect_link(linkInfo.kind)
  let via String = join(&link, "x.txt")
  let s String = try {
    read_file(&via)
  } catch e IoErr {
    _cleanup_all(&link);
    _cleanup_all(&dir);
    _fail_io("read_jn", e);
    ""
  }
  try {
    remove_all(&link)
  } catch e IoErr {
    _cleanup_all(&link);
    _cleanup_all(&dir);
    _fail_io("remove_jn", e)
  }
  assert_true(exists(&file))
  _cleanup_all(&dir);
  assert_eq(s, "z")
}

#Test
fn test_symlink_file_or_skip() {
  let a String = "_yux_io_sy_a.txt"
  let b String = "_yux_io_sy_b.txt"
  _cleanup(&a);
  _cleanup(&b);
  try {
    write_file(&a, "sy")
  } catch e IoErr {
    _fail_io("write_sy", e)
  }
  try {
    symlink(&a, &b)
  } catch e IoErr {
    match e {
      IoErr::AccessDenied => {
        _cleanup(&a);
        ret;
      }
      IoErr::Other(code) => {
        if code == 1314u32 {
          _cleanup(&a);
          ret;
        }
        _cleanup(&a);
        _cleanup(&b);
        _fail_io("symlink", e)
      }
      IoErr::Eof => {
        _cleanup(&a);
        _fail_io("symlink", e)
      }
      IoErr::NotFound => {
        _cleanup(&a);
        _fail_io("symlink", e)
      }
      IoErr::InvalidUtf8 => {
        _cleanup(&a);
        _fail_io("symlink", e)
      }
      IoErr::Closed => {
        _cleanup(&a);
        _fail_io("symlink", e)
      }
    }
  }
  let s String = try {
    read_file(&b)
  } catch e IoErr {
    _cleanup(&a);
    _cleanup(&b);
    _fail_io("read_sy", e);
    ""
  }
  assert_true(is_link(&b))
  _cleanup(&b);
  _cleanup(&a);
  assert_eq(s, "sy")
}

; ==================== Path / File 对象 API ====================

#Test
fn test_path_object_operations() {
  let baseRaw String = "a"
  let emptyRaw String = ""
  let basePath Path = Path::from(&baseRaw)
  let child Path = basePath.join("b")
  assert_eq(basePath.to_string(), "a")
  assert_eq(child.to_string(), "a\\b")
  assert_eq(child.name(), "b")
  assert_eq(child.parent().to_string(), "a")

  let empty Path = Path::from(&emptyRaw)
  assert_eq(empty.name(), "")
  assert_eq(empty.parent().to_string(), ".")

  let raw String = "_yux_io_path_missing.txt"
  _cleanup(&raw)
  let missing Path = Path::from(&raw)
  let absolute Path = try {
    missing.absolute()
  } catch e IoErr {
    _fail_io("path_absolute", e)
    ret;
  }
  assert_eq(absolute.name(), raw)
  let entry File = File::at(&absolute)
  assert_false(entry.exists())

  let fooRaw String = "foo"
  let fooUpperRaw String = "FOO"
  let barRaw String = "bar"
  let foo Path = Path::from(&fooRaw)
  let fooUpper Path = Path::from(&fooUpperRaw)
  let bar Path = Path::from(&barRaw)
  assert_true(foo.same_as(&fooUpper))
  assert_false(foo.same_as(&bar))
  let fooAbs Path = try {
    foo.absolute()
  } catch e IoErr {
    _fail_io("path_same_as_abs", e)
    ret;
  }
  assert_true(foo.same_as(&fooAbs))
  assert_false(foo.is_empty())
  assert_true(empty.is_empty())
  assert_eq("${foo}", "foo")
}

#Test
fn test_file_info_list_and_methods() {
  let dirRaw String = "_yux_io_file_api"
  let aRaw String = join(&dirRaw, "a.txt")
  let bRaw String = join(&dirRaw, "b.txt")
  _cleanup_all(&dirRaw)

  let dir File = File::from(&dirRaw)
  try {
    dir.mkdir()
    write_file(&aRaw, "abc")
    write_file(&bRaw, "")
  } catch e IoErr {
    _cleanup_all(&dirRaw)
    _fail_io("file_setup", e)
  }

  assert_true(dir.exists())
  assert_true(dir.is_dir())
  assert_false(dir.is_file())
  assert_false(dir.is_link())
  let dirInfo FileInfo = try {
    dir.info()
  } catch e IoErr {
    _cleanup_all(&dirRaw)
    _fail_io("dir_info", e)
    ret;
  }
  _expect_directory(dirInfo.kind)

  let a File = File::from(&aRaw)
  let aInfo FileInfo = try {
    a.info()
  } catch e IoErr {
    _cleanup_all(&dirRaw)
    _fail_io("file_info", e)
    ret;
  }
  _expect_regular(aInfo.kind)
  assert_eq(aInfo.size, 3u64)
  assert_false(aInfo.readonly)
  assert_eq(a.path().name(), "a.txt")
  assert_true(a.is_file())
  assert_false(a.is_dir())
  assert_false(a.is_link())
  assert_eq("${a}", aRaw)
  assert_true(a.same_as(&a))
  assert_false(a.same_as(&dir))

  let children Array<File> = try {
    dir.list()
  } catch e IoErr {
    _cleanup_all(&dirRaw)
    _fail_io("file_list", e)
    ret;
  }
  assert_eq(children.len(), 2)
  #Mut let foundA bool = false
  #Mut let foundB bool = false
  for child in children {
    let name String = child.path().name()
    if name == "a.txt" {
      foundA = true
    } elif name == "b.txt" {
      foundB = true
    }
  }
  assert_true(foundA)
  assert_true(foundB)

  let b File = File::from(&bRaw)
  try {
    a.remove()
    b.remove()
    dir.remove()
  } catch e IoErr {
    _cleanup_all(&dirRaw)
    _fail_io("file_remove", e)
  }
  assert_false(dir.exists())
}

#Test
fn test_file_hardlink_to() {
  let aRaw String = "_yux_io_fhl_a.txt"
  let bRaw String = "_yux_io_fhl_b.txt"
  _cleanup(&aRaw)
  _cleanup(&bRaw)
  try {
    write_file(&aRaw, "hi")
  } catch e IoErr {
    _fail_io("write_fhl", e)
  }
  let a File = File::from(&aRaw)
  let b File = File::from(&bRaw)
  try {
    b.hardlink_to(&a)
  } catch e IoErr {
    _cleanup(&aRaw)
    _cleanup(&bRaw)
    _fail_io("hardlink_to", e)
  }
  let s String = try {
    read_file(&bRaw)
  } catch e IoErr {
    _cleanup(&aRaw)
    _cleanup(&bRaw)
    _fail_io("read_fhl", e)
    ""
  }
  _cleanup(&bRaw)
  _cleanup(&aRaw)
  assert_eq(s, "hi")
}

#Test
fn test_file_junction_to() {
  let dirRaw String = "_yux_io_fjn_dir"
  let linkRaw String = "_yux_io_fjn_link"
  let fileRaw String = join(&dirRaw, "x.txt")
  _cleanup_all(&linkRaw)
  _cleanup_all(&dirRaw)
  let dir File = File::from(&dirRaw)
  let link File = File::from(&linkRaw)
  try {
    dir.mkdir()
    write_file(&fileRaw, "z")
    link.junction_to(&dir)
  } catch e IoErr {
    _cleanup_all(&linkRaw)
    _cleanup_all(&dirRaw)
    _fail_io("junction_to", e)
  }
  assert_true(link.is_dir())
  assert_true(link.is_link())
  let via String = join(&linkRaw, "x.txt")
  let s String = try {
    read_file(&via)
  } catch e IoErr {
    _cleanup_all(&linkRaw)
    _cleanup_all(&dirRaw)
    _fail_io("read_fjn", e)
    ""
  }
  try {
    link.remove_all()
  } catch e IoErr {
    _cleanup_all(&linkRaw)
    _cleanup_all(&dirRaw)
    _fail_io("remove_fjn", e)
  }
  assert_true(exists(&fileRaw))
  _cleanup_all(&dirRaw)
  assert_eq(s, "z")
}

#Test
fn test_file_symlink_to_or_skip() {
  let aRaw String = "_yux_io_fsy_a.txt"
  let bRaw String = "_yux_io_fsy_b.txt"
  _cleanup(&aRaw)
  _cleanup(&bRaw)
  try {
    write_file(&aRaw, "sy")
  } catch e IoErr {
    _fail_io("write_fsy", e)
  }
  let a File = File::from(&aRaw)
  let b File = File::from(&bRaw)
  try {
    b.symlink_to(&a)
  } catch e IoErr {
    match e {
      IoErr::AccessDenied => {
        _cleanup(&aRaw)
        ret;
      }
      IoErr::Other(code) => {
        if code == 1314u32 {
          _cleanup(&aRaw)
          ret;
        }
        _cleanup(&aRaw)
        _cleanup(&bRaw)
        _fail_io("symlink_to", e)
      }
      IoErr::Eof => {
        _cleanup(&aRaw)
        _fail_io("symlink_to", e)
      }
      IoErr::NotFound => {
        _cleanup(&aRaw)
        _fail_io("symlink_to", e)
      }
      IoErr::InvalidUtf8 => {
        _cleanup(&aRaw)
        _fail_io("symlink_to", e)
      }
      IoErr::Closed => {
        _cleanup(&aRaw)
        _fail_io("symlink_to", e)
      }
    }
  }
  let s String = try {
    read_file(&bRaw)
  } catch e IoErr {
    _cleanup(&aRaw)
    _cleanup(&bRaw)
    _fail_io("read_fsy", e)
    ""
  }
  assert_true(b.is_link())
  _cleanup(&bRaw)
  _cleanup(&aRaw)
  assert_eq(s, "sy")
}

#Test
fn test_file_info_readonly() {
  let raw String = "_yux_io_readonly.txt"
  _cleanup(&raw)
  try {
    write_file(&raw, "x")
  } catch e IoErr {
    _fail_io("readonly_setup", e)
  }

  #Mut let wide Array<u16> = [95u16, 121u16, 117u16, 120u16, 95u16, 105u16, 111u16, 95u16, 114u16, 101u16, 97u16, 100u16, 111u16, 110u16, 108u16, 121u16, 46u16, 116u16, 120u16, 116u16, 0u16]
  if _TestSetFileAttributesW(wide, 1u32) == 0 {
    _cleanup(&raw)
    fail("set readonly failed")
  }

  let file File = File::from(&raw)
  let info FileInfo = try {
    file.info()
  } catch e IoErr {
    _TestSetFileAttributesW(wide, 128u32);
    _cleanup(&raw)
    _fail_io("readonly_info", e)
    ret;
  }
  assert_true(info.readonly)
  assert_eq(_TestSetFileAttributesW(wide, 128u32), 1)
  _cleanup(&raw)
}

; ==================== 文件流 ====================

#Test
fn test_stream_chunk_progress_and_close() {
  let raw String = "_yux_io_stream_chunks.bin"
  _cleanup(&raw)
  let path Path = Path::from(&raw)
  #Mut let bytes Array<u8> = []
  loop i usize = 0 {
    if i >= 600 {
      break;
    }
    bytes.push(65u8)
    i += 1
  }

  let output FileOutputStream = try {
    _create_output(&path)
  } catch e IoErr {
    _fail_io("stream_create", e)
    ret;
  }
  try {
    output.write(&bytes)
    output.flush()
    output.close()
    output.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_write_close", e)
  }
  assert_false(output.is_open())

  let input FileInputStream = try {
    _open_input(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_open", e)
    ret;
  }
  let zero Array<u8> = try {
    input.read(0usize)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_read_zero", e)
    ret;
  }
  let first Array<u8> = try {
    input.read(257usize)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_read_first", e)
    ret;
  }
  let second Array<u8> = try {
    input.read(300usize)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_read_second", e)
    ret;
  }
  let third Array<u8> = try {
    input.read(100usize)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_read_third", e)
    ret;
  }
  let eof Array<u8> = try {
    input.read(1usize)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_read_eof", e)
    ret;
  }
  assert_eq(zero.len(), 0)
  assert_eq(first.len(), 257)
  assert_eq(second.len(), 300)
  assert_eq(third.len(), 43)
  assert_eq(eof.len(), 0)
  assert_eq(copy_of(first[0]), 65u8)
  assert_eq(copy_of(third[42]), 65u8)
  try {
    input.close()
    input.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("stream_input_close", e)
  }
  assert_false(input.is_open())
  _cleanup(&raw)
}

#Test
fn test_stream_text_append_and_truncate() {
  let raw String = "_yux_io_stream_text.txt"
  _cleanup(&raw)
  let path Path = Path::from(&raw)

  let first FileOutputStream = try {
    _create_output(&path)
  } catch e IoErr {
    _fail_io("text_create_first", e)
    ret;
  }
  try {
    first.write_string("旧内容")
    first.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_write_first", e)
  }

  let truncated FileOutputStream = try {
    _create_output(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_create_truncate", e)
    ret;
  }
  try {
    truncated.write_string("新")
    truncated.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_write_truncate", e)
  }

  let appended FileOutputStream = try {
    _append_output(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_append_open", e)
    ret;
  }
  try {
    appended.write_string("内容")
    appended.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_append_write", e)
  }

  let input FileInputStream = try {
    _open_input(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_input_open", e)
    ret;
  }
  let content String = try {
    input.read_to_string()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("text_input_read", e)
    ret;
  }
  _cleanup(&raw)
  assert_eq(content, "新内容")
}

#Test
fn test_stream_closed_errors() {
  let raw String = "_yux_io_stream_closed.txt"
  _cleanup(&raw)
  let path Path = Path::from(&raw)
  let empty Array<u8> = []

  let output FileOutputStream = try {
    _create_output(&path)
  } catch e IoErr {
    _fail_io("closed_create", e)
    ret;
  }
  try {
    output.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("closed_output_close", e)
  }
  try {
    output.write(&empty)
    fail("write on closed stream should fail")
  } catch e IoErr {
    _expect_closed("closed_write", e)
  }
  try {
    output.flush()
    fail("flush on closed stream should fail")
  } catch e IoErr {
    _expect_closed("closed_flush", e)
  }

  let input FileInputStream = try {
    _open_input(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("closed_input_open", e)
    ret;
  }
  try {
    input.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("closed_input_close", e)
  }
  try {
    input.read(1usize)
    fail("read on closed stream should fail")
  } catch e IoErr {
    _expect_closed("closed_read", e)
  }
  _cleanup(&raw)
}

#Test
fn test_stream_invalid_utf8_and_missing() {
  let raw String = "_yux_io_stream_invalid_utf8.bin"
  _cleanup(&raw)
  let path Path = Path::from(&raw)
  let invalid Array<u8> = [0xC0u8, 0x80u8]
  let output FileOutputStream = try {
    _create_output(&path)
  } catch e IoErr {
    _fail_io("invalid_create", e)
    ret;
  }
  try {
    output.write(&invalid)
    output.close()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("invalid_write", e)
  }
  let input FileInputStream = try {
    _open_input(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("invalid_open", e)
    ret;
  }
  try {
    input.read_to_string()
    fail("invalid UTF-8 should fail")
  } catch e IoErr {
    match e {
      IoErr::InvalidUtf8 => {
      }
      IoErr::Eof => _fail_io("invalid_decode", e)
      IoErr::NotFound => _fail_io("invalid_decode", e)
      IoErr::AccessDenied => _fail_io("invalid_decode", e)
      IoErr::Closed => _fail_io("invalid_decode", e)
      IoErr::Other(code) => _fail_io("invalid_decode", e)
    }
  }
  _cleanup(&raw)

  let missingRaw String = "_yux_io_stream_no_such_file.txt"
  _cleanup(&missingRaw)
  let missing Path = Path::from(&missingRaw)
  try {
    FileInputStream::open(&missing)
    fail("missing stream should fail")
  } catch e IoErr {
    match e {
      IoErr::NotFound => {
      }
      IoErr::Eof => _fail_io("stream_missing", e)
      IoErr::AccessDenied => _fail_io("stream_missing", e)
      IoErr::InvalidUtf8 => _fail_io("stream_missing", e)
      IoErr::Closed => _fail_io("stream_missing", e)
      IoErr::Other(code) => _fail_io("stream_missing", e)
    }
  }
}

#Test
fn test_stream_move_transfer() {
  let raw String = "_yux_io_stream_move.txt"
  _cleanup(&raw)
  try {
    write_file(&raw, "move")
  } catch e IoErr {
    _fail_io("move_setup", e)
  }
  let path Path = Path::from(&raw)
  let source FileInputStream = try {
    _open_input(&path)
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("move_open", e)
    ret;
  }
  let moved FileInputStream = move(source)
  let content String = try {
    moved.read_to_string()
  } catch e IoErr {
    _cleanup(&raw)
    _fail_io("move_read", e)
    ret;
  }
  _cleanup(&raw)
  assert_eq(content, "move")
}

; ==================== io_err_text ====================

#Test
fn test_io_err_text_named() {
  assert_eq(io_err_text(IoErr::Eof), "End of file")
  assert_eq(io_err_text(IoErr::NotFound), "File not found")
  assert_eq(io_err_text(IoErr::AccessDenied), "Access denied")
  assert_eq(io_err_text(IoErr::InvalidUtf8), "Invalid UTF-8")
  assert_eq(io_err_text(IoErr::Closed), "File already closed")
}

; FormatMessageW 文案随系统语言，只断言拿到了非回退串。
#Test
fn test_io_err_text_win32() {
  let s2 String = io_err_text(IoErr::Other(2u32))
  assert_true(s2.len() > 0)
  assert_false(s2.starts_with("Win32 "))
  let s5 String = io_err_text(IoErr::Other(5u32))
  assert_true(s5.len() > 0)
  assert_false(s5.starts_with("Win32 "))
  let s1314 String = io_err_text(IoErr::Other(1314u32))
  assert_true(s1314.len() > 0)
  assert_false(s1314.starts_with("Win32 "))
}
