fn test_exists_missing() {
  let path String = "_yux_io_exists_nope.txt"
  _cleanup(&path);
  assert_false(exists(&path))
}

#Test
fn test_cwd_nonempty() {
  try {
    let d String = cwd()
    assert_true(d.len() > 0)
  } catch e IoErr {
    _fail_io("cwd", e)
  }
}

#Test
fn test_env_path() {
  let v String? = env("PATH")
  assert_true(v.has())
  assert_true(v.get().len() > 0)
  let miss String? = env("YUX_NO_SUCH_ENV_VAR_ZXQ")
  assert_false(miss.has())
}

#Test
fn test_mkdir_list_remove() {
  let dir String = "_yux_io_dir"
  let file String = join(&dir, "a.txt")
  _cleanup(&file);
  _cleanup(&dir);
  try {
    mkdir(&dir)
  } catch e IoErr {
    _fail_io("mkdir", e)
  }
  assert_true(exists(&dir))
  try {
    write_file(&file, "x")
  } catch e IoErr {
    _cleanup(&file);
    _cleanup(&dir);
    _fail_io("write_in_dir", e)
  }
  let names Array<String> = try {
    list_dir(&dir)
  } catch e IoErr {
    _cleanup(&file);
    _cleanup(&dir);
    _fail_io("list_dir", e);
    []
  }
  #Mut let found bool = false
  for n in names {
    if n == "a.txt" {
      found = true
    }
  }
  _cleanup(&file);
  _cleanup(&dir);
  assert_true(found)
}

