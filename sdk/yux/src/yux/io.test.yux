; yux.io：write/read/append 回合 + 缺文件 NotFound
; 路径 / 环境 / 目录。不调用 read_line（会堵 stdin）。临时文件名互不抢；失败路径可能留文件，gitignore 兜底。

use yux.io.*

fn _cleanup(path String&) {
  try {
    remove(path)
  } catch e IoErr {
  }
}

fn _cleanup_all(path String&) {
  try {
    remove_all(path)
  } catch e IoErr {
  }
}

fn _fail_io(op String&, e IoErr) {
  match e {
    IoErr::Eof => fail("${op}: Eof")
    IoErr::NotFound => fail("${op}: NotFound")
    IoErr::AccessDenied => fail("${op}: AccessDenied")
    IoErr::InvalidUtf8 => fail("${op}: InvalidUtf8")
    IoErr::Other(code) => fail("${op}: Other(${code})")
  }
}

; 验证：write_file 后 read_file 读回 ASCII
#Test
fn test_write_read_roundtrip() {
  let path String = "_yux_io_rw.txt"
  try {
    write_file(&path, "hello")
  } catch e IoErr {
    _fail_io("write", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "hello")
}

; 验证：中文内容按 UTF-8 往返
#Test
fn test_write_read_chinese() {
  let path String = "_yux_io_zh.txt"
