; 验证：缺文件 → IoErr::NotFound
#Test
fn test_read_missing_not_found() {
  let path String = "_yux_io_no_such_file.txt"
  _cleanup(&path);
  try {
    let _s String = read_file(&path)
    fail("missing file should error");
  } catch e IoErr {
    match e {
      IoErr::NotFound => {
      }
      IoErr::Eof => fail("missing: Eof")
      IoErr::AccessDenied => fail("missing: AccessDenied")
      IoErr::InvalidUtf8 => fail("missing: InvalidUtf8")
      IoErr::Closed => fail("missing: Closed")
      IoErr::Other(code) => fail("missing: Other(${code})")
    };
  }
}

; ==================== 路径 ====================

#Test
fn test_join_dirname() {
  assert_eq(join("a", "b"), "a\\b")
  assert_eq(join("a\\", "b"), "a\\b")
  assert_eq(join("a", "\\b"), "a\\b")
  assert_eq(join("", "b"), "b")
  assert_eq(join("a", ""), "a")
  assert_eq(dirname("a\\b\\c"), "a\\b")
  assert_eq(dirname("a"), ".")
  assert_eq(dirname("\\foo"), "\\")
  assert_eq(dirname("a\\"), ".")
}

