  } catch e IoErr {
    match e {
      IoErr::NotFound => {
      }
      IoErr::Eof => fail("list missing: Eof")
      IoErr::AccessDenied => fail("list missing: AccessDenied")
      IoErr::InvalidUtf8 => fail("list missing: InvalidUtf8")
      IoErr::Closed => fail("list missing: Closed")
      IoErr::Other(code) => fail("list missing: Other(${code})")
    }
  }
}

#Test
fn test_basename() {
  assert_eq(basename("a\\b\\c"), "c")
  assert_eq(basename("a/b/c"), "c")
  assert_eq(basename("a\\b\\c\\"), "c")
  assert_eq(basename("a"), "a")
  assert_eq(basename(""), "")
  assert_eq(basename("\\foo"), "foo")
}

#Test
fn test_is_dir_file() {
  let dir String = "_yux_io_kind_dir"
  let file String = join(&dir, "f.txt")
  _cleanup_all(&dir);
  try {
    mkdir(&dir)
  } catch e IoErr {
    _fail_io("mkdir_kind", e)
  }
  try {
    write_file(&file, "x")
  } catch e IoErr {
    _cleanup_all(&dir);
    _fail_io("write_kind", e)
  }
  assert_true(is_dir(&dir))
  assert_false(is_file(&dir))
  assert_true(is_file(&file))
  assert_false(is_dir(&file))
  assert_false(is_dir("_yux_io_kind_nope"))
  assert_false(is_file("_yux_io_kind_nope"))
  assert_false(is_link(&file))
  _cleanup_all(&dir);
}

