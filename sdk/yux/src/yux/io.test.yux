; yux.io：write/read/append 回合 + 缺文件 NotFound；覆盖分层文件 API
; 路径 / 环境 / 目录；io_err_text。不调用 read_line（会堵 stdin）。临时文件名互不抢；失败路径可能留文件，由 gitignore 兜底。

use yux.io.*

extern {
  #CName("SetFileAttributesW")
  fn _TestSetFileAttributesW(path Ptr, attrs u32) i32
}

fn _cleanup(path String&) {
  try {
    remove(path)
  } catch e IoErr {
  }
}

fn _cleanup_all(path String&) {
  try {
    remove_all(path)
  } catch e IoErr {
  }
}

fn _fail_io(op String&, e IoErr) {
  match e {
    IoErr::Eof => fail("${op}: Eof")
    IoErr::NotFound => fail("${op}: NotFound")
    IoErr::AccessDenied => fail("${op}: AccessDenied")
    IoErr::InvalidUtf8 => fail("${op}: InvalidUtf8")
    IoErr::Closed => fail("${op}: Closed")
    IoErr::Other(code) => fail("${op}: Other(${code})")
  }
}

fn _expect_closed(op String&, e IoErr) {
  match e {
    IoErr::Closed => {
    }
    IoErr::Eof => fail("${op}: Eof")
    IoErr::NotFound => fail("${op}: NotFound")
    IoErr::AccessDenied => fail("${op}: AccessDenied")
    IoErr::InvalidUtf8 => fail("${op}: InvalidUtf8")
    IoErr::Other(code) => fail("${op}: Other(${code})")
  }
}

fn _expect_regular(kind FileKind) {
  match kind {
    FileKind::Regular => {
    }
    FileKind::Directory => fail("expected regular file, got directory")
    FileKind::Link => fail("expected regular file, got link")
    FileKind::Other => fail("expected regular file, got other")
  }
}

fn _expect_directory(kind FileKind) {
  match kind {
    FileKind::Directory => {
    }
    FileKind::Regular => fail("expected directory, got regular file")
    FileKind::Link => fail("expected directory, got link")
    FileKind::Other => fail("expected directory, got other")
  }
}

fn _expect_link(kind FileKind) {
  match kind {
    FileKind::Link => {
    }
    FileKind::Regular => fail("expected link, got regular file")
    FileKind::Directory => fail("expected link, got directory")
    FileKind::Other => fail("expected link, got other")
  }
}

; 静态 fallible 调用当前需置于 try 内；包装后供测试用普通 `!` 传播。
fn _open_input(path Path&) FileInputStream ! IoErr {
  let stream FileInputStream = try {
    FileInputStream::open(&path)
  } catch e IoErr {
    ret e
  }
  ret move(stream)
}

fn _create_output(path Path&) FileOutputStream ! IoErr {
  let stream FileOutputStream = try {
    FileOutputStream::create(&path)
  } catch e IoErr {
    ret e
  }
  ret move(stream)
}

fn _append_output(path Path&) FileOutputStream ! IoErr {
  let stream FileOutputStream = try {
    FileOutputStream::append(&path)
  } catch e IoErr {
    ret e
  }
  ret move(stream)
}

; 验证：write_file 后 read_file 读回 ASCII（兼容 facade）
#Test
fn test_write_read_roundtrip() {
  let path String = "_yux_io_rw.txt"
  try {
    write_file(&path, "hello")
  } catch e IoErr {
    _fail_io("write", e)
  }
  let s String = try {
    read_file(&path)
  } catch e IoErr {
    _cleanup(&path);
    _fail_io("read", e);
    ""
  }
  _cleanup(&path);
  assert_eq(s, "hello")
}

