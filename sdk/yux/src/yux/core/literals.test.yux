; 字面量用例
; 迁自 tests/cases/literals.yux + tests/cases/all_types.yux

#Test
fn test_int_literal_default() {
  let a = 42
  assert_eq(a, 42)
}

#Test
fn test_i8_literal() {
  let e = 42
  assert_eq(e, 42)
}

#Test
fn test_i8_min_max() {
  let lo i8 = -128
  let hi i8 = 127
  assert_eq(lo, -128)
  assert_eq(hi, 127)
}

#Test
fn test_u8_max() {
  let c u8 = 255
  assert_eq(c, 255)
}

#Test
fn test_i16_min() {
  let d i16 = -32768
  assert_eq(d, -32768)
}

#Test
fn test_u16_max() {
  let e u16 = 65535
  assert_eq(e, 65535)
}

#Test
fn test_i32_min() {
  let f i32 = -2147483648
  assert_eq(f, -2147483648)
}

#Test
fn test_u64_literal() {
  let f = 100
  assert_eq(f, 100)
}

#Test
fn test_i32_negative_literal() {
  let g = -123
  assert_eq(g, -123)
}

#Test
fn test_i64_min_plus_one() {
  let g i64 = -9223372036854775807
  assert_eq(g, -9223372036854775807)
}

#Test
fn test_f64_default() {
  let h = 3.14
  assert_eq(h, 3.14)
}

#Test
fn test_f32_literal() {
  let i = 2.5f32
  assert_eq(i, 2.5f32)
}

#Test
fn test_f64_literal_explicit() {
  let j = 1.0f64
  assert_eq(j, 1.0f64)
}

#Test
fn test_f64_negative() {
  let k = -0.5
  assert_eq(k, -0.5)
}

#Test
fn test_bool_literals() {
  assert_eq(true, true)
  assert_eq(false, false)
}

; ==================== hex / binary / octal 字面量（迁自 bug_hunt） ====================

#Test
fn test_literal_hex_i64() {
  ; 验证：十六进制 i64 字面量
  let a i64 = 0xFF
  assert_eq(a, 255)
}

#Test
fn test_literal_binary() {
  ; 验证：二进制 u8 字面量
  let a u8 = 0b1010
  assert_eq(a, 10)
}

#Test
fn test_literal_octal() {
  ; 验证：八进制 i32 字面量
  let a i32 = 0o77
  assert_eq(a, 63)
}
