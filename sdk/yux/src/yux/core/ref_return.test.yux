; 函数返回 T&（引用返回）行为测试
;
; 覆盖：
;   - 方法返回字段引用（&$.field）
;   - 方法返回 Self&（$）
;   - 自由函数透传 T& 形参
;   - 通过返回的引用修改源 struct 字段（写穿）
;
; 已知缺口：返回 T& 的生命周期检查（不能返回局部变量的引用）当前依赖 sema 诊断，
; 正面用例覆盖不足；泛型 struct 方法返回 T& 见 generic_method_ref_return.test.yux。
; T& 借用基础见 ref.test.yux。

struct P {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) P {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 方法返回字段引用（根 = $）
  fn x_ref() i32& = &$.x

  ; 方法返回 Self&（源 = $）
  fn me() Self& = $
}

; 自由函数：单个 T& 形参，透传
fn alias(p P&) P& = p

; 验证：方法返回字段引用
#Test
fn test_method_field_ref() {
  #Mut let a P = P::make(7, 8)
  let rx i32& = a.x_ref()
  assert_eq(rx, 7)
}

; 验证：方法返回自身引用
#Test
fn test_method_self_ref() {
  #Mut let a P = P::make(1, 2)
  let r P& = a.me()
  assert_eq(r.x, 1)
  assert_eq(r.y, 2)
}

; 验证：别名参数传递与修改
#Test
fn test_freefn_alias_param() {
  #Mut let a P = P::make(11, 22)
  let r P& = alias(&a)
  assert_eq(r.x, 11)
}

; ==================== ref 返回后修改源值（迁自 bug_hunt） ====================

struct BHRefData {
  val i32

  #Static
  fn make(val i32) Self {
    Self {
      .val = val
    }
  }
}

fn bh_ref_get_val(s BHRefData&) i32& {
  ret &s.val
}

#Test
fn test_ref_return_modify() {
  ; 验证：通过返回的 ref 修改源 struct 字段
  #Mut let s BHRefData = BHRefData::make(42)
  #Mut let r i32& = bh_ref_get_val(&s)
  r = 99
  assert_eq(s.val, 99)
}
