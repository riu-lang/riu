; 验证 fn 返回 T&（来源限定 $ 或 T& 形参）

struct P {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) P {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 方法返回字段引用（根 = $）
  fn x_ref() i32& = &$.x

  ; 方法返回 Self&（源 = $）
  fn me() Self& = $
}

; 自由函数：单个 T& 形参，透传
fn alias(p P&) P& = p

#Test
fn test_method_field_ref() {
  #Mut let a P = P::make(7, 8)
  let rx i32& = a.x_ref()
  assert_eq(rx, 7)
}

#Test
fn test_method_self_ref() {
  #Mut let a P = P::make(1, 2)
  let r P& = a.me()
  assert_eq(r.x, 1)
  assert_eq(r.y, 2)
}

#Test
fn test_freefn_alias_param() {
  #Mut let a P = P::make(11, 22)
  let r P& = alias(&a)
  assert_eq(r.x, 11)
}
