; 验证 fn 返回 T&（来源限定 $ 或 T& 形参）

struct P {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) P {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 方法返回字段引用（根 = $）
  fn x_ref() i32& = &$.x

  ; 方法返回 Self&（源 = $）
  fn me() Self& = $
}

; 自由函数：单个 T& 形参，透传
fn alias(p P&) P& = p

#Test
fn test_method_field_ref() {
  #Mut let a P = P::make(7, 8)
  let rx i32& = a.x_ref()
  assert_eq(rx, 7)
}

#Test
fn test_method_self_ref() {
  #Mut let a P = P::make(1, 2)
  let r P& = a.me()
  assert_eq(r.x, 1)
  assert_eq(r.y, 2)
}

#Test
fn test_freefn_alias_param() {
  #Mut let a P = P::make(11, 22)
  let r P& = alias(&a)
  assert_eq(r.x, 11)
}

; ==================== ref 返回后修改源值（迁自 bug_hunt） ====================

struct BHRefData {
  val i32

  #Static
  fn make(val i32) Self {
    Self {
      .val = val
    }
  }
}

fn bh_ref_get_val(s BHRefData&) i32& {
  ret &s.val
}

#Test
fn test_ref_return_modify() {
  ; 验证：通过返回的 ref 修改源 struct 字段
  #Mut let s BHRefData = BHRefData::make(42)
  #Mut let r i32& = bh_ref_get_val(&s)
  r = 99
  assert_eq(s.val, 99)
}
