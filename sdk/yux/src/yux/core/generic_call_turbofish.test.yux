; turbofish 显式泛型调用用例
; 迁自 tests/cases/generic_call_turbofish.yux

#Test
fn test_turbofish_nullable_value() {
  var n i32? = Nullable:<i32>(42i32)
  val v i32 = n ?? -1i32
  assert_eq(v, 42)
}

#Test
fn test_turbofish_nullable_empty() {
  var e i32? = Nullable:<i32>()
  val ev i32 = e ?? -1i32
  assert_eq(ev, -1)
}
