; turbofish 显式泛型调用用例
; 迁自 tests/cases/generic_call_turbofish.yux

#Test
fn test_turbofish_nullable_value() {
  #Mut let n i32? = Nullable:<i32>(42i32)
  let v i32 = n ?? -1i32
  assert_eq(v, 42)
}

#Test
fn test_turbofish_nullable_empty() {
  #Mut let e i32? = Nullable:<i32>()
  let ev i32 = e ?? -1i32
  assert_eq(ev, -1)
}
