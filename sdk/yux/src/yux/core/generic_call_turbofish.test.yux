; turbofish 显式泛型调用用例
; 迁自 tests/cases/generic_call_turbofish.yux
; Phase 6 (砍 ctor): 原 `Nullable:<T>(...)` 形态依赖同名 ctor, 已废除.
; 当前 Nullable<T> 只通过隐式包装路径构造 (decl-assign 中 expr type vs declared Nullable<T> 匹配自动包).

#Test
fn test_turbofish_nullable_value() {
  #Mut let n i32? = 42i32
  let v i32 = n ?? -1i32
  assert_eq(v, 42)
}

#Test
fn test_turbofish_nullable_empty() {
  #Mut let e i32? = null
  let ev i32 = e ?? -1i32
  assert_eq(ev, -1)
}
