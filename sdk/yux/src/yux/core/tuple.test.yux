; 元组构造与成员访问行为用例（Phase 3 / Phase 4）

; 以元组为参数（不读取）
fn take_pair(t (i32, i32)) i32 {
  ret 1i32
}

; 以元组为参数并读取首元素
fn first_of(t (i32, i32)) i32 {
  ret t.0
}

; 返回元组
fn make_pair() (i32, i32) {
  ret (1i32, 2i32)
}

; 嵌套元组
fn make_nested() ((i32, i32), i32) {
  ret ((1i32, 2i32), 3i32)
}

#Test
fn test_tuple_construct_local() {
  var t (i32, i32) = (10i32, 20i32)
  assert_eq(t.0, 10i32)
  assert_eq(t.1, 20i32)
}

#Test
fn test_tuple_pass_by_value() {
  assert_eq(take_pair((7i32, 8i32)), 1i32)
  assert_eq(first_of((7i32, 8i32)), 7i32)
}

#Test
fn test_tuple_return_value() {
  var t (i32, i32) = make_pair()
  assert_eq(t.0, 1i32)
  assert_eq(t.1, 2i32)
}

#Test
fn test_tuple_nested() {
  var t ((i32, i32), i32) = make_nested()
  ; 嵌套需借中间变量；`t.0.0` / `t.0.1` 形式被 lexer 吞成 float 字面量
  var inner (i32, i32) = t.0
  assert_eq(inner.0, 1i32)
  assert_eq(inner.1, 2i32)
  assert_eq(t.1, 3i32)
}

#Test
fn test_tuple_member_on_literal() {
  ; 直接对元组字面量取元素（应在 SSA 上 ExtractValue）
  assert_eq((100i32, 200i32).0, 100i32)
  assert_eq((100i32, 200i32).1, 200i32)
}
