; Phase 4a: Self { ... } 句柄字段 retain 回归 (BUGS #4)

struct Buf {
  data Array<u32>

  fn ~() {
    ; Array<u32> 由编译器代析构
  }

  #Static
  fn from(arr Array<u32>) Buf {
    ret Self {
      .data = move(arr)
    }
  }

  #Static
  fn one() Buf {
    ret Self {
      .data = [42u32]
    }
  }

  #Static
  fn empty() Buf {
    ret Self {
      .data = []
    }
  }

  fn len() usize = $.data.len()
  fn get(i usize) u32 = copy_of($.data[i])
}

#Test
fn test_buf_from_existing_array() {
  ; BUGS #1: Array 是 #NoCopy, 按值传参需要 move() 转移所有权
  let arr Array<u32> = [10u32, 32u32, 30u32]
  let arr_len = arr.len()
  let b Buf = Buf::from(move(arr))
  assert_eq(b.len(), arr_len)
  assert_eq(b.get(0), 10u32)
  assert_eq(b.get(2), 30u32)
  ; arr 已 move 走, b.data 独占句柄
}

#Test
fn test_buf_one_via_array_literal() {
  ; fresh 源: 数组字面量自带 +1, 不应再 retain
  let b Buf = Buf::one()
  assert_eq(b.len(), 1)
  assert_eq(b.get(0), 42u32)
}

#Test
fn test_buf_empty_via_empty_literal() {
  ; BUGS #3 验证: Self {...} 内嵌空数组 [] 既能 parse 也能 codegen
  let b Buf = Buf::empty()
  assert_eq(b.len(), 0)
}
