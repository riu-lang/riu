; #Static fn + Self { ... } 句柄字段行为测试
;
; 覆盖：
;   - Self { .field = move(arr) } 句柄字段所有权转移
;   - Self { .field = [literal] } fresh 数组字面量（不应再 retain）
;   - Self { .field = [] } 空数组字面量（parse + codegen）
;   - 含 Array<T> 字段 + 析构函数的 struct 静态工厂
;
; 已知缺口：无——本文件为 BUGS #4（Self 句柄字段 retain 回归）的专项验证。
; 基础 #Static fn 见 static_fn.test.yux。

enum BufErr {
  Failed
}

#NoCopy
struct Buf {
  data Array<u32>

  fn ~() {
    ; Array<u32> 由编译器代析构
  }

  #Static
  fn from(arr Array<u32>) Buf {
    ret Self {
      .data = move(arr)
    }
  }

  #Static
  fn one() Buf {
    ret Self {
      .data = [42u32]
    }
  }

  #Static
  fn empty() Buf {
    ret Self {
      .data = []
    }
  }

  #Static
  fn fallible() Buf ! BufErr {
    ret Self {
      .data = [7u32, 8u32]
    }
  }

  #Static
  fn fails() Buf ! BufErr {
    ret BufErr::Failed
  }

  fn len() usize = $.data.len()
  fn get(i usize) u32 = copy_of($.data[i])
}

fn propagated_buf() Buf ! BufErr {
  ret Buf::fallible()!
}

fn propagated_failure() Buf ! BufErr {
  ret Buf::fails()!
}

; 验证：从现有数组创建缓冲区并保持数据一致性
#Test
fn test_buf_from_existing_array() {
  ; BUGS #1: Array 是 #NoCopy, 按值传参需要 move() 转移所有权
  let arr Array<u32> = [10u32, 32u32, 30u32]
  let arr_len = arr.len()
  let b Buf = Buf::from(move(arr))
  assert_eq(b.len(), arr_len)
  assert_eq(b.get(0), 10u32)
  assert_eq(b.get(2), 30u32)
  ; arr 已 move 走, b.data 独占句柄
}

; 验证：数组字面量创建的 Buffer 长度和内容
#Test
fn test_buf_one_via_array_literal() {
  ; fresh 源: 数组字面量自带 +1, 不应再 retain
  let b Buf = Buf::one()
  assert_eq(b.len(), 1)
  assert_eq(b.get(0), 42u32)
}

#Test
fn test_buf_empty_via_empty_literal() {
  ; BUGS #3 验证: Self {...} 内嵌空数组 [] 既能 parse 也能 codegen
  let b Buf = Buf::empty()
  assert_eq(b.len(), 0)
}

; 验证：带析构 struct 作为 try 块值时，所有权转交给外层绑定，不提前析构。
#Test
fn test_buf_fallible_factory_via_try() {
  let b Buf = try {
    propagated_buf()
  } catch e BufErr {
    fail("fallible factory should succeed")
    Buf::empty()
  }
  assert_eq(b.len(), 2)
  assert_eq(b.get(0), 7u32)
  assert_eq(b.get(1), 8u32)
}

; 验证：静态 fallible 调用的错误值经 `!` 原样传播。
#Test
fn test_buf_fallible_factory_error_propagates() {
  let b Buf = try {
    propagated_failure()
  } catch e BufErr {
    Buf::empty()
  }
  assert_eq(b.len(), 0)
}
