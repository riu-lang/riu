; 数值类型转换用例
; 迁自 tests/cases/type_cast.yux
;
; 本文件包含类型转换测试:
; - 整数类型互转
; - 浮点类型转换
; - 整数与浮点互转
; - to_bool() 转换
; - to_string() 转换

; ==================== 整数类型互转 ====================

#Test
fn test_i32_to_i64() {
  let a i32 = 10
  let c i64 = a.to_i64()
  assert_eq(c, 10)
}

#Test
fn test_i64_to_i32() {
  let h i64 = -123
  let i i32 = h.to_i32()
  assert_eq(i, -123)
}

#Test
fn test_u8_to_i32() {
  let d u8 = 100
  let e i32 = d.to_i32()
  assert_eq(e, 100)
}

#Test
fn test_i32_to_u8() {
  let a i32 = 200
  let b u8 = a.to_u8()
  assert_eq(b, 200)
}

#Test
fn test_i16_to_i32() {
  let a i16 = 1000
  let b i32 = a.to_i32()
  assert_eq(b, 1000)
}

#Test
fn test_u32_to_i64() {
  let a u32 = 4000000000
  let b i64 = a.to_i64()
  assert_eq(b, 4000000000)
}

; ==================== 浮点类型转换 ====================

#Test
fn test_f32_to_f64() {
  let a f32 = 2.5f32
  let b f64 = a.to_f64()
  assert_eq(b, 2.5f64)
}

#Test
fn test_f64_to_f32() {
  let a f64 = 2.718
  let b f32 = a.to_f32()
  assert_eq(b, 2.718f32)
}

; ==================== 整数与浮点互转 ====================

#Test
fn test_i32_to_f64() {
  let a i32 = 10
  let b f64 = a.to_f64()
  assert_eq(b, 10.0f64)
}

#Test
fn test_f64_to_i32_trunc() {
  let f f64 = 3.7
  let g i32 = f.to_i32()
  assert_eq(g, 3)
}

#Test
fn test_f64_to_i64() {
  let a f64 = 12345.6
  let b i64 = a.to_i64()
  assert_eq(b, 12345)
}

#Test
fn test_i64_to_f64() {
  let a i64 = 1000000000
  let b f64 = a.to_f64()
  assert_eq(b, 1000000000.0f64)
}

; ==================== to_bool() 转换 ====================

#Test
fn test_i32_to_bool_zero() {
  let a i32 = 0
  let b bool = a.to_bool()
  assert_eq(b, false)
}

#Test
fn test_i32_to_bool_nonzero() {
  let a i32 = 1
  let b bool = a.to_bool()
  assert_eq(b, true)
}

#Test
fn test_i32_to_bool_negative() {
  let a i32 = -1
  let b bool = a.to_bool()
  assert_eq(b, true)
}

; ==================== to_string() 转换 ====================

#Test
fn test_i32_to_string() {
  let a i32 = 42
  let s String = a.to_string()
  assert_eq(s, "42")
}

#Test
fn test_i64_to_string() {
  let a i64 = 123456789
  let s String = a.to_string()
  assert_eq(s, "123456789")
}

#Test
fn test_f64_to_string() {
  let a f64 = 3.14
  let s String = a.to_string()
  assert_contains(s, "3")
}

#Test
fn test_bool_to_string() {
  let a bool = true
  let s String = a.to_string()
  assert_eq(s, "true")
  
  let b bool = false
  let s2 String = b.to_string()
  assert_eq(s2, "false")
}
