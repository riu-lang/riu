; 数值类型转换行为测试
;
; 覆盖：
;   - 整数互转：i32→i64 / i64→i32 / u8→i32 / i32→u8 / i16→i32 / u32→i64 / i16→u32
;   - 浮点互转：f32→f64 / f64→f32
;   - 整数↔浮点：i32→f64 / f64→i32（截断）/ f64→i64 / i64→f64 / f32→i32 / i32→f32
;   - to_bool()：i32（零/非零/负）/ u64 / f32 / f64
;   - to_string()：i32 / i64 / f64 / bool / f32
;   - 溢出回绕：i64→u8（300 → 44）
;   - 间接路径：i64→f32 经 i64→f64→f32
;
; 已知缺口：isize / usize 类型转换未覆盖；
; 负面诊断（不兼容类型转换）见 tests/check-cases/diag_cast_*。

; ==================== 整数类型互转 ====================

; 验证：i32 到 i64 的类型转换是否正确
#Test
fn test_i32_to_i64() {
  let a i32 = 10
  let c i64 = a.to_i64()
  assert_eq(c, 10)
}

; 验证：i64 转换为 i32 的正确性
#Test
fn test_i64_to_i32() {
  let h i64 = -123
  let i i32 = h.to_i32()
  assert_eq(i, -123)
}

; 验证：u8 到 i32 的类型转换
#Test
fn test_u8_to_i32() {
  let d u8 = 100
  let e i32 = d.to_i32()
  assert_eq(e, 100)
}

; 验证：i32 转换为 u8 的行为
#Test
fn test_i32_to_u8() {
  let a i32 = 200
  let b u8 = a.to_u8()
  assert_eq(b, 200)
}

; 验证：i16 到 i32 的类型转换
#Test
fn test_i16_to_i32() {
  let a i16 = 1000
  let b i32 = a.to_i32()
  assert_eq(b, 1000)
}

; 验证：u32 到 i64 的类型转换是否正确
#Test
fn test_u32_to_i64() {
  let a u32 = 4000000000
  let b i64 = a.to_i64()
  assert_eq(b, 4000000000)
}

; ==================== 浮点类型转换 ====================

; 验证：浮点数从 f32 转换到 f64 的行为
#Test
fn test_f32_to_f64() {
  let a f32 = 2.5f32
  let b f64 = a.to_f64()
  assert_eq(b, 2.5f64)
}

; 验证：浮点数类型转换 f64 到 f32
#Test
fn test_f64_to_f32() {
  let a f64 = 2.718
  let b f32 = a.to_f32()
  assert_eq(b, 2.718f32)
}

; ==================== 整数与浮点互转 ====================

; 验证：整数到浮点数的类型转换
#Test
fn test_i32_to_f64() {
  let a i32 = 10
  let b f64 = a.to_f64()
  assert_eq(b, 10.0f64)
}

; 验证：f64 转 i32 的截断行为
#Test
fn test_f64_to_i32_trunc() {
  let f f64 = 3.7
  let g i32 = f.to_i32()
  assert_eq(g, 3)
}

; 验证：浮点数到整数的类型转换
#Test
fn test_f64_to_i64() {
  let a f64 = 12345.6
  let b i64 = a.to_i64()
  assert_eq(b, 12345)
}

; 验证：i64 转换为 f64 的精度和范围
#Test
fn test_i64_to_f64() {
  let a i64 = 1000000000
  let b f64 = a.to_f64()
  assert_eq(b, 1000000000.0f64)
}

; ==================== to_bool() 转换 ====================

; 验证：i32 转换为 bool 时，0 应该转换为 false
#Test
fn test_i32_to_bool_zero() {
  let a i32 = 0
  let b bool = a.to_bool()
  assert_eq(b, false)
}

; 验证：非零整数转换为布尔值为真
#Test
fn test_i32_to_bool_nonzero() {
  let a i32 = 1
  let b bool = a.to_bool()
  assert_eq(b, true)
}

; 验证：负整数转换为布尔值结果为真
#Test
fn test_i32_to_bool_negative() {
  let a i32 = -1
  let b bool = a.to_bool()
  assert_eq(b, true)
}

; 验证：整数转换为布尔值，偶数非零值转换为真
#Test
fn test_i32_to_bool_even_nonzero() {
  let a i32 = 2
  let b bool = a.to_bool()
  assert_eq(b, true)
}

; 验证：u64 转换为 bool 时，非零偶数应为真
#Test
fn test_u64_to_bool_even_nonzero() {
  let a u64 = 10
  let b bool = a.to_bool()
  assert_eq(b, true)
}

; ==================== to_string() 转换 ====================

; 验证：i32 转换为字符串
#Test
fn test_i32_to_string() {
  let a i32 = 42
  let s String = a.to_string()
  assert_eq(s, "42")
}

; 验证：i64 转换为字符串
#Test
fn test_i64_to_string() {
  let a i64 = 123456789
  let s String = a.to_string()
  assert_eq(s, "123456789")
}

; 验证：f64 转换为字符串时包含预期数字部分
#Test
fn test_f64_to_string() {
  let a f64 = 3.14
  let s String = a.to_string()
  assert_contains(s, "3")
}

; 验证：布尔值转换为字符串
#Test
fn test_bool_to_string() {
  let a bool = true
  let s String = a.to_string()
  assert_eq(s, "true")

  let b bool = false
  let s2 String = b.to_string()
  assert_eq(s2, "false")
}

; ==================== f32 类型转换 ====================

#Test
fn test_f32_to_i32() {
  ; 验证：f32 转 i32 截断
  let a f32 = 3.7f32
  let b i32 = a.to_i32()
  assert_eq(b, 3)

  let c f32 = -2.3f32
  let d i32 = c.to_i32()
  assert_eq(d, -2)
}

#Test
fn test_f32_to_f64() {
  ; 验证：f32 转 f64
  let a f32 = 2.5f32
  let b f64 = a.to_f64()
  assert_eq(b, 2.5f64)
}

; 验证：浮点数到布尔值的类型转换行为
#Test
fn test_f32_to_bool() {
  assert_eq((0.0f32).to_bool(), false)
  assert_eq((1.0f32).to_bool(), true)
  assert_eq((-0.5f32).to_bool(), true)
}

; 验证：浮点数到布尔值的类型转换行为
#Test
fn test_f64_to_bool() {
  assert_eq((0.0f64).to_bool(), false)
  assert_eq((1.0f64).to_bool(), true)
  assert_eq((-0.5f64).to_bool(), true)
}

#Test
fn test_f32_to_string() {
  ; 验证：f32 转 String
  let a f32 = 3.25f32
  let s String = a.to_string()
  assert_contains(s, "3")
}

#Test
fn test_i32_to_f32() {
  ; 验证：i32 转 f32
  let a i32 = 10
  let b f32 = a.to_f32()
  assert_eq(b, 10.0f32)
}

#Test
fn test_i64_to_f32() {
  ; 验证：i64 转 f32
  let a i64 = 100
  let b f32 = a.to_f64().to_f32()
  assert_eq(b, 100.0f32)
}

; ==================== 补充转换路径（迁自 bug_hunt） ====================

#Test
fn test_u8_to_f64() {
  ; 验证：u8 转 f64
  let a u8 = 200
  let b f64 = a.to_f64()
  assert_eq(b, 200.0f64)
}

#Test
fn test_i16_to_u32() {
  ; 验证：i16 转 u32
  let a i16 = 1000
  let b u32 = a.to_u32()
  assert_eq(b, 1000)
}

#Test
fn test_i64_to_u8_wrap() {
  ; 验证：i64 转 u8 回绕（300 = 256 + 44）
  let a i64 = 300
  let b u8 = a.to_u8()
  assert_eq(b, 44)
}
