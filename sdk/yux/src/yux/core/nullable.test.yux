; Nullable<T> 用例（迁自 tests/cases/nullable_*）
; 覆盖：?? 默认值、?.field 短路、.has() / .get()、null 重赋为有值。

struct NN {
  v i32
}

NN {
  fn NN(v i32) {
    $.v = v
  }
}

; ---------- nullable_basic：?? 拿 fallback ----------

#Test
fn test_nullable_some_or_default() {
  #Mut let nx i32? = 42i32
  assert_eq(nx ?? -1i32, 42i32)
}

#Test
fn test_nullable_null_or_default() {
  #Mut let ny i32? = null
  assert_eq(ny ?? -1i32, -1i32)
}

; ---------- nullable_chain：?.field 短路 ----------

#Test
fn test_nullable_chain_some_field() {
  #Mut let n NN = NN(7i32)
  #Mut let maybeN NN? = n
  #Mut let v1 i32? = maybeN?.v
  assert_eq(v1 ?? -1i32, 7i32)
}

#Test
fn test_nullable_chain_null_field() {
  #Mut let emptyN NN? = null
  #Mut let v2 i32? = emptyN?.v
  assert_eq(v2 ?? -99i32, -99i32)
}

; ---------- nullable_chain_method：泛型结构体方法链式 ----------

#Test
fn test_nullable_method_chain_get() {
  #Mut let nx i32? = 42i32
  ; nx.get() 返回 i32，本测里直接断言
  assert_eq(nx.get(), 42i32)
}

; ---------- nullable_reassign：null 重赋为有值 ----------

#Test
fn test_nullable_reassign_from_null() {
  #Mut let x i64? = null
  x = 0i64
  assert_true(x.has())
  assert_eq(x.get(), 0i64)
}
