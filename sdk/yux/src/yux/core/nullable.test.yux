; Nullable<T> 用例（迁自 tests/cases/nullable_*）
; 覆盖：?? 默认值、?.field 短路、.has() / .get()、null 重赋为有值。

struct NN {
  v i32

  #Static
  fn make(v i32) NN {
    ret Self {
      .v = v
    }
  }
}

; ---------- nullable_basic：?? 拿 fallback ----------

#Test
fn test_nullable_some_or_default() {
  #Mut let nx i32? = 42
  assert_eq(nx ?? -1, 42)
}

#Test
fn test_nullable_null_or_default() {
  #Mut let ny i32? = null
  assert_eq(ny ?? -1, -1)
}

; ---------- nullable_chain：?.field 短路 ----------

#Test
fn test_nullable_chain_some_field() {
  #Mut let n NN = NN::make(7)
  #Mut let maybeN NN? = n
  #Mut let v1 i32? = maybeN?.v
  assert_eq(v1 ?? -1, 7)
}

#Test
fn test_nullable_chain_null_field() {
  #Mut let emptyN NN? = null
  #Mut let v2 i32? = emptyN?.v
  assert_eq(v2 ?? -99, -99)
}

; ---------- nullable_chain_method：泛型结构体方法链式 ----------

#Test
fn test_nullable_method_chain_get() {
  #Mut let nx i32? = 42
  ; nx.get() 返回 i32，本测里直接断言
  assert_eq(nx.get(), 42i32)
}

; ---------- nullable_reassign：null 重赋为有值 ----------

#Test
fn test_nullable_reassign_from_null() {
  #Mut let x i64? = null
  x = 0
  assert_true(x.has())
  assert_eq(x.get(), 0i64)
}

; ---------- null 类型自动推断：函数调用 ----------

fn take_nullable_i32(x i32?) bool {
  ret !x.has()
}

#Test
fn test_null_infer_fn_call() {
  ; null 作为实参应自动推断为 Nullable<i32>
  assert_true(take_nullable_i32(null))
}

fn take_nullable_string(x String?) bool {
  ret !x.has()
}

#Test
fn test_null_infer_fn_call_string() {
  assert_true(take_nullable_string(null))
}

; ---------- null 类型自动推断：重载消歧 ----------

fn overload_nullable(x i32) bool {
  ret false
}

fn overload_nullable(x i32?) bool {
  ret true
}

#Test
fn test_null_infer_overload_disambig() {
  ; null 应精确匹配 i32? 重载
  assert_true(overload_nullable(null))
}

; ---------- null 类型自动推断：多参数（T + T?） ----------

fn multi_param_nullable(a i32, b i32?) bool {
  ret !b.has()
}

#Test
fn test_null_infer_multi_param() {
  assert_true(multi_param_nullable(42, null))
}

; ---------- null 类型自动推断：泛型函数 + 显式类型参数 ----------

fn identity_nullable<T>(x T?) T? {
  ret x
}

#Test
fn test_null_infer_generic_turbofish() {
  ; 显式指定类型参数，null 推断为 Nullable<i32>
  #Mut let r i32? = identity_nullable:<i32>(null)
  assert_true(!r.has())
}

; ---------- Array<Nullable<T>> 下标 Ref 直接 ??（P0-2）----------

#Test
fn test_nullable_array_subscript_null_else() {
  ; arr[0] 返回 i32?&（Ref<Nullable<i32>>），?? 应自动解引用取 _value
  #Mut let arr Array<i32?> = [42, null]
  assert_eq(arr[0] ?? -1, 42)
}

#Test
fn test_nullable_array_subscript_null_else_null_elem() {
  ; arr[1] 是 null，?? 应返回默认值
  #Mut let arr Array<i32?> = [42, null]
  assert_eq(arr[1] ?? -1, -1)
}

#Test
fn test_nullable_array_subscript_null_else_via_ref() {
  ; 通过 Ref 变量间接持有 下标结果再 ??
  #Mut let arr Array<i32?> = [7, null]
  #Mut let r i32?& = arr[0]
  assert_eq(r ?? -1, 7)
}

; ---------- 嵌套 Nullable ?? null 展开（P0-1）----------

#Test
fn test_nullable_nested_null_else_outer_null() {
  ; b: i32?? = null（外层为 None），?? null 应返回 null（i32?）
  #Mut let b i32?? = null
  #Mut let r i32? = b ?? null
  assert_true(r == null)
}

#Test
fn test_nullable_nested_null_else_outer_some_inner_some() {
  ; b: i32?? = Some(Some(42))，?? null 应返回 Some(42)
  #Mut let inner i32? = 42
  #Mut let b i32?? = inner
  #Mut let r i32? = b ?? null
  assert_eq(r ?? -1, 42)
}

#Test
fn test_nullable_nested_null_else_outer_some_inner_null() {
  ; b: i32?? = Some(None)，?? null 应返回 None（i32?）
  #Mut let inner i32? = null
  #Mut let b i32?? = inner
  #Mut let r i32? = b ?? null
  assert_true(r == null)
}

; ---------- 实参 T 自动包装为 Nullable<T>（P1-3）----------

fn take_nullable(x i32?) bool {
  ret (x ?? -999) == 42
}

fn take_nullable_two(x i32?, y i32?) (i32, i32) {
  ret (x ?? -1, y ?? -1)
}

#Test
fn test_nullable_arg_wrap_i32() {
  ; f(42) 调用 fn f(x i32?) → 42 自动包装为 Some(42)
  assert_true(take_nullable(42))
}

#Test
fn test_nullable_arg_wrap_null() {
  ; null 仍正常工作
  assert_true(!take_nullable(null))
}

#Test
fn test_nullable_arg_wrap_mixed() {
  ; 第一个实参 i32、第二个 null 混合
  #Mut let r (i32, i32) = take_nullable_two(10, null)
  assert_eq(r.0, 10)
  assert_eq(r.1, -1)
}

#Test
fn test_nullable_arg_wrap_with_var() {
  ; 变量作为实参传给 Nullable 形参
  #Mut let v i32 = 42
  assert_true(take_nullable(v))
}

#Test
fn test_nullable_arg_wrap_expression() {
  ; 表达式结果作为实参
  assert_true(take_nullable(21 + 21))
}

; ---------- P1-3 边界：i64? 形参 ----------

fn nullable_i64_check(x i64?) bool {
  ret (x ?? -1i64) == 100i64
}

#Test
fn test_nullable_arg_wrap_i64_explicit() {
  ; 显式 i64 后缀：100i64 → 自动包装为 Nullable<i64>
  assert_true(nullable_i64_check(100i64))
}

#Test
fn test_nullable_arg_wrap_i64_flexible_int() {
  ; 灵活整数（不带后缀）→ 自动推断为 i64 并包装为 Nullable<i64>
  assert_true(nullable_i64_check(100))
}

#Test
fn test_nullable_arg_wrap_i64_null() {
  ; null 匹配 i64? 形参
  assert_true(!nullable_i64_check(null))
}

; ---------- P1-3 边界：String? / struct 类型 Nullable 形参 T→Nullable<T> 自动包装 ----------
; 修复：2026-07-15 — compileKnownFunctionCall / compileGenericFunctionCall 中
; Nullable 包装逻辑移到 typeNeedsDestructor 检查之前，防止 String 等含 RC 字段类型
; 被 typeNeedsDestructor 分支提前 continue 跳过包装

fn take_string_nullable(s String?) String {
  ret s ?? "(null)"
}

#Test
fn test_nullable_arg_wrap_string_literal() {
  ; 字符串字面量 → 自动包装为 Nullable<String>
  let result String = take_string_nullable("hello")
  assert_eq(result, "hello")
}

#Test
fn test_nullable_arg_wrap_string_null() {
  ; null → Nullable<String>
  let result String = take_string_nullable(null)
  assert_eq(result, "(null)")
}

#Test
fn test_nullable_arg_wrap_string_expression() {
  ; 表达式结果 → 自动包装为 Nullable<String>
  let a String = "world"
  let result String = take_string_nullable(a)
  assert_eq(result, "world")
}

struct NT_NullableBox {
  val i32

  #Static
  fn make(val i32) Self {
    Self {
      .val = val
    }
  }
}

fn nt_check_nullable_box(p NT_NullableBox?) bool {
  ret p != null
}

#Test
fn test_nullable_arg_wrap_struct_literal() {
  ; struct 字面量 → 自动包装为 Nullable<Struct>
  assert_true(nt_check_nullable_box(NT_NullableBox::make(42)))
}

#Test
fn test_nullable_arg_wrap_struct_null() {
  ; null → Nullable<Struct>
  assert_true(!nt_check_nullable_box(null))
}
