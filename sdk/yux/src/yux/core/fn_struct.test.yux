; §6–7 函数 / 结构体（Slice 3）：表达式体、块体隐式 ret、fallible void、
; 方法 / #Static、struct 字面量。标量表达式体 / 按值 struct / #Static 工厂
; 见 functions / struct / static_fn / return_type_match / error_model。

enum FsErr {
  Boom
}

struct FsPt {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) FsPt {
    ret Self {
      .x = x
      .y = y
    }
  }

  #Static
  fn origin() FsPt = Self {
    .x = 0
    .y = 0
  }

  #Static
  fn parse(n i32) i32 ! FsErr {
    if n == 0 {
      ret FsErr::Boom
    }
    ret n
  }

  fn sum() i32 = $.x + $.y

  fn as_arr() Array<i32> = [$.x, $.y]

  fn pick(c bool) i32 = if c { $.x } else { $.y }

  fn maybe(fail bool) ! FsErr {
    if fail {
      ret FsErr::Boom
    }
  }

  fn parse_self(n i32) i32 ! FsErr {
    if n < 0 {
      ret FsErr::Boom
    }
    ret n + $.x
  }
}

struct FsCell {
  n i32

  #Static
  fn make(n i32) FsCell {
    ret Self {
      .n = n
    }
  }
}

struct FsBuf {
  data Array<i32>
  tag i32
}

struct FsNamed {
  name String
  n i32
}

struct FsRect {
  tl FsPt
  br FsPt
}

struct FsOpt {
  n i32?
}

fn fs_give_a() Array<i32> {
  ret [1, 2]
}

fn fs_give_b() Array<i32> {
  ret [8]
}

fn fs_sink(x i32) {
}

fn fs_void_expr(x i32) = fs_sink(x)

fn fs_expr_arr() Array<i32> = [1, 2]

fn fs_expr_empty() Array<i32> = []

fn fs_expr_str() String = "hi"

fn fs_expr_if(c bool) i32 = if c { 1 } else { 0 }

fn fs_expr_if_arr(c bool) Array<i32> = if c { fs_give_a() } else { fs_give_b() }

fn fs_expr_ok() i32 ! FsErr = 7

fn fs_expr_err() i32 ! FsErr = FsErr::Boom

fn fs_expr_ref(x i32&) i32 = x + 1

fn fs_impl_arr() Array<i32> {
  [3, 4]
}

fn fs_impl_empty() Array<i32> {
  []
}

fn fs_impl_str() String {
  let s String = "ok"
  s
}

fn fs_impl_rc() Rc<FsCell> {
  #Mut let c Rc<FsCell> = FsCell::make(5)
  c
}

fn fs_impl_lit() FsPt {
  FsPt {
    .x = 9
    .y = 8
  }
}

fn fs_impl_if_arr(c bool) Array<i32> {
  if c { fs_give_a() } else { fs_give_b() }
}

fn fs_void_empty() ! FsErr {
}

fn fs_bang_method(p FsPt&, n i32) i32 ! FsErr {
  ret p.parse_self(n)!
}

fn fs_frozen_read(#Frozen p FsPt) i32 = p.x

fn fs_frozen_group(#Frozen a, b FsPt) i32 = a.x + b.x

fn fs_named_lit() FsNamed {
  ret FsNamed {
    .name = "ok"
    .n = 1
  }
}

fn fs_buf_lit() FsBuf {
  ret FsBuf {
    .data = [1, 2]
    .tag = 7
  }
}

fn fs_nested_lit() FsRect {
  ret FsRect {
    .tl = FsPt {
      .x = 1
      .y = 2
    }
    .br = FsPt {
      .x = 3
      .y = 4
    }
  }
}

fn fs_opt_null() FsOpt {
  ret FsOpt {
    .n = null
  }
}

; ==================== 表达式体 ====================

; 验证：表达式体返回非空 Array
#Test
fn test_expr_body_array() {
  let a Array<i32> = fs_expr_arr()
  assert_eq(a.len(), 2)
  assert_eq(a[0], 1)
  assert_eq(a[1], 2)
}

; 验证：表达式体 `= []` 靶向 Array
#Test
fn test_expr_body_empty_array() {
  let a Array<i32> = fs_expr_empty()
  assert_eq(a.len(), 0)
}

; 验证：表达式体返回 String
#Test
fn test_expr_body_string() {
  assert_eq(fs_expr_str(), "hi")
}

; 验证：表达式体 `= if` 标量
#Test
fn test_expr_body_if() {
  assert_eq(fs_expr_if(true), 1)
  assert_eq(fs_expr_if(false), 0)
}

; 验证：表达式体 `= if` 绑 Array（fresh 调用）
#Test
fn test_expr_body_if_array() {
  let a Array<i32> = fs_expr_if_arr(true)
  assert_eq(a.len(), 2)
  assert_eq(a[0], 1)
  let b Array<i32> = fs_expr_if_arr(false)
  assert_eq(b.len(), 1)
  assert_eq(b[0], 8)
}

; 验证：表达式体 fallible 成功 / 失败通道
#Test
fn test_expr_body_fallible() {
  let ok i32 = try {
    fs_expr_ok()
  } catch e FsErr {
    -1
  }
  assert_eq(ok, 7)
  let err i32 = try {
    fs_expr_err()
  } catch e FsErr {
    99
  }
  assert_eq(err, 99)
}

; 验证：表达式体 T& 形参自动解引用
#Test
fn test_expr_body_ref_param() {
  #Mut let x i32 = 10
  assert_eq(fs_expr_ref(&x), 11)
}

; 验证：void 表达式体调用 void 函数
#Test
fn test_expr_body_void() {
  fs_void_expr(1)
  assert_true(true)
}

; ==================== 块体隐式 ret ====================

; 验证：块体末表达式作 Array 返回
#Test
fn test_impl_ret_array() {
  let a Array<i32> = fs_impl_arr()
  assert_eq(a.len(), 2)
  assert_eq(a[0], 3)
  assert_eq(a[1], 4)
}

; 验证：块体末 `[]` 靶向 Array
#Test
fn test_impl_ret_empty_array() {
  let a Array<i32> = fs_impl_empty()
  assert_eq(a.len(), 0)
}

; 验证：块体末表达式返回 String
#Test
fn test_impl_ret_string() {
  assert_eq(fs_impl_str(), "ok")
}

; 验证：块体末表达式返回 Rc
#Test
fn test_impl_ret_rc() {
  let c Rc<FsCell> = fs_impl_rc()
  assert_eq(c.n, 5)
}

; 验证：块体末 TypeName 字面量
#Test
fn test_impl_ret_struct_lit() {
  let p FsPt = fs_impl_lit()
  assert_eq(p.x, 9)
  assert_eq(p.y, 8)
}

; 验证：块体末 if 绑 Array
#Test
fn test_impl_ret_if_array() {
  let a Array<i32> = fs_impl_if_arr(true)
  assert_eq(a.len(), 2)
  let b Array<i32> = fs_impl_if_arr(false)
  assert_eq(b[0], 8)
}

; ==================== fallible void / 方法 / #Static ====================

; 验证：空体 `fn f() ! E` 隐式成功
#Test
fn test_fallible_void_empty() {
  try {
    fs_void_empty()
  } catch e FsErr {
    fail("empty fallible void should succeed")
  }
}

; 验证：#Static 表达式体 `= Self { ... }`
#Test
fn test_static_expr_body_self_lit() {
  let p FsPt = FsPt::origin()
  assert_eq(p.x, 0)
  assert_eq(p.y, 0)
}

; 验证：方法表达式体标量 / Array / if
#Test
fn test_method_expr_body() {
  let p FsPt = FsPt::make(3, 4)
  assert_eq(p.sum(), 7)
  let a Array<i32> = p.as_arr()
  assert_eq(a.len(), 2)
  assert_eq(a[0], 3)
  assert_eq(a[1], 4)
  assert_eq(p.pick(true), 3)
  assert_eq(p.pick(false), 4)
}

; 验证：实例方法 fallible void 隐式成功 / 失败
#Test
fn test_method_fallible_void() {
  let p FsPt = FsPt::make(1, 2)
  try {
    p.maybe(false)
  } catch e FsErr {
    fail("maybe(false) should succeed")
  }
  try {
    p.maybe(true)
    fail("maybe(true) should error")
  } catch e FsErr {
  }
}

; 验证：实例方法 `T ! E` 成功 / 失败
#Test
fn test_method_fallible_value() {
  let p FsPt = FsPt::make(10, 0)
  let ok i32 = try {
    p.parse_self(2)
  } catch e FsErr {
    -1
  }
  assert_eq(ok, 12)
  let err i32 = try {
    p.parse_self(-1)
  } catch e FsErr {
    99
  }
  assert_eq(err, 99)
}

; 验证：#Static `T ! E`
#Test
fn test_static_fallible() {
  let ok i32 = try {
    FsPt::parse(5)
  } catch e FsErr {
    -1
  }
  assert_eq(ok, 5)
  let err i32 = try {
    FsPt::parse(0)
  } catch e FsErr {
    99
  }
  assert_eq(err, 99)
}

; 验证：实例方法 `!` 同类型透传
#Test
fn test_method_fallible_bang() {
  let p FsPt = FsPt::make(10, 0)
  let ok i32 = try {
    fs_bang_method(&p, 2)
  } catch e FsErr {
    -1
  }
  assert_eq(ok, 12)
  let err i32 = try {
    fs_bang_method(&p, -1)
  } catch e FsErr {
    99
  }
  assert_eq(err, 99)
}

; ==================== #Frozen 形参 ====================

; 验证：#Frozen 形参可读
#Test
fn test_frozen_param_read() {
  let p FsPt = FsPt::make(6, 7)
  assert_eq(fs_frozen_read(p), 6)
}

; 验证：#Frozen 参数组作用于组内每个名字
#Test
fn test_frozen_param_group() {
  let a FsPt = FsPt::make(1, 0)
  let b FsPt = FsPt::make(2, 0)
  assert_eq(fs_frozen_group(a, b), 3)
}

; ==================== struct 字面量（普通 fn）====================

; 验证：普通 fn 内 TypeName 字面量含 String 字段
#Test
fn test_struct_lit_string_field() {
  let s FsNamed = fs_named_lit()
  assert_eq(s.name, "ok")
  assert_eq(s.n, 1)
}

; 验证：普通 fn 内 TypeName 字面量含 Array 字段（fresh 字面量）
#Test
fn test_struct_lit_array_field() {
  let b FsBuf = fs_buf_lit()
  assert_eq(b.tag, 7)
  assert_eq(b.data.len(), 2)
  assert_eq(b.data[0], 1)
}

; 验证：运行期嵌套 struct 字面量
#Test
fn test_struct_lit_nested_runtime() {
  let r FsRect = fs_nested_lit()
  assert_eq(r.tl.x, 1)
  assert_eq(r.tl.y, 2)
  assert_eq(r.br.x, 3)
  assert_eq(r.br.y, 4)
}

; 验证：T? 字段须显式 `null`（无隐式默认）
#Test
fn test_struct_lit_nullable_explicit_null() {
  let o FsOpt = fs_opt_null()
  assert_eq(o.n ?? -1, -1)
}
