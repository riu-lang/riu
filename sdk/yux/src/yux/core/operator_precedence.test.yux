; 运算符优先级用例
; 迁自 tests/cases/operator_precedence.yux

#Test
fn test_mul_before_add() {
  assert_eq(1 + 2 * 3, 7)
}

#Test
fn test_paren_overrides() {
  assert_eq((1 + 2) * 3, 9)
}

#Test
fn test_left_assoc_sub() {
  assert_eq(10 - 2 - 3, 5)
}

#Test
fn test_left_assoc_div_mul() {
  assert_eq(10 / 2 * 3, 15)
}

#Test
fn test_relational_after_arith() {
  assert_true((1 + 2) > 2)
  assert_true((3 * 2) == 6)
}
