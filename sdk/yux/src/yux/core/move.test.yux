; Phase B-1: move 语义功能测试

; ---- #NoCopy struct ----

#NoCopy
struct Box {
  val i32
  fn ~() {
    ; 显式析构，自动隐含 #NoCopy
  }
}

; ---- make_box 辅助 ----

fn make_box() Box {
  ret Box {
    .val = 7
  }
}

; ---- move 基本所有权转移 (i32) ----

#Test
fn test_move_i32_ownership() {
  let a i32 = 42
  let b i32 = move(a)
  assert_eq(b, 42)
}

; ---- move #NoCopy struct ----

#Test
fn test_move_no_copy_struct() {
  let a Box = Box {
    .val = 10
  }
  let b Box = move(a)
  assert_eq(b.val, 10)
}

; ---- fresh 构造不触发 #NoCopy 检查 ----

#Test
fn test_no_copy_fresh_constructor() {
  let a Box = Box {
    .val = 1
  }
  assert_eq(a.val, 1)
}

; ---- #NoCopy 类型作为函数返回值 ----

#Test
fn test_no_copy_return() {
  let b Box = make_box()
  assert_eq(b.val, 7)
}

; ---- elif 分支 move ----

#Test
fn test_move_elif_branch() {
  let a Box = Box {
    .val = 99
  }
  if false {
    let _ = 0
  } elif true {
    let b Box = move(a)
    assert_eq(b.val, 99)
  }
  ; a was moved in elif branch — scope exit skips a's dtor via _movedVars merge
}

; ---- move Rc<i32> ----

#Test
fn test_move_rc_i32() {
  let a Rc<i32> = 100
  let v i32& = as_ref(a)
  assert_eq(v, 100)
  let b Rc<i32> = move(a)
  ; a was moved — b now owns the handle
  let w i32& = as_ref(b)
  assert_eq(w, 100)
}

; ---- move Array<i32> ----

#Test
fn test_move_array_i32() {
  let a Array<i32> = [1, 2, 3]
  assert_eq(a.len(), 3)
  let b Array<i32> = move(a)
  ; a was moved — b now owns
  assert_eq(b.len(), 3)
  assert_eq(b.get(0), 1)
  assert_eq(b.get(2), 3)
}

; ---- move String ----

#Test
fn test_move_string() {
  let s String = "hello"
  assert_eq(s.len(), 5)
  let t String = move(s)
  ; s was moved — t now owns
  assert_eq(t.len(), 5)
}

; ---- move Heap<T> ----

#Test
fn test_move_heap_i32() {
  ; 验证：move Heap<T> 转移所有权
  let a Heap<i32> = heap:<i32>(42)
  assert_true(a == 42)
  let b Heap<i32> = move(a)
  assert_true(b == 42)
}

#Test
fn test_move_heap_f64() {
  ; 验证：move Heap<f64> 转移所有权
  let a Heap<f64> = heap:<f64>(3.14f64)
  assert_true(a == 3.14f64)
  let b Heap<f64> = move(a)
  assert_true(b == 3.14f64)
}

#Test
fn test_move_rc_after_move() {
  ; 验证：move Rc 后新 owner 可正常使用
  let a Rc<i32> = 100
  let b Rc<i32> = move(a)
  assert_true(b == 100)
  ; b 仍可读
  let v i32& = as_ref(b)
  assert_eq(v, 100)
}
