; StringBuilder 行为测试
;
; 覆盖：
;   - 构造：StringBuilder::make() 空 builder
;   - append：码点（c'H'）、ASCII byte（72u8）、String、混合类型链
;   - len：空构造后 / append 后 / clear 后
;   - clear：清空 + 复用（clear 后重新 append 并 build）
;   - build：返回 String、重置 buffer（build 后 len=0 可继续 append）
;   - 重复 build：多次 build 各得独立 String
;   - Unicode：追加中文码点（你/好）、混合 ASCII + Unicode
;   - 边界：空 String append、空 builder build
;
; 已知缺口：StringBuilder eq/ne 比较未覆盖；build 后与之前返回的 String 隔离性仅单项验证。

; 构造测试

#Test
fn test_empty_ctor() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.len(), 0)
}

; append 测试

#Test
fn test_append_code_point() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(c'H')
  sb.append(c'e')
  sb.append(c'l')
  sb.append(c'l')
  sb.append(c'o')
  assert_eq(sb.len(), 5)
  let s String = sb.build()
  assert_eq(s, "Hello")
}

; 验证：StringBuilder 追加 ASCII 字节并构建字符串
#Test
fn test_append_ascii_byte() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(72u8)   ; 'H'
  sb.append(105u8)  ; 'i'
  sb.append(33u8)   ; '!'
  assert_eq(sb.len(), 3)
  let s String = sb.build()
  assert_eq(s, "Hi!")
}

; 验证：StringBuilder 追加字符串并构建最终结果
#Test
fn test_append_string() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  sb.append(" ")
  sb.append("World")
  assert_eq(sb.len(), 11)
  let s String = sb.build()
  assert_eq(s, "Hello World")
}

; 验证：StringBuilder 追加不同类型数据并构建字符串
#Test
fn test_append_mixed() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(c'H')
  sb.append("ello")
  sb.append(32u8)   ; space
  sb.append("World")
  sb.append(33u8)   ; '!'
  let s String = sb.build()
  assert_eq(s, "Hello World!")
}

; len 测试

#Test
fn test_len_after_append() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.len(), 0)
  sb.append("abc")
  assert_eq(sb.len(), 3)
  sb.append("def")
  assert_eq(sb.len(), 6)
}

; clear 测试

#Test
fn test_clear() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  assert_eq(sb.len(), 5)
  sb.clear()
  assert_eq(sb.len(), 0)
  let s String = sb.build()
  assert_eq(s.len(), 0)
}

; 验证：StringBuilder 清空后可以重用
#Test
fn test_clear_and_reuse() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("First")
  let s1 String = sb.build()
  assert_eq(s1, "First")
  
  sb.clear()
  sb.append("Second")
  let s2 String = sb.build()
  assert_eq(s2, "Second")
}

; build 测试

#Test
fn test_build_returns_string() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Test")
  let s String = sb.build()
  assert_eq(s, "Test")
}

; 验证：StringBuilder build 后 buffer 重置不影响已返回的字符串
#Test
fn test_build_resets_buffer() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  let s1 String = sb.build()
  assert_eq(s1, "Hello")
  assert_eq(sb.len(), 0)
  
  ; build 后继续 append 不影响已返回的 String
  sb.append("World")
  let s2 String = sb.build()
  assert_eq(s1, "Hello")  ; s1 不受影响
  assert_eq(s2, "World")
}

; 验证：StringBuilder 多次构建字符串
#Test
fn test_multiple_build() {
  #Mut let sb StringBuilder = StringBuilder::make()
  
  sb.append("A")
  let s1 String = sb.build()
  assert_eq(s1, "A")
  
  sb.append("B")
  let s2 String = sb.build()
  assert_eq(s2, "B")
  
  sb.append("C")
  let s3 String = sb.build()
  assert_eq(s3, "C")
}

; Unicode 测试

#Test
fn test_append_unicode() {
  #Mut let sb StringBuilder = StringBuilder::make()
  ; 追加 Unicode 码点（中文）
  sb.append(20320u32)  ; '你'
  sb.append(22909u32)  ; '好'
  let s String = sb.build()
  assert_eq(s.len(), 2)
}

; 验证：StringBuilder 追加混合 Unicode 字符串
#Test
fn test_append_mixed_unicode() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello ")
  sb.append(20320u32)  ; '你'
  sb.append(22909u32)  ; '好'
  let s String = sb.build()
  assert_eq(s.len(), 8)  ; "Hello 你好" = 6 + 2 = 8 个码点
}

; 边界测试

#Test
fn test_empty_string_append() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("")
  assert_eq(sb.len(), 0)
  let s String = sb.build()
  assert_eq(s.len(), 0)
}

; 验证：StringBuilder 构建空字符串
#Test
fn test_build_empty() {
  #Mut let sb StringBuilder = StringBuilder::make()
  let s String = sb.build()
  assert_eq(s.len(), 0)
}
