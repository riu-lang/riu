; StringBuilder 测试
; 覆盖构造、append、len、clear、build 等方法

; 构造测试

#Test
fn test_empty_ctor() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.len(), 0i64)
}

; append 测试

#Test
fn test_append_code_point() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(c'H')
  sb.append(c'e')
  sb.append(c'l')
  sb.append(c'l')
  sb.append(c'o')
  assert_eq(sb.len(), 5i64)
  let s String = sb.build()
  assert_eq(s, "Hello")
}

#Test
fn test_append_ascii_byte() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(72u8)   ; 'H'
  sb.append(105u8)  ; 'i'
  sb.append(33u8)   ; '!'
  assert_eq(sb.len(), 3i64)
  let s String = sb.build()
  assert_eq(s, "Hi!")
}

#Test
fn test_append_string() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  sb.append(" ")
  sb.append("World")
  assert_eq(sb.len(), 11i64)
  let s String = sb.build()
  assert_eq(s, "Hello World")
}

#Test
fn test_append_mixed() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(c'H')
  sb.append("ello")
  sb.append(32u8)   ; space
  sb.append("World")
  sb.append(33u8)   ; '!'
  let s String = sb.build()
  assert_eq(s, "Hello World!")
}

; len 测试

#Test
fn test_len_after_append() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.len(), 0i64)
  sb.append("abc")
  assert_eq(sb.len(), 3i64)
  sb.append("def")
  assert_eq(sb.len(), 6i64)
}

; clear 测试

#Test
fn test_clear() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  assert_eq(sb.len(), 5i64)
  sb.clear()
  assert_eq(sb.len(), 0i64)
  let s String = sb.build()
  assert_eq(s.len(), 0i64)
}

#Test
fn test_clear_and_reuse() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("First")
  let s1 String = sb.build()
  assert_eq(s1, "First")
  
  sb.clear()
  sb.append("Second")
  let s2 String = sb.build()
  assert_eq(s2, "Second")
}

; build 测试

#Test
fn test_build_returns_string() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Test")
  let s String = sb.build()
  assert_eq(s, "Test")
}

#Test
fn test_build_resets_buffer() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello")
  let s1 String = sb.build()
  assert_eq(s1, "Hello")
  assert_eq(sb.len(), 0i64)
  
  ; build 后继续 append 不影响已返回的 String
  sb.append("World")
  let s2 String = sb.build()
  assert_eq(s1, "Hello")  ; s1 不受影响
  assert_eq(s2, "World")
}

#Test
fn test_multiple_build() {
  #Mut let sb StringBuilder = StringBuilder::make()
  
  sb.append("A")
  let s1 String = sb.build()
  assert_eq(s1, "A")
  
  sb.append("B")
  let s2 String = sb.build()
  assert_eq(s2, "B")
  
  sb.append("C")
  let s3 String = sb.build()
  assert_eq(s3, "C")
}

; Unicode 测试

#Test
fn test_append_unicode() {
  #Mut let sb StringBuilder = StringBuilder::make()
  ; 追加 Unicode 码点（中文）
  sb.append(20320u32)  ; '你'
  sb.append(22909u32)  ; '好'
  let s String = sb.build()
  assert_eq(s.len(), 2i64)
}

#Test
fn test_append_mixed_unicode() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("Hello ")
  sb.append(20320u32)  ; '你'
  sb.append(22909u32)  ; '好'
  let s String = sb.build()
  assert_eq(s.len(), 8i64)  ; "Hello 你好" = 6 + 2 = 8 个码点
}

; 边界测试

#Test
fn test_empty_string_append() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append("")
  assert_eq(sb.len(), 0i64)
  let s String = sb.build()
  assert_eq(s.len(), 0i64)
}

#Test
fn test_build_empty() {
  #Mut let sb StringBuilder = StringBuilder::make()
  let s String = sb.build()
  assert_eq(s.len(), 0i64)
}
