; math.* 标准库基本用例
; 迁自 tests/cases/math_int.yux

#Test
fn test_math_abs_i8_neg() {
  ; 0i8 - 5i8 = -5i8；abs 应得 5i8
  assert_eq(math.abs(0i8 - 5i8), 5i8)
}

#Test
fn test_math_abs_i8_positive() {
  assert_eq(math.abs(42i8), 42i8)
}

#Test
fn test_math_abs_i8_zero() {
  assert_eq(math.abs(0i8), 0i8)
}
