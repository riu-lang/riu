; 基础类型用例
; 迁自 tests/cases/basic_types.yux
;
; 本文件包含基础类型测试:
; - 布尔类型
; - 各整数类型
; - 浮点类型
; - 整数字面量进制

; ==================== 布尔类型 ====================

#Test
fn test_bool_true() {
  let b bool = true
  assert_true(b)
  assert_eq(b, true)
}

#Test
fn test_bool_false() {
  let b bool = false
  assert_false(b)
  assert_eq(b, false)
}

; ==================== 整数类型 ====================

#Test
fn test_i8_type() {
  let a i8 = 42
  assert_eq(a, 42)
}

#Test
fn test_u8_type() {
  let a u8 = 255
  assert_eq(a, 255)
}

#Test
fn test_i16_type() {
  let a i16 = 1000
  assert_eq(a, 1000)
}

#Test
fn test_u16_type() {
  let a u16 = 65535
  assert_eq(a, 65535)
}

#Test
fn test_i32_type() {
  let a i32 = 100000
  assert_eq(a, 100000)
}

#Test
fn test_u32_type() {
  let a u32 = 4000000000
  assert_eq(a, 4000000000)
}

#Test
fn test_i64_type() {
  let a i64 = 1000000000
  assert_eq(a, 1000000000)
}

#Test
fn test_u64_type() {
  let a u64 = 1000000000
  assert_eq(a, 1000000000)
}

; ==================== 浮点类型 ====================

#Test
fn test_f32_type() {
  let a f32 = 3.14f32
  assert_eq(a, 3.14f32)
}

#Test
fn test_f64_type() {
  let a f64 = 3.14159265358979
  assert_eq(a, 3.14159265358979)
}

; ==================== 整数字面量进制 ====================

#Test
fn test_binary_literal() {
  let a i32 = 0b1010
  assert_eq(a, 10)
}

#Test
fn test_octal_literal() {
  let a i32 = 0o755
  assert_eq(a, 493)
}

#Test
fn test_hex_literal() {
  let a i32 = 0xFF
  assert_eq(a, 255)
}

; ==================== 类型后缀字面量 ====================

#Test
fn test_i8_suffix() {
  let a i8 = 127i8
  assert_eq(a, 127)
}

#Test
fn test_u64_suffix() {
  let a u64 = 100u64
  assert_eq(a, 100)
}

#Test
fn test_f32_suffix() {
  let a f32 = 2.5f32
  assert_eq(a, 2.5f32)
}
