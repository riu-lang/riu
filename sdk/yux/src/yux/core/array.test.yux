; Array<T> 行为测试
;
; 覆盖：
;   - 下标读写（Array<T> / [T * N]）
;   - push / len / first / last / is_empty
;   - Array:<T>::with_capacity 静态工厂
;   - f64 元素链式加法（回归 v0.18 LLVM crash）
;   - bool / String 元素
;   - Array<String>[i].len() / Array<struct>[i].method()（下标后走元素方法）
;   - clear / clone
;   - slice / concat / contains
;   - index_of / last_index_of / get_or_null / first_or_null / last_or_null
;   - insert / remove_at / reverse
;   - take / drop
;   - 函数返回 move、传参共享语义
;   - Array<Rc<T>> 元素重赋值 retain/release
;   - 嵌套 Array<Array<T>> 字面量
;   - get / copy_of / T& 写穿
;   - [T * N] 定长数组 T& 绑定 + 运算符 + copy_of

; ==================== 下标读写 ====================

; 验证：Array 下标读写与赋值
#Test
fn test_array_access_read_write() {
  #Mut let arr Array<i32> = [10i32, 20i32, 30i32]
  assert_eq(arr[0], 10i32)
  arr[1] = 25i32
  assert_eq(arr[1], 25i32)
  arr[2] = arr[0] + arr[1]
  assert_eq(arr[2], 35i32)
}

; ==================== 定长数组 fill / 列表初始化 ====================

; 验证：定长数组 fill 初始化为零值
#Test
fn test_array_fill_u8_zero() {
  #Mut let buf [u8 * 5] = [0u8 ...]
  assert_eq(buf[0], 0u8)
  assert_eq(buf[4], 0u8)
}

; 验证：Array 填充零值
#Test
fn test_array_fill_i32_zero_with_type() {
  #Mut let arr [i32 * 3] = [0 ... i32]
  assert_eq(arr[0], 0i32)
  assert_eq(arr[2], 0i32)
}

; 验证：固定大小数组中布尔值的读取与断言
#Test
fn test_array_fixed_bool_listed() {
  #Mut let flags [bool * 3] = [true, true, true]
  assert_true(flags[0])
  assert_true(flags[2])
}

; 验证：固定大小数组的索引读取
#Test
fn test_array_fixed_i32_list() {
  let arr [i32 * 5] = [1i32, 2i32, 3i32, 4i32, 5i32]
  assert_eq(arr[0], 1i32)
  assert_eq(arr[4], 5i32)
}

; 验证：固定大小数组的元素读取
#Test
fn test_array_fixed_u8_list() {
  let bytes [u8 * 4] = [97u8, 98u8, 99u8, 100u8]
  assert_eq(bytes[0], 97u8)
  assert_eq(bytes[3], 100u8)
}

; 验证：固定长度数组中布尔值的读取与断言
#Test
fn test_array_fixed_bool_list_mixed() {
  let bools [bool * 3] = [true, false, true]
  assert_true(bools[0])
  assert_false(bools[1])
}

; ==================== Array:<T>::with_capacity ====================

; 验证：with_capacity 预留容量，len 为 0，push 不立刻扩容
#Test
fn test_array_with_capacity() {
  #Mut let arr Array<i32> = Array:<i32>::with_capacity(8)
  assert_eq(arr.len(), 0)
  assert_eq(arr.cap(), 8)
  assert_true(arr.is_empty())
  arr.push(1)
  arr.push(2)
  arr.push(3)
  assert_eq(arr.len(), 3)
  assert_eq(arr.cap(), 8)
  assert_eq(arr[0], 1)
  assert_eq(arr[1], 2)
  assert_eq(arr[2], 3)
}

; 验证：with_capacity(0) 与空字面量相同（不分配）
#Test
fn test_array_with_capacity_zero() {
  #Mut let arr Array<i32> = Array:<i32>::with_capacity(0)
  assert_eq(arr.len(), 0)
  assert_eq(arr.cap(), 0)
  assert_true(arr.is_empty())
  arr.push(42)
  assert_eq(arr.len(), 1)
  assert_eq(arr[0], 42)
}

; 验证：容量实参为运行期 usize
#Test
fn test_array_with_capacity_runtime_n() {
  let n usize = 4usize
  #Mut let arr Array<i32> = Array:<i32>::with_capacity(n)
  assert_eq(arr.cap(), 4usize)
  arr.push(10)
  arr.push(20)
  assert_eq(arr.len(), 2)
  assert_eq(arr.cap(), 4usize)
}

; ==================== push / len / first / last / is_empty ====================

; 验证：Array push 基本行为
#Test
fn test_array_push_basic() {
  #Mut let arr Array<i32> = []
  arr.push(1)
  arr.push(2)
  assert_eq(arr.len(), 2)
}

; 验证：Array push 多次后长度正确
#Test
fn test_array_push_many() {
  #Mut let arr Array<i32> = []
  loop i = 0 {
    if i >= 5 {
      break;
    }
    arr.push(i * 10)
    i = i + 1
  }
  assert_eq(arr.len(), 5)
}

; 验证：Array len 方法返回数组长度
#Test
fn test_array_len() {
  #Mut let arr Array<i32> = [1, 2, 3, 4, 5]
  assert_eq(arr.len(), 5)
}

; 验证：Array 的 first 和 last 方法返回正确值
#Test
fn test_array_first_last() {
  #Mut let arr Array<i32> = [100, 200, 300]
  assert_eq(arr.first(), 100)
  assert_eq(arr.last(), 300)
}

; 验证：Array is_empty 方法在非空数组上返回 false
#Test
fn test_array_is_empty() {
  #Mut let arr Array<i32> = [1, 2, 3]
  assert_false(arr.is_empty())
}

; 验证：空数组的 is_empty 方法返回 true
#Test
fn test_array_empty_is_empty() {
  #Mut let empty Array<i32> = []
  assert_true(empty.is_empty())
}

; ==================== f64 元素运算（含 v0.18 回归） ====================

; 验证：Array f64 基本运算和长度检查
#Test
fn test_array_f64_basic() {
  #Mut let arr Array<f64> = [1.5f64, 2.5f64, 3.5f64]
  assert_eq(arr.len(), 3)
  assert_eq(arr[0] + arr[1], 4.0f64)
}

; 验证：Array f64 项链式加法
#Test
fn test_array_f64_chain_add() {
  ; v0.18: 修复 f64 3 项链式加法 LLVM crash
  ; 根因：ExprAddSubNode::getType() 在操作数都是 Ref<f64> 时返回 Ref<f64> 而非 f64
  #Mut let arr Array<f64> = [1.0f64, 2.0f64, 3.0f64]
  assert_eq(arr[0] + arr[1] + arr[2], 6.0f64)
}

; 验证：Array 中的 f64 类型元素通过索引访问并进行加法运算
#Test
fn test_array_f64_let_bind() {
  ; v0.18: 修复后 let x f64 = arr[i] + arr[j] 不再报 "expected f64, got Ref<f64>"
  #Mut let arr Array<f64> = [1.0f64, 2.0f64]
  let x f64 = arr[0] + arr[1]
  assert_eq(x, 3.0f64)
}

; ==================== bool / String 元素 ====================

; 验证：Array 存储布尔元素的长度和值
#Test
fn test_array_bool_elements() {
  #Mut let arr Array<bool> = [true, false, true]
  assert_eq(arr.len(), 3)
  assert_true(arr[0])
  assert_false(arr[1])
}

; 验证：Array of String 的长度
#Test
fn test_array_of_string() {
  #Mut let arr Array<String> = ["hello", "world"]
  assert_eq(arr.len(), 2)
}

; 验证：Array<String>[i].len() / get(i).len() 走 String.len，不是外层 Array.len
#Test
fn test_array_string_index_method() {
  #Mut let arr Array<String> = ["hello", "world"]
  assert_eq(arr[0].len(), 5)
  assert_eq(arr[1].len(), 5)
  assert_eq(arr.get(0).len(), 5)
}

struct ElemMeth {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) ElemMeth {
    ret Self {
      .a = a
      .b = b
    }
  }

  fn sum() i32 {
    $.a + $.b
  }

  fn set_a(v i32) {
    $.a = v
  }
}

; 验证：下标后调用户 struct 方法，读 + 写穿元素
#Test
fn test_array_struct_index_method() {
  #Mut let arr Array<ElemMeth> = [ElemMeth::make(1, 2), ElemMeth::make(3, 4)]
  assert_eq(arr[0].sum(), 3)
  assert_eq(arr[1].sum(), 7)
  arr[0].set_a(10)
  assert_eq(arr[0].a, 10)
  assert_eq(arr[0].sum(), 12)
  assert_eq(arr[1].a, 3)
}

; ==================== clear / clone ====================

; 验证：Array clear 方法是否能清空数组并使长度和 is_empty 返回正确值
#Test
fn test_array_clear() {
  #Mut let arr Array<i32> = [1, 2, 3]
  assert_eq(arr.len(), 3)
  arr.clear()
  assert_eq(arr.len(), 0)
  assert_true(arr.is_empty())
}

; 验证：Array clone 后长度不变
#Test
fn test_array_clone() {
  #Mut let arr Array<i32> = [1, 2, 3]
  #Mut let copy Array<i32> = arr.clone()
  assert_eq(copy.len(), 3)
}

; ==================== 函数返回 Array<T>（move-return） ====================

fn make_array_i32() Array<i32> {
  #Mut let a Array<i32> = [10i32, 20i32, 30i32]
  ret a
}

; 验证：Array 返回移动后长度和元素值正确
#Test
fn test_array_return_move() {
  #Mut let arr Array<i32> = make_array_i32()
  assert_eq(arr.len(), 3)
  assert_eq(arr[0], 10i32)
  assert_eq(arr[1], 20i32)
  assert_eq(arr[2], 30i32)
}

; ==================== 传参共享语义 ====================

fn modify_share(a Array<i32>&) {
  a[0] = 99i32
  a.push(42i32)
}

; 验证：Array 通过引用共享修改
#Test
fn test_array_passing_share() {
  #Mut let arr Array<i32> = [1i32, 2i32, 3i32]
  modify_share(&arr)
  assert_eq(arr.len(), 4)
  assert_eq(arr[0], 99i32)
  assert_eq(arr[1], 2i32)
  assert_eq(arr[2], 3i32)
  assert_eq(arr[3], 42i32)
}

; ==================== Array<Rc<T>> 元素重赋值 ====================

struct ArrPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) ArrPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

; 验证：Rc 引用计数数组元素重新赋值
#Test
fn test_array_elem_box_reassign() {
  #Mut let p Rc<ArrPair> = ArrPair::make(10, 20)
  #Mut let q Rc<ArrPair> = ArrPair::make(30, 40)
  #Mut let arr Array<Rc<ArrPair>> = [p]
  assert_eq(arr[0].a, 10i32)
  arr[0] = q
  assert_eq(arr[0].a, 30i32)
  assert_eq(p.a, 10)
  assert_eq(q.b, 40)
}

; ==================== 嵌套 Array<Array<T>> ====================

; 验证：嵌套 Array<Array<T>> 的字面量初始化和访问
#Test
fn test_array_nested_literal_even() {
  #Mut let rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32]]
  assert_eq(rows.len(), 2)
  assert_eq(rows[0].len(), 2)
  assert_eq(rows[0][0], 1i32)
  assert_eq(rows[1][0], 3i32)
}

; 验证：嵌套数组字面量的长度和元素访问
#Test
fn test_array_nested_literal_uneven() {
  #Mut let rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32, 5i32]]
  assert_eq(rows.len(), 2)
  assert_eq(rows[0].len(), 2)
  assert_eq(rows[1].len(), 3)
  assert_eq(rows[0][0], 1i32)
  assert_eq(rows[1][2], 5i32)
}

; ==================== T& 引用访问（get / copy_of / 写穿） ====================

; 验证：Array 引用访问与解引用
#Test
fn test_array_get_tref_bind() {
  #Mut let a Array<i32> = [100, 200]
  let r i32& = a.get(0)
  assert_eq(r, 100)
}

; 验证：Array get 方法返回值的复制
#Test
fn test_array_get_copy_of() {
  #Mut let a Array<i32> = [10, 20, 30]
  let v i32 = copy_of(a.get(0))
  assert_eq(v, 10)
  assert_eq(copy_of(a.get(2)), 30i32)
}

; 验证：Array get 方法返回的引用可以用于修改数组元素
#Test
fn test_array_get_write_through() {
  #Mut let a Array<i32> = [5, 10, 15]
  #Mut let w i32& = a.get(1)
  w = 42
  assert_eq(a[1], 42)
}

; ==================== v0.16 [] → T&（Array<T>） ====================

; 验证：Array 索引引用绑定与修改
#Test
fn test_array_index_ref_bind() {
  #Mut let arr Array<i32> = [100, 200, 300]
  let r i32& = arr[0]
  assert_eq(r, 100)
  #Mut let w i32& = arr[1]
  w = 42
  assert_eq(arr[1], 42)
  assert_eq(w, 42)
}

; 验证：Array 索引引用操作符的行为，包括加法、乘法、相等性比较和大小比较
#Test
fn test_array_index_ref_ops() {
  let arr Array<i32> = [10, 20, 30]
  assert_eq(arr[0] + arr[1], 30i32)
  assert_eq(arr[1] * arr[2], 600i32)
  assert_true(arr[0] == arr[0])
  assert_false(arr[0] == arr[1])
  assert_eq(arr[0], 10i32)
  assert_true(arr[1] > arr[0])
  assert_true(arr[0] < arr[2])
}

; 验证：Array 索引读取与复制行为
#Test
fn test_array_index_copy_of() {
  #Mut let arr Array<i32> = [5, 10, 15]
  let x i32 = copy_of(arr[0])
  assert_eq(x, 5)
  let y i32 = copy_of(arr[1])
  arr[1] = 99
  assert_eq(y, 10)
  assert_eq(arr[1], 99)
  let z i64 = copy_of(arr[2]).to_i64()
  assert_eq(z, 15)
}

; ==================== v0.16 [] → T&（[T * N] 定长数组） ====================

; 验证：定长数组索引引用绑定与修改
#Test
fn test_fixed_array_index_ref_bind() {
  #Mut let buf [i32 * 3] = [1i32, 2i32, 3i32]
  let r i32& = buf[0]
  assert_eq(r, 1)
  #Mut let w i32& = buf[2]
  w = 99
  assert_eq(buf[2], 99i32)
}

; 验证：固定数组索引引用操作
#Test
fn test_fixed_array_index_ref_ops() {
  let buf [i32 * 3] = [5i32, 10i32, 15i32]
  assert_eq(buf[0] + buf[1], 15i32)
  assert_eq(buf[2] - buf[1], 5i32)
  assert_true(buf[0] < buf[2])
}

; 验证：FixedArray 索引访问与元素复制
#Test
fn test_fixed_array_index_copy_of() {
  let buf [i32 * 3] = [7i32, 14i32, 21i32]
  let x i32 = copy_of(buf[0])
  assert_eq(x, 7)
  let y i64 = copy_of(buf[2]).to_i64()
  assert_eq(y, 21)
}

; ==================== pop / set_len / clear+push（迁自 bug_hunt） ====================

#Test
fn test_array_pop_basic() {
  ; 验证：pop 返回值并递减 len
  #Mut let arr Array<i32> = [10, 20, 30]
  assert_eq(arr.pop(), 30)
  assert_eq(arr.len(), 2)
  assert_eq(arr.pop(), 20)
  assert_eq(arr.len(), 1)
  assert_eq(arr.pop(), 10)
  assert_eq(arr.len(), 0)
}

#Test
fn test_array_pop_to_empty() {
  ; 验证：pop 到空数组后可继续 push
  #Mut let arr Array<i32> = [42]
  assert_eq(arr.pop(), 42)
  assert_true(arr.is_empty())
  arr.push(99)
  assert_eq(arr.len(), 1)
  assert_eq(arr.pop(), 99)
}

#Test
fn test_array_set_len_shrink() {
  ; 验证：set_len 截断数组，保留前 N 个元素
  #Mut let arr Array<i32> = [1, 2, 3, 4, 5]
  arr.set_len(2)
  assert_eq(arr.len(), 2)
  assert_eq(arr[0], 1)
  assert_eq(arr[1], 2)
}

fn array_set_len_string_drop_scope() {
  #Mut let strings Array<String> = ["a", "b", "c"]
  strings.set_len(1usize)
  assert_eq(strings.len(), 1)
  assert_eq(strings[0], "a")
}

#Test
fn test_array_set_len_drops_truncated_strings() {
  #Mut let base i64 = rc_leak_count()
  array_set_len_string_drop_scope()
  assert_eq(rc_leak_count() - base, 0)
}

#Test
fn test_array_push_after_clear() {
  ; 验证：clear 后 is_empty，可继续 push
  #Mut let arr Array<i32> = []
  arr.push(1)
  arr.push(2)
  arr.clear()
  assert_true(arr.is_empty())
  arr.push(3)
  assert_eq(arr.len(), 1)
  assert_eq(arr[0], 3)
}

; ==================== reserve ====================

#Test
fn test_array_reserve_basic() {
  ; 验证：reserve 后 cap >= len+additional，len 不变
  #Mut let arr Array<i32> = []
  arr.reserve(10usize)
  assert_eq(arr.len(), 0)
  assert_true(arr.is_empty())
  ; push 不应触发重分配
  loop i i32 = 0 {
    if i >= 10 {
      break;
    }
    arr.push(i)
    i += 1
  }
  assert_eq(arr.len(), 10)
}

#Test
fn test_array_reserve_after_push() {
  ; 验证：先 push 再 reserve，数据不丢
  #Mut let arr Array<i32> = []
  arr.push(42)
  arr.reserve(100usize)
  assert_eq(arr.len(), 1)
  assert_eq(arr[0], 42)
}

#Test
fn test_array_reserve_no_shrink() {
  ; 验证：reserve 小于当前 cap 时不会缩容
  #Mut let arr Array<i32> = []
  loop i i32 = 0 {
    if i >= 20 {
      break;
    }
    arr.push(i)
    i += 1
  }
  let cap_before usize = arr.cap()
  arr.reserve(1usize)
  assert_true(arr.cap() >= cap_before)
}

; ==================== 嵌套 Array（迁自 bug_hunt） ====================

#Test
fn test_nested_array_push_inner() {
  ; 验证：push(move(inner)) 到 Array<Array<i32>>
  #Mut let outer Array<Array<i32>> = []
  #Mut let inner Array<i32> = [1, 2]
  outer.push(move(inner))
  assert_eq(outer.len(), 1)
  assert_eq(outer[0].len(), 2)
  assert_eq(outer[0][0], 1)
  assert_eq(outer[0][1], 2)
}

; ==================== Array<f64>（迁自 bug_hunt） ====================

#Test
fn test_array_f64_push_and_read() {
  ; 验证：Array<f64> push 和索引读取
  #Mut let arr Array<f64> = []
  arr.push(1.0f64)
  arr.push(2.5f64)
  arr.push(3.0f64)
  assert_eq(arr.len(), 3)
  assert_eq(arr[0] + arr[1] + arr[2], 6.5f64)
}

#Test
fn test_array_f64_first_last() {
  ; 验证：Array<f64> first() 和 last()
  #Mut let arr Array<f64> = [1.0f64, 2.0f64, 3.0f64]
  assert_eq(arr.first(), 1.0f64)
  assert_eq(arr.last(), 3.0f64)
}

; ==================== slice / concat / contains ====================

#Test
fn test_array_slice() {
  let arr Array<i32> = [10, 20, 30, 40]
  let mid Array<i32> = arr.slice(1, 3)
  assert_eq(mid.len(), 2)
  assert_eq(mid[0], 20)
  assert_eq(mid[1], 30)
  let empty Array<i32> = arr.slice(2, 2)
  assert_true(empty.is_empty())
  let clamp Array<i32> = arr.slice(3, 99)
  assert_eq(clamp.len(), 1)
  assert_eq(clamp[0], 40)
  let flipped Array<i32> = arr.slice(3, 1)
  assert_true(flipped.is_empty())
}

#Test
fn test_array_concat() {
  let a Array<i32> = [1, 2]
  let b Array<i32> = [3, 4, 5]
  let c Array<i32> = a.concat(&b)
  assert_eq(c.len(), 5)
  assert_eq(c[0], 1)
  assert_eq(c[4], 5)
  assert_eq(a.len(), 2)
  assert_eq(b.len(), 3)
  let empty Array<i32> = []
  let d Array<i32> = a.concat(&empty)
  assert_eq(d.len(), 2)
  assert_eq(d[1], 2)
}

#Test
fn test_array_contains() {
  let arr Array<i32> = [1, 2, 3]
  assert_true(arr.contains(2))
  assert_false(arr.contains(9))
  let empty Array<i32> = []
  assert_false(empty.contains(1))
}

#Test
fn test_array_contains_string() {
  let arr Array<String> = ["a", "b", "c"]
  assert_true(arr.contains("b"))
  assert_false(arr.contains("z"))
}

; ==================== index_of / last_index_of ====================

#Test
fn test_array_index_of() {
  let arr Array<i32> = [10, 20, 30, 20]
  let i usize? = arr.index_of(20)
  assert_true(i.has())
  assert_eq(i.get(), 1)
  let miss usize? = arr.index_of(9)
  assert_false(miss.has())
  let empty Array<i32> = []
  assert_false(empty.index_of(1).has())
}

#Test
fn test_array_last_index_of() {
  let arr Array<i32> = [10, 20, 30, 20]
  let i usize? = arr.last_index_of(20)
  assert_true(i.has())
  assert_eq(i.get(), 3)
  let one usize? = arr.last_index_of(10)
  assert_eq(one.get(), 0)
  assert_false(arr.last_index_of(9).has())
}

#Test
fn test_array_index_of_string() {
  let arr Array<String> = ["a", "b", "a"]
  assert_eq(arr.index_of("a").get(), 0)
  assert_eq(arr.last_index_of("a").get(), 2)
  assert_false(arr.index_of("z").has())
}

; ==================== get_or_null / first_or_null / last_or_null ====================

#Test
fn test_array_get_or_null() {
  let arr Array<i32> = [10, 20, 30]
  let v i32? = arr.get_or_null(1)
  assert_true(v.has())
  assert_eq(v.get(), 20)
  assert_false(arr.get_or_null(3).has())
  assert_false(arr.get_or_null(99).has())
}

#Test
fn test_array_first_last_or_null() {
  let arr Array<i32> = [10, 20, 30]
  assert_eq(arr.first_or_null().get(), 10)
  assert_eq(arr.last_or_null().get(), 30)
  let empty Array<i32> = []
  assert_false(empty.first_or_null().has())
  assert_false(empty.last_or_null().has())
}

#Test
fn test_array_first_or_null_string() {
  let arr Array<String> = ["hello", "world"]
  assert_eq(arr.first_or_null().get(), "hello")
  assert_eq(arr.last_or_null().get(), "world")
}

; ==================== insert / remove_at / reverse ====================

#Test
fn test_array_insert() {
  #Mut let arr Array<i32> = [10, 30]
  arr.insert(1, 20)
  assert_eq(arr.len(), 3)
  assert_eq(arr[0], 10)
  assert_eq(arr[1], 20)
  assert_eq(arr[2], 30)
  arr.insert(0, 5)
  assert_eq(arr[0], 5)
  assert_eq(arr.len(), 4)
  arr.insert(4, 40)
  assert_eq(arr[4], 40)
  assert_eq(arr.len(), 5)
}

#Test
fn test_array_insert_empty() {
  #Mut let arr Array<i32> = []
  arr.insert(0, 7)
  assert_eq(arr.len(), 1)
  assert_eq(arr[0], 7)
}

#Test
fn test_array_remove_at() {
  #Mut let arr Array<i32> = [10, 20, 30, 40]
  assert_eq(arr.remove_at(1), 20)
  assert_eq(arr.len(), 3)
  assert_eq(arr[0], 10)
  assert_eq(arr[1], 30)
  assert_eq(arr[2], 40)
  assert_eq(arr.remove_at(0), 10)
  assert_eq(arr[0], 30)
  assert_eq(arr.remove_at(1), 40)
  assert_eq(arr.len(), 1)
  assert_eq(arr[0], 30)
}

#Test
fn test_array_reverse() {
  #Mut let arr Array<i32> = [1, 2, 3, 4]
  arr.reverse()
  assert_eq(arr[0], 4)
  assert_eq(arr[1], 3)
  assert_eq(arr[2], 2)
  assert_eq(arr[3], 1)
  #Mut let odd Array<i32> = [1, 2, 3]
  odd.reverse()
  assert_eq(odd[0], 3)
  assert_eq(odd[1], 2)
  assert_eq(odd[2], 1)
  #Mut let one Array<i32> = [9]
  one.reverse()
  assert_eq(one[0], 9)
  #Mut let empty Array<i32> = []
  empty.reverse()
  assert_true(empty.is_empty())
}

#Test
fn test_array_insert_remove_string() {
  #Mut let arr Array<String> = ["a", "c"]
  arr.insert(1, "b")
  assert_eq(arr[1], "b")
  assert_eq(arr.remove_at(0), "a")
  assert_eq(arr[0], "b")
  arr.reverse()
  assert_eq(arr[0], "c")
  assert_eq(arr[1], "b")
}

; ==================== take / drop ====================

#Test
fn test_array_take_drop() {
  let arr Array<i32> = [10, 20, 30, 40]
  let t Array<i32> = arr.take(2)
  assert_eq(t.len(), 2)
  assert_eq(t[0], 10)
  assert_eq(t[1], 20)
  let d Array<i32> = arr.drop(2)
  assert_eq(d.len(), 2)
  assert_eq(d[0], 30)
  assert_eq(d[1], 40)
  assert_eq(arr.len(), 4)
  let over Array<i32> = arr.take(99)
  assert_eq(over.len(), 4)
  let none Array<i32> = arr.drop(99)
  assert_true(none.is_empty())
  let z Array<i32> = arr.take(0)
  assert_true(z.is_empty())
}

; ==================== 急切高阶方法 ====================

#Test
fn test_array_any_all_i32() {
  let arr Array<i32> = [1, 2, 3, 4]
  let threshold i32 = 3
  assert_true(arr.any((x) => x > threshold))
  assert_false(arr.any((x) => x > 9))
  assert_true(arr.all((x) => x > 0))
  assert_false(arr.all((x) => x < 4))

  let empty Array<i32> = []
  assert_false(empty.any((x) => x == 0))
  assert_true(empty.all((x) => x == 0))
}

#Test
fn test_array_filter_i32() {
  let arr Array<i32> = [1, 2, 3, 4, 5]
  let even Array<i32> = arr.filter((x) => x % 2 == 0)
  assert_eq(even.len(), 2)
  assert_eq(even[0], 2)
  assert_eq(even[1], 4)
  assert_eq(arr.len(), 5)

  let none Array<i32> = arr.filter((x) => x > 9)
  assert_true(none.is_empty())
}

#Test
fn test_array_filter_string() {
  let arr Array<String> = ["a", "long", "b"]
  let short Array<String> = arr.filter((s) => s.len() == 1)
  assert_eq(short.len(), 2)
  assert_eq(short[0], "a")
  assert_eq(short[1], "b")
  assert_eq(arr[1], "long")
}

fn array_double_ref(x i32&) i32 = x * 2

fn array_higher_order_capture_smoke() {
  let arr Array<i32> = [1, 2, 3]
  let threshold i32 = 1
  let predicate Function<i32&, bool> = (x) => x > threshold
  assert_true(arr.any(predicate))
  ; 同一个 Function 值可重复传入，方法调用不能消费源变量
  assert_true(arr.any(predicate))
  let kept Array<i32> = arr.filter((x) => x > threshold)
  let mapped Array<i32> = kept.map:<i32>((x) => x * threshold)
  assert_eq(mapped[0], 2)
}

#Test
fn test_array_map_i32_to_string() {
  let arr Array<i32> = [1, 20, 300]
  let strings Array<String> = arr.map:<String>((x) => x.to_string())
  assert_eq(strings.len(), 3)
  assert_eq(strings[0], "1")
  assert_eq(strings[1], "20")
  assert_eq(strings[2], "300")

  ; Function 返回类型明确时可反推 U，不要求 turbofish
  let doubled Array<i32> = arr.map(array_double_ref)
  assert_eq(doubled[0], 2)
  assert_eq(doubled[2], 600)
}

#Test
fn test_array_higher_order_releases_captures() {
  #Mut let base i64 = rc_leak_count()
  array_higher_order_capture_smoke()
  assert_eq(rc_leak_count() - base, 0)
}

fn array_string_drop_scope() {
  let ints Array<i32> = [1, 2]
  let strings Array<String> = ints.map:<String>((x) => x.to_string())
  assert_eq(strings.len(), 2)
}

#Test
fn test_array_drops_live_string_elements() {
  #Mut let base i64 = rc_leak_count()
  array_string_drop_scope()
  assert_eq(rc_leak_count() - base, 0)
}

fn array_string_drop_empty_scope() {
  let strings Array<String> = []
  assert_true(strings.is_empty())
}

#Test
fn test_array_drop_empty_is_noop() {
  #Mut let base i64 = rc_leak_count()
  array_string_drop_empty_scope()
  assert_eq(rc_leak_count() - base, 0)
}

fn array_string_clear_scope() {
  let ints Array<i32> = [1, 2]
  #Mut let strings Array<String> = ints.map:<String>((x) => x.to_string())
  strings.clear()
}

#Test
fn test_array_clear_drops_removed_string_elements() {
  #Mut let base i64 = rc_leak_count()
  array_string_clear_scope()
  assert_eq(rc_leak_count() - base, 0)
}

fn array_string_move_out_scope() {
  let ints Array<i32> = [1, 2, 3]
  #Mut let strings Array<String> = ints.map:<String>((x) => x.to_string())
  let popped String = strings.pop()
  let removed String = strings.remove_at(0usize)
  assert_eq(popped, "3")
  assert_eq(removed, "1")
  assert_eq(strings[0], "2")
}

#Test
fn test_array_drop_ignores_moved_out_slots() {
  #Mut let base i64 = rc_leak_count()
  array_string_move_out_scope()
  assert_eq(rc_leak_count() - base, 0)
}

struct ArrayDropValue {
  text String

  #Static
  fn make(value i32) ArrayDropValue {
    ret Self {
      .text = value.to_string()
    }
  }
}

fn array_struct_drop_scope() {
  let values Array<ArrayDropValue> = [ArrayDropValue::make(1), ArrayDropValue::make(2)]
  assert_eq(values[1].text, "2")
}

#Test
fn test_array_drops_struct_elements() {
  #Mut let base i64 = rc_leak_count()
  array_struct_drop_scope()
  assert_eq(rc_leak_count() - base, 0)
}

fn nested_array_clone_scope() {
  let rows Array<Array<i32>> = [[1, 2], [3]]
  let copy Array<Array<i32>> = rows.clone()
  assert_eq(copy[0][0], 1)
  assert_eq(copy[1][0], 3)
  assert_eq(rows[0][1], 2)
}

#Test
fn test_array_clone_nested_no_double_free() {
  nested_array_clone_scope()
}

fn nested_array_filter_scope() {
  let rows Array<Array<i32>> = [[1], [2, 3], []]
  let kept Array<Array<i32>> = rows.filter((row) => row.len() != 0usize)
  assert_eq(kept.len(), 2)
  assert_eq(kept[1][1], 3)
  assert_eq(rows[2].len(), 0)
}

#Test
fn test_array_filter_nested_no_double_free() {
  nested_array_filter_scope()
}

#NoCopy
struct ArrBox {
  items Array<i32>
}

fn struct_array_field_clone_scope() {
  let values Array<ArrBox> = [ArrBox {
    .items = [1, 2]
  }]
  let copy Array<ArrBox> = values.clone()
  assert_eq(copy[0].items[0], 1)
  assert_eq(values[0].items[1], 2)
}

#Test
fn test_array_clone_struct_array_field_no_double_free() {
  struct_array_field_clone_scope()
}
