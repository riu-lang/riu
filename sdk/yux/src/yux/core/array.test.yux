; Array<T> 行为用例（迁自 tests/cases/array_*）
; 覆盖：基础下标读写、定长数组初始化（fill/列表）、按值传参共享语义、
;       函数返回 move、Array<Rc<T>> 元素重赋值的 retain/release。

; ---------- array_access：下标读写 ----------

#Test
fn test_array_access_read_write() {
  #Mut let arr Array<i32> = [10i32, 20i32, 30i32]
  assert_eq(arr[0], 10i32)
  arr[1] = 25i32
  assert_eq(arr[1], 25i32)
  arr[2] = arr[0] + arr[1]
  assert_eq(arr[2], 35i32)
}

; ---------- array_fill：定长数组 fill 与混合初始化 ----------

#Test
fn test_array_fill_u8_zero() {
  #Mut let buf [u8 * 5] = [0u8 ...]
  assert_eq(buf[0], 0u8)
  assert_eq(buf[4], 0u8)
}

#Test
fn test_array_fill_i32_zero_with_type() {
  #Mut let arr [i32 * 3] = [0 ... i32]
  assert_eq(arr[0], 0i32)
  assert_eq(arr[2], 0i32)
}

#Test
fn test_array_fixed_bool_listed() {
  #Mut let flags [bool * 3] = [true, true, true]
  assert_true(flags[0])
  assert_true(flags[2])
}

; ---------- array_types：定长数组列表初始化 + 各元素类型 ----------

#Test
fn test_array_fixed_i32_list() {
  let arr [i32 * 5] = [1i32, 2i32, 3i32, 4i32, 5i32]
  assert_eq(arr[0], 1i32)
  assert_eq(arr[4], 5i32)
}

#Test
fn test_array_fixed_u8_list() {
  let bytes [u8 * 4] = [97u8, 98u8, 99u8, 100u8]
  assert_eq(bytes[0], 97u8)
  assert_eq(bytes[3], 100u8)
}

#Test
fn test_array_fixed_bool_list_mixed() {
  let bools [bool * 3] = [true, false, true]
  assert_true(bools[0])
  assert_false(bools[1])
}

; ---------- array_return：函数返回 Array<T> 走 move-return ----------

fn make_array_i32() Array<i32> {
  #Mut let a Array<i32> = [10i32, 20i32, 30i32]
  ret a
}

#Test
fn test_array_return_move() {
  #Mut let arr Array<i32> = make_array_i32()
  assert_eq(arr.len(), 3i64)
  assert_eq(arr[0], 10i32)
  assert_eq(arr[1], 20i32)
  assert_eq(arr[2], 30i32)
}

; ---------- array_passing_share：传参为句柄共享，callee 修改对 caller 可见 ----------

fn modify_share(a Array<i32>) {
  a[0] = 99i32
  a.push(42i32)
}

#Test
fn test_array_passing_share() {
  #Mut let arr Array<i32> = [1i32, 2i32, 3i32]
  modify_share(arr)
  assert_eq(arr.len(), 4i64)
  assert_eq(arr[0], 99i32)
  assert_eq(arr[1], 2i32)
  assert_eq(arr[2], 3i32)
  assert_eq(arr[3], 42i32)
}

; ---------- array_elem_rc_assign：Array<Rc<T>> 元素重赋值 retain-then-release ----------

struct ArrPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) ArrPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

#Test
fn test_array_elem_box_reassign() {
  #Mut let p Rc<ArrPair> = ArrPair::make(10i32, 20i32)
  #Mut let q Rc<ArrPair> = ArrPair::make(30i32, 40i32)
  #Mut let arr Array<Rc<ArrPair>> = [p]
  assert_eq(arr[0].a, 10i32)
  arr[0] = q
  assert_eq(arr[0].a, 30i32)
  ; 旧元素仍由 main 的 p 持有
  assert_eq(p.a, 10i32)
  assert_eq(q.b, 40i32)
}

; ---------- 嵌套 Array<Array<T>> 字面量：内层按外层 elemType 走 Array<T> 路径 ----------

#Test
fn test_array_nested_literal_even() {
  #Mut let rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32]]
  assert_eq(rows.len(), 2i64)
  #Mut let r0 Array<i32> = copy_of:<Array<i32>>(rows[0])
  #Mut let r1 Array<i32> = copy_of:<Array<i32>>(rows[1])
  assert_eq(r0.len(), 2i64)
  assert_eq(r1.len(), 2i64)
  assert_eq(r0[0], 1i32)
  assert_eq(r0[1], 2i32)
  assert_eq(r1[0], 3i32)
  assert_eq(r1[1], 4i32)
}

#Test
fn test_array_nested_literal_uneven() {
  #Mut let rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32, 5i32]]
  assert_eq(rows.len(), 2i64)
  #Mut let r0 Array<i32> = copy_of:<Array<i32>>(rows[0])
  #Mut let r1 Array<i32> = copy_of:<Array<i32>>(rows[1])
  assert_eq(r0.len(), 2i64)
  assert_eq(r1.len(), 3i64)
  assert_eq(r1[2], 5i32)
}

; ---------- array_get：T& 引用访问 ----------

#Test
fn test_array_get_tref_bind() {
  #Mut let a Array<i32> = [100, 200]
  ; get 返回 T&，可绑定到 T& 局部
  let r i32& = a.get(0i64)
  assert_eq(r, 100)
}

#Test
fn test_array_get_copy_of() {
  #Mut let a Array<i32> = [10, 20, 30]
  ; get 返回 T&，通过 copy_of 显式转换为 T 值
  let v i32 = copy_of:<i32>(a.get(0i64))
  assert_eq(v, 10i32)
  assert_eq(copy_of:<i32>(a.get(2i64)), 30i32)
}

#Test
fn test_array_get_write_through() {
  #Mut let a Array<i32> = [5, 10, 15]
  ; 通过 T& 写穿元素
  #Mut let w i32& = a.get(1i64)
  w = 42
  ; 验证原数组元素被修改
  assert_eq(a[1], 42)
  assert_eq(a[1], 42)
}

; ---------- v0.16 [] → T& 新增用例 ----------

; D.1: T& 绑定 + 读 + 写穿（let r T& = arr[i]）
#Test
fn test_array_index_ref_bind() {
  #Mut let arr Array<i32> = [100, 200, 300]
  ; 绑定到 T& 局部
  let r i32& = arr[0]
  assert_eq(r, 100)
  ; 写穿：通过 T& 修改引用
  #Mut let w i32& = arr[1]
  w = 42
  assert_eq(arr[1], 42)
  assert_eq(w, 42)
}

; D.2: 操作符自动解包（arr[i] + arr[j] / arr[i] == arr[j]）
#Test
fn test_array_index_ref_ops() {
  let arr Array<i32> = [10, 20, 30]
  ; 加法：两边 T& 自动剥 & + Load
  assert_eq(arr[0] + arr[1], 30i32)
  ; 乘法
  assert_eq(arr[1] * arr[2], 600i32)
  ; 比较：T& == T&
  assert_true(arr[0] == arr[0])
  assert_false(arr[0] == arr[1])
  ; 比较：T& == 字面量
  assert_eq(arr[0], 10i32)
  assert_true(arr[1] > arr[0])
  assert_true(arr[0] < arr[2])
}

; D.3: copy_of 取值（copy_of:<i32>(arr[i])）
#Test
fn test_array_index_copy_of() {
  #Mut let arr Array<i32> = [5, 10, 15]
  ; copy_of 从 T& 取出 T 值
  let x i32 = copy_of:<i32>(arr[0])
  assert_eq(x, 5i32)
  ; copy_of 的值与原数组独立（值语义）
  let y i32 = copy_of:<i32>(arr[1])
  arr[1] = 99
  assert_eq(y, 10i32)
  assert_eq(arr[1], 99)
  ; copy_of 的值可赋给不同类型宽度的变量
  let z i64 = copy_of:<i32>(arr[2]).to_i64()
  assert_eq(z, 15i64)
}

; D.1b: [T * N] 固定数组 T& 绑定 + 读 + 写穿
#Test
fn test_fixed_array_index_ref_bind() {
  #Mut let buf [i32 * 3] = [1i32, 2i32, 3i32]
  let r i32& = buf[0]
  assert_eq(r, 1i32)
  #Mut let w i32& = buf[2]
  w = 99
  assert_eq(buf[2], 99i32)
}

; D.2b: [T * N] 操作符自动解包
#Test
fn test_fixed_array_index_ref_ops() {
  let buf [i32 * 3] = [5i32, 10i32, 15i32]
  assert_eq(buf[0] + buf[1], 15i32)
  assert_eq(buf[2] - buf[1], 5i32)
  assert_true(buf[0] < buf[2])
}

; D.3b: [T * N] 用 copy_of 取值
#Test
fn test_fixed_array_index_copy_of() {
  let buf [i32 * 3] = [7i32, 14i32, 21i32]
  let x i32 = copy_of:<i32>(buf[0])
  assert_eq(x, 7i32)
  let y i64 = copy_of:<i32>(buf[2]).to_i64()
  assert_eq(y, 21i64)
}
