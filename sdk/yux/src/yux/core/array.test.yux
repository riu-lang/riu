; Array<T> 行为用例（迁自 tests/cases/array_*）
; 覆盖：基础下标读写、定长数组初始化（fill/列表）、按值传参共享语义、
;       函数返回 move、Array<Rc<T>> 元素重赋值的 retain/release。

; ---------- array_access：下标读写 ----------

#Test
fn test_array_access_read_write() {
  var arr Array<i32> = [10i32, 20i32, 30i32]
  assert_eq(arr[0], 10i32)
  arr[1] = 25i32
  assert_eq(arr[1], 25i32)
  arr[2] = arr[0] + arr[1]
  assert_eq(arr[2], 35i32)
}

; ---------- array_fill：定长数组 fill 与混合初始化 ----------

#Test
fn test_array_fill_u8_zero() {
  var buf [u8 * 5] = [0u8 ...]
  assert_eq(buf[0], 0u8)
  assert_eq(buf[4], 0u8)
}

#Test
fn test_array_fill_i32_zero_with_type() {
  var arr [i32 * 3] = [0 ... i32]
  assert_eq(arr[0], 0i32)
  assert_eq(arr[2], 0i32)
}

#Test
fn test_array_fixed_bool_listed() {
  var flags [bool * 3] = [true, true, true]
  assert_true(flags[0])
  assert_true(flags[2])
}

; ---------- array_types：定长数组列表初始化 + 各元素类型 ----------

#Test
fn test_array_fixed_i32_list() {
  val arr [i32 * 5] = [1i32, 2i32, 3i32, 4i32, 5i32]
  assert_eq(arr[0], 1i32)
  assert_eq(arr[4], 5i32)
}

#Test
fn test_array_fixed_u8_list() {
  val bytes [u8 * 4] = [97u8, 98u8, 99u8, 100u8]
  assert_eq(bytes[0], 97u8)
  assert_eq(bytes[3], 100u8)
}

#Test
fn test_array_fixed_bool_list_mixed() {
  val bools [bool * 3] = [true, false, true]
  assert_true(bools[0])
  assert_false(bools[1])
}

; ---------- array_return：函数返回 Array<T> 走 move-return ----------

fn make_array_i32() Array<i32> {
  var a Array<i32> = [10i32, 20i32, 30i32]
  ret a
}

#Test
fn test_array_return_move() {
  var arr Array<i32> = make_array_i32()
  assert_eq(arr.len(), 3i64)
  assert_eq(arr[0], 10i32)
  assert_eq(arr[1], 20i32)
  assert_eq(arr[2], 30i32)
}

; ---------- array_passing_share：传参为句柄共享，callee 修改对 caller 可见 ----------

fn modify_share(a Array<i32>) {
  a[0] = 99i32
  a.push(42i32)
}

#Test
fn test_array_passing_share() {
  var arr Array<i32> = [1i32, 2i32, 3i32]
  modify_share(arr)
  assert_eq(arr.len(), 4i64)
  assert_eq(arr[0], 99i32)
  assert_eq(arr[1], 2i32)
  assert_eq(arr[2], 3i32)
  assert_eq(arr[3], 42i32)
}

; ---------- array_elem_rc_assign：Array<Rc<T>> 元素重赋值 retain-then-release ----------

struct ArrPair {
  a i32
  b i32
}

ArrPair {
  fn ArrPair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

#Test
fn test_array_elem_box_reassign() {
  var p Rc<ArrPair> = ArrPair(10i32, 20i32)
  var q Rc<ArrPair> = ArrPair(30i32, 40i32)
  var arr Array<Rc<ArrPair>> = [p]
  assert_eq(arr[0].a, 10i32)
  arr[0] = q
  assert_eq(arr[0].a, 30i32)
  ; 旧元素仍由 main 的 p 持有
  assert_eq(p.a, 10i32)
  assert_eq(q.b, 40i32)
}

; ---------- 嵌套 Array<Array<T>> 字面量：内层按外层 elemType 走 Array<T> 路径 ----------

#Test
fn test_array_nested_literal_even() {
  var rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32]]
  assert_eq(rows.len(), 2i64)
  var r0 Array<i32> = rows[0]
  var r1 Array<i32> = rows[1]
  assert_eq(r0.len(), 2i64)
  assert_eq(r1.len(), 2i64)
  assert_eq(r0[0], 1i32)
  assert_eq(r0[1], 2i32)
  assert_eq(r1[0], 3i32)
  assert_eq(r1[1], 4i32)
}

#Test
fn test_array_nested_literal_uneven() {
  var rows Array<Array<i32>> = [[1i32, 2i32], [3i32, 4i32, 5i32]]
  assert_eq(rows.len(), 2i64)
  var r0 Array<i32> = rows[0]
  var r1 Array<i32> = rows[1]
  assert_eq(r0.len(), 2i64)
  assert_eq(r1.len(), 3i64)
  assert_eq(r1[2], 5i32)
}
