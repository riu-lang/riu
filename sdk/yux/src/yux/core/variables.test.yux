; 变量声明与赋值行为测试
;
; 覆盖：
;   - #Mut let：可变变量声明 + 重赋值（i32）
;   - let（val）：不可变变量声明（i64）
;   - 类型推断：整数（默认 i32）、浮点（默认 f64）、bool
;
; 已知缺口：String / Array / Rc 等句柄类型变量声明未在本文件覆盖（见各专项文件）；
; 声明不初始化见 declare_no_init.test.yux。

#Test
fn test_var_reassign() {
  #Mut let a i32 = 10
  assert_eq(a, 10)
  a = 20
  assert_eq(a, 20)
}

#Test
fn test_val_i64() {
  let b i64 = 100
  assert_eq(b, 100)
}

#Test
fn test_val_inferred_int() {
  let c = 123
  assert_eq(c, 123)
}

#Test
fn test_val_inferred_f64() {
  let d = 3.14
  assert_eq(d, 3.14)
}

#Test
fn test_val_inferred_bool() {
  let e = true
  assert_true(e)
}
