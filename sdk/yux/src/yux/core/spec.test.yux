; spec 测试套件
; 迁自 tests/cases/spec_*.yux
; 覆盖: spec 默认方法体 fall-through、disambig @、抽象+默认体共存、静态字段段 parse

; ==================== 测试用类型定义 ====================

; --- 基础 Ord spec (带默认体) ---

#Spec
struct Ord {
  fn cmp(other Self&) i32
  fn lt(other Self&) bool = $.cmp(&other) < 0
  fn le(other Self&) bool = $.cmp(&other) <= 0
  fn gt(other Self&) bool = $.cmp(&other) > 0
  fn ge(other Self&) bool = $.cmp(&other) >= 0
}

; --- 带默认体的简单 spec ---

#Spec
struct A {
  fn m() i32 = 1
}

#Spec
struct B {
  fn m() i32 = 2
}

; --- spec_default_fallthrough_basic 用 ---

#Spec
struct OrdLt {
  fn cmp(other Self&) i32
  fn lt(other Self&) bool = $.cmp(&other) < 0
}

#Impl(OrdLt)
struct N {
  v i32

  #Static
  fn make(v i32) N {
    ret Self {
      .v = v
    }
  }

  fn cmp(other N&) i32 {
    $.v - other.v
  }
}

; --- spec_default_fallthrough_block 用 ---

#Spec
struct CmpGe {
  fn cmp(other Self&) i32
  fn ge(other Self&) bool {
    $.cmp(&other) >= 0
  }
}

#Impl(CmpGe)
struct K {
  v i32

  #Static
  fn make(v i32) K {
    ret Self {
      .v = v
    }
  }

  fn cmp(other K&) i32 {
    $.v - other.v
  }
}

; --- spec_combine_default_plus_abstract 用 ---

#Spec
struct SpecA {
  fn act() i32
  fn run() i32 = 42
}

#Spec
struct SpecB {
  fn other() i32
  fn run() i32
}

#Impl(SpecA)
#Impl(SpecB)
struct K2 {
  v i32

  #Static
  fn make(v i32) K2 {
    ret Self {
      .v = v
    }
  }

  fn act() i32 {
    $.v
  }

  fn other() i32 {
    $.v + 1
  }
}

; --- spec_default_fallthrough_eq_sdk 用 ---

#Impl(Eq)
struct NEq {
  v i32

  #Static
  fn make(v i32) NEq {
    ret Self {
      .v = v
    }
  }

  fn eq(other NEq&) bool {
    $.v == other.v
  }
}

; --- spec_default_fallthrough_ord_sdk 用 ---

#Impl(Ord)
struct NOrd {
  v i32

  #Static
  fn make(v i32) NOrd {
    ret Self {
      .v = v
    }
  }

  fn cmp(other NOrd&) i32 {
    $.v - other.v
  }
}

; --- spec_disambig_at_override_delegate 用（A 默认体 = 10）---

#Spec
struct A10 {
  fn m() i32 = 10
}

#Impl(A10)
struct S10 {
  v i32

  #Static
  fn make() S10 {
    ret Self {
      .v = 0
    }
  }

  fn m() i32 = 99

  fn override_call() i32 {
    $.m()
  }

  fn delegate_call() i32 {
    $.m@A10()
  }
}

; --- spec_disambig_at_e3132_delegate 用 ---

#Impl(A)
#Impl(B)
struct S {
  v i32

  #Static
  fn make() S {
    ret Self {
      .v = 0
    }
  }

  fn m() i32 = 99

  fn pick_a() i32 {
    $.m@A()
  }

  fn pick_b() i32 {
    $.m@B()
  }
}

; --- spec_disambig_at_basic 用（S 未覆盖 m）---

#Impl(A)
struct S2 {
  v i32

  #Static
  fn make() S2 {
    ret Self {
      .v = 0
    }
  }

  fn call_default() i32 {
    $.m()
  }

  fn call_at() i32 {
    $.m@A()
  }
}

; ==================== Phase 1: Parse + AST 接受 ====================

#Test
fn test_spec_default_body_parse() {
  ; spec body 内方法可携带默认体（块形 / 单表达式形）
  ; 本测试仅验编译通过（类型定义已在文件顶层完成）
  assert_true(true)
}

; 验证：spec body 内允许定义静态字段
#Test
fn test_spec_static_field_parse() {
  ; spec body 内允许 #Static 字段段
  assert_true(true)
}

; ==================== Phase 3: 默认体 fall-through ====================

; 验证：基本的默认体 fall-through 行为
#Test
fn test_spec_default_fallthrough_basic() {
  let a N = N::make(3)
  let b N = N::make(7)
  assert_true(a.lt(&b))
}

; 验证：K 类型的 ge 方法默认行为是 fallthrough
#Test
fn test_spec_default_fallthrough_block() {
  let a K = K::make(5)
  let b K = K::make(5)
  assert_true(a.ge(&b))
}

; 验证：K2 结构体的默认值与抽象方法组合行为
#Test
fn test_spec_combine_default_plus_abstract() {
  let k K2 = K2::make(7)
  assert_eq(k.run(), 42)
}

; ==================== Phase 5: SDK 内置 Eq/Ord 默认体 ====================

; 验证：SDK 内置 Eq 默认体的 eq 和 ne 方法行为
#Test
fn test_spec_default_fallthrough_eq_sdk() {
  let a NEq = NEq::make(3)
  let b NEq = NEq::make(3)
  let c NEq = NEq::make(7)
  assert_true(a.eq(&b))
  assert_true(a.ne(&c))
}

; 验证：NOrd 类型的比较行为，包括 lt、le、gt 和 ge 方法
#Test
fn test_spec_default_fallthrough_ord_sdk() {
  let a NOrd = NOrd::make(3)
  let b NOrd = NOrd::make(7)
  let c NOrd = NOrd::make(3)
  assert_true(a.lt(&b))
  assert_true(a.le(&c))
  assert_true(b.gt(&a))
  assert_true(c.ge(&a))
}

; ==================== Disambig @ 测试 ====================

; 验证：基本的 disambig @ 行为
#Test
fn test_spec_disambig_at_basic() {
  let s S2 = S2::make()
  assert_eq(s.call_default(), 1)
  assert_eq(s.call_at(), 1)
}

; 验证：Spec disambiguation at e3132 with delegate method
#Test
fn test_spec_disambig_at_e3132_delegate() {
  let s S = S::make()
  assert_eq(s.m(), 99)
  assert_eq(s.pick_a(), 1)
  assert_eq(s.pick_b(), 2)
}

; 验证：Override 和 Delegate 方法调用的歧义解析
#Test
fn test_spec_disambig_at_override_delegate() {
  let s S10 = S10::make()
  assert_eq(s.override_call(), 99)
  assert_eq(s.delegate_call(), 10)
}
