i64 : ToString {
  fn to_string() String {
    var out Array<u32> = []
    var buf [u8 * 21] = [0u8 ...]
    var is_neg = $ < 0i64
    var v i64 = $
    if is_neg {
      v = -$
    }
    var i i64 = 0
    loop {
      if v == 0 {
        break;
      }
      var digit i64 = v % 10
      buf[20i64 - i] = 48u8 + digit.to_u8()
      v /= 10
      i += 1
    }
    if i == 0 {
      buf[20i64] = 48u8
      i = 1
    }
    if is_neg {
      out.push(c'-')
    }
    var start i64 = 21i64 - i
    var k i64 = 0
    loop {
      if k >= i {
        break;
      }
      out.push(buf[start + k].to_u32())
      k += 1
    }
    String(out)
  }
}

