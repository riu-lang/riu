; yux SDK - 自举运行时
; 使用 Windows API 进行 I/O

; 外部 Windows 函数声明
extern {
  fn GetStdHandle(nStdHandle i32) Ptr
  fn WriteFile(hFile Ptr, lpBuffer Ptr, nNumberOfBytesToWrite u32, lpNumberOfBytesWritten Ptr, lpOverlapped Ptr) i32
  #NoReturn
  fn ExitProcess(uExitCode u32)
}

; 全局常量
cval _STD_OUTPUT_HANDLE i32 = -11
cval _STD_ERROR_HANDLE i32 = -12

; 内部：向 stdout 写入
fn _stdout_write(buf Ptr, off i64, len i64) {
  var hStdout Ptr = GetStdHandle(_STD_OUTPUT_HANDLE)
  var bufWithOff Ptr = _ptr_offset(buf, off)
  var written u32 = 0u32
  WriteFile(hStdout, bufWithOff, len.to_u32(), &written, null);
}

; 内部：向 stderr 写入（panic / eprint* 模板用，DRAFT-错误.md §8.6）
fn _stderr_write(buf Ptr, off i64, len i64) {
  var hStderr Ptr = GetStdHandle(_STD_ERROR_HANDLE)
  var bufWithOff Ptr = _ptr_offset(buf, off)
  var written u32 = 0u32
  WriteFile(hStderr, bufWithOff, len.to_u32(), &written, null);
}

#CompilerInner
fn size_of<T>() u64

; ==================== 内置 draft（spec §12.7） ====================

; ToString：v0.5 引入；不标 #DraftLike，强契约（用户类型必须显式 Type : ToString { ... }）
draft ToString {
  fn to_string() String
}

; Any：空签名集；标 #DraftLike，所有 owned 类型自动满足
#DraftLike
draft Any {
}

