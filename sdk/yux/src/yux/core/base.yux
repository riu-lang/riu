f64 : ToString {
  fn to_string() String {
    var out Array<u32> = []
    var is_neg = $ < 0.0f64
    var v f64 = $
    if is_neg {
      v = 0.0f64 - $
    }
    if is_neg {
      out.push(c'-')
    }
    ; 整数部分：复用 i64.to_string 后逐码点 push
    val int_part String = v.to_i64().to_string()
    var ii i64 = 0
    loop {
      if ii >= int_part.len() {
        break;
      }
      out.push(int_part.at(ii))
      ii += 1
    }
    out.push(c'.')
    var frac f64 = v - v.to_i64().to_f64()
    var i i64 = 0
    loop {
      if i == 6 {
        break;
      }
      frac *= 10.0f64
      var digit i64 = frac.to_i64()
      out.push((48u8 + digit.to_u8()).to_u32())
      frac -= digit.to_f64()
      i += 1
    }
    String(out)
  }
}

