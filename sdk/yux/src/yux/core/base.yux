}

; Nullable<T> - 可空包装类型
; T? 是 Nullable<T> 的语法糖（编译器解糖）
; 当前实现为简单包装；性能优化（指针类退化、sentinel 等）后置
struct Nullable<T> {
  _has bool
  _value T
}

Nullable<T> {
  ; 空构造：未持值
  fn Nullable() {
    $._has = false
  }

  ; 包一个值
  fn Nullable(v T) {
    $._has = true
    $._value = v
  }

  ; 是否持有值
  fn has() bool = $._has

  ; 取值。空时调用 _exit(1) 终止进程（语言尚无 panic 设施）
  fn get() T {
    if !$._has {
      _exit(1i32);
    }
    $._value
  }
}

; String 类型 - 不可变；内部使用 Array<u32> 存储 Unicode code points
; v1 mutable 用例走 Array<u32> 缓冲 + String(buf) 构造
struct String {
  data Array<u32>
}

String {
  fn ~() {
    ; Array<u32> 会自动释放
  }

  ; 空字符串构造
  fn String() {
    $.data = []
  }

  ; 拷贝构造（句柄共享）
  fn String(s String) {
    $.data = s.data
  }

  ; 接管 Array<u32> 缓冲构造
  ; 共享 buf 的 Block；调用方仍持原句柄，作用域结束自动 release
  fn String(buf Array<u32>) {
    $.data = buf
  }

  fn len() i64 {
    $.data.len()
  }

  ; 取码点
  fn at(i i64) u32 {
    $.data[i]
  }

  ; 转为 UTF-8 字节数组
  fn to_bytes() Array<u8> {
    var r Array<u8> = []
    var i i64 = 0
    loop {
      if i >= $.data.len() {
        break;
      }
      val cp u32 = $.data[i]
      if cp < 128u32 {
        r.push(cp.to_u8());
      } elif cp < 2048u32 {
        r.push(192u8 + ((cp >> 6u32) & 31u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } elif cp < 65536u32 {
        r.push(224u8 + ((cp >> 12u32) & 15u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } else {
        r.push(240u8 + ((cp >> 18u32) & 7u32).to_u8())
        r.push(128u8 + ((cp >> 12u32) & 63u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      }
      i += 1
    }
    r
  }
}

; StringBuilder - 可变字符串缓冲
; 内部持有 Array<u32> 码点缓冲；支持追加；build() 终态产出不可变 String 并重置自身
; 推荐用法：本地短生命周期累积 → build() 一次产出 String；不要在 build() 之后继续写入并对外暴露同一 String
struct StringBuilder {
  data Array<u32>
}

StringBuilder {
  fn StringBuilder() {
    $.data = []
  }

  fn len() i64 {
    $.data.len()
  }

  ; 追加一个 Unicode 码点
  fn append(cp u32) {
    $.data.push(cp)
  }

  ; 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    $.data.push(b.to_u32())
  }

  ; 追加另一个字符串的全部码点
  fn append(s String) {
    var i i64 = 0
    loop {
      if i >= s.len() {
        break;
      }
      $.data.push(s.at(i))
      i += 1
    }
  }

  ; 清空缓冲
  fn clear() {
    $.data = []
  }

  ; 取出缓冲、构造不可变 String、自身重置为空
  ; 取出后再 append/clear 不会影响已返回的 String（不同 Array<u32> Block）
  fn build() String {
    val s String = String($.data)
    $.data = []
    s
  }
}

#CompilerInner
struct bool {
  ; 内部处理
}

bool {
  ; 一元运算符
  #CompilerInner
  fn not() bool

  fn to_string() String {
    if $ { "true" } else { "false" }
  }
}

fn print(s String) {
  val bytes Array<u8> = s.to_bytes()
  var i i64 = 0
  loop {
    if i >= bytes.len() {
      break;
    }
    val b [u8 * 1] = [bytes[i]]
    _stdout_write(&b, 0i64, 1i64)
    i += 1
  }
}

fn println(s String) {
  print(s)
  val nl [u8 * 1] = [10u8]
  _stdout_write(&nl, 0i64, 1i64)
}
