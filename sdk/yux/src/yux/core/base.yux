  ; 编译为 C void*
}

Ptr {
  #CompilerInner
  fn to_int() u64
}

#CompilerInner
fn ptr_from_addr(addr u64) Ptr

; 私有（`_` 前缀约定）：Ptr + i64 字节偏移；编译器 GEP i8，不暴露给用户
; 取代 ptr_from_addr(p.to_int() + off.to_u64()) 的冗长写法（DRAFT §9.1：Ptr 算术不开放给用户）
#CompilerInner
fn _ptr_offset(p Ptr, off i64) Ptr

#CompilerInner
struct Box<T> {
  ; 内部处理
}

; Weak<T> 实例 layout = { ptr handle }，与 Box<T> 同形
; handle 指向同一 Block；weak 计数维护 block 存活；不维护 payload 存活
#CompilerInner
struct Weak<T> {
}

; upgrade(w) Box<T>?：尝试从 Weak 升级到 Box；strong==0 → null；存活 → strong++ 返回 Some(Box{handle})
#CompilerInner
fn upgrade<T>(w Weak<T>) Box<T>?

; same_ref:<T>(a, b) bool：地址相等比较（DRAFT §10）
; T 必须是 Box<U> / Weak<U> / Array<U> / String / U&；标量禁
; 比对底层 handle 指针；空 Weak 与任何活句柄不等
#CompilerInner
fn same_ref<T>(a T, b T) bool

; rc_leak_count() i64：返回当前未释放的 RC Block 数（Box / Array / String / Weak 共用计数）
; 仅供测试 / 自检使用；正常程序不应依赖
#CompilerInner
fn rc_leak_count() i64

; ptr_of:<T>(obj) Ptr：显式取裸指针（DRAFT §9.4）
; T = U&         → 指向 U 的 Ptr（短生命周期，C 端不可保存超出本次调用）
; T = Box<U>    → 指向 U payload（跳过 RC 头；C 端只能读写 payload，不能 free）
; T = Array<U>  → 指向元素首地址（同上）
; T = String     → 指向 UTF-32 码点首地址（不带 NUL 终止）
; T = 标量       → 报错
#CompilerInner
fn ptr_of<T>(obj T) Ptr

; as_ref:<T>(box) T&：显式获取 Box payload 的借用（spec §8.3.5.5）
; v1 唯一允许"以 T& 形态借用 Box payload 整体"的途径；返回的 T& 根对象
; 视为传入的 box 句柄本身，受 §8.6.5 一切寿命规则约束
; T 由实参推断；不接受 Box<T>?
#CompilerInner
fn as_ref<T>(box Box<T>) T&

; Array<T> 实例 layout 由编译器内部管理：{ ptr handle }，handle 指向 Block
; （Phase 1b：所有方法编译器特例化，主体不再读 yux 端字段）
#CompilerInner
struct Array<T> {
}

Array<T> {
  #CompilerInner
  fn len() i64

  #CompilerInner
  fn cap() i64

  #CompilerInner
  fn is_empty() bool

  #CompilerInner
  fn clear()

  #CompilerInner
  fn set_len(new_len i64)

  #CompilerInner
  fn push(value T)

  #CompilerInner
  fn at(i i64) T

  #CompilerInner
  fn first() T

  #CompilerInner
  fn last() T

  #CompilerInner
  fn pop() T
}

; Nullable<T> - 可空包装类型
; T? 是 Nullable<T> 的语法糖（编译器解糖）
; 当前实现为简单包装；性能优化（指针类退化、sentinel 等）后置
struct Nullable<T> {
  _has bool
  _value T
}

Nullable<T> {
  ; 空构造：未持值
  fn Nullable() {
    $._has = false
  }

  ; 包一个值
  fn Nullable(v T) {
    $._has = true
    $._value = v
  }

  ; 是否持有值
  fn has() bool = $._has

  ; 取值。空时调用 exit(1) 终止进程（语言尚无 panic 设施）
  fn get() T {
    if !$._has {
      exit(1);
    }
    $._value
  }
}

; String 类型 - 不可变；内部使用 Array<u32> 存储 Unicode code points
; v1 mutable 用例走 Array<u32> 缓冲 + String(buf) 构造
struct String {
  data Array<u32>
}

String {
  fn ~() {
    ; Array<u32> 会自动释放
  }

  ; 空字符串构造
  fn String() {
    $.data = []
  }

  ; 拷贝构造（句柄共享）
  fn String(s String) {
    $.data = s.data
  }

  ; 接管 Array<u32> 缓冲构造
  ; 共享 buf 的 Block；调用方仍持原句柄，作用域结束自动 release
  fn String(buf Array<u32>) {
    $.data = buf
  }

  fn len() i64 {
    $.data.len()
  }

  ; 取码点
  fn at(i i64) u32 {
    $.data[i]
  }

  ; 等值比较：长度相同且每个码点相同
  ; 形参为 String&（spec §7.2.3.3），运算符位置自动取址
  fn eq(other String&) bool {
    if $.data.len() != other.data.len() {
      ret false
    }
    var i i64 = 0
    loop {
      if i >= $.data.len() {
        break;
      }
      if $.data[i] != other.data[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other String&) bool {
    !$.eq(&other)
  }

  ; 是否以 prefix 开头：长度足够且前 plen 个码点逐位相等
  fn starts_with(prefix String&) bool {
    val plen i64 = prefix.data.len()
    if plen > $.data.len() {
      ret false
    }
    var i i64 = 0
    loop {
      if i >= plen {
        break;
      }
      if $.data[i] != prefix.data[i] {
        ret false
      }
      i += 1
    }
    true
  }

  ; 是否包含 needle 子串：朴素 O(n*m) 滑窗匹配
  ; 空 needle 视为匹配任何字符串（与 starts_with("") 一致）
  fn contains(needle String&) bool {
    val nlen i64 = needle.data.len()
    if nlen == 0 {
      ret true
    }
    val hlen i64 = $.data.len()
    if nlen > hlen {
      ret false
    }
    var i i64 = 0
    loop {
      if i + nlen > hlen {
        break;
      }
      var j i64 = 0
      var hit bool = true
      loop {
        if j >= nlen {
          break;
        }
        if $.data[i + j] != needle.data[j] {
          hit = false
          break;
        }
        j += 1
      }
      if hit {
        ret true
      }
      i += 1
    }
    false
  }

  ; 转为 UTF-8 字节数组
  fn to_bytes() Array<u8> {
    var r Array<u8> = []
    var i i64 = 0
    loop {
      if i >= $.data.len() {
        break;
      }
      val cp u32 = $.data[i]
      if cp < 128u32 {
        r.push(cp.to_u8());
      } elif cp < 2048u32 {
        r.push(192u8 + ((cp >> 6u32) & 31u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } elif cp < 65536u32 {
        r.push(224u8 + ((cp >> 12u32) & 15u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } else {
        r.push(240u8 + ((cp >> 18u32) & 7u32).to_u8())
        r.push(128u8 + ((cp >> 12u32) & 63u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      }
      i += 1
    }
    r
  }
}

String : ToString {
  ; String 自身实现 ToString：复用底层 Array<u32> Block，句柄共享
  fn to_string() String {
    String($.data)
  }
}

; StringBuilder - 可变字符串缓冲
; 内部持有 Array<u32> 码点缓冲；支持追加；build() 终态产出不可变 String 并重置自身
; 推荐用法：本地短生命周期累积 → build() 一次产出 String；不要在 build() 之后继续写入并对外暴露同一 String
struct StringBuilder {
  data Array<u32>
}

StringBuilder {
  fn StringBuilder() {
    $.data = []
  }

  fn len() i64 {
    $.data.len()
  }

  ; 追加一个 Unicode 码点
  fn append(cp u32) {
    $.data.push(cp)
  }

  ; 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    $.data.push(b.to_u32())
  }

  ; 追加另一个字符串的全部码点
  fn append(s String) {
    var i i64 = 0
    loop {
      if i >= s.len() {
        break;
      }
      $.data.push(s.at(i))
      i += 1
    }
  }

  ; 清空缓冲
  fn clear() {
    $.data = []
  }

  ; 等值比较：长度相同且每个码点相同
  fn eq(other StringBuilder&) bool {
    if $.data.len() != other.data.len() {
      ret false
    }
    var i i64 = 0
    loop {
      if i >= $.data.len() {
        break;
      }
      if $.data[i] != other.data[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other StringBuilder&) bool {
    !$.eq(&other)
  }

  ; 取出缓冲、构造不可变 String、自身重置为空
  ; 取出后再 append/clear 不会影响已返回的 String（不同 Array<u32> Block）
  fn build() String {
    val s String = String($.data)
    $.data = []
    s
  }
}

#CompilerInner
struct bool {
  ; 内部处理
}

bool {
  ; 一元运算符
  #CompilerInner
  fn not() bool
}

bool : ToString {
  fn to_string() String {
    if $ { "true" } else { "false" }
  }
}

; ==================== stdlib I/O ====================
; v0.6 起 print* / eprint* 三态：
;   - 非泛型借用 `(s String&)` —— String 实参与字面量走的快路径（owned 实参由 §7.2.3.3 自动取址匹配）
;   - 泛型 owned `<T : ToString>(x T)` —— 其他实现 ToString 的类型通过单态化分发
; 选择 String& 而非 String 非泛型形态的原因：避免 owned/borrow 双非泛型时 dispatcher 无法在 String 值参上消歧（[E6014]）；
; 同时与既有 SDK 约定（assert_eq / starts_with / contains 形参均 String&）一致。
; 通道：print / println → stdout；eprint / eprintln → stderr（DRAFT-错误.md §8.6 panic 模板沿用此通道）。

fn print(s String&) {
  val bytes Array<u8> = s.to_bytes()
  var i i64 = 0
  loop {
    if i >= bytes.len() {
      break;
    }
    val b [u8 * 1] = [bytes[i]]
    _stdout_write(&b, 0i64, 1i64)
    i += 1
  }
}

fn print<T : ToString>(x T) {
  val s String = x.to_string()
  print(&s)
}

fn println(s String&) {
  print(&s)
  val nl [u8 * 1] = [10u8]
  _stdout_write(&nl, 0i64, 1i64)
}

fn println<T : ToString>(x T) {
  val s String = x.to_string()
  println(&s)
}

fn eprint(s String&) {
  val bytes Array<u8> = s.to_bytes()
  var i i64 = 0
  loop {
    if i >= bytes.len() {
      break;
    }
    val b [u8 * 1] = [bytes[i]]
    _stderr_write(&b, 0i64, 1i64)
    i += 1
  }
}

fn eprint<T : ToString>(x T) {
  val s String = x.to_string()
  eprint(&s)
}

fn eprintln(s String&) {
  eprint(&s)
  val nl [u8 * 1] = [10u8]
  _stderr_write(&nl, 0i64, 1i64)
}

fn eprintln<T : ToString>(x T) {
  val s String = x.to_string()
  eprintln(&s)
}

; ==================== Phase 4b：String 断言（纯 yux）====================
; 与 assert.yux 中的 #CompilerInner 同名/同失败语义，但走 yux 实现路径。
; dispatcher（compiler_call.cpp）在参数严格匹配的非泛型重载存在时优先选这里，
; 绕开 compileTestAssertEq —— 后者仅处理 i8..u64 / f32 / f64 / bool。
;
; 形参均为 String&（spec §7.2.3.3）。调用方传 String 由「运算符位置自动取址」
; （§7.2.3.6）和按 String& 形参的自动转换处理。
;
; 放在 base.yux 末尾而不是单独文件：避免 SDK 多文件分开编译时各 Compiler 实例
; 创建独立 StructType 与已发射的模块声明类型冲突（详见 docs/dev 注释）。

fn assert_eq(actual String&, expected String&) {
  if actual != expected {
    _yux_test_assert_failed();
  }
}

fn assert_contains(haystack String&, needle String&) {
  if !haystack.contains(&needle) {
    _yux_test_assert_failed();
  }
}

fn assert_starts_with(s String&, prefix String&) {
  if !s.starts_with(&prefix) {
    _yux_test_assert_failed();
  }
}
