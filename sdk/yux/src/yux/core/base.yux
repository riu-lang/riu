; yux SDK - 自举运行时
; 使用 Windows API 进行 I/O

; 外部 Windows 函数声明
extern {
  fn GetStdHandle(nStdHandle i32) Ptr
  fn WriteFile(hFile Ptr, lpBuffer Ptr, nNumberOfBytesToWrite u32, lpNumberOfBytesWritten Ptr, lpOverlapped Ptr) i32
  #NoReturn
  fn ExitProcess(uExitCode u32)

  ; 堆管理 API（B-3: Array 去 Builtin 后 yux 层直接管理内存）
  fn GetProcessHeap() Ptr
  fn HeapAlloc(hHeap Ptr, dwFlags u32, dwBytes u64) Ptr
  fn HeapReAlloc(hHeap Ptr, dwFlags u32, lpMem Ptr, dwBytes u64) Ptr
  fn HeapFree(hHeap Ptr, dwFlags u32, lpMem Ptr) i32
}

; 全局常量
#Cval
let _STD_OUTPUT_HANDLE i32 = -11
#Cval
let _STD_ERROR_HANDLE i32 = -12

; 内部：向 stdout 写入
fn _stdout_write(buf Ptr, off i64, len i64) {
  #Mut let hStdout Ptr = GetStdHandle(_STD_OUTPUT_HANDLE)
  #Mut let bufWithOff Ptr = _ptr_offset(buf, off)
  #Mut let written u32 = 0u32
  WriteFile(hStdout, bufWithOff, len.to_u32(), &written, null);
}

; 内部：向 stderr 写入（panic / eprint* 模板用，DRAFT-错误.md §8.6）
fn _stderr_write(buf Ptr, off i64, len i64) {
  #Mut let hStderr Ptr = GetStdHandle(_STD_ERROR_HANDLE)
  #Mut let bufWithOff Ptr = _ptr_offset(buf, off)
  #Mut let written u32 = 0u32
  WriteFile(hStderr, bufWithOff, len.to_u32(), &written, null);
}

#Builtin
fn size_of<T>() u64

; DRAFT-spec-reflect Phase 3a (捷径 A): 反射 Type 节点拿取 intrinsic.
; 调用站 `__yux_reflect_type:<Counter>()` 由编译器特例化 lower 到
; `load %Type, ptr __yux_reflect_<mod>_<typename>__type` (linkonce_odr rodata).
; 草案 §2 的 `Counter::type` path 形态留 Phase 4 接入完整 spec 链, 这里走 fn 形态过渡.
#Builtin
fn __yux_reflect_type<T>() Type

; ==================== 内置 spec（spec §12.7） ====================
; spec-unify v1：以 #Spec / #Impl(...) 替代 draft 关键字与 `: Spec` 头部槽
; DRAFT-spec-default-body 落地：spec body 内方法允许带默认体；实现者未覆盖即 fall-through
; #DraftLike 不进 v1；Any 已删（无 #DraftLike 自动派生时无意义）

#Spec
struct ToString {
  fn to_string() String
}

; Eq / Ord：实现者仅写 eq / cmp，剩余比较方法由默认体推导（DRAFT-spec-default-body §5）
#Spec
struct Eq {
  fn eq(other Self&) bool
  fn ne(other Self&) bool = !$.eq(&other)
}

#Spec
struct Ord {
  fn cmp(other Self&) i32
  fn lt(other Self&) bool = $.cmp(&other) < 0
  fn le(other Self&) bool = $.cmp(&other) <= 0
  fn gt(other Self&) bool = $.cmp(&other) > 0
  fn ge(other Self&) bool = $.cmp(&other) >= 0
}

; Clone / ToJson：纯抽象签名；按字段递归 derive 永不引入（DRAFT [#1.AE]）
#Spec
struct Clone {
  fn clone() Self
}

#Spec
struct ToJson {
  fn to_json() String
}

; 内置类型
; 结构体仅占位，实际类型由编译器处理
; to_<数字/bool> 方法由编译器合成，通过 #Builtin 标注

#Impl(ToString)
#Builtin
struct i8 {
  #Builtin
  fn to_i8() i8

  #Builtin
  fn to_u8() u8

  #Builtin
