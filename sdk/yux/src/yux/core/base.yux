#CompilerInner
struct i64 {
  ; 内部处理
}

i64 {
  #CompilerInner
  fn to_i8() i8

  #CompilerInner
  fn to_u8() u8

  #CompilerInner
  fn to_i16() i16

  #CompilerInner
  fn to_u16() u16

  #CompilerInner
  fn to_i32() i32

  #CompilerInner
  fn to_u32() u32

  #CompilerInner
  fn to_u64() u64

  #CompilerInner
  fn to_f64() f64

  #CompilerInner
  fn to_f32() f32

  #CompilerInner
  fn to_bool() bool

  ; 算术运算符
  #CompilerInner
  fn plus(other i64) i64

  #CompilerInner
  fn minus(other i64) i64

  #CompilerInner
  fn mul(other i64) i64

  #CompilerInner
  fn div(other i64) i64

  #CompilerInner
  fn mod(other i64) i64

  ; 比较运算符
  #CompilerInner
  fn eq(other i64) bool

  #CompilerInner
  fn ne(other i64) bool

  #CompilerInner
  fn lt(other i64) bool

  #CompilerInner
  fn le(other i64) bool

  #CompilerInner
  fn gt(other i64) bool

  #CompilerInner
  fn ge(other i64) bool

  ; 位运算符
  #CompilerInner
  fn and(other i64) i64

  #CompilerInner
  fn or(other i64) i64

  #CompilerInner
  fn xor(other i64) i64

  #CompilerInner
  fn shl(other i64) i64

  #CompilerInner
  fn shr(other i64) i64

  ; 一元运算符
  #CompilerInner
  fn neg() i64

  #CompilerInner
  fn inv() i64

  fn to_string() String {
    var out Array<u32> = []
    var buf [u8 * 21] = [0u8 ...]
    var is_neg = $ < 0i64
    var v i64 = $
    if is_neg {
      v = -$
    }
    var i i64 = 0
    loop {
      if v == 0 {
        break;
      }
      var digit i64 = v % 10
      buf[20i64 - i] = 48u8 + digit.to_u8()
      v /= 10
      i += 1
    }
    if i == 0 {
      buf[20i64] = 48u8
      i = 1
    }
    if is_neg {
      out.push(c'-')
    }
    var start i64 = 21i64 - i
    var k i64 = 0
    loop {
      if k >= i {
        break;
      }
      out.push(buf[start + k].to_u32())
      k += 1
    }
    String(out)
  }
}

