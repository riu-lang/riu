  #Builtin
  fn to_u64() u64

  #Builtin
  fn to_f64() f64

  #Builtin
  fn to_f32() f32

  #Builtin
  fn to_bool() bool

  ; 算术运算符
  #Builtin
  fn plus(other i8) i8

  #Builtin
  fn plus(other i8&) i8

  #Builtin
  fn minus(other i8) i8

  #Builtin
  fn minus(other i8&) i8

  #Builtin
  fn mul(other i8) i8

  #Builtin
  fn mul(other i8&) i8

  #Builtin
  fn div(other i8) i8

  #Builtin
  fn div(other i8&) i8

  #Builtin
  fn mod(other i8) i8

  #Builtin
  fn mod(other i8&) i8

  ; 比较运算符
  #Builtin
  fn eq(other i8) bool

  #Builtin
  fn eq(other i8&) bool

  #Builtin
  fn ne(other i8) bool

  #Builtin
  fn ne(other i8&) bool

  #Builtin
  fn lt(other i8) bool

  #Builtin
  fn lt(other i8&) bool

  #Builtin
  fn le(other i8) bool

  #Builtin
  fn le(other i8&) bool

  #Builtin
  fn gt(other i8) bool

  #Builtin
  fn gt(other i8&) bool

  #Builtin
  fn ge(other i8) bool

  #Builtin
  fn ge(other i8&) bool

  ; 位运算符
  #Builtin
  fn and(other i8) i8

  #Builtin
  fn and(other i8&) i8

  #Builtin
  fn or(other i8) i8

  #Builtin
  fn or(other i8&) i8

  #Builtin
  fn xor(other i8) i8

  #Builtin
  fn xor(other i8&) i8

  #Builtin
  fn shl(other i8) i8

  #Builtin
  fn shl(other i8&) i8

  #Builtin
  fn shr(other i8) i8

  #Builtin
  fn shr(other i8&) i8

  ; 一元运算符
  #Builtin
  fn neg() i8

  #Builtin
  fn inv() i8

  fn to_string() String {
    $.to_i64().to_string()
  }
}

