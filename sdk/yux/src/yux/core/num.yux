#Impl(ToString)
#Builtin
struct f64 {
  #Builtin
  fn to_i8() i8

  #Builtin
  fn to_u8() u8

  #Builtin
  fn to_i16() i16

  #Builtin
  fn to_u16() u16

  #Builtin
  fn to_i32() i32

  #Builtin
  fn to_u32() u32

  #Builtin
  fn to_u64() u64

  #Builtin
  fn to_f64() f64

  #Builtin
  fn to_f32() f32

  #Builtin
  fn to_bool() bool

  ; 算术运算符
  #Builtin
  fn plus(other f64) f64

  #Builtin
  fn plus(other f64&) f64

  #Builtin
  fn minus(other f64) f64

  #Builtin
  fn minus(other f64&) f64

  #Builtin
  fn mul(other f64) f64

  #Builtin
  fn mul(other f64&) f64

  #Builtin
  fn div(other f64) f64

  #Builtin
  fn div(other f64&) f64

  #Builtin
  fn mod(other f64) f64

  #Builtin
  fn mod(other f64&) f64

  ; 比较运算符
  #Builtin
  fn eq(other f64) bool

  #Builtin
  fn eq(other f64&) bool

  #Builtin
  fn ne(other f64) bool

  #Builtin
  fn ne(other f64&) bool

  #Builtin
  fn lt(other f64) bool

  #Builtin
  fn lt(other f64&) bool

  #Builtin
  fn le(other f64) bool

  #Builtin
  fn le(other f64&) bool

  #Builtin
  fn gt(other f64) bool

  #Builtin
  fn gt(other f64&) bool

  #Builtin
  fn ge(other f64) bool

  #Builtin
  fn ge(other f64&) bool

  ; 一元运算符
  #Builtin
  fn neg() f64

  fn to_string() String {
    #Mut let out Array<u32> = []
    #Mut let is_neg = $ < 0.0f64
    #Mut let v f64 = $
    if is_neg {
      v = 0.0f64 - $
    }
    if is_neg {
      out.push(c'-')
    }
    ; 整数部分：复用 i64.to_string 后逐码点 push
    let int_part String = v.to_i64().to_string()
    #Mut let ii usize = 0
    loop {
      if ii >= int_part.len() {
        break;
      }
      out.push(int_part.get(ii))
      ii += 1
    }
    out.push(c'.')
    #Mut let frac f64 = v - v.to_i64().to_f64()
    #Mut let i i64 = 0
    loop {
      if i == 6 {
        break;
      }
      frac *= 10.0f64
      #Mut let digit i64 = frac.to_i64()
      out.push((48 + digit.to_u8()).to_u32())
      frac -= digit.to_f64()
      i += 1
    }
    String::_take_buf(move(out))
  }
}

