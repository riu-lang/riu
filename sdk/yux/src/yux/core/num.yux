#Impl(ToString)
#Builtin
struct i64 {
  #Builtin
  fn to_i8() i8

  #Builtin
  fn to_u8() u8

  #Builtin
  fn to_i16() i16

  #Builtin
  fn to_u16() u16

  #Builtin
  fn to_i32() i32

  #Builtin
  fn to_u32() u32

  #Builtin
  fn to_u64() u64

  #Builtin
  fn to_f64() f64

  #Builtin
  fn to_f32() f32

  #Builtin
  fn to_bool() bool

  ; 算术运算符
  #Builtin
  fn plus(other i64) i64

  #Builtin
  fn plus(other i64&) i64

  #Builtin
  fn minus(other i64) i64

  #Builtin
  fn minus(other i64&) i64

  #Builtin
  fn mul(other i64) i64

  #Builtin
  fn mul(other i64&) i64

  #Builtin
  fn div(other i64) i64

  #Builtin
  fn div(other i64&) i64

  #Builtin
  fn mod(other i64) i64

  #Builtin
  fn mod(other i64&) i64

  ; 比较运算符
  #Builtin
  fn eq(other i64) bool

  #Builtin
  fn eq(other i64&) bool

  #Builtin
  fn ne(other i64) bool

  #Builtin
  fn ne(other i64&) bool

  #Builtin
  fn lt(other i64) bool

  #Builtin
  fn lt(other i64&) bool

  #Builtin
  fn le(other i64) bool

  #Builtin
  fn le(other i64&) bool

  #Builtin
  fn gt(other i64) bool

  #Builtin
  fn gt(other i64&) bool

  #Builtin
  fn ge(other i64) bool

  #Builtin
  fn ge(other i64&) bool

  ; 位运算符
  #Builtin
  fn and(other i64) i64

  #Builtin
  fn and(other i64&) i64

  #Builtin
  fn or(other i64) i64

  #Builtin
  fn or(other i64&) i64

  #Builtin
  fn xor(other i64) i64

  #Builtin
  fn xor(other i64&) i64

  #Builtin
  fn shl(other i64) i64

  #Builtin
  fn shl(other i64&) i64

  #Builtin
  fn shr(other i64) i64

  #Builtin
  fn shr(other i64&) i64

  ; 一元运算符
  #Builtin
  fn neg() i64

  #Builtin
  fn inv() i64

  fn to_string() String {
    #Mut let out Array<u32> = []
    #Mut let buf [u8 * 21] = [0u8 ...]
    #Mut let is_neg = $ < 0
    #Mut let v i64 = $
    if is_neg {
      v = -$
    }
    #Mut let i i64 = 0
    loop {
      if v == 0 {
        break;
      }
      #Mut let digit i64 = v % 10
      buf[20 - i] = 48 + digit.to_u8()
      v /= 10
      i += 1
    }
    if i == 0 {
      buf[20] = 48
      i = 1
    }
    if is_neg {
      out.push(c'-')
    }
    #Mut let start i64 = 21 - i
    #Mut let k i64 = 0
    loop {
      if k >= i {
        break;
      }
      out.push(buf[start + k].to_u32())
      k += 1
    }
    String::_take_buf(move(out))
  }
}

