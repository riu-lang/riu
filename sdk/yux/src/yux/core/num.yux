; yux SDK - 内置数字类型（i8/u8/i16/u16/i32/u32/i64/u64/isize/usize/f64/f32）
; 编译器特例化：方法体由 #Builtin 标注，编译器在调用点合成 IR
; to_<类型> 方法、算术/比较/位/一元运算符均为编译器 intrinsic

#Impl(ToString)
#Builtin
struct i8 {
  #Builtin
  fn to_i8() i8

  #Builtin
  fn to_u8() u8

  #Builtin
  fn to_i16() i16

  #Builtin
  fn to_u16() u16

  #Builtin
  fn to_i32() i32

  #Builtin
  fn to_u32() u32

  #Builtin
  fn to_i64() i64

  #Builtin
  fn to_u64() u64

  #Builtin
  fn to_f64() f64

  #Builtin
  fn to_f32() f32

  #Builtin
  fn to_bool() bool

  ; 算术运算符
  #Builtin
  fn plus(other i8) i8

  #Builtin
  fn plus(other i8&) i8

  #Builtin
  fn minus(other i8) i8

  #Builtin
  fn minus(other i8&) i8

  #Builtin
  fn mul(other i8) i8

  #Builtin
  fn mul(other i8&) i8

  #Builtin
  fn div(other i8) i8

  #Builtin
  fn div(other i8&) i8

  #Builtin
  fn mod(other i8) i8

  #Builtin
  fn mod(other i8&) i8

  ; 比较运算符
  #Builtin
  fn eq(other i8) bool

  #Builtin
  fn eq(other i8&) bool

  #Builtin
  fn ne(other i8) bool

  #Builtin
  fn ne(other i8&) bool

  #Builtin
  fn lt(other i8) bool

  #Builtin
  fn lt(other i8&) bool

  #Builtin
  fn le(other i8) bool

  #Builtin
  fn le(other i8&) bool

  #Builtin
  fn gt(other i8) bool

  #Builtin
  fn gt(other i8&) bool

  #Builtin
  fn ge(other i8) bool

  #Builtin
  fn ge(other i8&) bool

  ; 位运算符
  #Builtin
  fn and(other i8) i8

  #Builtin
  fn and(other i8&) i8

  #Builtin
  fn or(other i8) i8

  #Builtin
  fn or(other i8&) i8

  #Builtin
  fn xor(other i8) i8

  #Builtin
  fn xor(other i8&) i8

  #Builtin
  fn shl(other i8) i8

  #Builtin
  fn shl(other i8&) i8

  #Builtin
  fn shr(other i8) i8

  #Builtin
  fn shr(other i8&) i8

  ; 一元运算符
  #Builtin
  fn neg() i8

  #Builtin
  fn inv() i8

  fn to_string() String {
    $.to_i64().to_string()
  }
}

