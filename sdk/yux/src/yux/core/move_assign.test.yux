; 移入赋值 `<-` 行为用例（DRAFT-static-ref / v0.15 Move 语义）
; 覆盖：标量 swap、Rc 句柄交换、字段级移入、表达式值语义、
;       右结合、链式、#Mut let 延后赋值后的 <-、元组成员 <-。

; ==================== 辅助类型 ====================

struct MvPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) MvPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

; ==================== 标量 swap ====================

#Test
fn test_move_assign_scalar_swap() {
  #Mut let a i32 = 10
  #Mut let b i32 = 20
  let old = a <- b
  ; old = 旧值 10, a = 20, b 不变
  assert_eq(old, 10)
  assert_eq(a, 20)
  assert_eq(b, 20)
}

#Test
fn test_move_assign_scalar_self_swap() {
  ; a <- a 自己移入自己：旧值==新值
  #Mut let a i32 = 42
  let old = a <- a
  assert_eq(old, 42)
  assert_eq(a, 42)
}

; ==================== Rc<T> 句柄交换 ====================

#Test
fn test_move_assign_box_swap() {
  #Mut let x Rc<MvPair> = MvPair::make(1, 2)
  #Mut let y Rc<MvPair> = MvPair::make(3, 4)
  let prev Rc<MvPair> = x <- y
  ; prev 持有原 x 的 Rc, x 现在指向 y 的 Rc
  assert_eq(prev.a, 1)
  assert_eq(prev.b, 2)
  assert_eq(x.a, 3)
  assert_eq(x.b, 4)
  assert_eq(y.a, 3)
  assert_eq(y.b, 4)
}

#Test
fn test_move_assign_box_no_double_free() {
  ; 交换后无 double-free，后续分配稳定
  #Mut let a Rc<MvPair> = MvPair::make(10, 20)
  #Mut let b Rc<MvPair> = MvPair::make(30, 40)
  let prev Rc<MvPair> = a <- b
  ; 验证 prev 独立存活
  assert_eq(prev.a, 10)
  assert_eq(a.b, 40)
  ; 再分配新 Rc，不应崩溃
  #Mut let c Rc<MvPair> = MvPair::make(50, 60)
  assert_eq(c.a, 50)
}

; ==================== 字段级移入 ====================

struct MvHolder {
  bx Rc<MvPair>
  tag i32

  #Static
  fn make(bx Rc<MvPair>, tag i32) MvHolder {
    ret Self {
      .bx = bx
      .tag = tag
    }
  }
}

#Test
fn test_move_assign_field_level() {
  #Mut let p1 Rc<MvPair> = MvPair::make(1, 2)
  #Mut let p2 Rc<MvPair> = MvPair::make(3, 4)
  #Mut let h MvHolder = MvHolder::make(p1, 7)
  ; 字段级 <-：取出旧值，写入新值
  let old_field Rc<MvPair> = h.bx <- p2
  assert_eq(old_field.a, 1)
  assert_eq(old_field.b, 2)
  assert_eq(h.bx.a, 3)
  assert_eq(h.bx.b, 4)
  ; p1 仍独立
  assert_eq(p1.a, 1)
}

; ==================== 表达式值语义：<- 返回旧值可直接消费 ====================

#Test
fn test_move_assign_expr_value_used() {
  #Mut let a i32 = 100
  #Mut let b i32 = 200
  ; <- 返回的旧值直接参与运算
  let doubled = (a <- b) * 2
  assert_eq(doubled, 200)
  assert_eq(a, 200)
}

#Test
fn test_move_assign_expr_value_passed_to_fn() {
  #Mut let x i32 = 50
  #Mut let y i32 = 60
  ; <- 返回旧值传给函数
  let sum = (x <- y) + y
  assert_eq(sum, 110)
  assert_eq(x, 60)
}

; ==================== 右结合：a <- b <- c = a <- (b <- c) ====================

#Test
fn test_move_assign_right_assoc() {
  #Mut let a i32 = 1
  #Mut let b i32 = 2
  #Mut let c i32 = 3
  ; a <- b <- c 等价 a <- (b <- c)
  ; 先算 b <- c: 返回 b 旧值 2, b=3
  ; 再算 a <- 2: 返回 a 旧值 1, a=2
  let old_a = a <- b <- c
  assert_eq(old_a, 1)
  assert_eq(a, 2)
  assert_eq(b, 3)
  assert_eq(c, 3)
}

; ==================== #Mut let 延后赋值后使用 <- ====================

#Test
fn test_move_assign_after_deferred_init() {
  #Mut let x i32
  x = 10
  #Mut let y i32 = 20
  let old = x <- y
  assert_eq(old, 10)
  assert_eq(x, 20)
}

; ==================== <- 作为表达式传给函数 + 忽略返回值 ====================

#Test
fn test_move_assign_expr_passed_to_fn_and_ignored() {
  #Mut let a i32 = 15
  #Mut let b i32 = 25
  ; 显式接住旧值避免 E4030
  let _old = a <- b
  assert_eq(a, 25)
}

; ==================== 链式 <- 多次交换 ====================

#Test
fn test_move_assign_chain_three() {
  #Mut let x i32 = 1
  #Mut let y i32 = 2
  #Mut let z i32 = 3
  ; x <- y <- z: 右结合, y 取 z 旧值, x 取 y 旧值
  let old_x = x <- y <- z
  assert_eq(old_x, 1)
  assert_eq(x, 2)
  assert_eq(y, 3)
  assert_eq(z, 3)
}

; ==================== 字段级 <- 多次交换同字段 ====================

#Test
fn test_move_assign_field_twice() {
  #Mut let p1 Rc<MvPair> = MvPair::make(1, 2)
  #Mut let p2 Rc<MvPair> = MvPair::make(3, 4)
  #Mut let p3 Rc<MvPair> = MvPair::make(5, 6)
  #Mut let h MvHolder = MvHolder::make(p1, 7)
  ; 第一次交换
  let old1 Rc<MvPair> = h.bx <- p2
  assert_eq(old1.a, 1)
  assert_eq(h.bx.a, 3)
  ; 第二次交换
  let old2 Rc<MvPair> = h.bx <- p3
  assert_eq(old2.a, 3)
  assert_eq(h.bx.a, 5)
  ; 旧值都独立存活
  assert_eq(old1.b, 2)
  assert_eq(old2.b, 4)
}
