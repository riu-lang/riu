; 复合赋值行为测试
;
; 覆盖：
;   - 算术复合赋值：+= / -= / *= / /= / %=
;   - 位移复合赋值：>>= / <<=
;   - 位运算复合赋值：^=（i32 / u8 / u64）
;
; 已知缺口：|= 和 &= 复合赋值未覆盖；浮点类型（f32/f64）复合赋值未覆盖；
; 复合赋值在 Rc<T>/Heap<T> 等句柄类型上的行为未覆盖。

#Test
fn test_add_assign() {
  #Mut let a i32 = 10
  a += 5
  assert_eq(a, 15)
}

#Test
fn test_sub_assign() {
  #Mut let a i32 = 15
  a -= 3
  assert_eq(a, 12)
}

#Test
fn test_mul_assign() {
  #Mut let a i32 = 12
  a *= 2
  assert_eq(a, 24)
}

#Test
fn test_div_assign() {
  #Mut let a i32 = 24
  a /= 4
  assert_eq(a, 6)
}

#Test
fn test_mod_assign() {
  #Mut let a i32 = 6
  a %= 3
  assert_eq(a, 0)
}

#Test
fn test_shr_assign() {
  #Mut let b i32 = 16
  b >>= 2
  assert_eq(b, 4)
}

#Test
fn test_shl_assign() {
  #Mut let b i32 = 4
  b <<= 1
  assert_eq(b, 8)
}

#Test
fn test_xor_assign() {
  #Mut let a i32 = 0x0F
  a ^= 0xF0
  assert_eq(a, 0xFF)
}

#Test
fn test_xor_assign_u8() {
  #Mut let a u8 = 0b1010u8
  a ^= 0b1100u8
  assert_eq(a, 0b0110u8)
}

#Test
fn test_xor_assign_u64() {
  #Mut let a u64 = 0xFFFFFFFF00000000u64
  a ^= 0x00000000FFFFFFFFu64
  assert_eq(a, 0xFFFFFFFFFFFFFFFFu64)
}
