; 复合赋值行为测试
;
; 覆盖：
;   - 算术复合赋值：+= / -= / *= / /= / %=
;   - 位移复合赋值：>>= / <<=
;   - 位运算复合赋值：^= / |= / &=（i32 / u8 / u64）
;
; 已知缺口：复合赋值在 Rc<T>/Heap<T> 等句柄类型上的行为未覆盖。

#Test
fn test_add_assign() {
  #Mut let a i32 = 10
  a += 5
  assert_eq(a, 15)
}

; 验证：SubAssign 赋值运算符行为
#Test
fn test_sub_assign() {
  #Mut let a i32 = 15
  a -= 3
  assert_eq(a, 12)
}

; 验证：整数乘法赋值运算符行为
#Test
fn test_mul_assign() {
  #Mut let a i32 = 12
  a *= 2
  assert_eq(a, 24)
}

; 验证：整数除法赋值操作
#Test
fn test_div_assign() {
  #Mut let a i32 = 24
  a /= 4
  assert_eq(a, 6)
}

; 验证：Modulo 赋值运算符行为
#Test
fn test_mod_assign() {
  #Mut let a i32 = 6
  a %= 3
  assert_eq(a, 0)
}

; 验证：右移赋值操作符（>>=）是否正确应用
#Test
fn test_shr_assign() {
  #Mut let b i32 = 16
  b >>= 2
  assert_eq(b, 4)
}

; 验证：左移赋值操作符 <<= 的行为
#Test
fn test_shl_assign() {
  #Mut let b i32 = 4
  b <<= 1
  assert_eq(b, 8)
}

; 验证：XOR 赋值运算符功能
#Test
fn test_xor_assign() {
  #Mut let a i32 = 0x0F
  a ^= 0xF0
  assert_eq(a, 0xFF)
}

; 验证：u8 类型的异或赋值操作
#Test
fn test_xor_assign_u8() {
  #Mut let a u8 = 0b1010u8
  a ^= 0b1100u8
  assert_eq(a, 0b0110u8)
}

; 验证：u64 类型的异或赋值操作
#Test
fn test_xor_assign_u64() {
  #Mut let a u64 = 0xFFFFFFFF00000000u64
  a ^= 0x00000000FFFFFFFFu64
  assert_eq(a, 0xFFFFFFFFFFFFFFFFu64)
}

; 验证：OR 赋值运算符功能
#Test
fn test_or_assign() {
  #Mut let a i32 = 0x0F
  a |= 0xF0
  assert_eq(a, 0xFF)
}

; 验证：u8 类型的 or 赋值操作
#Test
fn test_or_assign_u8() {
  #Mut let a u8 = 0b1010u8
  a |= 0b0101u8
  assert_eq(a, 0b1111u8)
}

; 验证：u64 类型的 or 赋值操作
#Test
fn test_or_assign_u64() {
  #Mut let a u64 = 0xAAAAAAAA00000000u64
  a |= 0x00000000FFFFFFFFu64
  assert_eq(a, 0xAAAAAAAAFFFFFFFFu64)
}

; 验证：AND 赋值运算符功能
#Test
fn test_and_assign() {
  #Mut let a i32 = 0xFF
  a &= 0x0F
  assert_eq(a, 0x0F)
}

; 验证：u8 类型的 and 赋值操作
#Test
fn test_and_assign_u8() {
  #Mut let a u8 = 0b1111u8
  a &= 0b1010u8
  assert_eq(a, 0b1010u8)
}

; 验证：u64 类型的 and 赋值操作
#Test
fn test_and_assign_u64() {
  #Mut let a u64 = 0xFFFFFFFFFFFFFFFFu64
  a &= 0x00000000FFFFFFFFu64
  assert_eq(a, 0x00000000FFFFFFFFu64)
}

; ==================== 边界 / 扩展测试 ====================

#Test
fn test_f64_add_assign() {
  ; 验证：f64 += 复合赋值
  #Mut let a f64 = 1.5
  a += 2.5
  assert_eq(a, 4.0)
}

#Test
fn test_f64_mul_assign() {
  ; 验证：f64 *= 复合赋值
  #Mut let a f64 = 3.0
  a *= 2.5
  assert_eq(a, 7.5)
}

#Test
fn test_f32_compound_assign() {
  ; 验证：f32 += / *= 复合赋值
  #Mut let a f32 = 1.0f32
  a += 2.0f32
  assert_eq(a, 3.0f32)
  a *= 2.0f32
  assert_eq(a, 6.0f32)
}

#Test
fn test_add_assign_overflow_wrap() {
  ; 验证：i32 += 溢出回绕（MAX + 1 = MIN）
  #Mut let a i32 = 2147483647
  a += 1
  assert_eq(a, -2147483648)
}

#Test
fn test_sub_assign_underflow_wrap() {
  ; 验证：i32 -= 下溢回绕（MIN - 1 = MAX）
  #Mut let a i32 = -2147483648
  a -= 1
  assert_eq(a, 2147483647)
}
