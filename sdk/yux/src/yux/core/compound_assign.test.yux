; 复合赋值用例
; 迁自 tests/cases/compound_assign.yux

#Test
fn test_add_assign() {
  #Mut let a i32 = 10
  a += 5
  assert_eq(a, 15)
}

#Test
fn test_sub_assign() {
  #Mut let a i32 = 15
  a -= 3
  assert_eq(a, 12)
}

#Test
fn test_mul_assign() {
  #Mut let a i32 = 12
  a *= 2
  assert_eq(a, 24)
}

#Test
fn test_div_assign() {
  #Mut let a i32 = 24
  a /= 4
  assert_eq(a, 6)
}

#Test
fn test_mod_assign() {
  #Mut let a i32 = 6
  a %= 3
  assert_eq(a, 0)
}

#Test
fn test_shr_assign() {
  #Mut let b i32 = 16
  b >>= 2
  assert_eq(b, 4)
}

#Test
fn test_shl_assign() {
  #Mut let b i32 = 4
  b <<= 1
  assert_eq(b, 8)
}
