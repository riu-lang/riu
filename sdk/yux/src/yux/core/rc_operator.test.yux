; Rc<T> 运算符自动解引用测试
;
; Rc 测试分散在 5 个文件中，详见 rc.test.yux 头部注释。
;
; 本文件覆盖（P1）：== / != / < / <= / > / >=、+ - * / %、位运算 & | ^ << >>、
; 一元 - ~ !、自定义类型运算符（Rc<Vec2f> + Vec2f / + Rc<Vec2f>）

; ==================== 比较运算符 ====================

; 验证：Rc<i32> 与 i32 的相等运算符重载
#Test
fn test_rc_i32_eq_literal() {
  let r Rc<i32> = 42
  assert_true(r == 42)
  assert_true(42 == r)
}

; 验证：Rc<i32> 不等于字面量 0 的比较
#Test
fn test_rc_i32_ne_literal() {
  let r Rc<i32> = 42
  assert_true(r != 0)
}

; 验证：Rc<i32> 相等性比较
#Test
fn test_rc_i32_eq_rc() {
  let a Rc<i32> = 10
  let b Rc<i32> = 10
  assert_true(a == b)
}

; 验证：Rc<i32> 不等运算符功能
#Test
fn test_rc_i32_ne_rc() {
  let a Rc<i32> = 10
  let b Rc<i32> = 20
  assert_true(a != b)
}

; 验证：Rc 包装的 f64 等于操作
#Test
fn test_rc_f64_eq() {
  let r Rc<f64> = 3.14
  assert_true(r == 3.14)
}

; 验证：Rc 包装的布尔值相等性比较
#Test
fn test_rc_bool_eq() {
  let r Rc<bool> = true
  assert_true(r == true)
}

; 验证：Rc<i32> 的比较运算符行为
#Test
fn test_rc_i32_cmp_lt() {
  let r Rc<i32> = 10
  assert_true(r < 20)
  assert_true(r <= 10)
  assert_true(r <= 20)
}

; 验证：Rc 包装的 i32 大小比较运算符重载
#Test
fn test_rc_i32_cmp_gt() {
  let r Rc<i32> = 30
  assert_true(r > 20)
  assert_true(r >= 30)
  assert_true(r >= 20)
}

; 验证：Rc 包装的 f64 类型比较操作符
#Test
fn test_rc_f64_cmp() {
  let r Rc<f64> = 1.5
  assert_true(r < 2.0)
  assert_true(r > 1.0)
}

; ==================== 算术运算符 ====================

; 验证：Rc 包装的 i32 加法运算
#Test
fn test_rc_i32_add() {
  let a Rc<i32> = 10
  let b Rc<i32> = 20
  let c i32 = a + b
  assert_eq(c, 30)
}

; 验证：Rc 包装的 i32 加法与赋值
#Test
fn test_rc_i32_add_literal() {
  let r Rc<i32> = 10
  let c i32 = r + 5
  assert_eq(c, 15)
}

; 验证：Rc 包装的 i32 相减操作
#Test
fn test_rc_i32_sub() {
  let a Rc<i32> = 30
  let b Rc<i32> = 10
  let c i32 = a - b
  assert_eq(c, 20)
}

; 验证：Rc 包装的 i32 相乘操作
#Test
fn test_rc_i32_mul() {
  let a Rc<i32> = 7
  let b Rc<i32> = 6
  let c i32 = a * b
  assert_eq(c, 42)
}

; 验证：Rc 包装的 i32 类型除法操作
#Test
fn test_rc_i32_div() {
  let a Rc<i32> = 100
  let b Rc<i32> = 4
  let c i32 = a / b
  assert_eq(c, 25)
}

; 验证：Rc 包装的 i32 取模运算
#Test
fn test_rc_i32_mod() {
  let a Rc<i32> = 17
  let b Rc<i32> = 5
  let c i32 = a % b
  assert_eq(c, 2)
}

; 验证：Rc 包装的浮点数相加
#Test
fn test_rc_f64_add() {
  let a Rc<f64> = 1.5
  let b Rc<f64> = 2.5
  let c f64 = a + b
  assert_eq(c, 4.0)
}

; 验证：Rc 指针下 f64 类型的减法操作
#Test
fn test_rc_f64_sub() {
  let a Rc<f64> = 10.0
  let b Rc<f64> = 3.0
  let c f64 = a - b
  assert_eq(c, 7.0)
}

; 验证：Rc 包装的浮点数乘法
#Test
fn test_rc_f64_mul() {
  let a Rc<f64> = 3.0
  let b Rc<f64> = 4.0
  let c f64 = a * b
  assert_eq(c, 12.0)
}

; 验证：Rc 包装的浮点数除法
#Test
fn test_rc_f64_div() {
  let a Rc<f64> = 10.0
  let b Rc<f64> = 4.0
  let c f64 = a / b
  assert_eq(c, 2.5)
}

; ==================== 一元运算符 ====================

; 验证：Rc 包装的 i32 取负运算符行为
#Test
fn test_rc_i32_neg() {
  let r Rc<i32> = 42
  let c i32 = -r
  assert_eq(c, -42)
}

; 验证：Rc 包装的 f64 取负操作
#Test
fn test_rc_f64_neg() {
  let r Rc<f64> = 3.14
  let c f64 = -r
  assert_eq(c, -3.14)
}

; 验证：Rc 包装的 i32 取反操作
#Test
fn test_rc_i32_rev() {
  let r Rc<i32> = 0xF0
  let c i32 = ~r
  assert_eq(c, ~0xF0)
}

; 验证：Rc 包装的布尔值取反
#Test
fn test_rc_bool_not() {
  let r Rc<bool> = true
  let c bool = !r
  assert_eq(c, false)
}

; ==================== 位运算符 ====================

; 验证：Rc 包装的 i32 类型按位与运算
#Test
fn test_rc_i32_bitwise_and() {
  let a Rc<i32> = 0xFF
  let b Rc<i32> = 0x0F
  let c i32 = a & b
  assert_eq(c, 0x0F)
}

; 验证：Rc 包装的 i32 进行按位或运算
#Test
fn test_rc_i32_bitwise_or() {
  let a Rc<i32> = 0xF0
  let b Rc<i32> = 0x0F
  let c i32 = a | b
  assert_eq(c, 0xFF)
}

; 验证：Rc 包装的 i32 进行按位异或运算
#Test
fn test_rc_i32_bitwise_xor() {
  let a Rc<i32> = 0xFF
  let b Rc<i32> = 0x0F
  let c i32 = a ^ b
  assert_eq(c, 0xF0)
}

; 验证：Rc 包装的 i32 左移操作
#Test
fn test_rc_i32_shl() {
  let r Rc<i32> = 1
  let c i32 = r << 4
  assert_eq(c, 16)
}

; 验证：Rc 包装的 i32 右移操作
#Test
fn test_rc_i32_shr() {
  let r Rc<i32> = 64
  let c i32 = r >> 2
  assert_eq(c, 16)
}

; ==================== 自定义类型运算符（Rc<struct> + struct） ====================

struct Vec2f {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2f {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn plus(other Vec2f&) Vec2f {
    ret Vec2f::make($.x + other.x, $.y + other.y)
  }

  fn minus(other Vec2f&) Vec2f {
    ret Vec2f::make($.x - other.x, $.y - other.y)
  }

  fn mul(scalar f64) Vec2f {
    ret Vec2f::make($.x * scalar, $.y * scalar)
  }

  fn neg() Vec2f {
    ret Vec2f::make(-$.x, -$.y)
  }
}

; 验证：Rc<Vec2f> 加法运算符重载
#Test
fn test_rc_vec2f_add_vec2f() {
  let r Rc<Vec2f> = Vec2f::make(1.0, 2.0)
  let v Vec2f = Vec2f::make(3.0, 4.0)
  let s Vec2f = r + v
  assert_eq(s.x, 4.0)
  assert_eq(s.y, 6.0)
}

; 验证：Rc<Vec2f> 加法运算符重载
#Test
fn test_rc_vec2f_add_rc_vec2f() {
  let a Rc<Vec2f> = Vec2f::make(1.0, 2.0)
  let b Rc<Vec2f> = Vec2f::make(3.0, 4.0)
  let s Vec2f = a + b
  assert_eq(s.x, 4.0)
  assert_eq(s.y, 6.0)
}

; 验证：Rc<Vec2f> 的减法操作
#Test
fn test_rc_vec2f_sub() {
  let r Rc<Vec2f> = Vec2f::make(5.0, 4.0)
  let v Vec2f = Vec2f::make(2.0, 1.0)
  let d Vec2f = r - v
  assert_eq(d.x, 3.0)
  assert_eq(d.y, 3.0)
}

; 验证：Rc<Vec2f> 乘以标量后得到正确结果
#Test
fn test_rc_vec2f_mul_scalar() {
  let r Rc<Vec2f> = Vec2f::make(2.0, 3.0)
  let s Vec2f = r * 2.0
  assert_eq(s.x, 4.0)
  assert_eq(s.y, 6.0)
}

; 验证：Rc<Vec2f> 的负号操作符行为
#Test
fn test_rc_vec2f_neg() {
  let r Rc<Vec2f> = Vec2f::make(3.0, -4.0)
  let n Vec2f = -r
  assert_eq(n.x, -3.0)
  assert_eq(n.y, 4.0)
}

; ==================== 复合运算 ====================

; 验证：Rc 引用计数智能指针链式加法
#Test
fn test_rc_i32_chain_add() {
  let a Rc<i32> = 10
  let b Rc<i32> = 20
  let c Rc<i32> = 30
  let sum i32 = a + b + c
  assert_eq(sum, 60)
}

; 验证：Rc<i32> 表达式计算与赋值
#Test
fn test_rc_i32_expr() {
  let r Rc<i32> = 10
  ; (r + r) * 2 == 40
  let result i32 = (r + r) * 2
  assert_eq(result, 40)
}
