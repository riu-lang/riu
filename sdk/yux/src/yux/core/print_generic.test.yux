; v0.6 stdlib I/O 泛型化回归
; print / println / eprint / eprintln 各保留三态：
;   String& 非泛型快路径 + `<T : ToString>(x T)` 泛型 owned + `<T : ToString>(x T&)` 泛型借用
; 测试目标：三种重载在 i64 / bool / String / 用户类型 / Array::get 返回 T& 上能正确分发并编译链接通过
; （stdout / stderr 实际字节不易在 in-process JIT 内回采，依赖 -v 时的捕获回放观察。）

#Impl(ToString)
struct PrintTag {
  v i64

  #Static
  fn make(v i64) PrintTag {
    ret Self {
      .v = v
    }
  }

  fn to_string() String {
    $.v.to_string()
  }
}

; 验证：Generic print 和 println 函数的调用与输出
#Test
fn test_print_generic_builtin() {
  print(42)
  print(true)
  println(7)
  println(false)
  ; 走到这里说明各重载都已成功单态化并链接
  assert_true(true)
}

; 验证：String 参数的非泛型 print 和 println 快路径
#Test
fn test_print_string_fast_path() {
  ; String 实参命中非泛型 print(s String&) / println(s String&) 快路径
  print("hello ")
  println("world")
  assert_true(true)
}

; 验证：打印自定义类型并断言真值
#Test
fn test_print_user_type() {
  let t PrintTag = PrintTag::make(123)
  println(t)
  assert_true(true)
}

; 验证：eprint 和 eprintln 函数的通用打印行为
#Test
fn test_eprint_generic() {
  eprint("err ")
  eprintln(99)
  eprintln(true)
  let t PrintTag = PrintTag::make(7)
  eprintln(t)
  assert_true(true)
}

; === T& 泛型借用重载：Array::get 返回 T&，免去手动 copy_of ===

; 验证：Array::get 返回 T&，直接打印免去手动 copy_of
#Test
fn test_print_generic_ref() {
  ; Array::get(i) 返回 i64&，应命中 print<T : ToString>(x T&)
  #Mut let arr Array<i64> = []
  arr.push(10i64)
  arr.push(20i64)
  arr.push(30i64)
  ; 直接打印 get 返回值（T&），不走 copy_of
  print(arr.get(0))
  print(arr.get(1))
  println(arr.get(2))
  assert_true(true)
}

; 验证：eprint 和 eprintln 函数的通用引用打印行为
#Test
fn test_eprint_generic_ref() {
  #Mut let arr Array<bool> = []
  arr.push(true)
  arr.push(false)
  ; bool& → eprint<T : ToString>(x T&) / eprintln<T : ToString>(x T&)
  eprint(arr.get(0))
  eprintln(arr.get(1))
  assert_true(true)
}

; 验证：泛型借用重载对用户类型引用的打印行为
#Test
fn test_print_user_type_ref() {
  ; 用户类型 T& 也应命中泛型借用重载
  #Mut let arr Array<PrintTag> = []
  arr.push(PrintTag::make(100i64))
  arr.push(PrintTag::make(200i64))
  print(arr.get(0))
  println(arr.get(1))
  assert_true(true)
}
