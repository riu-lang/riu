; if_else 条件表达式用例
; 迁自 tests/cases/if_else.yux

#Test
fn test_if_max() {
  val a = 10
  val b = 20
  val max = if a > b { a } else { b }
  assert_eq(max, 20)
}

#Test
fn test_if_elif_else() {
  val score = 85
  val grade = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } elif score >= 70 {
    3
  } else {
    4
  }
  assert_eq(grade, 2)
}

#Test
fn test_if_no_else_taken() {
  val a = 10
  var hit i32 = 0
  if a > 0 {
    hit = a
  }
  assert_eq(hit, 10)
}
