; if_else 条件表达式用例
; 迁自 tests/cases/if_else.yux

#Test
fn test_if_max() {
  let a = 10
  let b = 20
  let max = if a > b { a } else { b }
  assert_eq(max, 20)
}

#Test
fn test_if_elif_else() {
  let score = 85
  let grade = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } elif score >= 70 {
    3
  } else {
    4
  }
  assert_eq(grade, 2)
}

#Test
fn test_if_no_else_taken() {
  let a = 10
  #Mut let hit i32 = 0
  if a > 0 {
    hit = a
  }
  assert_eq(hit, 10)
}

; 迁自 tests/cases/inline_if.yux —— 后缀条件式 `<expr> if <cond> else <expr>`

#Test
fn test_postfix_if_else_max() {
  let a = 10
  let b = 20
  let m = a if a > b else b
  assert_eq(m, 20)
}

#Test
fn test_postfix_if_else_sign_pos() {
  let a = 10
  let sign = 1 if a >= 0 else -1
  assert_eq(sign, 1)
}

#Test
fn test_postfix_if_else_sign_neg() {
  let a = -3
  let sign = 1 if a >= 0 else -1
  assert_eq(sign, -1)
}

#Test
fn test_postfix_if_else_string() {
  let a = 10
  let msg = "positive" if a > 0 else "non-positive"
  assert_eq(msg, "positive")
}
