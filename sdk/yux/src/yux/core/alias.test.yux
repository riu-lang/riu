; 顶层透明类型别名 (v0.6 Phase 2b)
; A = T 时 A 与 T 在赋值 / 算术 / 函数签名 / 比较中等价

A = i32

#Test
fn test_alias_basic_int() {
  #Mut let x A = 7i32
  assert_eq(x, 7i32)
}

#Test
fn test_alias_in_arith() {
  #Mut let x A = 10i32
  #Mut let y A = 3i32
  assert_eq(x + y, 13i32)
}

fn add_alias(x A, y A) A {
  ret x + y
}

#Test
fn test_alias_fn_signature() {
  assert_eq(add_alias(2i32, 3i32), 5i32)
}

; 把 alias 类型的局部变量喂给以 alias 声明形参的函数
#Test
fn test_alias_var_as_arg() {
  #Mut let a A = 4i32
  #Mut let b A = 6i32
  assert_eq(add_alias(a, b), 10i32)
}

; 链式别名 A1 -> A2 -> A -> i32
A2 = A
A1 = A2

#Test
fn test_alias_chain() {
  #Mut let x A1 = 99i32
  assert_eq(x, 99i32)
}

; 元组别名 + 成员访问（Phase 4 与 alias 的协同）
IPair = (i32, i32)

#Test
fn test_alias_tuple_member() {
  #Mut let p IPair = (5i32, 9i32)
  assert_eq(p.0, 5i32)
  assert_eq(p.1, 9i32)
}

; 泛型元组别名实例化后的成员访问
Pair<T> = (T, T)

#Test
fn test_alias_generic_tuple_member() {
  #Mut let p Pair<i32> = (40i32, 2i32)
  assert_eq(p.0, 40i32)
  assert_eq(p.1, 2i32)
}

; 解构 alias 类型的元组（Phase 5）
#Test
fn test_alias_tuple_destructure() {
  #Mut let p IPair = (11i32, 22i32)
  var (a, b) IPair = p
  assert_eq(a, 11i32)
  assert_eq(b, 22i32)
}

; alias 路径上的元组成员赋值（Phase 6）
#Test
fn test_alias_tuple_member_assign() {
  #Mut let p IPair = (1i32, 2i32)
  p.0 = 100i32
  p.1 = 200i32
  assert_eq(p.0, 100i32)
  assert_eq(p.1, 200i32)
}

#Test
fn test_alias_generic_tuple_member_assign() {
  #Mut let p Pair<i32> = (3i32, 4i32)
  p.1 = 77i32
  assert_eq(p.0, 3i32)
  assert_eq(p.1, 77i32)
}
