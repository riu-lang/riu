; 顶层透明类型别名 (v0.6 Phase 2b)
; A = T 时 A 与 T 在赋值 / 算术 / 函数签名 / 比较中等价

A = i32

#Test
fn test_alias_basic_int() {
  #Mut let x A = 7
  assert_eq(x, 7)
}

#Test
fn test_alias_in_arith() {
  #Mut let x A = 10
  #Mut let y A = 3
  assert_eq(x + y, 13)
}

fn add_alias(x A, y A) A {
  ret x + y
}

#Test
fn test_alias_fn_signature() {
  assert_eq(add_alias(2, 3), 5)
}

; 把 alias 类型的局部变量喂给以 alias 声明形参的函数
#Test
fn test_alias_var_as_arg() {
  #Mut let a A = 4
  #Mut let b A = 6
  assert_eq(add_alias(a, b), 10)
}

; 链式别名 A1 -> A2 -> A -> i32
A2 = A
A1 = A2

#Test
fn test_alias_chain() {
  #Mut let x A1 = 99
  assert_eq(x, 99)
}

; 元组别名 + 成员访问（Phase 4 与 alias 的协同）
IPair = (i32, i32)

#Test
fn test_alias_tuple_member() {
  #Mut let p IPair = (5, 9)
  assert_eq(p.0, 5)
  assert_eq(p.1, 9)
}

; 泛型元组别名实例化后的成员访问
Pair<T> = (T, T)

#Test
fn test_alias_generic_tuple_member() {
  #Mut let p Pair<i32> = (40, 2)
  assert_eq(p.0, 40)
  assert_eq(p.1, 2)
}

; 解构 alias 类型的元组（Phase 5）
#Test
fn test_alias_tuple_destructure() {
  #Mut let p IPair = (11, 22)
  #Mut let (a, b) IPair = p
  assert_eq(a, 11)
  assert_eq(b, 22)
}

; alias 路径上的元组成员赋值（Phase 6）
#Test
fn test_alias_tuple_member_assign() {
  #Mut let p IPair = (1, 2)
  p.0 = 100
  p.1 = 200
  assert_eq(p.0, 100)
  assert_eq(p.1, 200)
}

#Test
fn test_alias_generic_tuple_member_assign() {
  #Mut let p Pair<i32> = (3, 4)
  p.1 = 77
  assert_eq(p.0, 3)
  assert_eq(p.1, 77)
}
