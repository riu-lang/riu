; Phase 3 端到端: #Static fn + Self { ... } + Type::name(...) JIT 验证

struct Point {
  x i32
  y i32
}

Point {
  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn sum() i32 = $.x + $.y
}

#Test
fn test_static_make_and_sum() {
  let p Point = Point::make(3i32, 4i32)
  assert_eq(p.sum(), 7i32)
}

#Test
fn test_static_make_zero() {
  let p Point = Point::make(0i32, 0i32)
  assert_eq(p.x, 0i32)
  assert_eq(p.y, 0i32)
}

#Test
fn test_static_make_negative() {
  let p Point = Point::make(-5i32, 10i32)
  assert_eq(p.x, -5i32)
  assert_eq(p.y, 10i32)
}
