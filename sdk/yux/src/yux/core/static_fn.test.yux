; #Static fn 静态工厂行为测试
;
; 覆盖：
;   - Type::name(...) 调用语法（JIT 编译+链接）
;   - 多个 static factory 方法共存（make / make_double 等）
;   - 基础构造、零值、负值等边界输入
;   - Self { ... } 字段字面量构造
;   - struct body 内 `Self::name(...)`（§7.10.2.3）
;
; 已知缺口：无——#Static fn 当前仅支持 struct 构造函数模式，
; 泛型 struct 的 #Static fn 见 generic_name_conflict / generic_method_ref_return。
; 更多 Self { ... } 句柄字段 retain 回归见 static_fn_handle.test.yux。
; String #Static 工厂见 static_fn_string.test.yux。

struct Point {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }

  #Static
  fn origin() Point {
    ret Self::make(0, 0)
  }

  fn translated(dx i32, dy i32) Point {
    ret Self::make($.x + dx, $.y + dy)
  }

  fn sum() i32 = $.x + $.y
}

; 验证：静态方法创建点并计算坐标和
#Test
fn test_static_make_and_sum() {
  let p Point = Point::make(3, 4)
  assert_eq(p.sum(), 7i32)
}

; 验证：静态方法 make 创建的 Point 对象初始值为零
#Test
fn test_static_make_zero() {
  let p Point = Point::make(0, 0)
  assert_eq(p.x, 0)
  assert_eq(p.y, 0)
}

; 验证：静态方法 make 创建的点对象坐标正确
#Test
fn test_static_make_negative() {
  let p Point = Point::make(-5, 10)
  assert_eq(p.x, -5)
  assert_eq(p.y, 10)
}

; 验证：#Static 体内 `Self::make` 等同 `Point::make`
#Test
fn test_self_static_from_static() {
  let p Point = Point::origin()
  assert_eq(p.sum(), 0)
}

; 验证：实例方法体内 `Self::make` 等同当前类型静态调用
#Test
fn test_self_static_from_instance() {
  let p Point = Point::make(3, 4)
  let q Point = p.translated(1, 2)
  assert_eq(q.x, 4)
  assert_eq(q.y, 6)
}

; ==================== 多个 static factory（迁自 bug_hunt） ====================

struct BHStaticTest {
  val i32

  #Static
  fn make(val i32) Self {
    Self {
      .val = val
    }
  }

  #Static
  fn make_double(val i32) Self {
    Self {
      .val = val * 2
    }
  }
}

#Test
fn test_static_fn_make_double() {
  ; 验证：多个 static factory 方法共存
  let d BHStaticTest = BHStaticTest::make_double(21)
  assert_eq(d.val, 42)
}

; ==================== 泛型 `Self::name` 绑当前单态 ====================

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  #Static
  fn wrap(v T) Self = Self::make(v)

  fn dup() Self {
    ret Self::make($.val)
  }
}

#Test
fn test_self_static_generic() {
  let s Slot<i32> = Slot:<i32>::wrap(9)
  assert_eq(s.val, 9)
  let t Slot<i32> = s.dup()
  assert_eq(t.val, 9)
}
