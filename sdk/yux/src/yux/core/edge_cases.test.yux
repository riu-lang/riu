; 综合边缘场景测试：文档示例覆盖缺口
; 覆盖：定长数组填充变体、loop 多层 break、match 含 RC payload、
;       bitwise 无符号类型、codePoint 字面量、if-else 表达式链。

; ==================== 定长数组填充变体 ====================

; bool 定长数组列表初始化
#Test
fn test_fixed_array_bool_list_four() {
  #Mut let flags [bool * 4] = [false, false, false, false]
  assert_false(flags[0])
  assert_false(flags[3])
}

#Test
fn test_fixed_array_fill_u8_pattern() {
  #Mut let buf [u8 * 6] = [97u8 ...]
  assert_eq(buf[0], 97u8)
  assert_eq(buf[5], 97u8)
}

#Test
fn test_fixed_array_fill_i64_with_type() {
  #Mut let arr [i64 * 3] = [7i64 ...]
  assert_eq(arr[0], 7i64)
  assert_eq(arr[2], 7i64)
}

#Test
fn test_fixed_array_fill_f64_with_type() {
  #Mut let arr [f64 * 2] = [1.5 ... f64]
  assert_eq(arr[0], 1.5)
  assert_eq(arr[1], 1.5)
}

; ==================== 定长数组部分写后读取 ====================

#Test
fn test_fixed_array_write_then_read() {
  #Mut let buf [i32 * 3] = [0 ... i32]
  buf[0] = 1
  buf[1] = 2
  buf[2] = buf[0] + buf[1]
  assert_eq(buf[2], 3)
}

; ==================== loop 多层嵌套 break ====================

#Test
fn test_loop_nested_break() {
  #Mut let outer i32 = 0
  #Mut let inner i32 = 0
  loop {
    outer = outer + 1
    if outer > 3 {
      break;
    }
    inner = 0
    loop {
      inner = inner + 1
      if inner > 2 {
        break;
      }
    }
  }
  assert_eq(outer, 4)
  assert_eq(inner, 3)
}

; ==================== loop 中用 ret 直接退出函数 ====================

; 原 BUG workaround: break + 外部 ret（仍保留作为基础测试）
fn loop_ret_sum_break(n i32) i32 {
  #Mut let sum i32 = 0
  #Mut let i i32 = 1
  loop {
    if i > n {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  ret sum
}

; loop 内直接 ret
fn loop_ret_sum(n i32) i32 {
  #Mut let sum i32 = 0
  #Mut let i i32 = 1
  loop {
    if i > n {
      ret sum
    }
    sum = sum + i
    i = i + 1
  }
}

#Test
fn test_loop_early_ret() {
  assert_eq(loop_ret_sum(5), 15)
  assert_eq(loop_ret_sum(10), 55)
}

; 最简单的 loop { ret } 形态
fn simple_loop_ret() i32 {
  loop {
    ret 42
  }
}

#Test
fn test_simple_loop_ret() {
  assert_eq(simple_loop_ret(), 42)
}

; loop 内多层 if-else 嵌套 ret
fn nested_if_ret(x i32) i32 {
  loop {
    if x > 0 {
      if x > 10 {
        ret 100
      }
      ret x
    }
    ret 0
  }
}

#Test
fn test_nested_loop_ret() {
  assert_eq(nested_if_ret(5), 5)
  assert_eq(nested_if_ret(15), 100)
  assert_eq(nested_if_ret(0), 0)
}

; ==================== match 含 RC payload（String）绑定为借用 ====================

enum MsgKind {
  Simple
  Greet(String)
  Data(i32, String)
}

fn inspect(m MsgKind&) String {
  match m {
    MsgKind::Simple => "simple"
    MsgKind::Greet(name) => name
    MsgKind::Data(code, desc) => desc
  }
}

#Test
fn test_match_rc_payload_string() {
  let msg1 MsgKind = MsgKind::Simple
  let msg2 MsgKind = MsgKind::Greet("hello")
  let msg3 MsgKind = MsgKind::Data(42, "world")
  assert_eq(inspect(&msg1), "simple")
  assert_eq(inspect(&msg2), "hello")
  assert_eq(inspect(&msg3), "world")
}

; ==================== match 含 else 兜底 ====================

enum SignKind {
  Pos
  Neg
  Zero
}

fn classify(n i32) SignKind {
  if n > 0 {
    ret SignKind::Pos
  }
  if n < 0 {
    ret SignKind::Neg
  }
  ret SignKind::Zero
}

fn sign_desc(s SignKind) String {
  match s {
    SignKind::Pos => "positive"
    else => "non-positive"
  }
}

#Test
fn test_match_else_branch() {
  let a SignKind = classify(5)
  let b SignKind = classify(-3)
  let c SignKind = classify(0)
  assert_eq(sign_desc(a), "positive")
  assert_eq(sign_desc(b), "non-positive")
  assert_eq(sign_desc(c), "non-positive")
}

; ==================== bitwise 无符号类型 ====================

#Test
fn test_bitwise_u8() {
  let a u8 = 0xF0u8
  let b u8 = 0x0Fu8
  assert_eq(a & b, 0x00u8)
  assert_eq(a | b, 0xFFu8)
  assert_eq(a ^ b, 0xFFu8)
}

#Test
fn test_bitwise_u32_mask() {
  let mask u32 = 0xFF00u32
  let val u32 = 0xABCDu32
  assert_eq(val & mask, 0xAB00u32)
  assert_eq(val | mask, 0xFFCDu32)
}

#Test
fn test_bitwise_shift_u32() {
  let x u32 = 1
  assert_eq(x << 4, 16)
  assert_eq(x << 8, 256)
  let y u32 = 256
  assert_eq(y >> 4, 16)
}

#Test
fn test_bitwise_not_u8() {
  let a u8 = 0
  assert_eq(~a, 255)
}

; ==================== codePoint 字面量 ====================

#Test
fn test_codepoint_ascii() {
  let a u32 = c'A'
  assert_eq(a, 65)
  let nl u32 = c'\n'
  assert_eq(nl, 10)
}

#Test
fn test_codepoint_digit() {
  let zero u32 = c'0'
  let nine u32 = c'9'
  assert_eq(zero, 48)
  assert_eq(nine, 57)
}

; ==================== 类型推断：上下文驱动整型宽度 ====================

fn accept_i64(x i64) i64 = x

#Test
fn test_type_inference_i64_literal() {
  ; 字面量按上下文推断为 i64
  let r i64 = accept_i64(42)
  assert_eq(r, 42)
}

fn accept_u8(x u8) u8 = x

#Test
fn test_type_inference_u8_literal() {
  let r u8 = accept_u8(100)
  assert_eq(r, 100)
}

; ==================== if-else 单行表达式（仅 if/else，不支持 elif） ====================

#Test
fn test_if_else_single_line_chain() {
  let score = 75
  let grade = if score >= 90 { 1 } else { if score >= 80 { 2 } else { if score >= 70 { 3 } else { 4 } } }
  assert_eq(grade, 3)
}

; ==================== 多行调用链式 ====================

fn add3(a, b, c i32) i32 = a + b + c

#Test
fn test_multi_line_call() {
  let r = add3(
    1,
    2,
    3,
  )
  assert_eq(r, 6)
}

; ==================== 比较运算符结果 bool ====================

#Test
fn test_comparison_result_bool() {
  let a = 10
  let b = 20
  assert_true(a < b)
  assert_true(a <= b)
  assert_false(a > b)
  assert_false(a >= b)
  assert_true(a != b)
  assert_false(a == b)
  assert_true(a <= 10)
  assert_true(b >= 20)
}

; ==================== && / || 短路求值 + #Mut let 全局可变态 ====================

#Mut let g_sc_val i32 = 0

fn sc_set_val() bool {
  g_sc_val = 1
  ret true
}

fn sc_get_val() i32 = g_sc_val

#Test
fn test_and_short_circuit_false_left() {
  g_sc_val = 0
  ; false && expr: 左侧为 false，右侧不应执行
  let a bool = false && sc_set_val()
  assert_false(a)
  assert_eq(sc_get_val(), 0)
}

#Test
fn test_and_short_circuit_true_left() {
  g_sc_val = 0
  ; true && expr: 左侧为 true，必须执行右侧
  let a bool = true && sc_set_val()
  assert_true(a)
  assert_eq(sc_get_val(), 1)
}

#Test
fn test_or_short_circuit_true_left() {
  g_sc_val = 0
  ; true || expr: 左侧为 true，右侧不应执行
  let a bool = true || sc_set_val()
  assert_true(a)
  assert_eq(sc_get_val(), 0)
}

#Test
fn test_or_short_circuit_false_left() {
  g_sc_val = 0
  ; false || expr: 左侧为 false，必须执行右侧
  let a bool = false || sc_set_val()
  assert_true(a)
  assert_eq(sc_get_val(), 1)
}

; 纯字面量短路求值（不涉函数调用）
#Test
fn test_and_literal_short_circuit() {
  assert_false(false && true)
  assert_false(false && false)
  assert_true(true && true)
  assert_false(true && false)
}

#Test
fn test_or_literal_short_circuit() {
  assert_true(true || false)
  assert_true(true || true)
  assert_true(false || true)
  assert_false(false || false)
}
