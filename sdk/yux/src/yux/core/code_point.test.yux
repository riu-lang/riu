; 字符字面量 / 码点用例
; 迁自 tests/cases/code_point.yux

#Test
fn test_code_point_a() {
  let a u32 = c'A'
  assert_eq(a, 65)
}

#Test
fn test_code_point_newline() {
  let b u32 = c'\n'
  assert_eq(b, 10)
}

#Test
fn test_code_point_tab() {
  let c u32 = c'\t'
  assert_eq(c, 9)
}

#Test
fn test_code_point_zero() {
  let d u32 = c'0'
  assert_eq(d, 48)
}
