; arithmetic 算术运算用例
; 迁自 tests/cases/arithmetic.yux —— 旧用例靠 println 比对 .expected，
; 这里用 assert_eq 直接断言。
;
; 本文件包含算术运算测试:
; - 整数加减乘除取模
; - 浮点数运算
; - 负数运算
; - 各整数类型运算

; ==================== 整数基本运算 ====================

#Test
fn test_int_add() {
  assert_eq(10 + 5, 15)
}

#Test
fn test_int_sub() {
  assert_eq(10 - 5, 5)
}

#Test
fn test_int_mul() {
  assert_eq(10 * 5, 50)
}

#Test
fn test_int_div() {
  assert_eq(10 / 5, 2)
}

#Test
fn test_int_mod() {
  assert_eq(10 % 3, 1)
}

; ==================== 浮点数运算 ====================

#Test
fn test_float_add() {
  ; 3.14 + 2.86 在 IEEE-754 下恰好等于 6.0
  assert_eq(3.14 + 2.86, 6.0)
}

#Test
fn test_float_sub() {
  assert_eq(10.0 - 0.5, 9.5)
}

#Test
fn test_float_mul() {
  assert_eq(2.5 * 4.0, 10.0)
}

#Test
fn test_float_div() {
  assert_eq(7.5 / 2.5, 3.0)
}

; ==================== 负数运算 ====================

#Test
fn test_neg_add() {
  assert_eq(-5 + 3, -2)
}

#Test
fn test_neg_sub() {
  assert_eq(-10 - (-5), -5)
}

#Test
fn test_neg_mul() {
  assert_eq(-3 * 4, -12)
  assert_eq(-3 * (-4), 12)
}

#Test
fn test_neg_div() {
  assert_eq(-12 / 4, -3)
  assert_eq(-12 / (-4), 3)
}

; ==================== 各整数类型运算 ====================

#Test
fn test_i64_add() {
  let a i64 = 1000000000
  let b i64 = 2000000000
  assert_eq(a + b, 3000000000)
}

#Test
fn test_u8_add() {
  let a u8 = 100
  let b u8 = 50
  assert_eq(a + b, 150)
}

#Test
fn test_u32_mul() {
  let a u32 = 1000
  let b u32 = 2000
  assert_eq(a * b, 2000000)
}

#Test
fn test_i16_div() {
  let a i16 = 1000
  let b i16 = 8
  assert_eq(a / b, 125)
}

; ==================== 运算优先级 ====================

#Test
fn test_arith_priority() {
  assert_eq(2 + 3 * 4, 14)
  assert_eq(10 - 6 / 2, 7)
  assert_eq((2 + 3) * 4, 20)
}

#Test
fn test_arith_chain() {
  assert_eq(1 + 2 + 3 + 4, 10)
  assert_eq(100 - 50 - 30, 20)
  assert_eq(2 * 3 * 4, 24)
}

; ==================== 零运算 ====================

#Test
fn test_zero_add() {
  assert_eq(0 + 0, 0)
  assert_eq(0 + 5, 5)
  assert_eq(5 + 0, 5)
}

#Test
fn test_zero_mul() {
  assert_eq(0 * 100, 0)
  assert_eq(100 * 0, 0)
}

#Test
fn test_zero_div() {
  assert_eq(0 / 5, 0)
}

; ==================== f32 浮点运算 ====================

#Test
fn test_f32_add() {
  ; 验证：f32 基本加法
  assert_eq(1.5f32 + 2.5f32, 4.0f32)
  assert_eq(0.0f32 + 3.14f32, 3.14f32)
  assert_eq(1.0f32 + 0.0f32, 1.0f32)
}

#Test
fn test_f32_sub() {
  ; 验证：f32 减法
  assert_eq(5.0f32 - 2.0f32, 3.0f32)
  assert_eq(2.0f32 - 5.0f32, -3.0f32)
  assert_eq(3.14f32 - 0.0f32, 3.14f32)
}

#Test
fn test_f32_mul() {
  ; 验证：f32 乘法
  assert_eq(2.5f32 * 4.0f32, 10.0f32)
  assert_eq(3.0f32 * 0.0f32, 0.0f32)
  assert_eq(1.5f32 * 2.0f32, 3.0f32)
}

#Test
fn test_f32_div() {
  ; 验证：f32 除法
  assert_eq(10.0f32 / 4.0f32, 2.5f32)
  assert_eq(0.0f32 / 3.14f32, 0.0f32)
  assert_eq(7.5f32 / 2.5f32, 3.0f32)
}

#Test
fn test_f32_neg_arithmetic() {
  ; 验证：负 f32 四则运算
  assert_eq(-1.5f32 + 0.5f32, -1.0f32)
  assert_eq(-3.0f32 - 2.0f32, -5.0f32)
  assert_eq(-2.0f32 * 3.0f32, -6.0f32)
  assert_eq(-6.0f32 / 2.0f32, -3.0f32)
}

#Test
fn test_f32_neg_neg_arithmetic() {
  ; 验证：两个负 f32 运算
  assert_eq(-1.5f32 + (-2.5f32), -4.0f32)
  assert_eq(-4.0f32 - (-1.0f32), -3.0f32)
  assert_eq(-2.0f32 * (-3.0f32), 6.0f32)
  assert_eq(-6.0f32 / (-2.0f32), 3.0f32)
}

#Test
fn test_f32_large_values() {
  ; 验证：f32 较大值运算
  assert_eq(1000000.0f32 + 2000000.0f32, 3000000.0f32)
  assert_eq(1000000.0f32 * 2.0f32, 2000000.0f32)
}

#Test
fn test_f32_chain() {
  ; 验证：f32 链式运算
  assert_eq(1.0f32 + 2.0f32 + 3.0f32, 6.0f32)
  assert_eq(2.0f32 * 3.0f32 * 4.0f32, 24.0f32)
  assert_eq(10.0f32 - 3.0f32 - 2.0f32, 5.0f32)
}

; ==================== T& 形参方法调用 ====================

#Test
fn test_scalar_plus_ref() {
  ; 显式调用 plus 方法，传入 T& 实参
  let x i32 = 10
  let y i32 = 3
  let r i32& = &y
  let z i32 = x.plus(r)
  assert_eq(z, 13)
}

#Test
fn test_scalar_eq_ref() {
  ; 显式调用 eq 方法，传入 T& 实参
  let a i32 = 5
  let b i32 = 5
  let rb i32& = &b
  assert_eq(a.eq(rb), true)
}

#Test
fn test_scalar_plus_ref_literal() {
  ; 直接传 &y 不用中间变量
  let x i32 = 7
  let y i32 = 8
  let z i32 = x.plus(&y)
  assert_eq(z, 15)
}

; ==================== f64 特殊值（迁自 bug_hunt） ====================

#Test
fn test_f64_neg_zero() {
  ; 验证：IEEE 754 -0.0 == +0.0
  let a f64 = -0.0f64
  let b f64 = 0.0f64
  assert_true(a == b)
}

#Test
fn test_f64_large_mul() {
  ; 验证：f64 大值乘法
  let a f64 = 1.0e10f64
  let b f64 = 2.0f64
  let c f64 = a * b
  assert_eq(c, 2.0e10f64)
}

#Test
fn test_f64_small_div() {
  ; 验证：1/3 ≈ 0.333...
  let a f64 = 1.0f64
  let b f64 = 3.0f64
  let c f64 = a / b
  assert_true(c > 0.33f64 && c < 0.34f64)
}
