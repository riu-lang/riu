; 运算符重载扩展行为测试
;
; 覆盖：
;   - 算术运算符：div（/）、mod（%）
;   - 位移运算符：shl（<<）、shr（>>）
;   - 一元运算符：not（~ 按位取反）
;   - 自定义类型（Ratio / Bitflag 等）上的运算符重载
;
; 已知缺口：基础运算符（+ - * == !=）见 operator.test.yux；
; 复合赋值（+= -= 等）的运算符重载无专项覆盖。

; ==================== 算术运算符 div / mod ====================

struct Ratio {
  num i32
  den i32

  #Static
  fn make(num i32, den i32) Ratio {
    ret Self {
      .num = num
      .den = den
    }
  }

  fn div(other Ratio&) Ratio {
    Ratio::make($.num / other.num, $.den / other.den)
  }

  fn mod(other Ratio&) Ratio {
    Ratio::make($.num % other.num, $.den % other.den)
  }
}

#Test
fn test_op_overload_div() {
  let a Ratio = Ratio::make(20, 40)
  let b Ratio = Ratio::make(4, 5)
  let c Ratio = a / b
  assert_eq(c.num, 5)
  assert_eq(c.den, 8)
}

#Test
fn test_op_overload_mod() {
  let a Ratio = Ratio::make(17, 25)
  let b Ratio = Ratio::make(5, 7)
  let c Ratio = a % b
  assert_eq(c.num, 2)
  assert_eq(c.den, 4)
}

; ==================== 移位运算符 shl / shr ====================

struct ShiftVal {
  v i32

  #Static
  fn make(v i32) ShiftVal {
    ret Self {
      .v = v
    }
  }

  fn shl(other ShiftVal&) ShiftVal {
    ShiftVal::make($.v << other.v)
  }

  fn shr(other ShiftVal&) ShiftVal {
    ShiftVal::make($.v >> other.v)
  }
}

#Test
fn test_op_overload_shl() {
  let a ShiftVal = ShiftVal::make(1)
  let b ShiftVal = ShiftVal::make(4)
  let c ShiftVal = a << b
  assert_eq(c.v, 16)
}

#Test
fn test_op_overload_shr() {
  let a ShiftVal = ShiftVal::make(32)
  let b ShiftVal = ShiftVal::make(2)
  let c ShiftVal = a >> b
  assert_eq(c.v, 8)
}

; ==================== 一元 not ====================

struct Flag {
  on bool

  #Static
  fn make(on bool) Flag {
    ret Self {
      .on = on
    }
  }

  fn not() bool {
    !$.on
  }
}

#Test
fn test_op_overload_not() {
  let a Flag = Flag::make(true)
  let b Flag = Flag::make(false)
  assert_false(!a)
  assert_true(!b)
}
