; 类型推断 / 字面量提升行为测试
;
; 覆盖：
;   - 字面量自动提升到目标类型（u8 / i64 / u32）
;   - u8 变量重赋值与复合赋值
;   - 函数调用时实参字面量提升（add_u8(1, 2)）
;
; 已知缺口：泛型函数类型推断见 generic_call_turbofish.test.yux；
; 复杂表达式（含运算符链）的类型推断未覆盖。

fn add_u8(a u8, b u8) u8 = a + b

; 验证：u8 类型字面量的算术运算结果推断为 i32
#Test
fn test_u8_promote_literal() {
  let a u8 = 1 + 2
  assert_eq(a, 3)
}

; 验证：i64 类型默认整数字面量
#Test
fn test_i64_default_int_literal() {
  let b i64 = 100 + 200
  assert_eq(b, 300)
}

; 验证：u32 类型的混合运算结果
#Test
fn test_u32_mixed() {
  let c u32 = 5 * 3 + 1
  assert_eq(c, 16)
}

; 验证：u8 类型变量的赋值和运算
#Test
fn test_u8_var_assign() {
  #Mut let x u8 = 42
  assert_eq(x, 42)
  x = 10
  assert_eq(x, 10)
  x += 5
  assert_eq(x, 15)
}

; 验证：u8 类型加法函数正确性
#Test
fn test_call_u8() {
  assert_eq(add_u8(1, 2), 3)
}
