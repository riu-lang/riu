; 一元运算符用例
; 迁自 tests/cases/unary_ops.yux

#Test
fn test_neg_int() {
  let a = -10
  assert_eq(a, -10)
}

#Test
fn test_neg_float() {
  let b = -3.14
  assert_eq(b, -3.14)
}

#Test
fn test_bit_not() {
  ; ~5 = -6（二补码）
  let c = ~5
  assert_eq(c, -6)
}

#Test
fn test_logical_not_true() {
  assert_eq(!true, false)
}

#Test
fn test_logical_not_false() {
  assert_eq(!false, true)
}

; ==================== 按位取反 u8（迁自 bug_hunt） ====================

#Test
fn test_unary_inv_u8() {
  ; 验证：u8 按位取反 ~0x0F == 0xF0
  let a u8 = 0x0F
  let b u8 = ~a
  assert_eq(b, 0xF0)
}
