; 一元运算符行为测试
;
; 覆盖：
;   - `-` 取负：整数（i32）、浮点（f64）
;   - `~` 按位取反：i32、u8
;   - `!` 逻辑非：bool（true/false）
;
; 已知缺口：f32 取负未覆盖；isize/usize 一元运算未覆盖。
; 运算符重载的一元运算见 operator.test.yux / op_overload_ext.test.yux。

#Test
fn test_neg_int() {
  let a = -10
  assert_eq(a, -10)
}

; 验证：浮点数取负操作
#Test
fn test_neg_float() {
  let b = -3.14
  assert_eq(b, -3.14)
}

; 验证：按位取反操作符的正确性
#Test
fn test_bit_not() {
  ; ~5 = -6（二补码）
  let c = ~5
  assert_eq(c, -6)
}

; 验证：逻辑非运算符对真值的转换
#Test
fn test_logical_not_true() {
  assert_eq(!true, false)
}

; 验证：逻辑非运算符对假值的处理
#Test
fn test_logical_not_false() {
  assert_eq(!false, true)
}

; ==================== 按位取反 u8（迁自 bug_hunt） ====================

#Test
fn test_unary_inv_u8() {
  ; 验证：u8 按位取反 ~0x0F == 0xF0
  let a u8 = 0x0F
  let b u8 = ~a
  assert_eq(b, 0xF0)
}
