; struct 用例（迁自 tests/cases/struct_*、ctor_daa、generic_struct_byval、field_reassign_rc）
; 覆盖：基础构造与字段读、==/!= 重载、按值传参（平凡 + 含 RC 字段 + 泛型实例化）、
;       含 RC 字段 struct 整体赋值的 retain-then-release、字段重赋走 retain/release、
;       构造函数定性赋值分析（DAA）、运算符重载、析构函数。

; ---------- struct_test：基础构造 + 字段读 ----------

struct StPointF {
  x f64
  y f64
}

StPointF {
  fn StPointF(x f64, y f64) {
    $.x = x
    $.y = y
  }
}

#Test
fn test_struct_basic_fields() {
  let p = StPointF(1.0, 2.0)
  assert_eq(p.x, 1.0)
  assert_eq(p.y, 2.0)
}

; ---------- struct_eq_op：用户结构体 == / != 重载 ----------

struct Pt {
  x i32
  y i32
}

Pt {
  fn Pt(x i32, y i32) {
    $.x = x
    $.y = y
  }

  fn eq(other Pt&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Pt&) bool {
    !$.eq(&other)
  }
}

#Test
fn test_struct_eq_overload() {
  let a Pt = Pt(1i32, 2i32)
  let b Pt = Pt(1i32, 2i32)
  let c Pt = Pt(1i32, 9i32)
  let d Pt = Pt(9i32, 2i32)
  assert_true(a == b)
  assert_false(a == c)
  assert_false(a == d)
  assert_false(a != b)
  assert_true(a != c)
  assert_true(a != d)
}

; ---------- 共享：含 RC 字段的 struct ----------

struct StPair {
  a i32
  b i32
}

StPair {
  fn StPair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

struct StHolder {
  bx Rc<StPair>
  tag i32
}

StHolder {
  fn StHolder(bx Rc<StPair>, tag i32) {
    $.bx = bx
    $.tag = tag
  }
}

; ---------- struct_byval_param：平凡结构体 by-value 传参 ----------

struct StPointI {
  x i32
  y i32
}

StPointI {
  fn StPointI(x i32, y i32) {
    $.x = x
    $.y = y
  }
}

fn st_modify_byval(p StPointI) {
  p.x = 999i32
  p.y = 888i32
}

#Test
fn test_struct_byval_trivial_no_caller_change() {
  #Mut let pt StPointI = StPointI(10i32, 20i32)
  st_modify_byval(pt)
  ; 调用方原值不受影响
  assert_eq(pt.x, 10i32)
  assert_eq(pt.y, 20i32)
}

; ---------- struct_byval_rc：含 RC 字段 struct by-value 传参 ----------

fn st_observe_holder(h StHolder) i32 {
  ret h.bx.a + h.bx.b + h.tag
}

#Test
fn test_struct_byval_with_rc_field() {
  #Mut let p Rc<StPair> = StPair(11i32, 22i32)
  #Mut let h StHolder = StHolder(p, 7i32)
  ; observe 内对 RC 字段 retain，返回后 caller 仍可读
  assert_eq(st_observe_holder(h), 11i32 + 22i32 + 7i32)
  assert_eq(h.bx.a, 11i32)
  assert_eq(p.b, 22i32)
  assert_eq(h.tag, 7i32)
}

; ---------- generic_struct_byval：泛型 struct 实例 by-value 传参 ----------

struct StGenericHolder<T> {
  payload T
  tag i32
}

StGenericHolder<T> {
  fn StGenericHolder(payload T, tag i32) {
    $.payload = payload
    $.tag = tag
  }
}

fn st_observe_generic(h StGenericHolder<Rc<StPair>>) i32 {
  ret h.payload.a + h.payload.b + h.tag
}

#Test
fn test_struct_byval_generic_instance() {
  #Mut let p Rc<StPair> = StPair(11i32, 22i32)
  #Mut let h StGenericHolder<Rc<StPair>> = StGenericHolder:<Rc<StPair>>(p, 7i32)
  assert_eq(st_observe_generic(h), 11i32 + 22i32 + 7i32)
  assert_eq(h.payload.a, 11i32)
  assert_eq(p.b, 22i32)
  assert_eq(h.tag, 7i32)
}

; ---------- struct_assign_rc：含 RC 字段 struct 整体赋值 retain-then-release ----------

#Test
fn test_struct_whole_assign_rc() {
  #Mut let p Rc<StPair> = StPair(1i32, 2i32)
  #Mut let q Rc<StPair> = StPair(3i32, 4i32)
  #Mut let h1 StHolder = StHolder(p, 10i32)
  #Mut let h3 StHolder = StHolder(q, 30i32)
  #Mut let h2 StHolder = h1
  assert_eq(h2.bx.a, 1i32)
  assert_eq(h2.tag, 10i32)
  h2 = h3
  assert_eq(h2.bx.a, 3i32)
  assert_eq(h2.tag, 30i32)
  ; 自赋值
  h2 = h2
  assert_eq(h2.bx.b, 4i32)
  ; 来源仍可读
  assert_eq(h1.bx.a, 1i32)
  assert_eq(p.a, 1i32)
  assert_eq(q.b, 4i32)
}

; ---------- field_reassign_rc：字段重赋值 retain-then-release ----------

#Test
fn test_struct_field_reassign_rc() {
  #Mut let p Rc<StPair> = StPair(11i32, 22i32)
  #Mut let q Rc<StPair> = StPair(33i32, 44i32)
  #Mut let h StHolder = StHolder(p, 7i32)
  assert_eq(h.bx.a, 11i32)
  assert_eq(h.bx.b, 22i32)
  h.bx = q
  assert_eq(h.bx.a, 33i32)
  assert_eq(h.bx.b, 44i32)
  ; p 仍由 main 持有
  assert_eq(p.a, 11i32)
  assert_eq(q.b, 44i32)
}

; ---------- ctor_daa：构造函数定性赋值分析 ----------

struct DaaPoint {
  x i32
  y i32
}

DaaPoint {
  fn DaaPoint(x i32, y i32) {
    $.x = x
    ; RHS 读已 Init 字段
    $.y = $.x + y
  }
}

struct DaaTagged {
  tag i32
  bx Rc<DaaPoint>
}

DaaTagged {
  fn DaaTagged(t i32, p Rc<DaaPoint>) {
    $.tag = t
    $.bx = p
  }
}

struct DaaBranchy {
  v i32
  w i32
}

DaaBranchy {
  fn DaaBranchy(c bool, a i32, b i32) {
    if c {
      $.v = a
      $.w = a + 1i32
    } else {
      $.v = b
      $.w = b - 1i32
    }
  }
}

#Test
fn test_ctor_daa_rhs_reads_init_field() {
  let p = DaaPoint(10i32, 5i32)
  assert_eq(p.x, 10i32)
  assert_eq(p.y, 15i32)
}

#Test
fn test_ctor_daa_with_box_field() {
  #Mut let bp Rc<DaaPoint> = DaaPoint(100i32, 200i32)
  let tg = DaaTagged(7i32, bp)
  assert_eq(tg.tag, 7i32)
  assert_eq(tg.bx.x, 100i32)
}

#Test
fn test_ctor_daa_branch_full_init() {
  let b1 = DaaBranchy(true, 3i32, 0i32)
  assert_eq(b1.v, 3i32)
  assert_eq(b1.w, 4i32)

  let b2 = DaaBranchy(false, 0i32, 50i32)
  assert_eq(b2.v, 50i32)
  assert_eq(b2.w, 49i32)
}

; ==================== 运算符重载 ====================

; ---------- 算术运算符重载 ----------

struct Vec2 {
  x i32
  y i32
}

Vec2 {
  fn Vec2(x i32, y i32) {
    $.x = x
    $.y = y
  }

  fn plus(other Vec2&) Vec2 {
    Vec2($.x + other.x, $.y + other.y)
  }

  fn minus(other Vec2&) Vec2 {
    Vec2($.x - other.x, $.y - other.y)
  }

  fn mul(other Vec2&) Vec2 {
    Vec2($.x * other.x, $.y * other.y)
  }

  fn neg() Vec2 {
    Vec2(-$.x, -$.y)
  }
}

#Test
fn test_op_overload_plus() {
  let a Vec2 = Vec2(1i32, 2i32)
  let b Vec2 = Vec2(3i32, 4i32)
  let c Vec2 = a + b
  assert_eq(c.x, 4i32)
  assert_eq(c.y, 6i32)
}

#Test
fn test_op_overload_minus() {
  let a Vec2 = Vec2(10i32, 20i32)
  let b Vec2 = Vec2(3i32, 4i32)
  let c Vec2 = a - b
  assert_eq(c.x, 7i32)
  assert_eq(c.y, 16i32)
}

#Test
fn test_op_overload_mul() {
  let a Vec2 = Vec2(2i32, 3i32)
  let b Vec2 = Vec2(4i32, 5i32)
  let c Vec2 = a * b
  assert_eq(c.x, 8i32)
  assert_eq(c.y, 15i32)
}

#Test
fn test_op_overload_neg() {
  let a Vec2 = Vec2(5i32, -3i32)
  let b Vec2 = -a
  assert_eq(b.x, -5i32)
  assert_eq(b.y, 3i32)
}

#Test
fn test_op_overload_chain() {
  let a Vec2 = Vec2(1i32, 2i32)
  let b Vec2 = Vec2(3i32, 4i32)
  let c Vec2 = Vec2(5i32, 6i32)
  let d Vec2 = a + b + c
  assert_eq(d.x, 9i32)
  assert_eq(d.y, 12i32)
}

; ---------- 比较运算符重载 ----------

struct OrderedPoint {
  x i32
  y i32
}

OrderedPoint {
  fn OrderedPoint(x i32, y i32) {
    $.x = x
    $.y = y
  }

  fn eq(other OrderedPoint&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other OrderedPoint&) bool {
    !$.eq(&other)
  }

  fn lt(other OrderedPoint&) bool {
    $.x < other.x || ($.x == other.x && $.y < other.y)
  }

  fn le(other OrderedPoint&) bool {
    $.lt(&other) || $.eq(&other)
  }

  fn gt(other OrderedPoint&) bool {
    !$.le(&other)
  }

  fn ge(other OrderedPoint&) bool {
    !$.lt(&other)
  }
}

#Test
fn test_op_overload_eq_ne() {
  let a OrderedPoint = OrderedPoint(1i32, 2i32)
  let b OrderedPoint = OrderedPoint(1i32, 2i32)
  let c OrderedPoint = OrderedPoint(1i32, 3i32)
  assert_true(a == b)
  assert_false(a == c)
  assert_false(a != b)
  assert_true(a != c)
}

#Test
fn test_op_overload_lt() {
  let a OrderedPoint = OrderedPoint(1i32, 2i32)
  let b OrderedPoint = OrderedPoint(2i32, 1i32)
  let c OrderedPoint = OrderedPoint(1i32, 3i32)
  assert_true(a < b)
  assert_true(a < c)
  assert_false(b < a)
}

#Test
fn test_op_overload_le() {
  let a OrderedPoint = OrderedPoint(1i32, 2i32)
  let b OrderedPoint = OrderedPoint(1i32, 2i32)
  let c OrderedPoint = OrderedPoint(2i32, 1i32)
  assert_true(a <= b)
  assert_true(a <= c)
  assert_false(c <= a)
}

#Test
fn test_op_overload_gt() {
  let a OrderedPoint = OrderedPoint(2i32, 1i32)
  let b OrderedPoint = OrderedPoint(1i32, 2i32)
  assert_true(a > b)
  assert_false(b > a)
}

#Test
fn test_op_overload_ge() {
  let a OrderedPoint = OrderedPoint(1i32, 2i32)
  let b OrderedPoint = OrderedPoint(1i32, 2i32)
  let c OrderedPoint = OrderedPoint(1i32, 1i32)
  assert_true(a >= b)
  assert_true(a >= c)
  assert_false(c >= a)
}

; ---------- 位运算符重载 ----------

struct BitFlags {
  bits u32
}

BitFlags {
  fn BitFlags(bits u32) {
    $.bits = bits
  }

  fn and(other BitFlags&) BitFlags {
    BitFlags($.bits & other.bits)
  }

  fn or(other BitFlags&) BitFlags {
    BitFlags($.bits | other.bits)
  }

  fn xor(other BitFlags&) BitFlags {
    BitFlags($.bits ^ other.bits)
  }

  fn inv() BitFlags {
    BitFlags(~$.bits)
  }
}

#Test
fn test_op_overload_bit_and() {
  let a BitFlags = BitFlags(0xFFu32)
  let b BitFlags = BitFlags(0x0Fu32)
  let c BitFlags = a & b
  assert_eq(c.bits, 0x0Fu32)
}

#Test
fn test_op_overload_bit_or() {
  let a BitFlags = BitFlags(0xF0u32)
  let b BitFlags = BitFlags(0x0Fu32)
  let c BitFlags = a | b
  assert_eq(c.bits, 0xFFu32)
}

#Test
fn test_op_overload_bit_xor() {
  let a BitFlags = BitFlags(0xFFu32)
  let b BitFlags = BitFlags(0x0Fu32)
  let c BitFlags = a ^ b
  assert_eq(c.bits, 0xF0u32)
}

#Test
fn test_op_overload_bit_inv() {
  let a BitFlags = BitFlags(0x00u32)
  let b BitFlags = ~a
  assert_eq(b.bits, 0xFFFFFFFFu32)
}

; ==================== 析构函数 ====================
; 注：当前编译器限制，无法在析构函数中访问嵌套成员
; 这里仅测试析构函数的基本定义和调用

struct SimpleDtor {
  value i32
}

SimpleDtor {
  fn ~() {
    ; 析构函数被调用时执行清理
    ; 当前仅验证编译通过，运行时不崩溃
  }

  fn SimpleDtor(value i32) {
    $.value = value
  }
}

#Test
fn test_dtor_basic() {
  #Mut let d SimpleDtor = SimpleDtor(42)
  assert_eq(d.value, 42i32)
  ; d 离开作用域时析构函数自动调用
}

#Test
fn test_dtor_multiple() {
  #Mut let d1 SimpleDtor = SimpleDtor(1)
  #Mut let d2 SimpleDtor = SimpleDtor(2)
  assert_eq(d1.value, 1i32)
  assert_eq(d2.value, 2i32)
  ; d1, d2 离开作用域时析构函数依次调用
}

#Test
fn test_dtor_nested_scope() {
  {
    #Mut let d SimpleDtor = SimpleDtor(100)
    assert_eq(d.value, 100i32)
  }
  ; d 在内层作用域结束时析构
  assert_true(true)
}

; ==================== 嵌套 struct ====================
; 注：当前编译器限制，嵌套成员赋值不支持

struct InnerStruct {
  value i32
}

InnerStruct {
  fn InnerStruct(value i32) {
    $.value = value
  }
}

struct OuterStruct {
  inner InnerStruct
  tag i32
}

OuterStruct {
  fn OuterStruct(value i32, tag i32) {
    $.inner = InnerStruct(value)
    $.tag = tag
  }
}

#Test
fn test_nested_struct_access() {
  let o OuterStruct = OuterStruct(42i32, 7i32)
  assert_eq(o.inner.value, 42i32)
  assert_eq(o.tag, 7i32)
}

; ==================== struct 方法链式调用 ====================

struct FluentBuilder {
  sum i32
}

FluentBuilder {
  fn FluentBuilder() {
    $.sum = 0i32
  }

  fn add(n i32) FluentBuilder {
    $.sum = $.sum + n
    ret $
  }

  fn get() i32 {
    ret $.sum
  }
}

#Test
fn test_method_chain() {
  let b FluentBuilder = FluentBuilder()
  let result i32 = b.add(1).add(2).add(3).get()
  assert_eq(result, 6i32)
}
