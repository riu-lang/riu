; struct 用例（迁自 tests/cases/struct_*、ctor_daa、generic_struct_byval、field_reassign_rc）
; 覆盖：基础构造与字段读、==/!= 重载、按值传参（平凡 + 含 RC 字段 + 泛型实例化）、
;       含 RC 字段 struct 整体赋值的 retain-then-release、字段重赋走 retain/release、
;       构造函数定性赋值分析（DAA）、运算符重载、析构函数。

; ---------- struct_test：基础构造 + 字段读 ----------

struct StPointF {
  x f64
  y f64
}

StPointF {
  #Static
  fn make(x f64, y f64) StPointF {
    ret Self {
      .x = x
      .y = y
    }
  }
}

#Test
fn test_struct_basic_fields() {
  let p = StPointF::make(1.0, 2.0)
  assert_eq(p.x, 1.0)
  assert_eq(p.y, 2.0)
}

; ---------- struct_eq_op：用户结构体 == / != 重载 ----------

struct Pt {
  x i32
  y i32
}

Pt {
  #Static
  fn make(x i32, y i32) Pt {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn eq(other Pt&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Pt&) bool {
    !$.eq(&other)
  }
}

#Test
fn test_struct_eq_overload() {
  let a Pt = Pt::make(1i32, 2i32)
  let b Pt = Pt::make(1i32, 2i32)
  let c Pt = Pt::make(1i32, 9i32)
  let d Pt = Pt::make(9i32, 2i32)
  assert_true(a == b)
  assert_false(a == c)
  assert_false(a == d)
  assert_false(a != b)
  assert_true(a != c)
  assert_true(a != d)
}

; ---------- 共享：含 RC 字段的 struct ----------

struct StPair {
  a i32
  b i32
}

StPair {
  #Static
  fn make(a i32, b i32) StPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

struct StHolder {
  bx Rc<StPair>
  tag i32
}

StHolder {
  #Static
  fn make(bx Rc<StPair>, tag i32) StHolder {
    ret Self {
      .bx = bx
      .tag = tag
    }
  }
}

; ---------- struct_byval_param：平凡结构体 by-value 传参 ----------

struct StPointI {
  x i32
  y i32
}

StPointI {
  #Static
  fn make(x i32, y i32) StPointI {
    ret Self {
      .x = x
      .y = y
    }
  }
}

fn st_modify_byval(p StPointI) {
  p.x = 999i32
  p.y = 888i32
}

#Test
fn test_struct_byval_trivial_no_caller_change() {
  #Mut let pt StPointI = StPointI::make(10i32, 20i32)
  st_modify_byval(pt)
  ; 调用方原值不受影响
  assert_eq(pt.x, 10i32)
  assert_eq(pt.y, 20i32)
}

; ---------- struct_byval_rc：含 RC 字段 struct by-value 传参 ----------

fn st_observe_holder(h StHolder) i32 {
  ret h.bx.a + h.bx.b + h.tag
}

#Test
fn test_struct_byval_with_rc_field() {
  #Mut let p Rc<StPair> = StPair::make(11i32, 22i32)
  #Mut let h StHolder = StHolder::make(p, 7i32)
  ; observe 内对 RC 字段 retain，返回后 caller 仍可读
  assert_eq(st_observe_holder(h), 11i32 + 22i32 + 7i32)
  assert_eq(h.bx.a, 11i32)
  assert_eq(p.b, 22i32)
  assert_eq(h.tag, 7i32)
}

