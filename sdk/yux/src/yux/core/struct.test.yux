; struct 用例（迁自 tests/cases/struct_*、ctor_daa、generic_struct_byval、field_reassign_rc）
; 覆盖：基础构造与字段读、==/!= 重载、按值传参（平凡 + 含 RC 字段 + 泛型实例化）、
;       含 RC 字段 struct 整体赋值的 retain-then-release、字段重赋走 retain/release、
;       构造函数定性赋值分析（DAA）、运算符重载、析构函数。

; ---------- struct_test：基础构造 + 字段读 ----------

struct StPointF {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) StPointF {
    ret Self {
      .x = x
      .y = y
    }
  }
}

#Test
fn test_struct_basic_fields() {
  let p = StPointF::make(1.0, 2.0)
  assert_eq(p.x, 1.0)
  assert_eq(p.y, 2.0)
}

; ---------- struct_eq_op：用户结构体 == / != 重载 ----------

struct Pt {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Pt {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn eq(other Pt&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Pt&) bool {
    !$.eq(&other)
  }
}

#Test
fn test_struct_eq_overload() {
  let a Pt = Pt::make(1, 2)
  let b Pt = Pt::make(1, 2)
  let c Pt = Pt::make(1, 9)
  let d Pt = Pt::make(9, 2)
  assert_true(a == b)
  assert_false(a == c)
  assert_false(a == d)
  assert_false(a != b)
  assert_true(a != c)
  assert_true(a != d)
}

; ---------- 共享：含 RC 字段的 struct ----------

struct StPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) StPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

struct StHolder {
  bx Rc<StPair>
  tag i32

  #Static
  fn make(bx Rc<StPair>, tag i32) StHolder {
    ret Self {
      .bx = bx
      .tag = tag
    }
  }
}

; ---------- struct_byval_param：平凡结构体 by-value 传参 ----------

struct StPointI {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) StPointI {
    ret Self {
      .x = x
      .y = y
    }
  }
}

fn st_modify_byval(p StPointI) {
  p.x = 999
  p.y = 888
}

#Test
fn test_struct_byval_trivial_no_caller_change() {
  #Mut let pt StPointI = StPointI::make(10, 20)
  st_modify_byval(pt)
  ; 调用方原值不受影响
  assert_eq(pt.x, 10)
  assert_eq(pt.y, 20)
}

; ---------- struct_byval_rc：含 RC 字段 struct by-value 传参 ----------

fn st_observe_holder(h StHolder) i32 {
  ret h.bx.a + h.bx.b + h.tag
}

#Test
fn test_struct_byval_with_rc_field() {
  #Mut let p Rc<StPair> = StPair::make(11, 22)
  #Mut let h StHolder = StHolder::make(p, 7)
  ; observe 内对 RC 字段 retain，返回后 caller 仍可读
  assert_eq(st_observe_holder(h), 11 + 22 + 7)
  assert_eq(h.bx.a, 11)
  assert_eq(p.b, 22)
  assert_eq(h.tag, 7)
}

; ---------- generic_struct_byval：泛型 struct 实例 by-value 传参 ----------

struct StGenericHolder<T> {
  payload T
  tag i32

  #Static
  fn make(payload T, tag i32) Self {
    Self {
      .payload = payload
      .tag = tag
    }
  }
}

fn st_observe_generic(h StGenericHolder<Rc<StPair>>) i32 {
  ret h.payload.a + h.payload.b + h.tag
}

#Test
fn test_struct_byval_generic_instance() {
  #Mut let p Rc<StPair> = StPair::make(11, 22)
  #Mut let h StGenericHolder<Rc<StPair>> = StGenericHolder:<Rc<StPair>>::make(p, 7)
  assert_eq(st_observe_generic(h), 11 + 22 + 7)
  assert_eq(h.payload.a, 11)
  assert_eq(p.b, 22)
  assert_eq(h.tag, 7)
}

; ---------- struct_assign_rc：含 RC 字段 struct 整体赋值 retain-then-release ----------

#Test
fn test_struct_whole_assign_rc() {
  #Mut let p Rc<StPair> = StPair::make(1, 2)
  #Mut let q Rc<StPair> = StPair::make(3, 4)
  #Mut let h1 StHolder = StHolder::make(p, 10)
  #Mut let h3 StHolder = StHolder::make(q, 30)
  #Mut let h2 StHolder = h1
  assert_eq(h2.bx.a, 1)
  assert_eq(h2.tag, 10)
  h2 = h3
  assert_eq(h2.bx.a, 3)
  assert_eq(h2.tag, 30)
  ; 自赋值
  h2 = h2
  assert_eq(h2.bx.b, 4)
  ; 来源仍可读
  assert_eq(h1.bx.a, 1)
  assert_eq(p.a, 1)
  assert_eq(q.b, 4)
}

; ---------- field_reassign_rc：字段重赋值 retain-then-release ----------

#Test
fn test_struct_field_reassign_rc() {
  #Mut let p Rc<StPair> = StPair::make(11, 22)
  #Mut let q Rc<StPair> = StPair::make(33, 44)
  #Mut let h StHolder = StHolder::make(p, 7)
  assert_eq(h.bx.a, 11)
  assert_eq(h.bx.b, 22)
  h.bx = q
  assert_eq(h.bx.a, 33)
  assert_eq(h.bx.b, 44)
  ; p 仍由 main 持有
  assert_eq(p.a, 11)
  assert_eq(q.b, 44)
}

; ---------- ctor_daa：构造函数定性赋值分析 ----------

struct DaaPoint {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) DaaPoint {
    ret Self {
      .x = x
      ; Self { ... } 中 .y RHS 直接读形参 x, 不依赖已 init 字段
      .y = x + y
    }
  }
}

struct DaaTagged {
  tag i32
  bx Rc<DaaPoint>

  #Static
  fn make(t i32, p Rc<DaaPoint>) DaaTagged {
    ret Self {
      .tag = t
      .bx = p
    }
  }
}

struct DaaBranchy {
  v i32
  w i32

  #Static
  fn make(c bool, a i32, b i32) DaaBranchy {
    if c {
      ret Self {
        .v = a
        .w = a + 1
      }
    }
    ret Self {
      .v = b
      .w = b - 1
    }
  }
}

#Test
fn test_ctor_daa_rhs_reads_init_field() {
  let p = DaaPoint::make(10, 5)
  assert_eq(p.x, 10)
  assert_eq(p.y, 15)
}

#Test
fn test_ctor_daa_with_box_field() {
  #Mut let bp Rc<DaaPoint> = DaaPoint::make(100, 200)
  let tg = DaaTagged::make(7, bp)
  assert_eq(tg.tag, 7)
  assert_eq(tg.bx.x, 100)
}

#Test
fn test_ctor_daa_branch_full_init() {
  let b1 = DaaBranchy::make(true, 3, 0)
  assert_eq(b1.v, 3)
  assert_eq(b1.w, 4)

  let b2 = DaaBranchy::make(false, 0, 50)
  assert_eq(b2.v, 50)
  assert_eq(b2.w, 49)
}

; ==================== 运算符重载 ====================

; ---------- 算术运算符重载 ----------

struct Vec2 {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn plus(other Vec2&) Vec2 {
    Vec2::make($.x + other.x, $.y + other.y)
  }

  fn minus(other Vec2&) Vec2 {
    Vec2::make($.x - other.x, $.y - other.y)
  }

  fn mul(other Vec2&) Vec2 {
    Vec2::make($.x * other.x, $.y * other.y)
  }

  fn neg() Vec2 {
    Vec2::make(-$.x, -$.y)
  }
}

#Test
fn test_op_overload_plus() {
  let a Vec2 = Vec2::make(1, 2)
  let b Vec2 = Vec2::make(3, 4)
  let c Vec2 = a + b
  assert_eq(c.x, 4)
  assert_eq(c.y, 6)
}

#Test
fn test_op_overload_minus() {
  let a Vec2 = Vec2::make(10, 20)
  let b Vec2 = Vec2::make(3, 4)
  let c Vec2 = a - b
  assert_eq(c.x, 7)
  assert_eq(c.y, 16)
}

#Test
fn test_op_overload_mul() {
  let a Vec2 = Vec2::make(2, 3)
  let b Vec2 = Vec2::make(4, 5)
  let c Vec2 = a * b
  assert_eq(c.x, 8)
  assert_eq(c.y, 15)
}

#Test
fn test_op_overload_neg() {
  let a Vec2 = Vec2::make(5, -3)
  let b Vec2 = -a
  assert_eq(b.x, -5)
  assert_eq(b.y, 3)
}

#Test
fn test_op_overload_chain() {
  let a Vec2 = Vec2::make(1, 2)
  let b Vec2 = Vec2::make(3, 4)
  let c Vec2 = Vec2::make(5, 6)
  let d Vec2 = a + b + c
  assert_eq(d.x, 9)
  assert_eq(d.y, 12)
}

; ---------- 比较运算符重载 ----------

struct OrderedPoint {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) OrderedPoint {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn eq(other OrderedPoint&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other OrderedPoint&) bool {
    !$.eq(&other)
  }

  fn lt(other OrderedPoint&) bool {
    $.x < other.x || ($.x == other.x && $.y < other.y)
  }

  fn le(other OrderedPoint&) bool {
    $.lt(&other) || $.eq(&other)
  }

  fn gt(other OrderedPoint&) bool {
    !$.le(&other)
  }

  fn ge(other OrderedPoint&) bool {
    !$.lt(&other)
  }
}

#Test
fn test_op_overload_eq_ne() {
  let a OrderedPoint = OrderedPoint::make(1, 2)
  let b OrderedPoint = OrderedPoint::make(1, 2)
  let c OrderedPoint = OrderedPoint::make(1, 3)
  assert_true(a == b)
  assert_false(a == c)
  assert_false(a != b)
  assert_true(a != c)
}

#Test
fn test_op_overload_lt() {
  let a OrderedPoint = OrderedPoint::make(1, 2)
  let b OrderedPoint = OrderedPoint::make(2, 1)
  let c OrderedPoint = OrderedPoint::make(1, 3)
  assert_true(a < b)
  assert_true(a < c)
  assert_false(b < a)
}

#Test
fn test_op_overload_le() {
  let a OrderedPoint = OrderedPoint::make(1, 2)
  let b OrderedPoint = OrderedPoint::make(1, 2)
  let c OrderedPoint = OrderedPoint::make(2, 1)
  assert_true(a <= b)
  assert_true(a <= c)
  assert_false(c <= a)
}

#Test
fn test_op_overload_gt() {
  let a OrderedPoint = OrderedPoint::make(2, 1)
  let b OrderedPoint = OrderedPoint::make(1, 2)
  assert_true(a > b)
  assert_false(b > a)
}

#Test
fn test_op_overload_ge() {
  let a OrderedPoint = OrderedPoint::make(1, 2)
  let b OrderedPoint = OrderedPoint::make(1, 2)
  let c OrderedPoint = OrderedPoint::make(1, 1)
  assert_true(a >= b)
  assert_true(a >= c)
  assert_false(c >= a)
}

; ---------- 位运算符重载 ----------

struct BitFlags {
  bits u32

  #Static
  fn make(bits u32) BitFlags {
    ret Self {
      .bits = bits
    }
  }

  fn and(other BitFlags&) BitFlags {
    BitFlags::make($.bits & other.bits)
  }

  fn or(other BitFlags&) BitFlags {
    BitFlags::make($.bits | other.bits)
  }

  fn xor(other BitFlags&) BitFlags {
    BitFlags::make($.bits ^ other.bits)
  }

  fn inv() BitFlags {
    BitFlags::make(~$.bits)
  }
}

#Test
fn test_op_overload_bit_and() {
  let a BitFlags = BitFlags::make(0xFFu32)
  let b BitFlags = BitFlags::make(0x0Fu32)
  let c BitFlags = a & b
  assert_eq(c.bits, 0x0Fu32)
}

#Test
fn test_op_overload_bit_or() {
  let a BitFlags = BitFlags::make(0xF0u32)
  let b BitFlags = BitFlags::make(0x0Fu32)
  let c BitFlags = a | b
  assert_eq(c.bits, 0xFFu32)
}

#Test
fn test_op_overload_bit_xor() {
  let a BitFlags = BitFlags::make(0xFFu32)
  let b BitFlags = BitFlags::make(0x0Fu32)
  let c BitFlags = a ^ b
  assert_eq(c.bits, 0xF0u32)
}

#Test
fn test_op_overload_bit_inv() {
  let a BitFlags = BitFlags::make(0x00u32)
  let b BitFlags = ~a
  assert_eq(b.bits, 0xFFFFFFFFu32)
}

; ==================== 析构函数 ====================
; 验证 fn ~() 析构函数被正确编译和调用（BUG3 修复）

; SimpleDtor：仅标量字段 + 显式析构
; BUG3 修复前 structNeedsDestructor 对仅含标量的 struct 返回 false，
; 导致 fn ~() 体永不被调用；修复后析构函数正常执行
struct SimpleDtor {
  value i32

  fn ~() {
    ; 析构函数体 —— 修复后会被 codegen 调用
    ; 调试时可加 println 观察执行
  }

  #Static
  fn make(value i32) SimpleDtor {
    ret Self {
      .value = value
    }
  }
}

#Test
fn test_dtor_basic() {
  #Mut let d SimpleDtor = SimpleDtor::make(42)
  assert_eq(d.value, 42)
  ; d 离开作用域时 fn ~() 体执行，然后字段级析构（i32 无需析构，等价 no-op）
}

#Test
fn test_dtor_multiple() {
  #Mut let d1 SimpleDtor = SimpleDtor::make(1)
  #Mut let d2 SimpleDtor = SimpleDtor::make(2)
  assert_eq(d1.value, 1)
  assert_eq(d2.value, 2)
  ; d2, d1 离开作用域时析构函数逆序调用
}

#Test
fn test_dtor_nested_scope() {
  {
    #Mut let d SimpleDtor = SimpleDtor::make(100)
    assert_eq(d.value, 100)
  }
  ; d 在内层作用域结束时析构
  assert_true(true)
}

; ==================== 嵌套 struct ====================
; 注：当前编译器限制，嵌套成员赋值不支持

struct InnerStruct {
  value i32

  #Static
  fn make(value i32) InnerStruct {
    ret Self {
      .value = value
    }
  }
}

struct OuterStruct {
  inner InnerStruct
  tag i32

  #Static
  fn make(value i32, tag i32) OuterStruct {
    ret Self {
      .inner = InnerStruct::make(value)
      .tag = tag
    }
  }
}

#Test
fn test_nested_struct_access() {
  let o OuterStruct = OuterStruct::make(42, 7)
  assert_eq(o.inner.value, 42)
  assert_eq(o.tag, 7)
}

; ==================== struct 方法链式调用 ====================

struct FluentBuilder {
  sum i32

  #Static
  fn make() FluentBuilder {
    ret Self {
      .sum = 0
    }
  }

  fn add(n i32) FluentBuilder {
    $.sum = $.sum + n
    ret $
  }

  fn get() i32 {
    ret $.sum
  }
}

#Test
fn test_method_chain() {
  let b FluentBuilder = FluentBuilder::make()
  let result i32 = b.add(1).add(2).add(3).get()
  assert_eq(result, 6)
}
