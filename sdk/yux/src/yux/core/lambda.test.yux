; lambda 测试套件
; 迁自 tests/cases/lambda_call_*.yux, lambda_type_*.yux, lambda_closure_*.yux
;
; 本文件包含 lambda 相关测试:
; - IIFE（立即调用 lambda）
; - lambda 作实参传给高阶 fn
; - fn 值作返回类型
; - struct 含 fn 字段
; - Array<fn> 元素调用
; - Rc<fn> 调用
; - fn 类型声明与别名
; - lambda 闭包捕获

; ==================== 类型别名 ====================

Callback = fn(s String)bool
Pred<T> = fn(x T)bool
Op2<A, B> = fn(a A, b B)A

; ==================== 辅助函数 ====================

fn apply(f fn(i32)i32, x i32) i32 {
  ret f(x)
}

fn apply0(f fn()i32) i32 {
  ret f()
}

fn run_twice(f fn(i32)i32, x i32) i32 {
  ret f(x) + f(x + 1)
}

fn forward(g fn(i32)i32, y i32) i32 {
  ret run_twice(g, y)
}

fn make_inc() fn(i32)i32 {
  ret (x i32) i32 => x + 1
}

fn make_const(v i32) fn(i32)i32 {
  ret (x i32) i32 => x * 2
}

fn make_adder(n i32) fn(i32)i32 {
  ret (x i32) i32 => x + n
}

fn run_first(a Array<fn(i32)i32>, x i32) i32 {
  ret a[0](x)
}

fn first(a Array<i32>) i32 {
  ret a[0]
}

; ==================== struct Holder ====================

struct Holder {
  h fn(i32)i32
  base i32
}

Holder {
  #Static
  fn make(h fn(i32)i32, base i32) Holder {
    ret Self {
      .h = h
      .base = base
    }
  }

  fn run(x i32) i32 {
    ret $.h(x) + $.base
  }

  fn set(h fn(i32)i32) {
    $.h = h
    ret;
  }
}

fn call_h_by_value(s Holder, x i32) i32 {
  ret s.h(x)
}

; ==================== struct Cell ====================

struct Cell {
  n i32
}

Cell {
  #Static
  fn make(n i32) Cell {
    ret Self {
      .n = n
    }
  }
  fn get() i32 {
    ret $.n
  }
}

; ==================== struct Counter ====================

struct Counter {
  value i32
}

Counter {
  #Static
  fn make(v i32) Counter {
    ret Self {
      .value = v
    }
  }

  fn double() i32 {
    ret $.value * 2
  }

  fn add_then_apply(x i32) i32 {
    ret apply((y i32) i32 => $.value + y, x)
  }

  fn triple_apply() i32 {
    #Mut let s i32 = 0
    s = s + apply0(() i32 => $.value)
    s = s + apply0(() i32 => $.value * 2)
    s = s + apply0(() i32 => $.double())
    ret s
  }
}

; ==================== IIFE 测试 ====================

#Test
fn test_iife_single_param() {
  let r = ((x i32) i32 => x + 1)(5)
  assert_eq(r, 6)
}

#Test
fn test_iife_multi_param() {
  let r = ((a, b i32) i32 => a + b)(3, 4)
  assert_eq(r, 7)
}

; ==================== lambda 变量调用测试 ====================

#Test
fn test_lambda_var_call() {
  #Mut let f fn(i32)i32 = (x i32) i32 => x * 2
  assert_eq(f(7), 14)
  assert_eq(f(0), 0)
  assert_eq(f(21), 42)
}

; ==================== lambda 作实参测试 ====================

#Test
fn test_lambda_as_arg_explicit() {
  let r = apply((x i32) i32 => x + 10, 5)
  assert_eq(r, 15)
}

#Test
fn test_lambda_as_arg_inferred() {
  let r = apply(x => x * x, 6)
  assert_eq(r, 36)
}

; ==================== lambda 作返回值测试 ====================

#Test
fn test_lambda_return() {
  #Mut let f fn(i32)i32 = make_inc()
  assert_eq(f(10), 11)
  assert_eq(f(99), 100)
}

#Test
fn test_lambda_return_chained() {
  let r = make_inc()(41)
  assert_eq(r, 42)
}

#Test
fn test_lambda_return_const() {
  #Mut let g fn(i32)i32 = make_const(0)
  assert_eq(g(7), 14)
}

; ==================== lambda 参数传递测试 ====================

#Test
fn test_lambda_param_pass() {
  #Mut let inc fn(i32)i32 = (x i32) i32 => x + 1
  #Mut let r1 = forward(inc, 10)
  assert_eq(r1, 23)

  #Mut let r2 = forward((x i32) i32 => x * 2, 3)
  assert_eq(r2, 14)
}

; ==================== struct fn 字段测试 ====================

#Test
fn test_struct_fn_field() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  assert_eq(s.run(5), 106)
  assert_eq(s.h(10), 11)
}

#Test
fn test_struct_fn_field_reassign() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  s.set((x i32) i32 => x * 3)
  assert_eq(s.h(4), 12)
}

#Test
fn test_struct_fn_field_by_value() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  let r = call_h_by_value(s, 7)
  assert_eq(r, 8)
}

#Test
fn test_struct_fn_field_whole_reassign() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  #Mut let s2 Holder = Holder::make((x i32) i32 => x - 1, 0)
  s = s2
  assert_eq(s.h(50), 49)
}

; ==================== Array<fn> 测试 ====================

#Test
fn test_array_fn_elem() {
  #Mut let arr Array<fn(i32)i32> = []
  arr.push(make_inc())
  arr.push((x i32) i32 => x * 2)
  arr.push((x i32) i32 => x - 5)

  assert_eq(arr.len(), 3i64)
  assert_eq(arr[0](10), 11)
  assert_eq(arr[1](10), 20)
  assert_eq(arr[2](10), 5)
}

#Test
fn test_array_fn_elem_by_value() {
  #Mut let arr Array<fn(i32)i32> = []
  arr.push(make_inc())

  let r = run_first(arr, 100)
  assert_eq(r, 101)
}

#Test
fn test_array_fn_elem_reassign() {
  #Mut let arr Array<fn(i32)i32> = []
  arr.push(make_inc())

  arr[0] = (x i32) i32 => x + 1000
  assert_eq(arr[0](1), 1001)
}

; ==================== Rc<fn> 测试 ====================

#Test
fn test_box_fn_call() {
  #Mut let b Rc<fn(i32)i32> = (x i32) i32 => x + 100
  assert_eq(b(5), 105)
  assert_eq(b(10), 110)
}

#Test
fn test_box_fn_copy() {
  #Mut let b Rc<fn(i32)i32> = (x i32) i32 => x + 100
  #Mut let b2 Rc<fn(i32)i32> = b
  assert_eq(b2(7), 107)
}

#Test
fn test_box_fn_reassign() {
  #Mut let b Rc<fn(i32)i32> = (x i32) i32 => x + 100
  #Mut let b2 Rc<fn(i32)i32> = b

  b = (x i32) i32 => x * 3
  assert_eq(b(4), 12)
  assert_eq(b2(20), 120)
}

; ==================== 0 参块 lambda tail-expr 返回（BUG#0 修复） ====================

#Test
fn test_zero_block_tail_expr_return() {
  let once fn()i32 = {
    42
  }
  assert_eq(once(), 42)
}

#Test
fn test_zero_block_tail_expr_with_prelude() {
  let f fn()i32 = {
    #Mut let a = 3
    #Mut let b = 4
    a + b
  }
  assert_eq(f(), 7)
}

#Test
fn test_zero_block_propagates_via_arg() {
  let seven fn()i32 = {
    7
  }
  assert_eq(apply0(seven), 7)
}

; ==================== fn 类型声明测试 ====================

#Test
fn test_fn_type_decl() {
  #Mut let a fn()
  #Mut let b fn()i32
  #Mut let c fn(i32)i32
  #Mut let d fn(x i32)i32
  #Mut let e fn(a, b i32)i32
  #Mut let f fn(g fn(i32)i32)i32
  #Mut let h fn()fn(i32)i32

  assert_true(true)
}

#Test
fn test_fn_type_alias() {
  #Mut let c Callback
  #Mut let pi Pred<i32>
  #Mut let ps Pred<String>
  #Mut let op Op2<i32, i32>
  #Mut let nested Pred<fn()i32>

  assert_true(true)
}

#Test
fn test_fn_type_equiv() {
  #Mut let x fn(s String)bool
  #Mut let c Callback = x
  #Mut let y Callback
  #Mut let z fn(s String)bool = y

  #Mut let a fn(a i32, b i32)i32
  #Mut let b fn(x i32, y i32)i32 = a
  #Mut let d fn(i32, i32)i32 = b

  #Mut let g fn(a, b i32)i32
  #Mut let ge fn(a i32, b i32)i32 = g

  #Mut let n1 fn(f fn(i32)i32)i32
  #Mut let n2 fn(f fn(x i32)i32)i32 = n1

  assert_true(true)
}

#Test
fn test_fn_type_container() {
  #Mut let arr Array<fn()i32> = []
  #Mut let b Rc<fn()i32>
  #Mut let p (fn()i32, i32)
  #Mut let fr fn(i32)i32&
  #Mut let nested Array<fn()fn(i32)i32> = []

  assert_true(true)
}

#Test
fn test_fn_type_nullable() {
  #Mut let a fn?()
  #Mut let b fn?(i32)i32
  #Mut let c fn(s String)i32?
  #Mut let d fn?(s String)i32?

  assert_true(true)
}

; ==================== lambda 闭包捕获测试 ====================

#Test
fn test_closure_capture_scalar() {
  #Mut let x i32 = 10
  let f = (y i32) i32 => y + x
  assert_eq(f(1), 11)
  assert_eq(f(7), 17)

  x = 100
  assert_eq(f(1), 11)
}

#Test
fn test_closure_capture_multi() {
  #Mut let a i32 = 3
  #Mut let b i32 = 7
  let sum = (x i32) i32 => a + b + x
  assert_eq(sum(0), 10)
  assert_eq(sum(5), 15)

  #Mut let pi f64 = 3.14
  let pifloor = () i32 => pi.to_i32()
  assert_eq(pifloor(), 3)

  #Mut let enabled bool = true
  let pick = (t, f i32) i32 => if enabled { t } else { f }
  assert_eq(pick(1, 2), 1)
}

#Test
fn test_closure_capture_box() {
  #Mut let b Rc<Cell> = Cell::make(42)
  let f = () i32 => b.get()
  assert_eq(f(), 42)
  assert_eq(f(), 42)

  let g = () i32 => b.get()
  assert_eq(g(), 42)
}

#Test
fn test_closure_capture_string() {
  #Mut let s String = "hello"
  let f = () String => s
  assert_eq(f(), "hello")
  assert_eq(f(), "hello")

  #Mut let n i32 = 7
  let g = () String => s
  let h = () i32 => n + 1
  assert_eq(g(), "hello")
  assert_eq(h(), 8)
}

#Test
fn test_closure_capture_array() {
  #Mut let arr Array<i32> = [10, 20, 30]
  let f = () i32 => first(arr)
  assert_eq(f(), 10)
  assert_eq(f(), 10)
}

#Test
fn test_closure_pass_around() {
  #Mut let add10 fn(i32)i32 = make_adder(10)
  assert_eq(apply(add10, 5), 15)
  assert_eq(apply(add10, 100), 110)

  #Mut let add42 fn(i32)i32 = make_adder(42)
  assert_eq(add42(8), 50)

  #Mut let alias fn(i32)i32 = add10
  assert_eq(alias(7), 17)
}

#Test
fn test_closure_self_capture() {
  #Mut let c Counter = Counter::make(10)
  assert_eq(c.add_then_apply(5), 15)
  assert_eq(c.triple_apply(), 50)
}
