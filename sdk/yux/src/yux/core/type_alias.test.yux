; 类型别名行为测试（具体透明别名）
;
; 已知问题：
;   - 泛型别名 Pair<T> = (T,T)：p.0+p.1 → codegen "Type does not support '+'"
;   - 泛型别名 Pair<T>：let x = p.0 → LLVM GEP crash
;   - 函数类型别名 Predicate = fn(i32)bool：let f Predicate = is_positive → GEP crash
;   - enum 别名 C = Color：match c2 { C::Green => ... } → 可能导致 sdk compile(需验证)

IPair = (i32, i32)
Point3D = (f64, f64, f64)

fn alias_sum(p IPair) i32 {
  ret p.0 + p.1
}

fn alias_make(a i32, b i32) IPair {
  ret (a, b)
}

fn alias_swap(p IPair) IPair {
  ret (p.1, p.0)
}

#Test
fn test_alias_basic() {
  let p IPair = (1, 2)
  assert_eq(p.0, 1)
  assert_eq(p.1, 2)
}

#Test
fn test_alias_fn_param() {
  let p IPair = (10, 20)
  assert_eq(alias_sum(p), 30)
}

#Test
fn test_alias_fn_return() {
  let p IPair = alias_make(3, 4)
  assert_eq(p.0, 3)
  assert_eq(p.1, 4)
}

#Test
fn test_alias_swap() {
  let q IPair = alias_swap((1, 2))
  assert_eq(q.0, 2)
  assert_eq(q.1, 1)
}

#Test
fn test_alias_tuple_3d() {
  let p Point3D = (1.0f64, 2.0f64, 3.0f64)
  assert_eq(p.0, 1.0f64)
  assert_eq(p.1, 2.0f64)
  assert_eq(p.2, 3.0f64)
}
