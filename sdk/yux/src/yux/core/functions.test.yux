; 顶层函数定义与调用行为测试
;
; 覆盖：
;   - 表达式体函数（fn f() T = expr）
;   - 块体函数（fn f() T { ... ret val }）
;   - void 函数（无返回值）
;   - 参数组语法
;   - 多返回路径（条件分支内 ret）
;   - 泛型函数（fn f<T>(x T) T）
;   - 提前返回（ret 在中途退出）
;
; 已知缺口：函数重载/同名冲突见 multi_fn.test.yux；
; #Static fn 见 static_fn.test.yux / static_fn_handle.test.yux；
; lambda / fn 值见 lambda.test.yux。

; ==================== 基础函数定义 ====================

fn fns_add(a i32, b i32) i32 = a + b

fn fns_sub(a i32, b i32) i32 {
  ret a - b
}

fn fns_nop() {
}

; 验证：函数调用表达式返回值正确性
#Test
fn test_call_expr_body() {
  assert_eq(fns_add(1, 2), 3)
}

; 验证：调用包含块体的函数并验证其返回值
#Test
fn test_call_block_body() {
  assert_eq(fns_sub(5, 3), 2)
}

; 验证：调用无返回值的函数并断言真值
#Test
fn test_call_void() {
  fns_nop()
  assert_true(true)
}

; ==================== 参数组语法 ====================

fn fns_param_group(a, b i32) i32 = a + b

fn fns_param_group_mixed(a, b i32, c f64) f64 = (a + b).to_f64() + c

fn fns_param_group_multi(a, b i32, x, y f64) f64 = (a + b).to_f64() + x + y

; 验证：fns_param_group 函数的两个参数相加
#Test
fn test_param_group_two() {
  assert_eq(fns_param_group(10, 20), 30)
}

; 验证：参数分组混合使用时的函数调用行为
#Test
fn test_param_group_mixed() {
  assert_eq(fns_param_group_mixed(1, 2, 3.0), 6.0)
}

; 验证：多参数分组函数的计算结果
#Test
fn test_param_group_multi() {
  assert_eq(fns_param_group_multi(1, 2, 3.0, 4.0), 10.0)
}

; ==================== 多返回路径 ====================

fn fns_multi_ret(x i32) i32 {
  if x < 0 {
    ret -1
  }
  if x == 0 {
    ret 0
  }
  ret 1
}

fn fns_multi_ret_expr(x i32) i32 {
  if x > 10 {
    ret x * 2
  } elif x > 5 {
    ret x + 10
  }
  ret x
}

fn fns_early_ret_void(flag bool) {
  if !flag {
    ret;
  }
  assert_true(flag)
}

; 验证：负数输入时 multi_ret 函数返回 -1
#Test
fn test_multi_ret_negative() {
  assert_eq(fns_multi_ret(-5), -1)
}

; 验证：多返回值函数在输入零时是否返回零
#Test
fn test_multi_ret_zero() {
  assert_eq(fns_multi_ret(0), 0)
}

; 验证：多返回值函数的正向返回值
#Test
fn test_multi_ret_positive() {
  assert_eq(fns_multi_ret(5), 1)
}

; 验证：多返回表达式函数的正确性
#Test
fn test_multi_ret_expr_large() {
  assert_eq(fns_multi_ret_expr(20), 40)
}

; 验证：多返回值表达式在特定输入下的行为
#Test
fn test_multi_ret_expr_medium() {
  assert_eq(fns_multi_ret_expr(7), 17)
}

; 验证：多返回值表达式在小范围内的行为
#Test
fn test_multi_ret_expr_small() {
  assert_eq(fns_multi_ret_expr(3), 3)
}

; 验证：早期返回 void 函数后跳过后续代码
#Test
fn test_early_ret_void_skip() {
  fns_early_ret_void(false)
  assert_true(true)
}

; 验证：函数提前返回导致的空执行
#Test
fn test_early_ret_void_exec() {
  fns_early_ret_void(true)
  assert_true(true)
}

; ==================== 泛型函数 ====================

fn fns_identity<T>(x T) T = x

fn fns_add_generic<T>(a T, b T) T = a + b

fn fns_pair_first<T>(a T, b T) T = a

; 验证：泛型 identity 函数对 i32 类型的正确性
#Test
fn test_generic_identity_i32() {
  let a i32 = fns_identity(42)
  assert_eq(a, 42)
}

; 验证：泛型 identity 函数对 i64 类型的正确性
#Test
fn test_generic_identity_i64() {
  let a i64 = fns_identity(100i64)
  assert_eq(a, 100)
}

; 验证：泛型 identity 函数对 f64 类型的值进行正确返回
#Test
fn test_generic_identity_f64() {
  let a f64 = fns_identity(3.14)
  assert_eq(a, 3.14)
}

; 验证：泛型加法函数对整数的正确性
#Test
fn test_generic_add_i32() {
  assert_eq(fns_add_generic(10, 20), 30)
}

; 验证：泛型函数 fns_add_generic 对 i64 类型的加法
#Test
fn test_generic_add_i64() {
  assert_eq(fns_add_generic(100, 200), 300)
}

; 验证：泛型加法函数对浮点数的处理
#Test
fn test_generic_add_f64() {
  assert_eq(fns_add_generic(1.5, 2.5), 4.0)
}

; 验证：泛型 Pair 的 first 成员访问
#Test
fn test_generic_pair_first() {
  assert_eq(fns_pair_first(1, 2), 1)
  assert_eq(fns_pair_first(100, 200), 100)
}

; ==================== 类型推断调用 ====================

; 验证：泛型推断整数类型
#Test
fn test_generic_inferred_i32() {
  let a i32 = fns_identity(999)
  assert_eq(a, 999)
}

; 验证：泛型推断 i64 类型的正确性
#Test
fn test_generic_inferred_i64() {
  let a i64 = fns_identity(123456789i64)
  assert_eq(a, 123456789)
}

; ==================== 嵌套调用 ====================

fn fns_double(x i32) i32 = x * 2

fn fns_triple(x i32) i32 = x * 3

; 验证：嵌套函数调用是否正确计算结果
#Test
fn test_nested_call() {
  assert_eq(fns_double(fns_triple(5)), 30)
}

; 验证：链式调用函数的正确性
#Test
fn test_chain_call() {
  assert_eq(fns_add(fns_double(3), fns_triple(2)), 12)
}

; ==================== 块表达式值函数（迁自 bug_hunt） ====================

fn bh_block_expr_val(flag bool) i32 {
  #Mut let result i32 = 0
  if flag {
    result = 42
  }
  if !flag {
    result = -1
  }
  ret result
}

#Test
fn test_fn_block_expr_true() {
  ; 验证：函数内条件赋值路径（true 分支）
  assert_eq(bh_block_expr_val(true), 42)
}

#Test
fn test_fn_block_expr_false() {
  ; 验证：函数内条件赋值路径（false 分支）
  assert_eq(bh_block_expr_val(false), -1)
}

; ==================== 边界 / 扩展测试 ====================

#Test
fn test_generic_identity_bool() {
  ; 验证：泛型 identity 对 bool 类型的正确性
  let a bool = fns_identity(true)
  assert_true(a)
  let b bool = fns_identity(false)
  assert_false(b)
}

#Test
fn test_generic_identity_string() {
  ; 验证：泛型 identity 对 String 类型的正确性
  let a String = fns_identity("hello")
  assert_eq(a, "hello")
}

#Test
fn test_void_fn_boundary() {
  ; 验证：void 函数在边界条件下的行为
  fns_nop()
  fns_early_ret_void(true)
  fns_early_ret_void(false)
  assert_true(true)
}

#Test
fn test_nested_ret_paths() {
  ; 验证：多层嵌套返回路径
  let v i32 = fns_multi_ret_expr(0)
  assert_eq(v, 0)
  let v2 i32 = fns_multi_ret_expr(6)
  assert_eq(v2, 16)
  let v3 i32 = fns_multi_ret_expr(11)
  assert_eq(v3, 22)
}
