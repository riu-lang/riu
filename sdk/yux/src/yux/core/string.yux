; yux SDK - String / StringBuilder 类型 + String 断言重载
;
; String: 不可变引用类型；内部使用 Rc<Array<u32>> 共享不可变码点缓冲
; StringBuilder: 可变字符串缓冲；build() 终态产出不可变 String 并重置自身

; ==================== String ====================
; 构造唯一通道：#Static 工厂 (String::empty / String::from / String::_take_buf)
; B-4: {_buf Rc<Array<u32>>} — Rc 提供 retain/release，字面量走 sentinel RC Block
#Impl(ToString)
struct String {
  _buf Rc<Array<u32>>
  ; 无显式 ~()：编译器对含 Rc 字段的 struct 自动生成析构 → _box_release(_buf.handle)

  ; 静态工厂：空字符串（复用空 sentinel RC Block）
  #Static
  fn empty() String {
    let a Array<u32> = []                  ; 先构造空 Array<u32>
    let buf Rc<Array<u32>> = move(a)       ; 再装箱到 Rc
    ret Self {
      ._buf = move(buf)                    ; 转移所有权
    }
  }

  ; 静态工厂：从外部 Array<u32> 码点缓冲**深拷贝**
  ; (公开安全入口；SDK 内部"我自己造的 buf 立即移交"场景用 _take_buf 走零拷贝)
  ; BUGS #1: buf 改为 Array<u32>& 借用——Array 是 #NoCopy，不可按值隐式拷贝
  #Static
  fn from(buf Array<u32>&) String {
    #Mut let copy Array<u32> = buf.clone()
    let rc Rc<Array<u32>> = move(copy)   ; 接管拷贝的所有权
    ret Self {
      ._buf = move(rc)                   ; 转移所有权
    }
  }

  ; SDK 私有：接管 Array<u32> 缓冲所有权
  ; 调用方承诺移交后不再 mutate buf 内容；典型场景: i*.to_string() / SB::build()
  ; `_` 前缀模块私有 (spec §10.4 _ 前缀可见性规则)；外部使用走 String::from
  #Static
  fn _take_buf(buf Array<u32>) String {
    let rc Rc<Array<u32>> = move(buf)    ; 接管所有权
    ret Self {
      ._buf = move(rc)                   ; 转移 Rc 所有权到 struct
    }
  }

  ; SDK 私有：从码点缓冲拷贝 [start, end) 构造新 String
  #Static
  fn _from_range(src Array<u32>&, start usize, end usize) String {
    #Mut let buf Array<u32> = []
    loop i usize = start {
      if i >= end {
        break;
      }
      buf.push(copy_of(src[i]))
      i += 1
    }
    String::_take_buf(move(buf))
  }

  fn len() usize {
    let a Array<u32>& = as_ref($._buf)
    a.len()
  }

  ; 取码点
  fn get(i usize) u32 {
    let a Array<u32>& = as_ref($._buf)
    copy_of(a[i])
  }

  ; 等值比较：长度相同且每个码点相同
  fn eq(other String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(other._buf)
    if a.len() != b.len() {
      ret false
    }
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      if a[i] != b[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other String&) bool {
    !$.eq(&other)
  }

  ; 是否以 prefix 开头：长度足够且前 plen 个码点逐位相等
  fn starts_with(prefix String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(prefix._buf)
    let plen usize = b.len()
    if plen > a.len() {
      ret false
    }
    loop i usize = 0 {
      if i >= plen {
        break;
      }
      if a[i] != b[i] {
        ret false
      }
      i += 1
    }
    true
  }

  ; 是否以 suffix 结尾：长度足够且后 slen 个码点逐位相等
  ; 空 suffix 视为匹配任何字符串（与 starts_with("") 一致）
  fn ends_with(suffix String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(suffix._buf)
    let slen usize = b.len()
    let hlen usize = a.len()
    if slen > hlen {
      ret false
    }
    let off usize = hlen - slen
    loop i usize = 0 {
      if i >= slen {
        break;
      }
      if a[off + i] != b[i] {
        ret false
      }
      i += 1
    }
    true
  }

  ; 是否包含 needle 子串：朴素 O(n*m) 滑窗匹配
  ; 空 needle 视为匹配任何字符串（与 starts_with("") 一致）
  fn contains(needle String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(needle._buf)
    let nlen usize = b.len()
    if nlen == 0 {
      ret true
    }
    let hlen usize = a.len()
    if nlen > hlen {
      ret false
    }
    loop i usize = 0 {
      if i + nlen > hlen {
        break;
      }
      #Mut let j usize = 0
      #Mut let hit bool = true
      loop {
        if j >= nlen {
          break;
        }
        if a[i + j] != b[j] {
          hit = false
          break;
        }
        j += 1
      }
      if hit {
        ret true
      }
      i += 1
    }
    false
  }

  ; ASCII 大写：a-z → A-Z，其余码点不变（含非 ASCII）；返回新 String
  fn to_upper() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let buf Array<u32> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      #Mut let cp u32 = copy_of(a[i])
      if cp >= c'a' && cp <= c'z' {
        cp = cp - 32u32
      }
      buf.push(cp)
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; ASCII 小写：A-Z → a-z，其余码点不变（含非 ASCII）；返回新 String
  fn to_lower() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let buf Array<u32> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      #Mut let cp u32 = copy_of(a[i])
      if cp >= c'A' && cp <= c'Z' {
        cp = cp + 32u32
      }
      buf.push(cp)
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; ASCII 空白：U+0009..U+000D（\t \n \v \f \r）与空格 U+0020
  fn _is_ascii_ws(cp u32) bool {
    (cp >= 9 && cp <= 13) || cp == 32
  }

  ; 去掉两端 ASCII 空白；全空白 / 空串 → ""
  fn trim() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let start usize = 0
    #Mut let end usize = a.len()
    loop {
      if start >= end {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[start])) {
        break;
      }
      start += 1
    }
    loop {
      if start >= end {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[end - 1])) {
        break;
      }
      end -= 1
    }
    String::_from_range(&a, start, end)
  }

  fn trim_left() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let start usize = 0
    loop {
      if start >= a.len() {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[start])) {
        break;
      }
      start += 1
    }
    String::_from_range(&a, start, a.len())
  }

  fn trim_right() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let end usize = a.len()
    loop {
      if end == 0 {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[end - 1])) {
        break;
      }
      end -= 1
    }
    String::_from_range(&a, 0, end)
  }

  ; 按 \n 切行；\r\n 视为一个换行；末尾换行不产生空段
  ; 空串 → []；"\n" → [""]
  fn lines() Array<String> {
    let a Array<u32>& = as_ref($._buf)
    let hlen usize = a.len()
    #Mut let parts Array<String> = []
    if hlen == 0 {
      ret parts
    }
    #Mut let start usize = 0
    #Mut let i usize = 0
    loop {
      if i >= hlen {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp == 10 {
        parts.push(String::_from_range(&a, start, i))
        i += 1
        start = i
      } elif cp == 13 && i + 1 < hlen && copy_of(a[i + 1]) == 10 {
        parts.push(String::_from_range(&a, start, i))
        i += 2
        start = i
      } else {
        i += 1
      }
    }
    if start < hlen {
      parts.push(String::_from_range(&a, start, hlen))
    }
    ret parts
  }

  ; 按 sep 切分；空 sep 按码点切开；连续 / 首尾 sep 产生空段
  ; 空接收者 + 非空 sep → [""]；空接收者 + 空 sep → []
  fn split(sep String&) Array<String> {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(sep._buf)
    let slen usize = b.len()
    let hlen usize = a.len()
    #Mut let parts Array<String> = []
    if slen == 0 {
      loop i usize = 0 {
        if i >= hlen {
          break;
        }
        parts.push(String::_from_range(&a, i, i + 1))
        i += 1
      }
      ret parts
    }
    #Mut let start usize = 0
    #Mut let i usize = 0
    loop {
      if i + slen > hlen {
        break;
      }
      #Mut let j usize = 0
      #Mut let hit bool = true
      loop {
        if j >= slen {
          break;
        }
        if a[i + j] != b[j] {
          hit = false
          break;
        }
        j += 1
      }
      if hit {
        parts.push(String::_from_range(&a, start, i))
        i += slen
        start = i
      } else {
        i += 1
      }
    }
    parts.push(String::_from_range(&a, start, hlen))
    ret parts
  }

  ; 十进制有符号 i32。可选前导 `+` / `-`；不吃空白。空 / 非数字 / 溢出 → null。
  fn parse_i32() i32? {
    let a Array<u32>& = as_ref($._buf)
    let n usize = a.len()
    if n == 0 {
      ret null
    }
    #Mut let i usize = 0
    #Mut let neg bool = false
    let first u32 = copy_of(a[0])
    if first == c'-' {
      neg = true
      i = 1
      if i >= n {
        ret null
      }
    } elif first == c'+' {
      i = 1
      if i >= n {
        ret null
      }
    }
    #Mut let acc i32 = 0
    #Mut let any bool = false
    loop {
      if i >= n {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp < c'0' || cp > c'9' {
        ret null
      }
      let d i32 = (cp - c'0').to_i32()
      any = true
      if acc > 214748364 {
        ret null
      }
      if acc == 214748364 {
        if neg && d == 8 {
          i += 1
          if i != n {
            ret null
          }
          ret -2147483648
        }
        if !neg && d > 7 {
          ret null
        }
        if neg && d > 8 {
          ret null
        }
      }
      acc = acc * 10 + d
      i += 1
    }
    if !any {
      ret null
    }
    if neg {
      ret -acc
    }
    ret acc
  }

  ; 转为 UTF-8 字节数组
  fn to_bytes() Array<u8> {
    let a Array<u32>& = as_ref($._buf)
    #Mut let r Array<u8> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp < 128 {
        r.push(cp.to_u8());
      } elif cp < 2048 {
        r.push(192u8 + ((cp >> 6u32) & 31u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } elif cp < 65536 {
        r.push(224u8 + ((cp >> 12u32) & 15u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } else {
        r.push(240u8 + ((cp >> 18u32) & 7u32).to_u8())
        r.push(128u8 + ((cp >> 12u32) & 63u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      }
      i += 1
    }
    r
  }

  ; B-4: String 自身实现 ToString — 浅复制 Rc，共享底层缓冲
  fn to_string() String {
    ret $
  }
}

; ==================== StringBuilder ====================
; 内部持有 Array<u32> 码点缓冲；支持追加；build() 终态产出不可变 String 并重置自身
; 推荐用法：本地短生命周期累积 → build() 一次产出 String；不要在 build() 之后继续写入并对外暴露同一 String
struct StringBuilder {
  data Array<u32>

  #Static
  fn make() StringBuilder {
    ret Self {
      .data = []
    }
  }

  fn len() usize {
    $.data.len()
  }

  ; 追加一个 Unicode 码点
  fn append(cp u32) {
    $.data.push(cp)
  }

  ; 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    $.data.push(b.to_u32())
  }

  ; 追加另一个字符串的全部码点
  fn append(s String) {
    loop i usize = 0 {
      if i >= s.len() {
        break;
      }
      $.data.push(s.get(i))
      i += 1
    }
  }

  ; 清空缓冲
  fn clear() {
    $.data = []
  }

  ; 等值比较：长度相同且每个码点相同
  fn eq(other StringBuilder&) bool {
    if $.data.len() != other.data.len() {
      ret false
    }
    loop i usize = 0 {
      if i >= $.data.len() {
        break;
      }
      if $.data[i] != other.data[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other StringBuilder&) bool {
    !$.eq(&other)
  }

  ; 取出缓冲、构造不可变 String、自身重置为空
  ; `$.data <- []` 原子移出旧值并用空数组替换，旧值直接交 _take_buf 构建 String
  ; 取出后再 append/clear 不会影响已返回的 String（不同 Array<u32> Block）
  fn build() String {
    String::_take_buf($.data <- [])
  }
}

; ==================== Phase 4b：String 断言（纯 yux）====================
; 与 assert.yux 中的 #Builtin 同名/同失败语义，但走 yux 实现路径。
; dispatcher（compiler_call.cpp）在参数严格匹配的非泛型重载存在时优先选这里，
; 绕开 compileTestAssertEq —— 后者仅处理 i8..u64 / f32 / f64 / bool。
;
; 形参均为 String&（spec §7.2.3.3）。调用方传 String 由「运算符位置自动取址」
; （§7.2.3.6）和按 String& 形参的自动转换处理。

fn assert_eq(actual String&, expected String&) {
  if actual != expected {
    __yux_test_assert_failed();
  }
}

fn assert_contains(haystack String&, needle String&) {
  if !haystack.contains(&needle) {
    __yux_test_assert_failed();
  }
}

fn assert_starts_with(s String&, prefix String&) {
  if !s.starts_with(&prefix) {
    __yux_test_assert_failed();
  }
}
