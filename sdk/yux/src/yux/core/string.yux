; yux SDK - String / StringBuilder 类型 + String 断言重载
;
; String: 不可变引用类型；内部使用 Rc<Array<u32>> 共享不可变码点缓冲
; StringBuilder: 可变字符串缓冲；build() 终态产出不可变 String 并重置自身

; ==================== String ====================
; 构造唯一通道：#Static 工厂 (String::empty / String::from / String::_take_buf)
; B-4: {_buf Rc<Array<u32>>} — Rc 提供 retain/release，字面量走 sentinel RC Block
#Impl(ToString)
#Impl(Eq)
#Impl(Ord)
struct String {
  _buf Rc<Array<u32>>
  ; 无显式 ~()：编译器对含 Rc 字段的 struct 自动生成析构 → _box_release(_buf.handle)

  ; 静态工厂：空字符串（复用空 sentinel RC Block）
  #Static
  fn empty() String {
    let a Array<u32> = []                  ; 先构造空 Array<u32>
    let buf Rc<Array<u32>> = move(a)       ; 再装箱到 Rc
    Self { move(buf) }                     ; 转移所有权
  }

  ; 静态工厂：从外部 Array<u32> 码点缓冲**深拷贝**
  ; (公开安全入口；SDK 内部"我自己造的 buf 立即移交"场景用 _take_buf 走零拷贝)
  ; BUGS #1: buf 改为 Array<u32>& 借用——Array 是 #NoCopy，不可按值隐式拷贝
  #Static
  fn from(buf Array<u32>&) String {
    #Mut let copy Array<u32> = buf.clone()
    let rc Rc<Array<u32>> = move(copy)   ; 接管拷贝的所有权
    Self { move(rc) }                    ; 转移所有权
  }

  ; SDK 私有：接管 Array<u32> 缓冲所有权
  ; 调用方承诺移交后不再 mutate buf 内容；典型场景: i*.to_string() / SB::build()
  ; `_` 前缀模块私有 (spec §10.4 _ 前缀可见性规则)；外部使用走 String::from
  #Static
  fn _take_buf(buf Array<u32>) String {
    let rc Rc<Array<u32>> = move(buf)    ; 接管所有权
    Self { move(rc) }                    ; 转移 Rc 所有权到 struct
  }

  ; SDK 私有：从码点缓冲拷贝 [start, end) 构造新 String
  #Static
  fn _from_range(src Array<u32>&, start usize, end usize) String {
    #Mut let buf Array<u32> = []
    loop i usize = start {
      if i >= end {
        break;
      }
      buf.push(copy_of(src[i]))
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; 单码点构造；不校验是否合法 Unicode 标量
  #Static
  fn from_codepoint(cp u32) String {
    #Mut let buf Array<u32> = []
    buf.push(cp)
    String::_take_buf(move(buf))
  }

  ; 用 sep 拼接；空 parts → ""；单段不加 sep
  ; sep 按值：静态方法不自动取址，字面量 `","` 才能直接传入
  #Static
  fn join(parts Array<String>&, sep String) String {
    let n usize = parts.len()
    if n == 0 {
      ret String::empty()
    }
    if n == 1 {
      ret copy_of(parts[0])
    }
    #Mut let buf Array<u32> = []
    #Mut let first bool = true
    for p in parts {
      if !first {
        let sbuf Array<u32>& = as_ref(sep._buf)
        loop si usize = 0 {
          if si >= sbuf.len() {
            break;
          }
          buf.push(copy_of(sbuf[si]))
          si += 1
        }
      }
      first = false
      let pbuf Array<u32>& = as_ref(p._buf)
      loop pi usize = 0 {
        if pi >= pbuf.len() {
          break;
        }
        buf.push(copy_of(pbuf[pi]))
        pi += 1
      }
    }
    String::_take_buf(move(buf))
  }

  ; 从 start 起把 a 收到的十进制数字收成 u64；须至少一位；非数字 / 溢出 → null
  #Static
  fn _parse_u64_from(a Array<u32>&, start usize) u64? {
    let n usize = a.len()
    if start >= n {
      ret null
    }
    #Mut let acc u64 = 0
    #Mut let i usize = start
    #Mut let any bool = false
    let limit u64 = u64::MAX / 10
    let last u64 = u64::MAX % 10
    loop {
      if i >= n {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp < c'0' || cp > c'9' {
        ret null
      }
      let d u64 = (cp - c'0').to_u64()
      any = true
      if acc > limit || (acc == limit && d > last) {
        ret null
      }
      acc = acc * 10 + d
      i += 1
    }
    if !any {
      ret null
    }
    acc
  }

  fn len() usize {
    let a Array<u32>& = as_ref($._buf)
    a.len()
  }

  fn is_empty() bool = $.len() == 0

  ; 取码点
  fn get(i usize) u32 {
    let a Array<u32>& = as_ref($._buf)
    copy_of(a[i])
  }

  ; [start, end) 拷贝；端点夹到 len；start > end 得 ""
  fn slice(start usize, end usize) String {
    let a Array<u32>& = as_ref($._buf)
    let n usize = a.len()
    #Mut let s usize = start
    #Mut let e usize = end
    if s > n {
      s = n
    }
    if e > n {
      e = n
    }
    if s >= e {
      ret String::empty()
    }
    String::_from_range(&a, s, e)
  }

  fn slice_from(start usize) String = $.slice(start, $.len())

  ; 等值比较：长度相同且每个码点相同
  fn eq(other String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(other._buf)
    if a.len() != b.len() {
      ret false
    }
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      if a[i] != b[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other String&) bool {
    !$.eq(&other)
  }

  ; 码点字典序：小于 -1、相等 0、大于 1
  fn cmp(other String&) i32 {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(other._buf)
    let na usize = a.len()
    let nb usize = b.len()
    #Mut let n usize = na
    if nb < n {
      n = nb
    }
    loop i usize = 0 {
      if i >= n {
        break;
      }
      let ca u32 = copy_of(a[i])
      let cb u32 = copy_of(b[i])
      if ca < cb {
        ret -1
      }
      if ca > cb {
        ret 1
      }
      i += 1
    }
    if na < nb {
      ret -1
    }
    if na > nb {
      ret 1
    }
    0
  }

  ; a[i .. i+b.len()) 是否与 b 逐码点相等；调用方保证不越界
  fn _eq_at(a Array<u32>&, b Array<u32>&, i usize) bool {
    loop j usize = 0 {
      if j >= b.len() {
        ret true
      }
      if a[i + j] != b[j] {
        ret false
      }
      j += 1
    }
    true
  }

  ; 是否以 prefix 开头：长度足够且前 plen 个码点逐位相等
  fn starts_with(prefix String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(prefix._buf)
    if b.len() > a.len() {
      ret false
    }
    $._eq_at(&a, &b, 0)
  }

  ; 是否以 suffix 结尾：长度足够且后 slen 个码点逐位相等
  ; 空 suffix 视为匹配任何字符串（与 starts_with("") 一致）
  fn ends_with(suffix String&) bool {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(suffix._buf)
    let slen usize = b.len()
    let hlen usize = a.len()
    if slen > hlen {
      ret false
    }
    $._eq_at(&a, &b, hlen - slen)
  }

  ; 是否包含 needle 子串：朴素 O(n*m) 滑窗匹配
  ; 空 needle 视为匹配任何字符串（与 starts_with("") 一致）
  fn contains(needle String&) bool = $.index_of(&needle).has()

  ; 首次出现位置；空 needle → 0；未找到 → null
  fn index_of(needle String&) usize? {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(needle._buf)
    let nlen usize = b.len()
    let hlen usize = a.len()
    if nlen == 0 {
      ret 0
    }
    if nlen > hlen {
      ret null
    }
    loop i usize = 0 {
      if i + nlen > hlen {
        break;
      }
      if $._eq_at(&a, &b, i) {
        ret i
      }
      i += 1
    }
    null
  }

  ; 末次出现位置；空 needle → len；未找到 → null
  fn last_index_of(needle String&) usize? {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(needle._buf)
    let nlen usize = b.len()
    let hlen usize = a.len()
    if nlen == 0 {
      ret hlen
    }
    if nlen > hlen {
      ret null
    }
    #Mut let i usize = hlen - nlen
    loop {
      if $._eq_at(&a, &b, i) {
        ret i
      }
      if i == 0 {
        break;
      }
      i -= 1
    }
    null
  }

  ; 去掉前缀；不匹配 → null（空前缀得自身）
  fn strip_prefix(prefix String&) String? {
    if !$.starts_with(&prefix) {
      ret null
    }
    ret $.slice_from(prefix.len())
  }

  ; 去掉后缀；不匹配 → null（空后缀得自身）
  fn strip_suffix(suffix String&) String? {
    if !$.ends_with(&suffix) {
      ret null
    }
    $.slice(0, $.len() - suffix.len())
  }

  ; ASCII 大写：a-z → A-Z，其余码点不变（含非 ASCII）；返回新 String
  fn to_upper() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let buf Array<u32> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      #Mut let cp u32 = copy_of(a[i])
      if cp >= c'a' && cp <= c'z' {
        cp = cp - 32u32
      }
      buf.push(cp)
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; ASCII 小写：A-Z → a-z，其余码点不变（含非 ASCII）；返回新 String
  fn to_lower() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let buf Array<u32> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      #Mut let cp u32 = copy_of(a[i])
      if cp >= c'A' && cp <= c'Z' {
        cp = cp + 32u32
      }
      buf.push(cp)
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; ASCII 空白：U+0009..U+000D（\t \n \v \f \r）与空格 U+0020
  fn _is_ascii_ws(cp u32) bool {
    (cp >= 9 && cp <= 13) || cp == 32
  }

  ; 去掉两端 ASCII 空白；全空白 / 空串 → ""
  fn trim() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let start usize = 0
    #Mut let end usize = a.len()
    loop {
      if start >= end {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[start])) {
        break;
      }
      start += 1
    }
    loop {
      if start >= end {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[end - 1])) {
        break;
      }
      end -= 1
    }
    String::_from_range(&a, start, end)
  }

  fn trim_left() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let start usize = 0
    loop {
      if start >= a.len() {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[start])) {
        break;
      }
      start += 1
    }
    String::_from_range(&a, start, a.len())
  }

  fn trim_right() String {
    let a Array<u32>& = as_ref($._buf)
    #Mut let end usize = a.len()
    loop {
      if end == 0 {
        break;
      }
      if !$._is_ascii_ws(copy_of(a[end - 1])) {
        break;
      }
      end -= 1
    }
    String::_from_range(&a, 0, end)
  }

  ; 按 \n 切行；\r\n 视为一个换行；末尾换行不产生空段
  ; 空串 → []；"\n" → [""]
  fn lines() Array<String> {
    let a Array<u32>& = as_ref($._buf)
    let hlen usize = a.len()
    #Mut let parts Array<String> = []
    if hlen == 0 {
      ret parts
    }
    #Mut let start usize = 0
    #Mut let i usize = 0
    loop {
      if i >= hlen {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp == 10 {
        parts.push(String::_from_range(&a, start, i))
        i += 1
        start = i
      } elif cp == 13 && i + 1 < hlen && copy_of(a[i + 1]) == 10 {
        parts.push(String::_from_range(&a, start, i))
        i += 2
        start = i
      } else {
        i += 1
      }
    }
    if start < hlen {
      parts.push(String::_from_range(&a, start, hlen))
    }
    parts
  }

  ; 按 sep 切分；空 sep 按码点切开；连续 / 首尾 sep 产生空段
  ; 空接收者 + 非空 sep → [""]；空接收者 + 空 sep → []
  fn split(sep String&) Array<String> {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(sep._buf)
    let slen usize = b.len()
    let hlen usize = a.len()
    #Mut let parts Array<String> = []
    if slen == 0 {
      loop i usize = 0 {
        if i >= hlen {
          break;
        }
        parts.push(String::_from_range(&a, i, i + 1))
        i += 1
      }
      ret parts
    }
    #Mut let start usize = 0
    #Mut let i usize = 0
    loop {
      if i + slen > hlen {
        break;
      }
      if $._eq_at(&a, &b, i) {
        parts.push(String::_from_range(&a, start, i))
        i += slen
        start = i
      } else {
        i += 1
      }
    }
    parts.push(String::_from_range(&a, start, hlen))
    parts
  }

  ; 全部替换非重叠 from；空 from 返回自身（避免无限插入）
  fn replace(from String&, to String&) String {
    let a Array<u32>& = as_ref($._buf)
    let b Array<u32>& = as_ref(from._buf)
    let t Array<u32>& = as_ref(to._buf)
    let flen usize = b.len()
    if flen == 0 {
      ret $
    }
    let hlen usize = a.len()
    #Mut let buf Array<u32> = []
    #Mut let i usize = 0
    loop {
      if i + flen > hlen {
        break;
      }
      if $._eq_at(&a, &b, i) {
        loop k usize = 0 {
          if k >= t.len() {
            break;
          }
          buf.push(copy_of(t[k]))
          k += 1
        }
        i += flen
      } else {
        buf.push(copy_of(a[i]))
        i += 1
      }
    }
    loop {
      if i >= hlen {
        break;
      }
      buf.push(copy_of(a[i]))
      i += 1
    }
    String::_take_buf(move(buf))
  }

  ; 重复 n 次；n == 0 或空串 → ""
  fn repeat(n usize) String {
    if n == 0 || $.is_empty() {
      ret String::empty()
    }
    let a Array<u32>& = as_ref($._buf)
    #Mut let buf Array<u32> = []
    loop k usize = 0 {
      if k >= n {
        break;
      }
      loop i usize = 0 {
        if i >= a.len() {
          break;
        }
        buf.push(copy_of(a[i]))
        i += 1
      }
      k += 1
    }
    String::_take_buf(move(buf))
  }

  ; 十进制有符号。可选前导 `+` / `-`；不吃空白。空 / 非数字 / 溢出 → null。
  fn _parse_signed_i64() i64? {
    let a Array<u32>& = as_ref($._buf)
    let n usize = a.len()
    if n == 0 {
      ret null
    }
    #Mut let i usize = 0
    #Mut let neg bool = false
    let first u32 = copy_of(a[0])
    if first == c'-' {
      neg = true
      i = 1
    } elif first == c'+' {
      i = 1
    }
    let mag u64? = String::_parse_u64_from(&a, i)
    if !mag.has() {
      ret null
    }
    let v u64 = mag.get()
    let max_pos u64 = i64::MAX.to_u64()
    if neg {
      if v > max_pos + 1 {
        ret null
      }
      if v == max_pos + 1 {
        ret i64::MIN
      }
      ret 0i64 - v.to_i64()
    }
    if v > max_pos {
      ret null
    }
    v.to_i64()
  }

  fn _parse_unsigned_u64() u64? {
    let a Array<u32>& = as_ref($._buf)
    let n usize = a.len()
    if n == 0 {
      ret null
    }
    #Mut let i usize = 0
    let first u32 = copy_of(a[0])
    if first == c'+' {
      i = 1
    } elif first == c'-' {
      ret null
    }
    String::_parse_u64_from(&a, i)
  }

  fn parse_i32() i32? {
    let v i64? = $._parse_signed_i64()
    if !v.has() {
      ret null
    }
    let x i64 = v.get()
    if x < i32::MIN.to_i64() || x > i32::MAX.to_i64() {
      ret null
    }
    ret x.to_i32()
  }

  fn parse_i64() i64? = $._parse_signed_i64()

  fn parse_u32() u32? {
    let v u64? = $._parse_unsigned_u64()
    if !v.has() {
      ret null
    }
    let x u64 = v.get()
    if x > u32::MAX.to_u64() {
      ret null
    }
    ret x.to_u32()
  }

  fn parse_u64() u64? = $._parse_unsigned_u64()

  fn parse_usize() usize? {
    let v u64? = $._parse_unsigned_u64()
    if !v.has() {
      ret null
    }
    let x u64 = v.get()
    if x > usize::MAX.to_u64() {
      ret null
    }
    x.to_usize()
  }

  ; 精确 `"true"` / `"false"`；其余 → null
  fn parse_bool() bool? {
    if $ == "true" {
      ret true
    }
    if $ == "false" {
      ret false
    }
    null
  }

  ; 转为 UTF-8 字节数组
  fn to_bytes() Array<u8> {
    let a Array<u32>& = as_ref($._buf)
    #Mut let r Array<u8> = []
    loop i usize = 0 {
      if i >= a.len() {
        break;
      }
      let cp u32 = copy_of(a[i])
      if cp < 128 {
        r.push(cp.to_u8());
      } elif cp < 2048 {
        r.push(192u8 + ((cp >> 6u32) & 31u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } elif cp < 65536 {
        r.push(224u8 + ((cp >> 12u32) & 15u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } else {
        r.push(240u8 + ((cp >> 18u32) & 7u32).to_u8())
        r.push(128u8 + ((cp >> 12u32) & 63u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      }
      i += 1
    }
    r
  }

  ; B-4: String 自身实现 ToString — 浅复制 Rc，共享底层缓冲（返回值独立持有引用）
  fn to_string() String {
    let buf Rc<Array<u32>> = $._buf
    String { move(buf) }
  }
}

; ==================== StringBuilder ====================
; 内部持有 Array<u32> 码点缓冲；支持追加；build() 终态产出不可变 String 并重置自身
; 推荐用法：本地短生命周期累积 → build() 一次产出 String；不要在 build() 之后继续写入并对外暴露同一 String
struct StringBuilder {
  data Array<u32>

  #Static
  fn make() StringBuilder {
    ret Self { [] }
  }

  fn len() usize {
    $.data.len()
  }

  ; 追加一个 Unicode 码点
  fn append(cp u32) {
    $.data.push(cp)
  }

  ; 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    $.data.push(b.to_u32())
  }

  ; 追加另一个字符串的全部码点
  fn append(s String) {
    loop i usize = 0 {
      if i >= s.len() {
        break;
      }
      $.data.push(s.get(i))
      i += 1
    }
  }

  ; 追加常用标量的文本表示；u8 / u32 保留上面的 byte / 码点语义
  fn append(value i8) { $.append(value.to_string()) }
  fn append(value i16) { $.append(value.to_string()) }
  fn append(value u16) { $.append(value.to_string()) }
  fn append(value i32) { $.append(value.to_string()) }
  fn append(value i64) { $.append(value.to_string()) }
  fn append(value u64) { $.append(value.to_string()) }
  fn append(value usize) { $.append(value.to_string()) }
  fn append(value f32) { $.append(value.to_string()) }
  fn append(value f64) { $.append(value.to_string()) }
  fn append(value bool) { $.append(value.to_string()) }

  ; 清空缓冲
  fn clear() {
    $.data = []
  }

  ; 等值比较：长度相同且每个码点相同
  fn eq(other StringBuilder&) bool {
    if $.data.len() != other.data.len() {
      ret false
    }
    loop i usize = 0 {
      if i >= $.data.len() {
        break;
      }
      if $.data[i] != other.data[i] {
        ret false
      }
      i += 1
    }
    true
  }

  fn ne(other StringBuilder&) bool {
    !$.eq(&other)
  }

  ; 取出缓冲、构造不可变 String、自身重置为空
  ; `$.data <- []` 原子移出旧值并用空数组替换，旧值直接交 _take_buf 构建 String
  ; 取出后再 append/clear 不会影响已返回的 String（不同 Array<u32> Block）
  fn build() String {
    String::_take_buf($.data <- [])
  }
}

; ==================== Phase 4b：String 断言（纯 yux）====================
; 与 assert.yux 中的 #Builtin 同名/同失败语义，但走 yux 实现路径。
; dispatcher（compiler_call.cpp）在参数严格匹配的非泛型重载存在时优先选这里，
; 绕开 compileTestAssertEq —— 后者仅处理 i8..u64 / f32 / f64 / bool。
;
; 形参均为 String&（spec §7.2.3.3）。调用方传 String 由「运算符位置自动取址」
; （§7.2.3.6）和按 String& 形参的自动转换处理。

fn assert_eq(actual String&, expected String&) {
  if actual != expected {
    __yux_test_assert_failed();
  }
}

fn assert_contains(haystack String&, needle String&) {
  if !haystack.contains(&needle) {
    __yux_test_assert_failed();
  }
}

fn assert_starts_with(s String&, prefix String&) {
  if !s.starts_with(&prefix) {
    __yux_test_assert_failed();
  }
}
