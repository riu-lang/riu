; 控制流行为测试
;
; 覆盖：
;   - if-else 表达式（单行/多行）
;   - if/elif/else 链作为表达式
;   - Python 风格三元 a if cond else b（含嵌套）
;   - if 作为语句（无 else）
;   - 嵌套 if-else 表达式
;   - 复杂条件（&& / || / 组合）
;   - 块内 ret 提前返回
;   - if 表达式 + 算术组合
;   - 短路求值（&& / ||）

; ==================== 基础 if-else 表达式 ====================

; 验证：基本的 if-else 表达式用于比较两个值并返回较大的那个
#Test
fn test_if_else_expr_basic() {
  let a i32 = 10
  let b i32 = 20
  let max i32 = if a > b { a } else { b }
  assert_eq(max, 20)
}

; 验证：单行 if-else 表达式是否正确返回值
#Test
fn test_if_else_expr_single_line() {
  let x i32 = 5
  let sign i32 = if x >= 0 { 1 } else { -1 }
  assert_eq(sign, 1)
}

; 验证：单行 if-else 表达式处理负数情况
#Test
fn test_if_else_expr_single_line_negative() {
  let x i32 = -3
  let sign i32 = if x >= 0 { 1 } else { -1 }
  assert_eq(sign, -1)
}

; ==================== if/elif/else 链作为表达式 ====================

; 验证：if/elif/else 链作为表达式是否正确返回值
#Test
fn test_if_elif_else_chain_expr() {
  let score i32 = 85
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } elif score >= 70 {
    3
  } else {
    4
  }
  assert_eq(grade, 2)
}

; 验证：if-elif-else 链中最后一个 else 分支的执行
#Test
fn test_if_elif_else_chain_else_branch() {
  let score i32 = 50
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } else {
    4
  }
  assert_eq(grade, 4)
}

; 验证：if-elif-else 链中第一个分支的执行
#Test
fn test_if_elif_else_chain_first_branch() {
  let score i32 = 95
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } else {
    4
  }
  assert_eq(grade, 1)
}

; ==================== Python 风格三元 a if cond else b ====================

; 验证：Python 风格三元运算符，条件为真时返回 a 的值
#Test
fn test_ternary_python_style_true() {
  let a i32 = 10
  let b i32 = 20
  let max i32 = a if a > b else b
  assert_eq(max, 20)
}

; 验证：Python 风格的三元运算符在 false 条件下的行为
#Test
fn test_ternary_python_style_false() {
  let a i32 = 30
  let b i32 = 20
  let max i32 = a if a > b else b
  assert_eq(max, 30)
}

; 验证：Python 风格的三元运算符用于条件赋值
#Test
fn test_ternary_python_style_sign() {
  let x i32 = -5
  let sign i32 = 1 if x >= 0 else -1
  assert_eq(sign, -1)
}

; 验证：三元运算符用于生成字符串并验证其长度
#Test
fn test_ternary_python_style_string() {
  let x i32 = 10
  let msg String = "positive" if x > 0 else "non-positive"
  assert_eq(msg.len(), 8)
}

; 验证：Python 风格嵌套三元运算符的正确性
#Test
fn test_ternary_python_style_nested() {
  let score i32 = 75
  let grade i32 = 1 if score >= 90 else (2 if score >= 80 else (3 if score >= 70 else 4))
  assert_eq(grade, 3)
}

; ==================== if 作为语句（无 else） ====================

; 验证：if 语句作为语句时，true 条件下的赋值行为
#Test
fn test_if_statement_no_else() {
  #Mut let x i32 = 0
  if true {
    x = 1
  }
  assert_eq(x, 1)
}

; 验证：if 语句条件为假时，不执行块内代码
#Test
fn test_if_statement_condition_false() {
  #Mut let x i32 = 0
  if false {
    x = 1
  }
  assert_eq(x, 0)
}

; ==================== 嵌套 if-else ====================

; 验证：嵌套 if-else 表达式求最大值
#Test
fn test_nested_if_else_expr() {
  let a i32 = 10
  let b i32 = 20
  let c i32 = 30
  let max i32 = if a > b {
    if a > c { a } else { c }
  } else {
    if b > c { b } else { c }
  }
  assert_eq(max, 30)
}

; ==================== 复杂条件（&& / ||） ====================

; 验证：if 语句中使用 && 条件判断
#Test
fn test_if_with_and_condition() {
  let x i32 = 5
  let y i32 = 10
  let result i32 = if x > 0 && y > 0 { 1 } else { 0 }
  assert_eq(result, 1)
}

; 验证：if 语句中使用或条件
#Test
fn test_if_with_or_condition() {
  let x i32 = -1
  let y i32 = 10
  let result i32 = if x > 0 || y > 0 { 1 } else { 0 }
  assert_eq(result, 1)
}

; 验证：if 语句处理复杂条件
#Test
fn test_if_with_complex_condition() {
  let a i32 = 10
  let b i32 = 5
  let c i32 = 20
  let result i32 = if (a > b) && (c > a) { 1 } else { 0 }
  assert_eq(result, 1)
}

; ==================== 块内 ret 提前返回 ====================

fn return_early(flag bool) i32 {
  if flag {
    ret 1
  }
  ret 0
}

; 验证：当条件为真时，函数是否能提前返回值
#Test
fn test_early_return_true() {
  let v i32 = return_early(true)
  assert_eq(v, 1)
}

; 验证：早期返回 false 时的默认值
#Test
fn test_early_return_false() {
  let v i32 = return_early(false)
  assert_eq(v, 0)
}

; ==================== if 表达式 + 算术组合 ====================

; 验证：If 表达式在算术组合中的使用
#Test
fn test_if_expr_in_arithmetic() {
  let a i32 = 10
  let b i32 = 5
  let result i32 = (if a > b { a } else { b }) * 2
  assert_eq(result, 20)
}

; ==================== 短路求值行为 ====================

fn side_effect_flag() bool {
  ret true
}

; 验证：短路与逻辑运算符的行为
#Test
fn test_short_circuit_and() {
  let result bool = false && side_effect_flag()
  assert_false(result)
}

; 验证：短路或运算符的行为
#Test
fn test_short_circuit_or() {
  let result bool = true || side_effect_flag()
  assert_true(result)
}

; ==================== 边界 / 扩展测试 ====================

#Test
fn test_if_elif_all_false() {
  ; 验证：if/elif 链全部条件为 false 时走 else 分支
  let x i32 = 0
  let result i32 = if x > 0 {
    1
  } elif x > 10 {
    2
  } else {
    99
  }
  assert_eq(result, 99)
}

#Test
fn test_ternary_with_arithmetic() {
  ; 验证：三元表达式直接参与算术运算
  let a i32 = 10
  let b i32 = 20
  let result i32 = (a if a > b else b) + 5
  assert_eq(result, 25)
}

#Test
fn test_if_else_zero_condition() {
  ; 验证：if 条件为字面量 false 和 true
  let result i32 = if false { 1 } else { 0 }
  assert_eq(result, 0)
  let result2 i32 = if true { 42 } else { 0 }
  assert_eq(result2, 42)
}

; ==================== 块作用域（§5.7.1）====================

; 验证：if 体内 let 可遮蔽外层同名；出块后仍是外层值
#Test
fn test_block_scope_if_shadow() {
  let x i32 = 1
  let inner i32 = if true {
    let x i32 = 42
    x
  } else {
    0
  }
  assert_eq(inner, 42)
  assert_eq(x, 1)
}

; 验证：loop init 变量在体内可用，并可 break 退出
#Test
fn test_block_scope_loop_init() {
  #Mut let sum i32 = 0
  loop i = 0 {
    if i >= 3 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 3)
}

; 验证：labeled break 跨层退出
#Test
fn test_block_scope_labeled_break() {
  #Mut let n i32 = 0
  outer: loop {
    loop i = 0 {
      if i >= 2 {
        break@outer;
      }
      n = n + 1
      i = i + 1
    }
  }
  assert_eq(n, 2)
}
