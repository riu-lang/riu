; loop 高级行为测试：label + break@、init、边界条件
;
; 覆盖：
;   - loop init i32
;   - labeled loop + break@
;   - 嵌套 labeled loop
;   - loop 空循环
;   - loop 中累加
;   - loop 中使用函数返回值

; ==================== loop init i32 ====================

#Test
fn test_loop_init_basic() {
  #Mut let sum i32 = 0
  loop i = 0 {
    if i >= 5 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 10)
}

; ==================== Labeled loop ====================

#Test
fn test_labeled_loop_basic() {
  #Mut let count i32 = 0
  outer: loop i = 0 {
    if i >= 3 {
      break@outer;
    }
    count = count + 1
    i = i + 1
  }
  assert_eq(count, 3)
}

#Test
fn test_nested_labeled_loop() {
  #Mut let found i32 = 0
  outer: loop i = 0 {
    if i >= 5 {
      break@outer;
    }
    inner: loop j = 0 {
      if j >= 3 {
        break;
      }
      if i == 2 && j == 1 {
        found = 1
        break@outer;
      }
      j = j + 1
    }
    i = i + 1
  }
  assert_eq(found, 1)
}

#Test
fn test_label_with_init() {
  #Mut let sum i32 = 0
  outer: loop i = 0 {
    if i >= 3 {
      break@outer;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 3)
}

; ==================== loop 边界 ====================

#Test
fn test_loop_zero_iteration() {
  #Mut let count i32 = 0
  loop i = 0 {
    if true {
      break;
    }
    count = count + 1
    i = i + 1
  }
  assert_eq(count, 0)
}

#Test
fn test_loop_accumulate() {
  #Mut let product i32 = 1
  loop i = 1 {
    if i > 5 {
      break;
    }
    product = product * i
    i = i + 1
  }
  assert_eq(product, 120)
}
