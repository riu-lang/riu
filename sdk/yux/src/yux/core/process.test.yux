; 进程：args() / tick_ms()
; args 在 yux test 里是 yux-test-runner 的命令行，只断言非空。
; 不用 `a[0].len()`：会误解析成 Array.len（见 BUGS）。

#Test
fn test_args_nonempty() {
  let a Array<String> = args()
  assert_true(a.len() >= 1)
  let s String& = a[0]
  assert_true(s.len() > 0)
}

#Test
fn test_tick_ms_runs() {
  let t u32 = tick_ms()
  assert_true(t == t)
}