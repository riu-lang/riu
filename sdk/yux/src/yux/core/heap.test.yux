; ==================== struct 字段 Heap<T> 析构 ====================

; 验证：Heap 在结构体字段中的析构行为
#Test
fn test_heap_inside_struct_field() {
  let w HeapWrap = HeapWrap::make(31)
  assert_eq(1, 1)
}

; ==================== 多局部 + 嵌套作用域 ====================

; 验证：多局部变量作用域内堆内存引用和求和
#Test
fn test_heap_multi_locals_scope_drop() {
  let a Heap<i32> = heap:<i32>(2)
  let b Heap<i32> = heap:<i32>(4)
  let c Heap<i32> = heap:<i32>(8)
  let ra i32& = as_ref(a)
  let rb i32& = as_ref(b)
  let rc i32& = as_ref(c)
  assert_eq(ra + rb + rc, 14)
}

; 验证：Heap 在嵌套块作用域中的可见性和生命周期管理
; （裸 `{ }` 是 0 参 lambda，不是语句块；用 if 真块作用域）
#Test
fn test_heap_nested_block_scope() {
  let outer Heap<i32> = heap:<i32>(100)
  if true {
    let inner Heap<i32> = heap:<i32>(200)
    let ri i32& = as_ref(inner)
    assert_eq(ri, 200)
  }
  let ro i32& = as_ref(outer)
  assert_eq(ro, 100)
}

; 验证：HeapWrap 和顶层堆共存时字段访问
#Test
fn test_heap_field_and_top_heap_coexist() {
  let w HeapWrap = HeapWrap::make(50)
  let h Heap<i32> = heap:<i32>(60)
  let rh i32& = as_ref(h)
  assert_eq(rh, 60)
}

; ==================== NRVO：return Heap<T> ====================

fn nrvo_make_h(v i32) Heap<i32> {
  let h Heap<i32> = heap:<i32>(v)
  ret h
}

; 验证：NRVO 返回局部变量的堆对象
#Test
fn test_heap_nrvo_return_local() {
  let r Heap<i32> = nrvo_make_h(77)
  let v i32& = as_ref(r)
  assert_eq(v, 77)
}

fn nrvo_pick(cond bool) Heap<i32> {
  if cond {
    let a Heap<i32> = heap:<i32>(11)
    ret a
  }
  let b Heap<i32> = heap:<i32>(22)
  ret b
}

; 验证：NRVO 多返回值优化
#Test
fn test_heap_nrvo_multi_ret() {
  let r1 Heap<i32> = nrvo_pick(true)
  let r2 Heap<i32> = nrvo_pick(false)
  let v1 i32& = as_ref(r1)
  let v2 i32& = as_ref(r2)
  assert_eq(v1, 11)
  assert_eq(v2, 22)
}

; ==================== heap_some / heap_null — Heap<T>? 构造 ====================

; 验证：Heap<T>? 构造函数是否能正确创建包含值的可选堆对象
#Test
fn test_heap_some_constructs_nullable_with_value() {
  let h Heap<i32>? = heap_some(7)
  assert_eq(h.has(), true)
}

; 验证：heap_null 构造空的可选堆
#Test
fn test_heap_null_constructs_empty_nullable() {
  let h Heap<i32>? = heap_null:<i32>()
  assert_eq(h.has(), false)
}

; 验证：Heap 的 has 方法在 Some 和 Null 状态下的区别
#Test
fn test_heap_some_and_null_distinct() {
  let a Heap<i32>? = heap_some(1)
  let b Heap<i32>? = heap_null:<i32>()
  assert_eq(a.has(), true)
  assert_eq(b.has(), false)
}

; ==================== B 档 nullable move 调用点写回 ====================

fn bdang_consume(h Heap<i32>?) i32 {
  if h.has() {
    ret 42
  }
  ret 0
}

; 验证：Heap 的 has 和 consume 方法行为
#Test
fn test_heap_bdang_call_site_writeback() {
  let a Heap<i32>? = heap_some(5)
  assert_eq(a.has(), true)
  let r i32 = bdang_consume(a)
  assert_eq(r, 42)
  assert_eq(a.has(), false)
}

; 验证：Heap 在 consume 后仍然可以正常使用
#Test
fn test_heap_bdang_no_double_free() {
  let a Heap<i32>? = heap_some(7)
  let _ i32 = bdang_consume(a)
  let b Heap<i32>? = heap_some(11)
  assert_eq(b.has(), true)
}

; 验证：heap_null 返回的空堆栈传递给 bdang_consume 后，返回值和堆栈状态正确
#Test
fn test_heap_bdang_null_arg_passthrough() {
  let a Heap<i32>? = heap_null:<i32>()
  let r i32 = bdang_consume(a)
  assert_eq(r, 0)
  assert_eq(a.has(), false)
}

; ==================== 字段 move-out（struct-lit + local id） ====================

struct HeapNullableHolder {
  buf Heap<i32>?

  #Static
  fn make() HeapNullableHolder {
    ret Self {
      .buf = heap_some(123)
    }
  }
}

struct HeapNullableTarget {
  buf Heap<i32>?

  #Static
  fn from_local_struct_field() HeapNullableTarget {
    let tmp HeapNullableHolder = HeapNullableHolder::make()
    ret Self {
      .buf = tmp.buf
    }
  }

  #Static
  fn from_local_id(h Heap<i32>?) HeapNullableTarget {
    ret Self {
      .buf = h
    }
  }
}

; 验证：HeapNullableTarget 构造函数从局部结构体字段移动出数据
#Test
fn test_heap_3d3_struct_lit_field_moveout() {
  let t HeapNullableTarget = HeapNullableTarget::from_local_struct_field()
  assert_eq(t.buf.has(), true)
}

; 验证：HeapNullableTarget 从本地 ID 创建并检查 has 方法返回值
#Test
fn test_heap_3d3_struct_lit_local_id_moveout() {
  let t HeapNullableTarget = HeapNullableTarget::from_local_id(heap_some(7))
  assert_eq(t.buf.has(), true)
}

; 验证：HeapNullableHolder 结构体的堆可选字段在创建时初始化为非空
#Test
fn test_heap_3d3_struct_with_heap_nullable_field_no_leak() {
  let a HeapNullableHolder = HeapNullableHolder::make()
  let b HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(a.buf.has(), true)
  assert_eq(b.buf.has(), true)
}

fn bdang_field_consume(h Heap<i32>?) bool {
  ret h.has()
}

; 验证：HeapNullableHolder 的 buf 字段在调用 consume 后变为 null
#Test
fn test_heap_3d3_call_site_field_lvalue_writeback() {
  let h HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(h.buf.has(), true)
  let r bool = bdang_field_consume(h.buf)
  assert_eq(r, true)
  assert_eq(h.buf.has(), false)
}

; 验证：HeapNullableHolder 的字段在调用时不会导致双重释放
#Test
fn test_heap_3d3_call_site_field_no_double_free() {
  let h HeapNullableHolder = HeapNullableHolder::make()
  let _ bool = bdang_field_consume(h.buf)
  let h2 HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(h2.buf.has(), true)
}

; ==================== Lambda 捕获 Heap<T>? ====================

; 验证：Lambda 捕获可选堆并移动所有权
#Test
fn test_heap_3e_lambda_move_capture_nullable() {
  let h Heap<i32>? = heap_some(33)
  let f fn()bool = {
    h.has()
  }
  assert_eq(h.has(), false)
  assert_eq(f(), true)
}

; 验证：空堆捕获 lambda 函数调用
#Test
fn test_heap_3e_lambda_move_capture_null_source() {
  let h Heap<i32>? = heap_null:<i32>()
  let f fn()bool = {
    h.has()
  }
  assert_eq(h.has(), false)
  assert_eq(f(), false)
}

; 验证：Lambda 捕获堆对象后，堆对象不会被重复释放
#Test
fn test_heap_3e_lambda_move_capture_no_double_free() {
  let h Heap<i32>? = heap_some(7)
  let f fn()bool = {
    h.has()
  }
  let _ bool = f()
  let h2 Heap<i32>? = heap_some(11)
  assert_eq(h2.has(), true)
}

; ==================== copy_of（深拷贝） ====================

; 验证：Heap 深拷贝后值不变
#Test
fn test_heap_3f_copy_of_owned_scalar() {
  let a Heap<i32> = heap:<i32>(99)
  let b Heap<i32> = copy_of(a)
  let ra i32& = as_ref(a)
  let rb i32& = as_ref(b)
  assert_eq(ra, 99)
  assert_eq(rb, 99)
}

struct CopyHeapBox {
  k i32

  #Static
  fn make(k i32) CopyHeapBox {
    ret Self {
      .k = k
    }
  }
}

; 验证：CopyHeapBox 在堆上复制后，两个变量的值保持一致
#Test
fn test_heap_3f_copy_of_owned_struct() {
  let a Heap<CopyHeapBox> = heap:<CopyHeapBox>(CopyHeapBox::make(7))
  let b Heap<CopyHeapBox> = copy_of(a)
  let ra CopyHeapBox& = as_ref(a)
  let rb CopyHeapBox& = as_ref(b)
  assert_eq(ra.k, 7)
  assert_eq(rb.k, 7)
}

; 验证：Heap 的 copy_of 函数对 Some 值的复制行为
#Test
fn test_heap_3f_copy_of_nullable_some() {
  let a Heap<i32>? = heap_some(33)
  let b Heap<i32>? = copy_of(a)
  assert_eq(a.has(), true)
  assert_eq(b.has(), true)
}

; 验证：Nullable Heap 复制后都为空
#Test
fn test_heap_3f_copy_of_nullable_null() {
  let a Heap<i32>? = heap_null:<i32>()
  let b Heap<i32>? = copy_of(a)
  assert_eq(a.has(), false)
  assert_eq(b.has(), false)
}

; 验证：Heap 复制操作不会导致双重释放
#Test
fn test_heap_3f_copy_of_no_double_free() {
  let a Heap<i32> = heap:<i32>(1)
  let b Heap<i32> = copy_of(a)
  let c Heap<i32> = heap:<i32>(2)
  let rc i32& = as_ref(c)
  assert_eq(rc, 2)
}

; ==================== FFI Heap ↔ Ptr 互转 ====================

; 验证：FFI 地址与堆值之间的相互转换
#Test
fn test_heap_8_ffi_ptr_roundtrip_scalar() {
  let h1 Heap<i32> = heap:<i32>(123)
  let p Ptr = ptr_of(h1)
  let h2 Heap<i32> = _heap_take:<i32>(p)
  let r i32& = as_ref(h2)
  assert_eq(r, 123)
}

; 验证：FFI 指针在堆上的双向传递和引用转换
#Test
fn test_heap_8_ffi_ptr_roundtrip_struct() {
  let h1 Heap<CopyHeapBox> = heap:<CopyHeapBox>(CopyHeapBox::make(42))
  let p Ptr = ptr_of(h1)
  let h2 Heap<CopyHeapBox> = _heap_take:<CopyHeapBox>(p)
  let r CopyHeapBox& = as_ref(h2)
  assert_eq(r.k, 42)
}

; 验证：FFI 指针在堆上分配和释放，确保无双重释放
#Test
fn test_heap_8_ffi_ptr_no_double_free() {
  let a Heap<i32> = heap:<i32>(1)
  let pa Ptr = ptr_of(a)
  let a2 Heap<i32> = _heap_take:<i32>(pa)

  let b Heap<i32> = heap:<i32>(2)
  let pb Ptr = ptr_of(b)
  let b2 Heap<i32> = _heap_take:<i32>(pb)

  let ra i32& = as_ref(a2)
  let rb i32& = as_ref(b2)
  assert_eq(ra, 1)
  assert_eq(rb, 2)
}

; ==================== 分配/释放生命周期验证 ====================

; 验证：Heap 分配与释放生命周期
#Test
fn test_heap_9_alloc_free_lifecycle() {
  let h1 Heap<i32> = heap:<i32>(77)
  let r1 i32& = as_ref(h1)
  assert_eq(r1, 77)

  let h2 Heap<i32> = heap:<i32>(88)
  let r2 i32& = as_ref(h2)
  assert_eq(r2, 88)
}
