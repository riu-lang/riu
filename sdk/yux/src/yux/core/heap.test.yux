; Heap<T> 行为测试
;
; 覆盖：
;   - 基础构造 + as_ref
;   - 自动解引用：字段访问、方法调用（builtin + struct）、运算符、位运算
;   - 生命周期：重赋、多局部、嵌套作用域、NRVO
;   - Heap<T>?（Nullable）：heap_some / heap_null / B 档 move / 字段 move-out
;   - Lambda 捕获 Heap<T>?
;   - copy_of（深拷贝）
;   - FFI ptr_of / _heap_take 互转
;   - 分配/释放生命周期验证
;
; 负面诊断（E3028 / E4023 / E4024 / E4025）见 tests/check-cases/diag_heap_*.

; ==================== 辅助类型 ====================

struct HeapBox {
  k i32

  #Static
  fn make(k i32) HeapBox {
    ret Self {
      .k = k
    }
  }

  fn get_k() i32 {
    ret $.k
  }
}

struct Vec2f {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2f {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn len_sq() f64 {
    ret $.x * $.x + $.y * $.y
  }
}

struct HeapWrap {
  inner Heap<i32>

  #Static
  fn make(v i32) HeapWrap {
    ret Self {
      .inner = heap:<i32>(v)
    }
  }
}

; ==================== 基础构造 + as_ref ====================

; 验证：Heap 构造与 as_ref 转换
#Test
fn test_heap_scalar_ctor_and_as_ref() {
  let h Heap<i32> = heap:<i32>(42)
  let r i32& = as_ref(h)
  assert_eq(r, 42)
}

; 验证：堆结构构造后字段读取
#Test
fn test_heap_struct_ctor_field_read() {
  let h Heap<HeapBox> = heap:<HeapBox>(HeapBox::make(7))
  let r HeapBox& = as_ref(h)
  assert_eq(r.k, 7)
}

; ==================== 自动解引用：字段访问 ====================

; 验证：堆字段访问
#Test
fn test_heap_field_access() {
  let h Heap<HeapBox> = heap:<HeapBox>(HeapBox::make(42))
  assert_eq(h.k, 42)
}

; 验证：堆上嵌套结构体字段访问
#Test
fn test_heap_field_access_nested() {
  let h Heap<Vec2f> = heap:<Vec2f>(Vec2f::make(3.0, 4.0))
  assert_eq(h.x, 3.0)
  assert_eq(h.y, 4.0)
}

