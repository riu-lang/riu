; DRAFT-heap-types §8.3a Heap<T> 行为用例（Phase 2.9）
; 覆盖：Heap:<T>(...) 构造、as_ref(Heap<T>) 借用、可变 Heap 重赋、
;       struct 字段 Heap<T> 析构、嵌套 Heap 构造、多次 as_ref 共享借用。
; 负面诊断（E3028 / E4023 / E4024 / E4025）见 tests/cases/diag_heap_*.

struct HeapBox {
  k i32
}

HeapBox {
  #Static
  fn make(k i32) HeapBox {
    ret Self {
      .k = k
    }
  }
}

struct HeapWrap {
  inner Heap<i32>
}

HeapWrap {
  #Static
  fn make(v i32) HeapWrap {
    ret Self {
      .inner = Heap:<i32>(v)
    }
  }
}

; ---------- 1. 标量 Heap<i32>：ctor + as_ref + 读 ----------

#Test
fn test_heap_scalar_ctor_and_as_ref() {
  let h Heap<i32> = Heap:<i32>(42i32)
  let r i32& = as_ref(h)
  assert_eq(r, 42i32)
}

; ---------- 2. Heap<S>：as_ref 解到 S& 后读字段 ----------

#Test
fn test_heap_struct_ctor_field_read() {
  let h Heap<HeapBox> = Heap:<HeapBox>(HeapBox::make(7i32))
  let r HeapBox& = as_ref(h)
  assert_eq(r.k, 7i32)
}

; ---------- 3. #Mut Heap：重赋必须是 Heap:<T>(...) 新构造 ----------

#Test
fn test_heap_mut_reassign_fresh_ctor() {
  #Mut let h Heap<i32> = Heap:<i32>(1i32)
  h = Heap:<i32>(99i32)
  let r i32& = as_ref(h)
  assert_eq(r, 99i32)
}

; ---------- 4. 同一 Heap 句柄两次 as_ref（共享借用） ----------

#Test
fn test_heap_two_as_ref_shared() {
  let h Heap<HeapBox> = Heap:<HeapBox>(HeapBox::make(13i32))
  let r1 HeapBox& = as_ref(h)
  let r2 HeapBox& = as_ref(h)
  assert_eq(r1.k, 13i32)
  assert_eq(r2.k, 13i32)
}

; ---------- 5. struct 字段 Heap<T>：构造 + scope-end 走 __yux_heap_free ----------
;   仅验证编译 + 运行无崩溃（Heap 无 RC 头，精确 leak 检测需 ASan；
;   此处看 callFieldDestructor 的 Heap 分支是否在出口正确触发）。
;   注：as_ref 现仅识别 ID 实参根，无法直接借用 w.inner（borrow_checker
;   E4001 兜底）；这里仅压构造 + scope 析构路径。

#Test
fn test_heap_inside_struct_field() {
  let w HeapWrap = HeapWrap::make(31i32)
  assert_eq(1i32, 1i32)
}

; ---------- 6. 同函数多个 Heap 局部：scope 析构顺序 ----------

#Test
fn test_heap_multi_locals_scope_drop() {
  let a Heap<i32> = Heap:<i32>(2i32)
  let b Heap<i32> = Heap:<i32>(4i32)
  let c Heap<i32> = Heap:<i32>(8i32)
  let ra i32& = as_ref(a)
  let rb i32& = as_ref(b)
  let rc i32& = as_ref(c)
  assert_eq(ra + rb + rc, 14i32)
}

; ---------- 7. 嵌套块作用域：内层 Heap 在块尾析构，不影响外层 ----------

#Test
fn test_heap_nested_block_scope() {
  let outer Heap<i32> = Heap:<i32>(100i32)
  {
    let inner Heap<i32> = Heap:<i32>(200i32)
    let ri i32& = as_ref(inner)
    assert_eq(ri, 200i32)
  }
  let ro i32& = as_ref(outer)
  assert_eq(ro, 100i32)
}

; ---------- 8. Heap 字段 + 顶层 Heap 同时构造（双重析构路径） ----------

#Test
fn test_heap_field_and_top_heap_coexist() {
  let w HeapWrap = HeapWrap::make(50i32)
  let h Heap<i32> = Heap:<i32>(60i32)
  let rh i32& = as_ref(h)
  assert_eq(rh, 60i32)
}

; ---------- 9. Phase 3c NRVO：return Heap<T> 移交所有权给调用方 ----------
;   `ret <local Heap>` 走 NRVO（borrow_checker 放行 + codegen 跳 dtor）；
;   调用方 `let r Heap<T> = call()` 接管 fresh handover（E4024 放行 ExprCallNode 形态）。

fn nrvo_make_h(v i32) Heap<i32> {
  let h Heap<i32> = Heap:<i32>(v)
  ret h
}

#Test
fn test_heap_nrvo_return_local() {
  let r Heap<i32> = nrvo_make_h(77i32)
  let v i32& = as_ref(r)
  assert_eq(v, 77i32)
}

; ---------- Phase 3d MVP: heap_some / heap_null 构造 Heap<T>? ----------

#Test
fn test_heap_some_constructs_nullable_with_value() {
  let h Heap<i32>? = heap_some(7i32)
  assert_eq(h.has(), true)
}

#Test
fn test_heap_null_constructs_empty_nullable() {
  let h Heap<i32>? = heap_null:<i32>()
  assert_eq(h.has(), false)
}

#Test
fn test_heap_some_and_null_distinct() {
  let a Heap<i32>? = heap_some(1i32)
  let b Heap<i32>? = heap_null:<i32>()
  assert_eq(a.has(), true)
  assert_eq(b.has(), false)
}

; ---------- 10. NRVO 多 ret：同 fn 多分支各自接管自身 slot ----------

fn nrvo_pick(cond bool) Heap<i32> {
  if cond {
    let a Heap<i32> = Heap:<i32>(11i32)
    ret a
  }
  let b Heap<i32> = Heap:<i32>(22i32)
  ret b
}

#Test
fn test_heap_nrvo_multi_ret() {
  let r1 Heap<i32> = nrvo_pick(true)
  let r2 Heap<i32> = nrvo_pick(false)
  let v1 i32& = as_ref(r1)
  let v2 i32& = as_ref(r2)
  assert_eq(v1, 11i32)
  assert_eq(v2, 22i32)
}

; ---------- Phase 3d.2: B 档 nullable move 调用点写回 ----------

fn bdang_consume(h Heap<i32>?) i32 {
  if h.has() {
    ret 42i32
  }
  ret 0i32
}

#Test
fn test_heap_bdang_call_site_writeback() {
  ; callee 接管 Heap<i32>? 后, 调用方 slot 被写回 {has=false, value=null}
  let a Heap<i32>? = heap_some(5i32)
  assert_eq(a.has(), true)
  let r i32 = bdang_consume(a)
  assert_eq(r, 42i32)
  assert_eq(a.has(), false)
}

#Test
fn test_heap_bdang_no_double_free() {
  ; B 档写回后 caller 作用域尾析构应跳过 free (_has=false), 与 callee 析构不冲突.
  ; 之后再分配一个新 Heap<i32>? 不应触发 double-free / use-after-free.
  let a Heap<i32>? = heap_some(7i32)
  let _ i32 = bdang_consume(a)
  let b Heap<i32>? = heap_some(11i32)
  assert_eq(b.has(), true)
}

#Test
fn test_heap_bdang_null_arg_passthrough() {
  ; B 档触发条件不依赖 _has=true; null 槽传入照样写回 (no-op 等价).
  let a Heap<i32>? = heap_null:<i32>()
  let r i32 = bdang_consume(a)
  assert_eq(r, 0i32)
  assert_eq(a.has(), false)
}

; ---------- Phase 3d.3: 字段 move-out (同函数 struct-lit) + B 档 字段 lvalue 实参 ----------

struct HeapNullableHolder {
  buf Heap<i32>?
}

HeapNullableHolder {
  #Static
  fn make() HeapNullableHolder {
    ret Self {
      .buf = heap_some(123i32)
    }
  }
}

struct HeapNullableTarget {
  buf Heap<i32>?
}

HeapNullableTarget {
  #Static
  fn from_local_struct_field() HeapNullableTarget {
    ; 同函数局部 struct 字段 move-out: tmp.buf -> Self.buf, tmp.buf 写 null;
    ; tmp scope-end dtor 看 _has=false 跳 free, 与新 Target 不冲突.
    let tmp HeapNullableHolder = HeapNullableHolder::make()
    ret Self {
      .buf = tmp.buf
    }
  }

  #Static
  fn from_local_id(h Heap<i32>?) HeapNullableTarget {
    ; 局部 ID (含 byval 形参) move-out: h -> Self.buf, h alloca 写 null.
    ret Self {
      .buf = h
    }
  }
}

#Test
fn test_heap_3d3_struct_lit_field_moveout() {
  let t HeapNullableTarget = HeapNullableTarget::from_local_struct_field()
  assert_eq(t.buf.has(), true)
}

#Test
fn test_heap_3d3_struct_lit_local_id_moveout() {
  let t HeapNullableTarget = HeapNullableTarget::from_local_id(heap_some(7i32))
  assert_eq(t.buf.has(), true)
}

#Test
fn test_heap_3d3_struct_with_heap_nullable_field_no_leak() {
  ; 含 Heap<T>? 字段的 struct dtor 命中 callFieldDestructor 的新 Nullable<Heap<T>>
  ; 分支 (走 releaseAtPtr), 避免 fallthrough 误查 bare `Nullable_~()`.
  let a HeapNullableHolder = HeapNullableHolder::make()
  let b HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(a.buf.has(), true)
  assert_eq(b.buf.has(), true)
}

fn bdang_field_consume(h Heap<i32>?) bool {
  ret h.has()
}

#Test
fn test_heap_3d3_call_site_field_lvalue_writeback() {
  ; B 档调用点: 实参形态扩展到 lvalue 字段 (b.field), 调用后源字段 _has=false.
  let h HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(h.buf.has(), true)
  let r bool = bdang_field_consume(h.buf)
  assert_eq(r, true)
  assert_eq(h.buf.has(), false)
}

#Test
fn test_heap_3d3_call_site_field_no_double_free() {
  ; move-out 后 h.buf=null, scope-end 跳 free; 再分配新 holder 不应崩.
  let h HeapNullableHolder = HeapNullableHolder::make()
  let _ bool = bdang_field_consume(h.buf)
  let h2 HeapNullableHolder = HeapNullableHolder::make()
  assert_eq(h2.buf.has(), true)
}

; ---------- Phase 3e: Lambda 捕获 Heap ----------
; - Heap<T>? 按所有权 move 捕获: outer 写 null, env 持有, lambda 调用后 env 释放
; - Heap<T>& / Heap<T>?& 走既有 T& 借用透传 (零代码改动)
; - Heap<T> 非空按值捕获 → E4024 (诊断用例见 tests/cases/diag_heap_lambda_*)

#Test
fn test_heap_3e_lambda_move_capture_nullable() {
  ; 捕获 Heap<i32>? 走 B 档 move: outer h 写回 null, 调用 lambda 走 env 内的副本.
  let h Heap<i32>? = heap_some(33i32)
  let f fn()bool = {
    h.has()
  }
  assert_eq(h.has(), false)
  assert_eq(f(), true)
}

#Test
fn test_heap_3e_lambda_move_capture_null_source() {
  ; null 源捕获: outer 写回 null (no-op 等价), env 持 _has=false 副本.
  let h Heap<i32>? = heap_null:<i32>()
  let f fn()bool = {
    h.has()
  }
  assert_eq(h.has(), false)
  assert_eq(f(), false)
}

#Test
fn test_heap_3e_lambda_move_capture_no_double_free() {
  ; 捕获 + lambda dtor 释放 env 内 Heap<i32>?; outer 跳 free; 再分配应稳定.
  let h Heap<i32>? = heap_some(7i32)
  let f fn()bool = {
    h.has()
  }
  let _ bool = f()
  let h2 Heap<i32>? = heap_some(11i32)
  assert_eq(h2.has(), true)
}

; ---------- Phase 3f / 6: copy_of 扩展 Heap ----------
; copy_of(h Heap<T>&)  → 新分配 + 写入 inner T + 递归 retain T 的 RC 字段
; copy_of(h Heap<T>?&) → null → null; some → 同 Heap<T>&
; 与 Rc 浅拷不同: Heap 单 owner, 拷贝必须深; 否则双 owner 同一 ptr → double-free

#Test
fn test_heap_3f_copy_of_owned_scalar() {
  let a Heap<i32> = Heap:<i32>(99i32)
  let b Heap<i32> = copy_of:<Heap<i32>>(a)
  let ra i32& = as_ref(a)
  let rb i32& = as_ref(b)
  assert_eq(ra, 99i32)
  assert_eq(rb, 99i32)
}

struct CopyHeapBox {
  k i32
}

CopyHeapBox {
  #Static
  fn make(k i32) CopyHeapBox {
    ret Self {
      .k = k
    }
  }
}

#Test
fn test_heap_3f_copy_of_owned_struct() {
  let a Heap<CopyHeapBox> = Heap:<CopyHeapBox>(CopyHeapBox::make(7i32))
  let b Heap<CopyHeapBox> = copy_of:<Heap<CopyHeapBox>>(a)
  let ra CopyHeapBox& = as_ref(a)
  let rb CopyHeapBox& = as_ref(b)
  assert_eq(ra.k, 7i32)
  assert_eq(rb.k, 7i32)
}

#Test
fn test_heap_3f_copy_of_nullable_some() {
  let a Heap<i32>? = heap_some(33i32)
  let b Heap<i32>? = copy_of:<Heap<i32>?>(a)
  assert_eq(a.has(), true)
  assert_eq(b.has(), true)
}

#Test
fn test_heap_3f_copy_of_nullable_null() {
  let a Heap<i32>? = heap_null:<i32>()
  let b Heap<i32>? = copy_of:<Heap<i32>?>(a)
  assert_eq(a.has(), false)
  assert_eq(b.has(), false)
}

#Test
fn test_heap_3f_copy_of_no_double_free() {
  ; 两个独立 Heap, 各自作用域尾 __yux_heap_free 不冲突; 再分配应稳定.
  let a Heap<i32> = Heap:<i32>(1i32)
  let b Heap<i32> = copy_of:<Heap<i32>>(a)
  let c Heap<i32> = Heap:<i32>(2i32)
  let rc i32& = as_ref(c)
  assert_eq(rc, 2i32)
}

; ---------- Phase 8: FFI Heap ↔ Ptr 互转 ----------
; ptr_of:<Heap<T>>(h)  → 移交所有权给 Ptr; source slot 写 null 且摘除 _scopeVars
; Heap:<T>(p Ptr)      → 从 Ptr 接管所有权; 作用域尾走 Heap<T> dtor (free + inner release)
; 责任方: Ptr 必须指向 __yux_heap_alloc 分配的 T-shape 内存
; (FFI 上下文门控 8c 延后, 当前不限调用上下文)

#Test
fn test_heap_8_ffi_ptr_roundtrip_scalar() {
  let h1 Heap<i32> = Heap:<i32>(123i32)
  let p Ptr = ptr_of:<Heap<i32>>(h1)
  ; h1 已 moveout; 后续访问由 borrow_checker 兜底 (本测试不复用)
  let h2 Heap<i32> = Heap:<i32>(p)
  let r i32& = as_ref(h2)
  assert_eq(r, 123i32)
}

#Test
fn test_heap_8_ffi_ptr_roundtrip_struct() {
  let h1 Heap<CopyHeapBox> = Heap:<CopyHeapBox>(CopyHeapBox::make(42i32))
  let p Ptr = ptr_of:<Heap<CopyHeapBox>>(h1)
  let h2 Heap<CopyHeapBox> = Heap:<CopyHeapBox>(p)
  let r CopyHeapBox& = as_ref(h2)
  assert_eq(r.k, 42i32)
}

#Test
fn test_heap_8_ffi_ptr_no_double_free() {
  ; 两次 roundtrip 各自独立; 末尾无 dangling.
  let a Heap<i32> = Heap:<i32>(1i32)
  let pa Ptr = ptr_of:<Heap<i32>>(a)
  let a2 Heap<i32> = Heap:<i32>(pa)

  let b Heap<i32> = Heap:<i32>(2i32)
  let pb Ptr = ptr_of:<Heap<i32>>(b)
  let b2 Heap<i32> = Heap:<i32>(pb)

  let ra i32& = as_ref(a2)
  let rb i32& = as_ref(b2)
  assert_eq(ra, 1i32)
  assert_eq(rb, 2i32)
}
