; loop 控制流用例
; 迁自 tests/cases/loop_test.yux
;
; 本文件包含 loop 循环测试:
; - 基本循环与 break
; - 循环内修改外部变量

; ==================== 基本循环 ====================

#Test
fn test_loop_break() {
  #Mut let i i32 = 0
  #Mut let sum i32 = 0
  loop {
    if i >= 5 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(i, 5)
  assert_eq(sum, 0 + 1 + 2 + 3 + 4)
}

; ==================== 循环内修改外部变量 ====================

#Test
fn test_loop_modify_outer() {
  #Mut let counter i32 = 0
  loop {
    counter = counter + 1
    if counter >= 10 {
      break;
    }
  }
  assert_eq(counter, 10)
}

#Test
fn test_loop_accumulate() {
  #Mut let sum i32 = 0
  #Mut let i i32 = 1
  loop {
    if i > 10 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 55)
}

; ==================== loop init（单变量） ====================

#Test
fn test_loop_init_counter() {
  #Mut let sum i32 = 0
  loop i = 0 {
    if i >= 10 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 45)
  assert_eq(i, 10)
}

#Test
fn test_loop_init_type_annot() {
  #Mut let sum i64 = 0
  loop i i64 = 0 {
    if i >= 100 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 4950)
}

#Test
fn test_loop_init_with_bound() {
  let n i32 = 7
  #Mut let count i32 = 0
  loop i = 0 {
    if i >= n {
      break;
    }
    count = count + 1
    i = i + 1
  }
  assert_eq(count, 7)
}

; ==================== loop init（tuple 解构） ====================

#Test
fn test_loop_init_tuple() {
  #Mut let acc i32 = 0
  loop (i, limit) = (0, 5) {
    if i >= limit {
      break;
    }
    acc = acc + i
    i = i + 1
  }
  assert_eq(acc, 0 + 1 + 2 + 3 + 4)
}
