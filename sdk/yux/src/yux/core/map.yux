; yux SDK - Map<K, V>（v0.21 Phase B）
; 纯 yux：平行 Array 线性查找。K 须可 ==（标量或 String）；不承诺 O(1) / 哈希。
; 公开符号经 pkg `map.*` 扁平进 yux.core。

struct Map<K, V> {
  _keys Array<K>
  _vals Array<V>

  #Static
  fn make() Self {
    ret Self {
      ._keys = Array:<K>::with_capacity(0usize)
      ._vals = Array:<V>::with_capacity(0usize)
    }
  }

  fn len() usize {
    ret $._keys.len()
  }

  fn is_empty() bool {
    ret $._keys.is_empty()
  }

  ; 线性查找；未命中返回 null
  fn _index_of(key K&) usize? {
    loop i usize = 0 {
      if i >= $._keys.len() {
        break;
      }
      if $._keys[i] == key {
        ret i
      }
      i += 1
    }
    ret null
  }

  ; 已有键则覆盖值（旧值释放）；否则追加
  fn insert(key K, value V) {
    let i usize? = $._index_of(key)
    if i.has() {
      let idx usize = i.get()
      $._vals[idx] = value
      ret;
    }
    $._keys.push(key)
    $._vals.push(value)
  }

  fn contains(key K&) bool {
    ret $._index_of(key).has()
  }

  fn get(key K&) V? {
    let i usize? = $._index_of(key)
    if !i.has() {
      ret null
    }
    let idx usize = i.get()
    ret copy_of:<V>($._vals[idx])
  }

  ; 命中则 copy 末项填洞 + pop，返回旧值；未命中 null
  fn remove(key K&) V? {
    let i usize? = $._index_of(key)
    if !i.has() {
      ret null
    }
    let idx usize = i.get()
    #Mut let out V = copy_of:<V>($._vals[idx])
    let last usize = $._keys.len() - 1
    if idx != last {
      $._keys[idx] = copy_of:<K>($._keys[last])
      $._vals[idx] = copy_of:<V>($._vals[last])
    }
    $._keys.pop()
    $._vals.pop()
    ret out
  }
}
