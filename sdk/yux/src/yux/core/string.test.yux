; String 行为测试
;
; 覆盖：
;   - 等值比较（== / !=）
;   - contains / starts_with（含 String& 形参直接调用）
;   - 转义序列与原始字符串（\n \t \" r"..."）
;   - \$ 转义与字符串模板插值（$id / ${expr} / UTF-8）
;   - ToString 自动分发（i32 / i64 / u64 / bool / f64）
;   - String + 链式连接（含左右非 String、混合类型链）
;   - 边界条件（空字符串、纯插值）

; ==================== 等值比较 ====================

#Test
fn test_string_eq_basic() {
  let a String = "hello"
  let b String = "hello"
  assert_eq(a, b)
}

#Test
fn test_string_eq_literal() {
  let s String = "world"
  assert_eq(s, "world")
}

#Test
fn test_string_eq_empty() {
  let a String = ""
  let b String = ""
  assert_eq(a, b)
}

; ==================== contains / starts_with ====================

#Test
fn test_string_contains_full() {
  let s String = "hello world"
  assert_contains(s, "hello")
  assert_contains(s, "world")
  assert_contains(s, "o w")
  assert_contains(s, "d")
}

#Test
fn test_string_contains_empty_needle() {
  let s String = "anything"
  assert_contains(s, "")
}

#Test
fn test_string_starts_with_basic() {
  let s String = "hello world"
  assert_starts_with(s, "hello")
  assert_starts_with(s, "h")
  assert_starts_with(s, "hello world")
}

#Test
fn test_string_starts_with_empty_prefix() {
  let s String = "x"
  assert_starts_with(s, "")
}

; String& 形参直接调用
#Test
fn test_string_starts_with_direct() {
  let s String = "hello world"
  assert_true(s.starts_with("hello"))
  assert_false(s.starts_with("world"))
}

#Test
fn test_string_contains_direct() {
  let s String = "foo bar baz"
  assert_true(s.contains("bar"))
  assert_false(s.contains("qux"))
}

; ==================== 转义序列 ====================

#Test
fn test_string_escape_newline_codepoint() {
  let s String = "a\nb"
  assert_eq(s.len(), 3)
  assert_eq(s.get(0), 97u32)
  assert_eq(s.get(1), 10u32)
  assert_eq(s.get(2), 98u32)
}

#Test
fn test_string_escape_tab_codepoint() {
  let s String = "x\ty"
  assert_eq(s.len(), 3)
  assert_eq(s.get(1), 9u32)
}

#Test
fn test_string_escape_quote_codepoint() {
  let s String = "\""
  assert_eq(s.len(), 1)
  assert_eq(s.get(0), 34u32)
}

; ==================== 原始字符串 ====================

#Test
fn test_string_raw_keeps_backslash() {
  let s String = r"\n"
  assert_eq(s.len(), 2)
  assert_eq(s.get(0), 92u32)
  assert_eq(s.get(1), 110u32)
}

#Test
fn test_string_raw_path() {
  let s String = r"C:\path"
  assert_eq(s.len(), 7)
  assert_eq(s.get(2), 92u32)
}

; ==================== \$ 转义 ====================

#Test
fn test_string_dollar_escape_codepoint() {
  let s String = "price=\$5"
  assert_eq(s.len(), 8)
  assert_eq(s.get(6), 36u32)
}

#Test
fn test_string_dollar_escape_only() {
  let s String = "\$"
  assert_eq(s.len(), 1)
  assert_eq(s.get(0), 36u32)
}

; ==================== 字符串模板插值（$id / ${expr}） ====================

#Test
fn test_string_template_dollar_id() {
  let name String = "yux"
  let s String = "hello, $name!"
  assert_eq(s.len(), 11)
  assert_eq(s, "hello, yux!")
}

#Test
fn test_string_template_id_surrounded() {
  let name String = "x"
  let s String = "[$name]"
  assert_eq(s, "[x]")
}

#Test
fn test_string_template_brace_interp() {
  let a String = "x"
  let b String = "y"
  let s String = "${a}=${b}"
  assert_eq(s, "x=y")
}

#Test
fn test_string_template_mixed_text() {
  let v String = "world"
  let s String = "hi ${v}, bye"
  assert_eq(s, "hi world, bye")
}

#Test
fn test_string_template_empty_part() {
  let a String = "ab"
  let b String = "cd"
  let s String = "${a}${b}"
  assert_eq(s, "abcd")
}

#Test
fn test_string_template_utf8_part() {
  let v String = "中"
  let s String = "前${v}后"
  assert_eq(s.len(), 3)
  assert_eq(s.get(0), 21069u32)
  assert_eq(s.get(1), 20013u32)
  assert_eq(s.get(2), 21518u32)
}

; ==================== ToString 自动分发 ====================

#Test
fn test_string_template_i32_interp() {
  let n i32 = 42
  let s String = "n=${n}"
  assert_eq(s, "n=42")
}

#Test
fn test_string_template_i64_literal_interp() {
  let s String = "x=${1234}"
  assert_eq(s, "x=1234")
}

#Test
fn test_string_template_bool_interp() {
  let b bool = true
  let s String = "b=${b}"
  assert_eq(s, "b=true")
  let s2 String = "b=${false}"
  assert_eq(s2, "b=false")
}

#Test
fn test_string_template_u64_interp() {
  let n u64 = 0
  let s String = "n=${n}"
  assert_eq(s, "n=0")
}

#Test
fn test_string_template_f64_interp() {
  let f f64 = 3.14f64
  let s String = "${f}"
  ; "3.140000" — f64 固定 6 位小数
  assert_eq(s.len(), 8)
}

#Test
fn test_string_template_mixed_kind_interp() {
  let name String = "yux"
  let n i32 = 7
  let s String = "$name v${n}"
  assert_eq(s, "yux v7")
}

; ==================== String + 链式连接 ====================

#Test
fn test_string_plus_two() {
  let a String = "foo"
  let b String = "bar"
  let s String = a + b
  assert_eq(s, "foobar")
}

#Test
fn test_string_plus_chain() {
  let a String = "a"
  let b String = "b"
  let c String = "c"
  let d String = "d"
  let s String = a + b + c + d
  assert_eq(s, "abcd")
}

#Test
fn test_string_plus_with_literal() {
  let name String = "yux"
  let s String = "hello, " + name + "!"
  assert_eq(s, "hello, yux!")
}

#Test
fn test_string_plus_to_string() {
  let n i32 = 42
  let s String = "n=" + n
  assert_eq(s, "n=42")
}

#Test
fn test_string_plus_left_non_string() {
  let n i64 = 7
  let s String = n + " items"
  assert_eq(s, "7 items")
}

#Test
fn test_string_plus_mixed_chain() {
  let name String = "yux"
  let v i32 = 6
  let ok bool = true
  let s String = name + " v" + v + " ok=" + ok
  assert_eq(s, "yux v6 ok=true")
}

#Test
fn test_string_plus_empty_left() {
  let s String = "" + "tail"
  assert_eq(s, "tail")
}

#Test
fn test_string_plus_utf8() {
  let a String = "你好"
  let b String = "世界"
  let s String = a + "，" + b
  assert_eq(s, "你好，世界")
}

#Test
fn test_string_plus_nested_expr() {
  ; 括号表达式在 + 链中
  let x i32 = 10
  let y i32 = 20
  let s String = "sum = " + (x + y)
  assert_eq(s, "sum = 30")
}
