; yux SDK - Win32 内部辅助声明
; 仅向 yux.io 定向开放；用户代码不能通过裸名或 yux.core.helper 访问。

extern {
  fn GetStdHandle(nStdHandle i32) Ptr
  fn WriteFile(hFile Ptr, lpBuffer Ptr, nNumberOfBytesToWrite u32, lpNumberOfBytesWritten Ptr, lpOverlapped Ptr) i32

  #NoReturn
  fn ExitProcess(uExitCode u32)

  fn GetCommandLineW() Ptr
  fn CommandLineToArgvW(lpCmdLine Ptr, pNumArgs Ptr) Ptr
  fn LocalFree(hMem Ptr) Ptr
  fn GetTickCount() u32

  #NoReturn
  fn RaiseException(dwExceptionCode u32, dwExceptionFlags u32, nNumberOfArguments u32, lpArguments Ptr)
}
