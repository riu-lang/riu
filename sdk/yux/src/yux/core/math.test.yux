; ==================== min 无符号整数 ====================

; 验证：无符号整数最小值计算
#Test
fn test_math_min_u8() {
  assert_eq(math.min(10u8, 20u8), 10u8)
  assert_eq(math.min(20u8, 10u8), 10u8)
  assert_eq(math.min(0u8, 255u8), 0u8)
  assert_eq(math.min(200u8, 200u8), 200u8)
}

; 验证：math.min 函数在不同无符号 16 位整数之间的最小值计算
#Test
fn test_math_min_u16() {
  assert_eq(math.min(100u16, 200u16), 100u16)
  assert_eq(math.min(200u16, 100u16), 100u16)
  assert_eq(math.min(0u16, 65535u16), 0u16)
  assert_eq(math.min(1000u16, 1000u16), 1000u16)
}

; 验证：math.min 函数返回两个 u32 类型值中的较小者
#Test
fn test_math_min_u32() {
  assert_eq(math.min(1000u32, 2000u32), 1000u32)
  assert_eq(math.min(2000u32, 1000u32), 1000u32)
  assert_eq(math.min(0u32, 4294967295u32), 0u32)
}

; 验证：math.min 函数返回两个 u64 类型值中的较小者
#Test
fn test_math_min_u64() {
  assert_eq(math.min(10000u64, 20000u64), 10000u64)
  assert_eq(math.min(20000u64, 10000u64), 10000u64)
  assert_eq(math.min(0u64, 18446744073709551615u64), 0u64)
}

; ==================== min f64 ====================

; 验证：math.min 函数返回两个浮点数中的最小值
#Test
fn test_math_min_f64() {
  assert_eq(math.min(1.5, 2.5), 1.5)
  assert_eq(math.min(2.5, 1.5), 1.5)
  assert_eq(math.min(-1.0, 1.0), -1.0)
  assert_eq(math.min(3.14, 3.14), 3.14)
}

; ==================== min f32 ====================

; 验证：math.min 函数返回两个浮点数中的最小值
#Test
fn test_math_min_f32() {
  assert_eq(math.min(1.5f32, 2.5f32), 1.5f32)
  assert_eq(math.min(2.5f32, 1.5f32), 1.5f32)
  assert_eq(math.min(-1.0f32, 1.0f32), -1.0f32)
}

