; ==================== clamp 有符号整数 ====================

; 验证：clamp 函数对有符号整数的边界处理
#Test
fn test_math_clamp_i8() {
  assert_eq(math.clamp(5i8, 0i8, 10i8), 5i8)
  assert_eq(math.clamp(-5i8, 0i8, 10i8), 0i8)
  assert_eq(math.clamp(15i8, 0i8, 10i8), 10i8)
  assert_eq(math.clamp(0i8, 0i8, 10i8), 0i8)
  assert_eq(math.clamp(10i8, 0i8, 10i8), 10i8)
}

; 验证：clamp 函数对 i16 类型的边界值处理
#Test
fn test_math_clamp_i16() {
  assert_eq(math.clamp(50i16, 0i16, 100i16), 50i16)
  assert_eq(math.clamp(-10i16, 0i16, 100i16), 0i16)
  assert_eq(math.clamp(200i16, 0i16, 100i16), 100i16)
}

; 验证：math.clamp 函数对不同值的裁剪行为
#Test
fn test_math_clamp_i32() {
  assert_eq(math.clamp(500i32, 0i32, 1000i32), 500i32)
  assert_eq(math.clamp(-100i32, 0i32, 1000i32), 0i32)
  assert_eq(math.clamp(2000i32, 0i32, 1000i32), 1000i32)
}

; 验证：clamp 函数在不同范围内的行为
#Test
fn test_math_clamp_i64() {
  assert_eq(math.clamp(5000i64, 0i64, 10000i64), 5000i64)
  assert_eq(math.clamp(-1000i64, 0i64, 10000i64), 0i64)
  assert_eq(math.clamp(20000i64, 0i64, 10000i64), 10000i64)
}

