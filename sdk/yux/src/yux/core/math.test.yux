; math.* 标准库测试（Step 1：泛化基础函数）
; 注：#Cval 常量（PI/TAU/E/PHI）当前为文件作用域，跨文件不可见（编译器限制），
; 暂无法在此测试。常量定义见 math.yux。

; ==================== abs f64 ====================

; 验证：f64 类型的绝对值计算
#Test
fn test_math_abs_f64_neg() {
  assert_eq(math.abs(-3.14), 3.14)
}

; 验证：全限定 yux.core.math.abs
#Test
fn test_math_fq_abs() {
  assert_eq(yux.core.math.abs(-3.14), 3.14)
}

; 验证：f64 类型的绝对值计算正确性
#Test
fn test_math_abs_f64_positive() {
  assert_eq(math.abs(2.718), 2.718)
}

; 验证：math.abs 对零值的处理
#Test
fn test_math_abs_f64_zero() {
  assert_eq(math.abs(0.0f64), 0.0f64)
}

; ==================== abs f32 ====================

; 验证：负数的绝对值计算
#Test
fn test_math_abs_f32_neg() {
  assert_eq(math.abs(-1.5f32), 1.5f32)
}

; 验证：正数的 f32 绝对值计算
#Test
fn test_math_abs_f32_positive() {
  assert_eq(math.abs(3.25f32), 3.25f32)
}

; 验证：math.abs 函数对零值的处理
#Test
fn test_math_abs_f32_zero() {
  assert_eq(math.abs(0.0f32), 0.0f32)
