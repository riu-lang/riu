  assert_eq(math.trunc(-3.7), -3.0f64)
  assert_eq(math.trunc(0.9), 0.0f64)
  assert_eq(math.trunc(0.0f64), 0.0f64)
}

; ==================== round f64 ====================

; 验证：浮点数四舍五入行为
#Test
fn test_math_round_f64() {
  assert_eq(math.round(3.3), 3.0f64)
  assert_eq(math.round(3.7), 4.0f64)
  assert_eq(math.round(3.5), 4.0f64)
  assert_eq(math.round(-3.3), -3.0f64)
  assert_eq(math.round(-3.7), -4.0f64)
  assert_eq(math.round(-3.5), -4.0f64)
  assert_eq(math.round(0.0f64), 0.0f64)
}

