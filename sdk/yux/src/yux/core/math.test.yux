; ==================== sqrt f64 ====================

; 验证：math.sqrt 函数对非负数的平方根计算
#Test
fn test_math_sqrt_f64() {
  assert_eq(math.sqrt(0.0f64), 0.0f64)
  assert_eq(math.sqrt(1.0f64), 1.0f64)
  assert_eq(math.sqrt(4.0f64), 2.0f64)
  assert_eq(math.sqrt(9.0f64), 3.0f64)
  assert_eq(math.sqrt(16.0f64), 4.0f64)
  assert_eq(math.sqrt(100.0f64), 10.0f64)
  ; sqrt(2) ≈ 1.414，容忍 f64 误差
  let s2 f64 = math.sqrt(2.0f64)
  assert_true(s2 > 1.414)
  assert_true(s2 < 1.415)
}

; ==================== sqrt f32 ====================

; 验证：sqrt 函数对不同浮点数的平方根计算
#Test
fn test_math_sqrt_f32() {
  assert_eq(math.sqrt_f32(0.0f32), 0.0f32)
  assert_eq(math.sqrt_f32(4.0f32), 2.0f32)
  assert_eq(math.sqrt_f32(25.0f32), 5.0f32)
}

; ==================== sin f64 ====================
; PI ≈ 3.141592653589793，跨文件 #Cval 不可见（BUGS.md），测试中用字面量

#Test
fn test_math_sin_f64() {
  ; sin(0) = 0
  assert_eq(math.sin(0.0f64), 0.0f64)
  ; sin(PI/2) ≈ 1
  let s_pi2 f64 = math.sin(1.5707963267948966)
  assert_true(s_pi2 > 0.999)
  assert_true(s_pi2 < 1.001)
  ; sin(PI) ≈ 0
  let s_pi f64 = math.sin(3.141592653589793)
  assert_true(s_pi > -0.001)
  assert_true(s_pi < 0.001)
  ; sin(-PI/2) ≈ -1
  let s_neg f64 = math.sin(-1.5707963267948966)
  assert_true(s_neg > -1.001)
  assert_true(s_neg < -0.999)
}

; ==================== cos f64 ====================

; 验证：Math cos 函数在不同角度的近似值
#Test
fn test_math_cos_f64() {
  ; cos(0) ≈ 1
  let c0 f64 = math.cos(0.0f64)
  assert_true(c0 > 0.999)
  assert_true(c0 < 1.001)
  ; cos(PI/2) ≈ 0
  let c_pi2 f64 = math.cos(1.5707963267948966)
  assert_true(c_pi2 > -0.001)
  assert_true(c_pi2 < 0.001)
  ; cos(PI) ≈ -1
  let c_pi f64 = math.cos(3.141592653589793)
  assert_true(c_pi > -1.001)
  assert_true(c_pi < -0.999)
}

; ==================== tan f64 ====================

; 验证：tan 函数在不同角度的计算结果
#Test
fn test_math_tan_f64() {
  ; tan(0) = 0
  assert_eq(math.tan(0.0f64), 0.0f64)
  ; tan(PI/4) ≈ 1
  let t f64 = math.tan(0.7853981633974483)
  assert_true(t > 0.999)
  assert_true(t < 1.001)
}

; ==================== exp f64 ====================

; 验证：数学库中 exp 函数的正确性，包括正数、负数和零的情况
#Test
fn test_math_exp_f64() {
  ; exp(0) = 1
  assert_eq(math.exp(0.0f64), 1.0f64)
  ; exp(1) = e ≈ 2.718
  let e1 f64 = math.exp(1.0f64)
  assert_true(e1 > 2.71)
  assert_true(e1 < 2.72)
  ; exp(-1) = 1/e ≈ 0.367
  let en1 f64 = math.exp(-1.0f64)
  assert_true(en1 > 0.36)
  assert_true(en1 < 0.37)
}

; ==================== pow_int f64 ====================

; 验证：整数幂运算的正确性
#Test
fn test_math_pow_int() {
  ; 2^0 = 1
  assert_eq(math.pow_int(2.0f64, 0), 1.0f64)
  ; 2^3 = 8
  assert_eq(math.pow_int(2.0f64, 3), 8.0f64)
  ; 2^10 = 1024
  assert_eq(math.pow_int(2.0f64, 10), 1024.0f64)
  ; 3^4 = 81
  assert_eq(math.pow_int(3.0f64, 4), 81.0f64)
  ; 2^{-1} = 0.5
  assert_eq(math.pow_int(2.0f64, -1), 0.5)
  ; 2^{-2} = 0.25
  assert_eq(math.pow_int(2.0f64, -2), 0.25)
  ; 10^0 = 1
  assert_eq(math.pow_int(10.0f64, 0), 1.0f64)
}

; ==================== ln f64 ====================

; 验证：自然对数函数 ln 的不同值的近似结果
#Test
fn test_math_ln_f64() {
  ; ln(1) = 0
  assert_eq(math.ln(1.0f64), 0.0f64)
  ; ln(e) ≈ 1 (E ≈ 2.718281828459045)
  let lne f64 = math.ln(2.718281828459045)
  assert_true(lne > 0.999)
  assert_true(lne < 1.001)
  ; ln(2) ≈ 0.693147
  let ln2 f64 = math.ln(2.0f64)
  assert_true(ln2 > 0.693)
  assert_true(ln2 < 0.694)
  ; ln(10) ≈ 2.302585
  let ln10 f64 = math.ln(10.0f64)
  assert_true(ln10 > 2.30)
  assert_true(ln10 < 2.31)
}

; ==================== log10 f64 ====================

; 验证：log10 函数的正确性，包括 log10(1)、log10(10) 和 log10(100) 的值
#Test
fn test_math_log10_f64() {
  ; log10(1) = 0
  assert_eq(math.log10(1.0f64), 0.0f64)
  ; log10(10) ≈ 1
  let lg10 f64 = math.log10(10.0f64)
  assert_true(lg10 > 0.999)
  assert_true(lg10 < 1.001)
  ; log10(100) ≈ 2
  let lg100 f64 = math.log10(100.0f64)
  assert_true(lg100 > 1.999)
  assert_true(lg100 < 2.001)
}

; ==================== atan f64 ====================

; 验证：atan 函数在不同输入下的正确性，包括边界值和奇函数性质
#Test
fn test_math_atan_f64() {
  ; atan(0) = 0
  assert_eq(math.atan(0.0f64), 0.0f64)
  ; atan(1) ≈ π/4 ≈ 0.7854
  let a1 f64 = math.atan(1.0f64)
  assert_true(a1 > 0.785)
  assert_true(a1 < 0.786)
  ; atan(∞) ≈ π/2 ≈ 1.5708
  let a_big f64 = math.atan(10000000000.0f64)
  assert_true(a_big > 1.56)
  assert_true(a_big < 1.58)
  ; atan(-1) ≈ -π/4: 奇函数
  let a_neg f64 = math.atan(-1.0f64)
  assert_true(a_neg > -0.786)
  assert_true(a_neg < -0.785)
}

; ==================== asin f64 ====================

; 验证：asin 函数在不同值下的正确性，包括边界值和奇函数性质
#Test
fn test_math_asin_f64() {
  ; asin(0) = 0
  assert_eq(math.asin(0.0f64), 0.0f64)
  ; asin(1) ≈ π/2 ≈ 1.5708
  let a1 f64 = math.asin(1.0f64)
  assert_true(a1 > 1.56)
  assert_true(a1 < 1.58)
  ; asin(0.5) ≈ π/6 ≈ 0.5236
  let a05 f64 = math.asin(0.5)
  assert_true(a05 > 0.523)
  assert_true(a05 < 0.524)
  ; asin(-0.5) 奇函数
  let a_neg f64 = math.asin(-0.5)
  assert_true(a_neg > -0.524)
  assert_true(a_neg < -0.523)
}

; ==================== acos f64 ====================

; 验证：acos 函数在不同输入值下的正确性
#Test
fn test_math_acos_f64() {
  ; acos(1) = 0
  assert_eq(math.acos(1.0f64), 0.0f64)
  ; acos(0) ≈ π/2 ≈ 1.5708
  let a0 f64 = math.acos(0.0f64)
  assert_true(a0 > 1.56)
  assert_true(a0 < 1.58)
  ; acos(-1) ≈ π
  let a_neg1 f64 = math.acos(-1.0f64)
  assert_true(a_neg1 > 3.14)
  assert_true(a_neg1 < 3.15)
}

; ==================== sinh f64 ====================

; 验证：math.sinh 函数的正确性，包括 sinh(0)、正数和负数的情况
#Test
fn test_math_sinh_f64() {
  ; sinh(0) = 0
  assert_eq(math.sinh(0.0f64), 0.0f64)
  ; sinh(1) = (e - 1/e)/2 ≈ 1.1752
  let s1 f64 = math.sinh(1.0f64)
  assert_true(s1 > 1.17)
  assert_true(s1 < 1.18)
  ; sinh 奇函数
  let s_neg f64 = math.sinh(-1.0f64)
  assert_true(s_neg > -1.18)
  assert_true(s_neg < -1.17)
}

; ==================== cosh f64 ====================

; 验证：cosh 函数的正确性，包括在 0、1 及其负值处的计算结果
#Test
fn test_math_cosh_f64() {
  ; cosh(0) = 1
  assert_eq(math.cosh(0.0f64), 1.0f64)
  ; cosh(1) = (e + 1/e)/2 ≈ 1.5431
  let c1 f64 = math.cosh(1.0f64)
  assert_true(c1 > 1.54)
  assert_true(c1 < 1.55)
  ; cosh 偶函数
  let c_neg f64 = math.cosh(-1.0f64)
  assert_true(c_neg > 1.54)
  assert_true(c_neg < 1.55)
}

; ==================== tanh f64 ====================

; 验证：tanh 函数在不同值下的行为，包括奇函数性质和大值近似
#Test
fn test_math_tanh_f64() {
  ; tanh(0) = 0
  assert_eq(math.tanh(0.0f64), 0.0f64)
  ; tanh(1) ≈ 0.7616
  let t1 f64 = math.tanh(1.0f64)
  assert_true(t1 > 0.76)
  assert_true(t1 < 0.77)
  ; tanh 奇函数
  let t_neg f64 = math.tanh(-1.0f64)
  assert_true(t_neg > -0.77)
  assert_true(t_neg < -0.76)
  ; tanh 大值 → 1（仅粗略检验，exp(x) 在 |x|≥10 时 Taylor 精度有限）
  let t_big f64 = math.tanh(10.0f64)
  assert_true(t_big > 0.99)
}

; ==================== pow_f64 ====================

; 验证：math.pow_f64 函数的幂运算结果是否正确
#Test
fn test_math_pow_f64() {
  ; 2^0.5 = sqrt(2) ≈ 1.4142
  let p1 f64 = math.pow_f64(2.0f64, 0.5)
  assert_true(p1 > 1.414)
  assert_true(p1 < 1.415)
  ; 10^2 = 100
  let p2 f64 = math.pow_f64(10.0f64, 2.0f64)
  assert_true(p2 > 99.9)
  assert_true(p2 < 100.1)
  ; e^1 ≈ 2.718
  let p3 f64 = math.pow_f64(2.718281828459045, 1.0f64)
  assert_true(p3 > 2.71)
  assert_true(p3 < 2.72)
  ; 任何数^0 = 1
  assert_eq(math.pow_f64(5.0f64, 0.0f64), 1.0f64)
}
