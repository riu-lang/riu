; ==================== sign 有符号整数 ====================

; 验证：math.sign 函数对有符号整数的符号进行判断
#Test
fn test_math_sign_i8() {
  assert_eq(math.sign(42i8), 1)
  assert_eq(math.sign(-42i8), -1)
  assert_eq(math.sign(0i8), 0)
  assert_eq(math.sign(127i8), 1)
  assert_eq(math.sign(-128i8), -1)
}

; 验证：math.sign 函数对 i16 类型的符号处理
#Test
fn test_math_sign_i16() {
  assert_eq(math.sign(100i16), 1)
  assert_eq(math.sign(-100i16), -1)
  assert_eq(math.sign(0i16), 0)
}

; 验证：math.sign 函数对 i32 类型的正负零值返回正确的符号
#Test
fn test_math_sign_i32() {
  assert_eq(math.sign(1000i32), 1)
  assert_eq(math.sign(-1000i32), -1)
  assert_eq(math.sign(0i32), 0)
}

; 验证：math.sign 函数对 i64 类型的符号进行正确判断
#Test
fn test_math_sign_i64() {
  assert_eq(math.sign(10000i64), 1)
  assert_eq(math.sign(-10000i64), -1)
  assert_eq(math.sign(0i64), 0)
}

; ==================== floor f64 ====================

; 验证：math.floor 函数对不同浮点数的向下取整行为
#Test
fn test_math_floor_f64() {
  assert_eq(math.floor(3.7), 3.0f64)
  assert_eq(math.floor(3.0f64), 3.0f64)
  assert_eq(math.floor(0.3), 0.0f64)
  assert_eq(math.floor(0.0f64), 0.0f64)
  assert_eq(math.floor(-0.3), -1.0f64)
  assert_eq(math.floor(-3.7), -4.0f64)
  assert_eq(math.floor(-3.0f64), -3.0f64)
}

; ==================== ceil f64 ====================

; 验证：math.ceil 函数对不同浮点数的上取整行为
#Test
fn test_math_ceil_f64() {
  assert_eq(math.ceil(3.7), 4.0f64)
  assert_eq(math.ceil(3.0f64), 3.0f64)
  assert_eq(math.ceil(0.3), 1.0f64)
  assert_eq(math.ceil(0.0f64), 0.0f64)
  assert_eq(math.ceil(-0.3), 0.0f64)
  assert_eq(math.ceil(-3.7), -3.0f64)
  assert_eq(math.ceil(-3.0f64), -3.0f64)
}

; ==================== trunc f64 ====================

