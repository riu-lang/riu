; 延迟初始化变量声明行为测试
;
; 覆盖：
;   - #Mut let 不初始化 + 后续赋值：i32 / i64 / f32
;
; 已知缺口：句柄类型（String / Array / Rc）的延迟初始化未覆盖；
; 负面诊断（未初始化使用）见 tests/check-cases/diag_uninit_*。

#Test
fn test_declare_then_assign_i32() {
  #Mut let a i32
  a = 10
  assert_eq(a, 10)
}

; 验证：变量声明后赋值与读取
#Test
fn test_declare_then_assign_i64() {
  #Mut let b i64
  b = 20
  assert_eq(b, 20)
}

; 验证：变量声明后赋值与比较浮点数
#Test
fn test_declare_then_assign_f32() {
  #Mut let c f32
  c = 3.14f32
  assert_eq(c, 3.14f32)
}
