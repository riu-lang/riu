; Rc<T> 方法调用自动解引用测试
; P2: Rc<T> 方法调用应穿透 wrapper，转发到内部 T 的方法。
; 覆盖：Rc<Array<i32>>.len()、Rc<i32>.to_string()、Rc<String>.len()

; ==================== Rc<Array<T>> 方法 ====================

#Test
fn test_rc_array_len() {
  #Mut let arr Array<i32> = [1, 2, 3]
  let r Rc<Array<i32>> = move(arr)
  assert_eq(r.len(), 3)
}

#Test
fn test_rc_array_is_empty() {
  #Mut let arr Array<i32> = []
  let r Rc<Array<i32>> = move(arr)
  assert_true(r.is_empty())
}

#Test
fn test_rc_array_cap() {
  #Mut let arr Array<i32> = []
  let r Rc<Array<i32>> = move(arr)
  ; 新构造的 Rc<Array> 长度应为 0
  assert_eq(r.len(), 0)
}

; ==================== Rc<builtin> SDK 方法 ====================

#Test
fn test_rc_i32_to_string() {
  let r Rc<i32> = 42
  assert_eq(r.to_string(), "42")
}

