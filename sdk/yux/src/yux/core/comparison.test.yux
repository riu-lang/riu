; comparison 比较运算用例
; 迁自 tests/cases/comparison.yux
;
; 本文件包含比较运算测试:
; - 整数比较
; - 浮点数比较
; - String 比较

; ==================== 整数比较 ====================

#Test
fn test_eq_ne() {
  assert_false(10 == 5)
  assert_true(10 == 10)
  assert_true(10 != 5)
  assert_false(10 != 10)
}

#Test
fn test_gt_ge() {
  assert_true(10 > 5)
  assert_false(10 > 15)
  assert_true(10 >= 5)
  assert_true(10 >= 10)
}

#Test
fn test_lt_le() {
  assert_false(10 < 5)
  assert_true(10 < 15)
  assert_false(10 <= 5)
  assert_true(10 <= 10)
}

; ==================== 浮点数比较 ====================

#Test
fn test_float_eq() {
  assert_true(3.14 == 3.14)
  assert_false(3.14 == 2.71)
}

#Test
fn test_float_lt_gt() {
  assert_true(1.5 < 2.5)
  assert_false(2.5 < 1.5)
  assert_true(2.5 > 1.5)
  assert_false(1.5 > 2.5)
}

#Test
fn test_float_le_ge() {
  assert_true(1.0 <= 1.0)
  assert_true(1.0 <= 2.0)
  assert_true(2.0 >= 1.0)
  assert_true(2.0 >= 2.0)
}

; ==================== String 比较 ====================

#Test
fn test_string_eq() {
  let a String = "hello"
  let b String = "hello"
  let c String = "world"
  assert_true(a == b)
  assert_false(a == c)
}

#Test
fn test_string_ne() {
  let a String = "hello"
  let b String = "world"
  assert_true(a != b)
  assert_false(a != a)
}

; ==================== 负数比较 ====================

#Test
fn test_neg_compare() {
  assert_true(-5 < 0)
  assert_true(-10 < -5)
  assert_false(-5 > 0)
  assert_true(-5 <= 0)
  assert_true(-5 >= -10)
}

; ==================== 各类型比较 ====================

#Test
fn test_i64_compare() {
  let a i64 = 1000000000i64
  let b i64 = 2000000000i64
  assert_true(a < b)
  assert_true(b > a)
  assert_true(a <= b)
  assert_true(b >= a)
}

#Test
fn test_u8_compare() {
  let a u8 = 100u8
  let b u8 = 200u8
  assert_true(a < b)
  assert_true(b > a)
}
