; 比较运算行为测试
;
; 覆盖：
;   - 整数比较：== / != / > / >= / < / <=（i32 / i64 / u8）
;   - 浮点比较：f64 / f32 的 == / != / < / > / <= / >=
;   - 负浮点比较：含 -0.0 == +0.0（IEEE 754）
;   - String 比较：== / !=
;   - 负数比较
;
; 已知缺口：自定义类型 == / !=（运算符重载）见 operator.test.yux；
; Rc<T> 自动解引用比较见 rc_operator.test.yux。

; ==================== 整数比较 ====================

; 验证：整数的相等和不相等比较运算符
#Test
fn test_eq_ne() {
  assert_false(10 == 5)
  assert_true(10 == 10)
  assert_true(10 != 5)
  assert_false(10 != 10)
}

; 验证：比较运算符大于和大于等于的行为
#Test
fn test_gt_ge() {
  assert_true(10 > 5)
  assert_false(10 > 15)
  assert_true(10 >= 5)
  assert_true(10 >= 10)
}

; 验证：比较运算符 < 和 <= 的行为
#Test
fn test_lt_le() {
  assert_false(10 < 5)
  assert_true(10 < 15)
  assert_false(10 <= 5)
  assert_true(10 <= 10)
}

; ==================== 浮点数比较 ====================

; 验证：浮点数相等与不相等的比较
#Test
fn test_float_eq() {
  assert_true(3.14 == 3.14)
  assert_false(3.14 == 2.71)
}

; 验证：浮点数比较运算符小于和大于
#Test
fn test_float_lt_gt() {
  assert_true(1.5 < 2.5)
  assert_false(2.5 < 1.5)
  assert_true(2.5 > 1.5)
  assert_false(1.5 > 2.5)
}

; 验证：浮点数的 <= 和 >= 比较运算符
#Test
fn test_float_le_ge() {
  assert_true(1.0 <= 1.0)
  assert_true(1.0 <= 2.0)
  assert_true(2.0 >= 1.0)
  assert_true(2.0 >= 2.0)
}

; ==================== String 比较 ====================

; 验证：String 等于比较
#Test
fn test_string_eq() {
  let a String = "hello"
  let b String = "hello"
  let c String = "world"
  assert_true(a == b)
  assert_false(a == c)
}

; 验证：String 不等运算符的行为
#Test
fn test_string_ne() {
  let a String = "hello"
  let b String = "world"
  assert_true(a != b)
  assert_false(a != a)
}

; ==================== 负数比较 ====================

; 验证：负数之间的比较行为
#Test
fn test_neg_compare() {
  assert_true(-5 < 0)
  assert_true(-10 < -5)
  assert_false(-5 > 0)
  assert_true(-5 <= 0)
  assert_true(-5 >= -10)
}

; ==================== 各类型比较 ====================

; 验证：i64 类型的比较操作符
#Test
fn test_i64_compare() {
  let a i64 = 1000000000
  let b i64 = 2000000000
  assert_true(a < b)
  assert_true(b > a)
  assert_true(a <= b)
  assert_true(b >= a)
}

; 验证：u8 类型的比较操作符小于和大于
#Test
fn test_u8_compare() {
  let a u8 = 100
  let b u8 = 200
  assert_true(a < b)
  assert_true(b > a)
}

; ==================== f32 比较 ====================

#Test
fn test_f32_eq() {
  ; 验证：f32 相等/不等比较
  assert_true(3.14f32 == 3.14f32)
  assert_false(3.14f32 == 2.71f32)
  assert_true(3.14f32 != 2.71f32)
  assert_false(3.14f32 != 3.14f32)
}

#Test
fn test_f32_lt_gt() {
  ; 验证：f32 小于/大于比较
  assert_true(1.5f32 < 2.5f32)
  assert_false(2.5f32 < 1.5f32)
  assert_true(2.5f32 > 1.5f32)
  assert_false(1.5f32 > 2.5f32)
}

#Test
fn test_f32_le_ge() {
  ; 验证：f32 小于等于/大于等于比较
  assert_true(1.0f32 <= 1.0f32)
  assert_true(1.0f32 <= 2.0f32)
  assert_true(2.0f32 >= 1.0f32)
  assert_true(2.0f32 >= 2.0f32)
}

#Test
fn test_f32_neg_compare() {
  ; 验证：负 f32 比较
  assert_true(-1.5f32 < 0.0f32)
  assert_true(-2.5f32 < -1.5f32)
  assert_false(-1.5f32 > 0.0f32)
  assert_true(-1.5f32 >= -2.5f32)
}

#Test
fn test_f32_zero_compare() {
  ; 验证：f32 零值比较
  assert_true(0.0f32 == 0.0f32)
  assert_true(-0.0f32 == 0.0f32)
  assert_true(0.0f32 < 0.001f32)
  assert_true(-0.001f32 < 0.0f32)
}
