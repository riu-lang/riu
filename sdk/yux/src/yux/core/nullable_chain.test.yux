; Nullable 链式操作行为测试
;
; 覆盖：
;   - 嵌套 ?. 链：a?.b?.c 短路传播
;   - ?? 链：多层 fallback 组合
;   - Nullable<String>：?. 与 ?? 在句柄类型上的行为
;   - ?.foo() 安全方法调用：有值 / 空 / 有参 / 实参短路 / unit 返回 / 链式
;   - SDK 类型方法：String?.len() / String?.to_string() / i32?.to_string()
;
; Nullable 基础行为（??、?.field、.has()、.get()）见 nullable.test.yux。

struct InnerVal {
  v i32

  #Static
  fn make(v i32) InnerVal {
    ret Self {
      .v = v
    }
  }
}

struct MidVal {
  inner InnerVal

  #Static
  fn make(inner InnerVal) MidVal {
    ret Self {
      .inner = inner
    }
  }
}

struct OuterVal {
  mid MidVal

  #Static
  fn make(mid MidVal) OuterVal {
    ret Self {
      .mid = mid
    }
  }
}

; ==================== 嵌套 ?. 链式 ====================

; 验证：两层可选链式访问
#Test
fn test_nullable_chain_two_level_some() {
  #Mut let inner InnerVal = InnerVal::make(42)
  #Mut let mid MidVal = MidVal::make(inner)
  #Mut let outer OuterVal = OuterVal::make(mid)
  #Mut let maybe OuterVal? = outer
  ; 两层 ?. 链式
  #Mut let v i32? = maybe?.mid?.inner?.v
  assert_eq(v ?? -1, 42)
}

; 验证：两层嵌套空值的可选链操作
#Test
fn test_nullable_chain_two_level_null_mid() {
  #Mut let outerMid OuterVal? = null
  ; 第一层为空 → 短路返回 null
  #Mut let v i32? = outerMid?.mid?.inner?.v
  assert_eq(v ?? -99, -99)
}

; ==================== Nullable<String> ====================

; 验证：Nullable<String> 的 has 和 ?? 操作符行为
#Test
fn test_nullable_string_some() {
  #Mut let s String? = "hello"
  assert_true(s.has())
  assert_eq(s ?? "fallback", "hello")
}

; 验证：NullableString 在 null 时的行为
#Test
fn test_nullable_string_null() {
  #Mut let s String? = null
  assert_false(s.has())
  assert_eq(s ?? "fallback", "fallback")
}

; ==================== 混合类型 ?? ====================

; 验证：nullable coalesce 在非空值时返回原值
#Test
fn test_nullable_coalesce_some() {
  #Mut let x i32? = 7
  ; x ?? -1 返回 7（非 null）
  let r i32 = x ?? -1
  assert_eq(r, 7)
}

; 验证：Nullable coalesce 在值为 null 时返回 fallback 值
#Test
fn test_nullable_coalesce_null() {
  #Mut let y i32? = null
  ; y ?? -1 返回 fallback
  let r i32 = y ?? -1
  assert_eq(r, -1)
}

; ==================== Nullable reassign with ?? ====================

; 验证：Nullable 变量重新赋值与空合并操作符
#Test
fn test_nullable_reassign_coalesce() {
  #Mut let x i64? = null
  let v i64 = x ?? 100
  assert_eq(v, 100)
  x = 50
  let w i64 = x ?? 0
  assert_eq(w, 50)
}

; ==================== ?.foo() 安全方法调用 ====================

struct ValWithMethod {
  v i32

  #Static
  fn make(v i32) ValWithMethod {
    ret Self {
      .v = v
    }
  }

  fn getValue() i32 {
    ret $.v
  }

  fn double() i32 {
    ret $.v * 2
  }

  fn add(x i32) i32 {
    ret $.v + x
  }

  fn bump() {
    $.v = $.v + 1
  }

  fn nest() ValWithMethod {
    ret ValWithMethod::make($.v)
  }
}

; 验证：可选链式调用在存在值时正确调用方法
#Test
fn test_safe_method_call_some() {
  #Mut let v ValWithMethod = ValWithMethod::make(42)
  #Mut let maybe ValWithMethod? = v
  ; ?.foo() 有值调用
  #Mut let r i32? = maybe?.getValue()
  assert_eq(r ?? -1, 42)
}

; 验证：空值链式调用短路行为
#Test
fn test_safe_method_call_null() {
  #Mut let n ValWithMethod? = null
  ; ?.foo() null 短路
  #Mut let r i32? = n?.getValue()
  assert_eq(r ?? -99, -99)
}

; 验证：可选链式调用方法并传递参数
#Test
fn test_safe_method_call_with_arg() {
  #Mut let v ValWithMethod = ValWithMethod::make(21)
  #Mut let maybe ValWithMethod? = v
  #Mut let r i32? = maybe?.add(21)
  assert_eq(r ?? -1, 42)
}

; ==================== ?. SDKBuiltin 类型方法调用 ====================

; 验证：在可选的 SDKBuiltin 类型上调用方法并处理空值
#Test
fn test_safe_method_string_len_some() {
  #Mut let s String? = "hello"
  ; ?.len() 在 SDK String? 上
  #Mut let r usize? = s?.len()
  assert_eq(r ?? 0usize, 5usize)
}

; 验证：在 null 的可选字符串上调用 safe method len 返回默认值
#Test
fn test_safe_method_string_len_null() {
  #Mut let s String? = null
  ; ?.len() 在 null String? 上
  #Mut let r usize? = s?.len()
  assert_eq(r ?? 999usize, 999usize)
}

; ==================== 实参短路 / unit 返回 / 链式 / String 返回 ====================

struct TickCounter {
  n i32

  #Static
  fn make(n i32) TickCounter {
    ret Self {
      .n = n
    }
  }

  fn tick() i32 {
    $.n = $.n + 1
    ret $.n
  }
}

; 验证：receiver 为空时不求值 ?.method 的实参
#Test
fn test_safe_method_arg_short_circuit_null() {
  #Mut let c TickCounter = TickCounter::make(0)
  #Mut let n ValWithMethod? = null
  #Mut let r i32? = n?.add(c.tick())
  assert_eq(r ?? -1, -1)
  assert_eq(c.n, 0)
}

; 验证：receiver 有值时求值实参并传入方法
#Test
fn test_safe_method_arg_eval_when_some() {
  #Mut let c TickCounter = TickCounter::make(0)
  #Mut let v ValWithMethod = ValWithMethod::make(10)
  #Mut let maybe ValWithMethod? = v
  #Mut let r i32? = maybe?.add(c.tick())
  assert_eq(r ?? -1, 11)
  assert_eq(c.n, 1)
}

; 验证：unit 返回方法在有值时被调用
#Test
fn test_safe_method_void_some() {
  #Mut let v ValWithMethod = ValWithMethod::make(1)
  #Mut let maybe ValWithMethod? = v
  #Mut let r ()? = maybe?.bump()
  assert_true(r.has())
  assert_eq(maybe.get().v, 2)
}

; 验证：unit 返回方法在空值时不调用
#Test
fn test_safe_method_void_null() {
  #Mut let n ValWithMethod? = null
  n?.bump()
  assert_false(n.has())
}

; 验证：?.method()?.method() 链式
#Test
fn test_safe_method_chain() {
  #Mut let v ValWithMethod = ValWithMethod::make(7)
  #Mut let maybe ValWithMethod? = v
  #Mut let r i32? = maybe?.nest()?.getValue()
  assert_eq(r ?? -1, 7)
}

; 验证：空值链式方法调用短路
#Test
fn test_safe_method_chain_null() {
  #Mut let n ValWithMethod? = null
  #Mut let r i32? = n?.nest()?.getValue()
  assert_eq(r ?? -99, -99)
}

; 验证：String?.to_string() 有值返回句柄
#Test
fn test_safe_method_string_to_string_some() {
  #Mut let s String? = "hi"
  #Mut let r String? = s?.to_string()
  assert_eq(r ?? "", "hi")
}

; 验证：String?.to_string() 空值短路
#Test
fn test_safe_method_string_to_string_null() {
  #Mut let s String? = null
  #Mut let r String? = s?.to_string()
  assert_eq(r ?? "none", "none")
}

; 验证：i32?.to_string() 有值
#Test
fn test_safe_method_i32_to_string_some() {
  #Mut let n i32? = 42
  #Mut let r String? = n?.to_string()
  assert_eq(r ?? "", "42")
}

; 验证：i32?.to_string() 空值短路
#Test
fn test_safe_method_i32_to_string_null() {
  #Mut let n i32? = null
  #Mut let r String? = n?.to_string()
  assert_eq(r ?? "none", "none")
}
