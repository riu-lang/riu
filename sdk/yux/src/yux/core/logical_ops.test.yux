; 逻辑运算行为测试
;
; 覆盖：
;   - &&（逻辑与）真值表：TT/TF/FT/FF
;   - ||（逻辑或）真值表：FT/FF
;   - ! 与 && 组合
;   - 逻辑 vs 位运算区分：&& 返回 bool，& 返回同类型（u8）
;
; 已知缺口：短路求值通过函数调用侧面验证（false && fn() 不调用 fn）。

#Test
fn test_and_tt() {
  assert_eq(true && true, true)
}

; 验证：逻辑与操作符的基本行为
#Test
fn test_and_tf() {
  assert_eq(true && false, false)
}

; 验证：逻辑或运算符的真值判断
#Test
fn test_or_ft() {
  assert_eq(false || true, true)
}

; 验证：逻辑或操作符在两个假值之间的行为
#Test
fn test_or_ff() {
  assert_eq(false || false, false)
}

; 验证：逻辑与和非操作的组合行为
#Test
fn test_and_with_not() {
  assert_eq(true && !false, true)
}

; ==================== 逻辑 vs 位运算对比（迁自 bug_hunt） ====================

#Test
fn test_logical_vs_bitwise_and() {
  ; 验证：&& 返回 bool，& 返回同类型
  assert_true(true && true)
  let b u8 = 0xFF & 0x0F
  assert_eq(b, 0x0F)
}

#Test
fn test_logical_vs_bitwise_or() {
  ; 验证：|| 返回 bool，| 返回同类型
  assert_true(false || true)
  let b u8 = 0xF0 | 0x0F
  assert_eq(b, 0xFF)
}

; ==================== 短路求值验证 ====================

#Test
fn test_and_short_circuit() {
  ; 验证：&& 短路求值——左操作数为 false 时右侧不执行
  ; 若右侧除零表达式被执行，SEH 会使本测试失败
  let ok = false && (1i32 / 0i32 == 0)
  assert_eq(ok, false)
}

#Test
fn test_or_short_circuit() {
  ; 验证：|| 短路求值——左操作数为 true 时右侧不执行
  ; 若右侧除零表达式被执行，SEH 会使本测试失败
  let ok = true || (1i32 / 0i32 == 0)
  assert_eq(ok, true)
}

#Test
fn test_and_chain_short_circuit() {
  ; 验证：&& 链中首个 false 之后的表达式均不执行
  let a = true && false && (1i32 / 0i32 == 0)
  assert_eq(a, false)
}

#Test
fn test_or_chain_short_circuit() {
  ; 验证：|| 链中首个 true 之后的表达式均不执行
  let a = false || true || (1i32 / 0i32 == 0)
  assert_eq(a, true)
}
