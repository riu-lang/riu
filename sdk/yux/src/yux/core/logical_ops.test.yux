; 逻辑运算行为测试
;
; 覆盖：
;   - &&（逻辑与）真值表：TT/TF/FT/FF
;   - ||（逻辑或）真值表：FT/FF
;   - ! 与 && 组合
;   - 逻辑 vs 位运算区分：&& 返回 bool，& 返回同类型（u8）
;
; 已知缺口：短路求值行为（&& / || 右侧不执行）无专项测试；
; 短路求值侧面验证见 control_flow.test.yux。

#Test
fn test_and_tt() {
  assert_eq(true && true, true)
}

; 验证：逻辑与操作符的基本行为
#Test
fn test_and_tf() {
  assert_eq(true && false, false)
}

; 验证：逻辑或运算符的真值判断
#Test
fn test_or_ft() {
  assert_eq(false || true, true)
}

; 验证：逻辑或操作符在两个假值之间的行为
#Test
fn test_or_ff() {
  assert_eq(false || false, false)
}

; 验证：逻辑与和非操作的组合行为
#Test
fn test_and_with_not() {
  assert_eq(true && !false, true)
}

; ==================== 逻辑 vs 位运算对比（迁自 bug_hunt） ====================

#Test
fn test_logical_vs_bitwise_and() {
  ; 验证：&& 返回 bool，& 返回同类型
  assert_true(true && true)
  let b u8 = 0xFF & 0x0F
  assert_eq(b, 0x0F)
}

#Test
fn test_logical_vs_bitwise_or() {
  ; 验证：|| 返回 bool，| 返回同类型
  assert_true(false || true)
  let b u8 = 0xF0 | 0x0F
  assert_eq(b, 0xFF)
}
