; 位运算行为测试
;
; 覆盖：
;   - 整数方法：and / or / xor / shl / shr / inv
;   - 各整数类型：i8 / i16 / i32 / i64 / u8 / u16 / u32 / u64 / isize / usize
;   - 负数（二补码）与边界值
;
; bool 仅 not / ! / && / ||，无位方法。

; ==================== 基本位运算 ====================

#Test
fn test_bit_and() {
  assert_eq(5.and(3), 1)
}

#Test
fn test_bit_or() {
  assert_eq(5.or(3), 7)
}

#Test
fn test_bit_xor() {
  assert_eq(5.xor(3), 6)
}

#Test
fn test_shr() {
  assert_eq(8.shr(2), 2)
}

#Test
fn test_shl() {
  assert_eq(2.shl(3), 16)
}

#Test
fn test_inv() {
  assert_eq((0).inv(), -1)
  assert_eq((5).inv(), -6)
}

; ==================== 各整数类型位运算 ====================

#Test
fn test_bitwise_i8() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_i16() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_i32() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_i64() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_u8() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_u16() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_u32() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

#Test
fn test_bitwise_u64() {
  assert_eq(5.and(3), 1)
  assert_eq(5.or(3), 7)
  assert_eq(5.xor(3), 6)
  assert_eq(8.shr(2), 2)
  assert_eq(2.shl(3), 16)
}

; ==================== 负数位运算 ====================

#Test
fn test_bitwise_negative_and() {
  ; -5.and(3) = 3（二补码）
  assert_eq((-5).and(3), 3)
}

#Test
fn test_bitwise_negative_or() {
  assert_eq((-5).or(3), -5)
}

#Test
fn test_bitwise_negative_xor() {
  assert_eq((-5).xor(3), -8)
}

#Test
fn test_bitwise_negative_shr() {
  ; 算术右移保留符号位
  assert_eq((-8).shr(2), -2)
}

#Test
fn test_bitwise_negative_shl() {
  assert_eq((-2).shl(3), -16)
}

; ==================== 边界值测试 ====================

#Test
fn test_bitwise_boundary_i8() {
  assert_eq(127.and(127), 127)
  assert_eq((-128).or(0), -128)
}

#Test
fn test_bitwise_boundary_u8() {
  assert_eq(255.and(255), 255)
  assert_eq(255.or(0), 255)
}

#Test
fn test_bitwise_shift_boundary() {
  assert_eq(1.shl(31), -2147483648)
  assert_eq(1.shl(63), -9223372036854775808)
}

; ==================== isize / usize 位运算 ====================

#Test
fn test_bitwise_isize() {
  let a isize = 5
  let b isize = 3
  assert_eq(a.and(b), 1)
  assert_eq(a.or(b), 7)
  assert_eq(a.xor(b), 6)
  assert_eq(a.shl(2), 20)
  assert_eq(a.shr(1), 2)
}

#Test
fn test_bitwise_usize() {
  let a usize = 5
  let b usize = 3
  assert_eq(a.and(b), 1)
  assert_eq(a.or(b), 7)
  assert_eq(a.xor(b), 6)
  assert_eq(a.shl(2), 20)
  assert_eq(a.shr(1), 2)
}

#Test
fn test_shift_all_bits() {
  assert_eq(1.shl(0), 1)
  assert_eq(1.shl(15), 32768)
  assert_eq((0xFFFF).shr(15), 1)
}

#Test
fn test_bit_method_chain() {
  ; 方法链代替旧运算符优先级
  assert_eq(1.shl(3).or(1), 9)
  assert_eq(8.shr(1).and(3), 0)
}
