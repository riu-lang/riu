; 位运算用例
; 迁自 tests/cases/bitwise_ops.yux

; ==================== 基本位运算 ====================

#Test
fn test_bit_and() {
  assert_eq(5 & 3, 1)
}

#Test
fn test_bit_or() {
  assert_eq(5 | 3, 7)
}

#Test
fn test_bit_xor() {
  assert_eq(5 ^ 3, 6)
}

#Test
fn test_shr() {
  assert_eq(8 >> 2, 2)
}

#Test
fn test_shl() {
  assert_eq(2 << 3, 16)
}

; ==================== 各整数类型位运算 ====================

#Test
fn test_bitwise_i8() {
  assert_eq(5i8 & 3i8, 1i8)
  assert_eq(5i8 | 3i8, 7i8)
  assert_eq(5i8 ^ 3i8, 6i8)
  assert_eq(8i8 >> 2i8, 2i8)
  assert_eq(2i8 << 3i8, 16i8)
}

#Test
fn test_bitwise_i16() {
  assert_eq(5i16 & 3i16, 1i16)
  assert_eq(5i16 | 3i16, 7i16)
  assert_eq(5i16 ^ 3i16, 6i16)
  assert_eq(8i16 >> 2i16, 2i16)
  assert_eq(2i16 << 3i16, 16i16)
}

#Test
fn test_bitwise_i32() {
  assert_eq(5i32 & 3i32, 1i32)
  assert_eq(5i32 | 3i32, 7i32)
  assert_eq(5i32 ^ 3i32, 6i32)
  assert_eq(8i32 >> 2i32, 2i32)
  assert_eq(2i32 << 3i32, 16i32)
}

#Test
fn test_bitwise_i64() {
  assert_eq(5i64 & 3i64, 1i64)
  assert_eq(5i64 | 3i64, 7i64)
  assert_eq(5i64 ^ 3i64, 6i64)
  assert_eq(8i64 >> 2i64, 2i64)
  assert_eq(2i64 << 3i64, 16i64)
}

#Test
fn test_bitwise_u8() {
  assert_eq(5u8 & 3u8, 1u8)
  assert_eq(5u8 | 3u8, 7u8)
  assert_eq(5u8 ^ 3u8, 6u8)
  assert_eq(8u8 >> 2u8, 2u8)
  assert_eq(2u8 << 3u8, 16u8)
}

#Test
fn test_bitwise_u16() {
  assert_eq(5u16 & 3u16, 1u16)
  assert_eq(5u16 | 3u16, 7u16)
  assert_eq(5u16 ^ 3u16, 6u16)
  assert_eq(8u16 >> 2u16, 2u16)
  assert_eq(2u16 << 3u16, 16u16)
}

#Test
fn test_bitwise_u32() {
  assert_eq(5u32 & 3u32, 1u32)
  assert_eq(5u32 | 3u32, 7u32)
  assert_eq(5u32 ^ 3u32, 6u32)
  assert_eq(8u32 >> 2u32, 2u32)
  assert_eq(2u32 << 3u32, 16u32)
}

#Test
fn test_bitwise_u64() {
  assert_eq(5u64 & 3u64, 1u64)
  assert_eq(5u64 | 3u64, 7u64)
  assert_eq(5u64 ^ 3u64, 6u64)
  assert_eq(8u64 >> 2u64, 2u64)
  assert_eq(2u64 << 3u64, 16u64)
}

; ==================== 负数位运算 ====================

#Test
fn test_bitwise_negative_and() {
  ; -5 & 3 = 3 (in two's complement)
  ; -5 = 0xFFFFFFFB (32-bit)
  ;  3 = 0x00000003
  ; AND = 0x00000003 = 3
  assert_eq(-5i32 & 3i32, 3i32)
}

#Test
fn test_bitwise_negative_or() {
  ; -5 | 3 = -5
  ; -5 = 0xFFFFFFFB
  ;  3 = 0x00000003
  ; OR  = 0xFFFFFFFB = -5
  assert_eq(-5i32 | 3i32, -5i32)
}

#Test
fn test_bitwise_negative_xor() {
  ; -5 ^ 3 = -8
  ; -5 = 0xFFFFFFFB
  ;  3 = 0x00000003
  ; XOR = 0xFFFFFFF8 = -8
  assert_eq(-5i32 ^ 3i32, -8i32)
}

#Test
fn test_bitwise_negative_shr() {
  ; 右移负数：算术右移（保留符号位）
  ; -8 >> 2 = -2
  ; -8 = 0xFFFFFFF8
  ; 算术右移 2 位 = 0xFFFFFFFE = -2
  assert_eq(-8i32 >> 2i32, -2i32)
}

#Test
fn test_bitwise_negative_shl() {
  ; 左移负数
  ; -2 << 3 = -16
  ; -2 = 0xFFFFFFFE
  ; 左移 3 位 = 0xFFFFFFF0 = -16
  assert_eq(-2i32 << 3i32, -16i32)
}

; ==================== 边界值测试 ====================

#Test
fn test_bitwise_boundary_i8() {
  ; i8 范围：-128 ~ 127
  assert_eq(127i8 & 127i8, 127i8)
  assert_eq(-128i8 | 0i8, -128i8)
}

#Test
fn test_bitwise_boundary_u8() {
  ; u8 范围：0 ~ 255
  assert_eq(255u8 & 255u8, 255u8)
  assert_eq(255u8 | 0u8, 255u8)
}

#Test
fn test_bitwise_shift_boundary() {
  ; 移位边界
  assert_eq(1i32 << 31, -2147483648i32)  ; 最小 i32
  assert_eq(1i64 << 63, -9223372036854775808i64)  ; 最小 i64
}
