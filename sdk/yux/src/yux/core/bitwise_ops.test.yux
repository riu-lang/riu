; 位运算用例
; 迁自 tests/cases/bitwise_ops.yux

; ==================== 基本位运算 ====================

#Test
fn test_bit_and() {
  assert_eq(5 & 3, 1)
}

#Test
fn test_bit_or() {
  assert_eq(5 | 3, 7)
}

#Test
fn test_bit_xor() {
  assert_eq(5 ^ 3, 6)
}

#Test
fn test_shr() {
  assert_eq(8 >> 2, 2)
}

#Test
fn test_shl() {
  assert_eq(2 << 3, 16)
}

; ==================== 各整数类型位运算 ====================

#Test
fn test_bitwise_i8() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_i16() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_i32() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_i64() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_u8() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_u16() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_u32() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

#Test
fn test_bitwise_u64() {
  assert_eq(5 & 3, 1)
  assert_eq(5 | 3, 7)
  assert_eq(5 ^ 3, 6)
  assert_eq(8 >> 2, 2)
  assert_eq(2 << 3, 16)
}

; ==================== 负数位运算 ====================

#Test
fn test_bitwise_negative_and() {
  ; -5 & 3 = 3 (in two's complement)
  ; -5 = 0xFFFFFFFB (32-bit)
  ;  3 = 0x00000003
  ; AND = 0x00000003 = 3
  assert_eq(-5 & 3, 3)
}

#Test
fn test_bitwise_negative_or() {
  ; -5 | 3 = -5
  ; -5 = 0xFFFFFFFB
  ;  3 = 0x00000003
  ; OR  = 0xFFFFFFFB = -5
  assert_eq(-5 | 3, -5)
}

#Test
fn test_bitwise_negative_xor() {
  ; -5 ^ 3 = -8
  ; -5 = 0xFFFFFFFB
  ;  3 = 0x00000003
  ; XOR = 0xFFFFFFF8 = -8
  assert_eq(-5 ^ 3, -8)
}

#Test
fn test_bitwise_negative_shr() {
  ; 右移负数：算术右移（保留符号位）
  ; -8 >> 2 = -2
  ; -8 = 0xFFFFFFF8
  ; 算术右移 2 位 = 0xFFFFFFFE = -2
  assert_eq(-8 >> 2, -2)
}

#Test
fn test_bitwise_negative_shl() {
  ; 左移负数
  ; -2 << 3 = -16
  ; -2 = 0xFFFFFFFE
  ; 左移 3 位 = 0xFFFFFFF0 = -16
  assert_eq(-2 << 3, -16)
}

; ==================== 边界值测试 ====================

#Test
fn test_bitwise_boundary_i8() {
  ; i8 范围：-128 ~ 127
  assert_eq(127 & 127, 127)
  assert_eq(-128 | 0, -128)
}

#Test
fn test_bitwise_boundary_u8() {
  ; u8 范围：0 ~ 255
  assert_eq(255 & 255, 255)
  assert_eq(255 | 0, 255)
}

#Test
fn test_bitwise_shift_boundary() {
  ; 移位边界
  assert_eq(1 << 31, -2147483648)  ; 最小 i32
  assert_eq(1 << 63, -9223372036854775808)  ; 最小 i64
}
