; String #Static 工厂行为测试
;
; 覆盖：
;   - String::empty() 空字符串构造
;   - String::from(&buf) 从 Array<u32> 深拷贝构造
;   - 空 buf 输入
;   - 深拷贝隔离性：构造后修改 buf 不影响已创建的 String
;
; 已知缺口：无——String 构造目前唯一通道为静态工厂（ctor 已砍）。
; String 其他行为见 string.test.yux / string_builder.test.yux。

#Test
fn test_string_static_empty() {
  let s String = String::empty()
  assert_eq(s.len(), 0)
  assert_eq(s, "")
}

#Test
fn test_string_static_from_buf() {
  ; 'h''i' = 104, 105
  let buf Array<u32> = [104u32, 105u32]
  let s String = String::from(&buf)
  assert_eq(s.len(), 2)
  assert_eq(s, "hi")
  ; from() 深拷贝, buf 自身仍可独立存在
  assert_eq(buf.len(), 2)
}

#Test
fn test_string_static_from_empty_buf() {
  let buf Array<u32> = []
  let s String = String::from(&buf)
  assert_eq(s.len(), 0)
  assert_eq(s, "")
}

#Test
fn test_string_from_defensive_copy() {
  ; 关键回归: String::from 深拷贝, 外界 mutate buf 不影响已构造的 String
  #Mut let buf Array<u32> = [104u32, 105u32]
  let s String = String::from(&buf)
  assert_eq(s, "hi")
  assert_eq(buf.len(), 2)
}
