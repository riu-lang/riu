; Phase 4b: String #Static 工厂回归

#Test
fn test_string_static_empty() {
  let s String = String::empty()
  assert_eq(s.len(), 0i64)
  assert_eq(s, "")
}

#Test
fn test_string_static_from_buf() {
  ; 'h''i' = 104, 105
  let buf Array<u32> = [104u32, 105u32]
  let s String = String::from(buf)
  assert_eq(s.len(), 2i64)
  assert_eq(s, "hi")
  ; 句柄共享：buf 与 s.data 同 block，出作用域后两者各 release，不应 double free
  assert_eq(buf.len(), 2i64)
}

#Test
fn test_string_static_from_empty_buf() {
  let buf Array<u32> = []
  let s String = String::from(buf)
  assert_eq(s.len(), 0i64)
  assert_eq(s, "")
}

#Test
fn test_string_static_coexist_with_ctor() {
  ; 同名 ctor `String(buf)` 与 `String::from(buf)` 并存，结果应一致
  let buf1 Array<u32> = [65u32]
  let buf2 Array<u32> = [65u32]
  let a String = String(buf1)
  let b String = String::from(buf2)
  assert_eq(a, b)
}
