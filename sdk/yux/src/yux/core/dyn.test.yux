; Phase 4a — Dyn<D> 运行时多态端到端
; 覆盖：内置类型 + ToString 走 fat ptr + vtable / 自定义 draft 多方法 / 跨 fn 形参传递 / dtor 路径
;
; 注：Dyn<D&> 借用形态目前 ast_builder 仅识别 owned `Dyn:<D>`（g4 `genericDef` 实参槽不允许 `&`），
; 借用调用路径俟构造解锁后再补；本文件只覆盖 owned `Dyn<D>`。

; ---------- 用户类型走 ToString：Dyn<ToString>(Rc<DynCounter>) ----------

#Impl(ToString)
struct DynCounter {
  n i64

  #Static
  fn make(start i64) DynCounter {
    ret Self {
      .n = start
    }
  }

  fn to_string() String {
    $.n.to_string()
  }
}

#Test
fn test_dyn_to_string_counter_pos() {
  let b Rc<DynCounter> = DynCounter::make(42i64)
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "42")
}

#Test
fn test_dyn_to_string_counter_neg() {
  let b Rc<DynCounter> = DynCounter::make(-7i64)
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "-7")
}

#Test
fn test_dyn_to_string_counter_zero() {
  let b Rc<DynCounter> = DynCounter::make(0i64)
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "0")
}

; ---------- 自定义 draft + struct，多方法 ----------

#Spec
struct Shape {
  fn area() i64
  fn name() String
}

#Impl(Shape)
struct Square {
  side i64

  #Static
  fn make(s i64) Square {
    ret Self {
      .side = s
    }
  }

  fn area() i64 {
    $.side * $.side
  }
  fn name() String {
    "square"
  }
}

#Impl(Shape)
struct Rect {
  w i64
  h i64

  #Static
  fn make(w i64, h i64) Rect {
    ret Self {
      .w = w
      .h = h
    }
  }

  fn area() i64 {
    $.w * $.h
  }
  fn name() String {
    "rect"
  }
}

#Test
fn test_dyn_custom_draft_square() {
  let b Rc<Square> = Square::make(5i64)
  let d Dyn<Shape> = Dyn:<Shape>(b)
  assert_eq(d.area(), 25i64)
  assert_eq(d.name(), "square")
}

#Test
fn test_dyn_custom_draft_rect() {
  let b Rc<Rect> = Rect::make(3i64, 4i64)
  let d Dyn<Shape> = Dyn:<Shape>(b)
  assert_eq(d.area(), 12i64)
  assert_eq(d.name(), "rect")
}

; ---------- 跨函数传 Dyn<Shape>（owned 移交，调用站消费） ----------

fn shape_area_via_dyn(d Dyn<Shape>) i64 {
  d.area()
}

#Test
fn test_dyn_pass_to_fn_square() {
  let b Rc<Square> = Square::make(6i64)
  assert_eq(shape_area_via_dyn(Dyn:<Shape>(b)), 36i64)
}

#Test
fn test_dyn_pass_to_fn_rect() {
  let b Rc<Rect> = Rect::make(7i64, 2i64)
  assert_eq(shape_area_via_dyn(Dyn:<Shape>(b)), 14i64)
}

; ---------- 含 RC 字段的 U：dyn release 必须调 U 的 dtor，String 字段被正确释放 ----------

#Impl(Shape)
struct Labeled {
  label String
  n i64

  #Static
  fn make(l String, n i64) Labeled {
    ret Self {
      .label = l
      .n = n
    }
  }

  fn area() i64 {
    $.n
  }
  fn name() String {
    $.label
  }
}

#Test
fn test_dyn_dtor_chain_string_field() {
  let b Rc<Labeled> = Labeled::make("triangle", 9i64)
  let d Dyn<Shape> = Dyn:<Shape>(b)
  assert_eq(d.area(), 9i64)
  assert_eq(d.name(), "triangle")
  ; d 离开 scope 时 _dyn_release → vtable[0] = Labeled.~ → String 字段 release
}

; ---------- Rc<primitive> 走 ToString：Rc<i32>/Rc<i64>/Rc<bool> ----------
; 回归 BUGS.md「Rc<primitive>.method() 调用走错路径」修复后场景：
; SDK base.yux 已为 i32/i64/bool 提供 ToString impl，vtable 走内置类型 by-value receiver。

#Test
fn test_dyn_to_string_box_i32() {
  let b Rc<i32> = 42i32
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "42")
}

#Test
fn test_dyn_to_string_box_i64() {
  let b Rc<i64> = 123i64
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "123")
}

#Test
fn test_dyn_to_string_box_bool() {
  let b Rc<bool> = true
  let d Dyn<ToString> = Dyn:<ToString>(b)
  assert_eq(d.to_string(), "true")
}

; ---------- Array<Dyn<D>> 遍历：收集多个不同 U 的实现，遍历调用同一方法 ----------

#Test
fn test_dyn_array_iterate() {
  #Mut let arr Array<Dyn<Shape>> = []
  let b1 Rc<Square> = Square::make(3i64)
  let b2 Rc<Rect> = Rect::make(4i64, 5i64)
  let b3 Rc<Square> = Square::make(6i64)
  arr.push(Dyn:<Shape>(b1))
  arr.push(Dyn:<Shape>(b2))
  arr.push(Dyn:<Shape>(b3))

  assert_eq(arr.len(), 3i64)
  assert_eq(arr[0].area(), 9i64)
  assert_eq(arr[1].area(), 20i64)
  assert_eq(arr[2].area(), 36i64)
}

; ---------- struct 字段持 Dyn<D>：直接访问和拷绑后调用 ----------

#Spec
struct Greet {
  fn hi() i64
  fn name() String
}

#Impl(Greet)
struct G {
  v i64
  tag String

  #Static
  fn make(v i64, t String) G {
    ret Self {
      .v = v
      .tag = t
    }
  }

  fn hi() i64 {
    $.v
  }
  fn name() String {
    $.tag
  }
}

struct DynHolder {
  before i64
  inner Dyn<Greet>
  after i64

  #Static
  fn make(b i64, d Dyn<Greet>, a i64) DynHolder {
    ret Self {
      .before = b
      .inner = d
      .after = a
    }
  }
}

#Test
fn test_dyn_field_owned() {
  let bg Rc<G> = G::make(42i64, "ok")
  let h DynHolder = DynHolder::make(7i64, Dyn:<Greet>(bg), 9i64)

  assert_eq(h.before, 7i64)
  assert_eq(h.inner.hi(), 42i64)
  assert_eq(h.inner.name(), "ok")
  assert_eq(h.after, 9i64)

  let d Dyn<Greet> = h.inner
  assert_eq(d.hi(), 42i64)
  assert_eq(d.name(), "ok")
}

; ---------- struct 方法体内构造 Dyn ----------

struct DynCaller {
  base i64

  #Static
  fn make(b i64) DynCaller {
    ret Self {
      .base = b
    }
  }

  fn run() i64 {
    let bg Rc<G> = G::make(40i64, "test")
    let d Dyn<Greet> = Dyn:<Greet>(bg)
    d.hi() + $.base
  }
}

#Test
fn test_dyn_ctor_in_method() {
  let c DynCaller = DynCaller::make(2i64)
  assert_eq(c.run(), 42i64)
}

; ==================== spec 默认体 fall-through 经 Dyn<D> vtable ====================

#Spec
struct Sign {
  fn raw() i32
  fn is_pos() bool = $.raw() > 0
}

#Impl(Sign)
struct N2 {
  v i32

  #Static
  fn make(v i32) N2 {
    ret Self {
      .v = v
    }
  }

  fn raw() i32 {
    $.v
  }
}

#Test
fn test_dyn_default_fallthrough() {
  let ra Rc<N2> = N2::make(3)
  let da Dyn<Sign> = Dyn:<Sign>(ra)
  assert_true(da.is_pos())

  let rb Rc<N2> = N2::make(0)
  let db Dyn<Sign> = Dyn:<Sign>(rb)
  assert_false(db.is_pos())

  let rc Rc<N2> = N2::make(-5)
  let dc Dyn<Sign> = Dyn:<Sign>(rc)
  assert_false(dc.is_pos())
}
