;  assert_eq(a2.len(), 3i64)
;  assert_eq(a1.len(), 3i64)
;  assert_eq(a2[0], 10i32)
;  assert_eq(a2[2], 30i32)
;}

; ---------- String：内含 Array<u32>，递归 retain ----------

#Test
fn test_copy_of_string() {
  #Mut let s1 String = "hello"
  #Mut let s2 String = copy_of:<String>(s1)
  assert_eq(s2, "hello")
  assert_eq(s1, "hello")
}

; ---------- 平凡 struct（无 RC 字段）：纯 memcpy ----------

#Test
fn test_copy_of_struct_no_rc_field() {
  #Mut let p1 CopyPair = CopyPair::make(5i32, 6i32)
  #Mut let p2 CopyPair = copy_of:<CopyPair>(p1)
  assert_eq(p2.a, 5i32)
  assert_eq(p2.b, 6i32)
}

; ---------- 含 Rc 字段的 struct：字段级 retain ----------

#Test
fn test_copy_of_struct_with_box_field() {
  #Mut let p Rc<CopyPair> = CopyPair::make(5i32, 6i32)
  #Mut let h1 Holder = Holder::make(p, 100i32)
  #Mut let h2 Holder = copy_of:<Holder>(h1)
  assert_eq(h2.tag, 100i32)
  assert_eq(h1.tag, 100i32)
  assert_eq(h2.payload.a, 5i32)
  assert_eq(h1.payload.a, 5i32)
  assert_eq(h2.payload.b, 6i32)
}
