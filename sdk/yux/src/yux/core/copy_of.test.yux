; copy_of<T> 用例（DRAFT-const-mut [#1.I] 脱 const 出口）
; 覆盖：原子 / Rc / Array / String / 平凡 struct / 含 Rc 字段 struct（字段级 retain）

struct CopyPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) CopyPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

struct Holder {
  payload Rc<CopyPair>
  tag i32

  #Static
  fn make(p Rc<CopyPair>, t i32) Holder {
    ret Self {
      .payload = p
      .tag = t
    }
  }
}

; ---------- 原子类型：纯值复制 ----------

#Test
fn test_copy_of_i32() {
  #Mut let x i32 = 42i32
  #Mut let y i32 = copy_of:<i32>(x)
  assert_eq(y, 42i32)
}

; ---------- Rc<T>：handle copy + strong++ ----------

#Test
fn test_copy_of_box_handle() {
  #Mut let b1 Rc<CopyPair> = CopyPair::make(11i32, 22i32)
  #Mut let b2 Rc<CopyPair> = copy_of:<Rc<CopyPair>>(b1)
  ; 两个 Rc 看到同一份数据（浅拷句柄 + strong++）
  assert_eq(b1.a, 11i32)
  assert_eq(b2.a, 11i32)
  assert_eq(b1.b, 22i32)
  assert_eq(b2.b, 22i32)
}

; ---------- Array<T>：handle copy + strong++ ----------
; TODO: Array 暂不支持浅/深复制（#NoCopy），等实现后再启用此测试

;#Test
;fn test_copy_of_array() {
