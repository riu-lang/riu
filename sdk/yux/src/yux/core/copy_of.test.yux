; copy_of<T> 用例（DRAFT-const-mut [#1.I] 脱 const 出口）
; 覆盖：原子 / Rc / Array / String / 平凡 struct / 含 Rc 字段 struct（字段级 retain）

struct CopyPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) CopyPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

struct Holder {
  payload Rc<CopyPair>
  tag i32

  #Static
  fn make(p Rc<CopyPair>, t i32) Holder {
    ret Self {
      .payload = p
      .tag = t
    }
  }
}

; ---------- 原子类型：纯值复制 ----------

#Test
fn test_copy_of_i32() {
  #Mut let x i32 = 42
  #Mut let y i32 = copy_of(x)
  assert_eq(y, 42)
}

; ---------- Rc<T>：handle copy + strong++ ----------

#Test
fn test_copy_of_box_handle() {
  #Mut let b1 Rc<CopyPair> = CopyPair::make(11, 22)
  #Mut let b2 Rc<CopyPair> = copy_of(b1)
  ; 两个 Rc 看到同一份数据（浅拷句柄 + strong++）
  assert_eq(b1.a, 11)
  assert_eq(b2.a, 11)
  assert_eq(b1.b, 22)
  assert_eq(b2.b, 22)
}

; ---------- Array<T>：深拷贝（.clone() 唯一入口，copy_of 不再接受 Array）----------

#Test
fn test_array_clone_i32() {
  #Mut let a1 Array<i32> = [10i32, 20i32, 30i32]
  #Mut let a2 Array<i32> = a1.clone()
  assert_eq(a2.len(), 3)
  assert_eq(a1.len(), 3)
  assert_eq(a2[0], 10i32)
  assert_eq(a2[1], 20i32)
  assert_eq(a2[2], 30i32)
  ; 修改 a1 不影响 a2（独立缓冲）
  a1[0] = 99i32
  assert_eq(a1[0], 99i32)
  assert_eq(a2[0], 10i32)
}

#Test
fn test_array_clone_empty() {
  let a1 Array<i32> = []
  #Mut let a2 Array<i32> = a1.clone()
  assert_eq(a2.len(), 0)
}

#Test
fn test_array_clone_struct() {
  #Mut let a1 Array<CopyPair> = [CopyPair::make(1, 2), CopyPair::make(3, 4), CopyPair::make(5, 6)]
  #Mut let a2 Array<CopyPair> = a1.clone()
  assert_eq(a2.len(), 3)
  assert_eq(a2[0].a, 1)
  assert_eq(a2[0].b, 2)
  assert_eq(a2[2].a, 5)
  assert_eq(a2[2].b, 6)
}

#Test
fn test_array_clone_string() {
  #Mut let a1 Array<String> = ["hello", "world"]
  #Mut let a2 Array<String> = a1.clone()
  assert_eq(a2.len(), 2)
  assert_eq(a2[0], "hello")
  assert_eq(a2[1], "world")
  ; 修改 a1 不影响 a2
  a1[0] = "changed"
  assert_eq(a1[0], "changed")
  assert_eq(a2[0], "hello")
}

; ---------- String：内含 Array<u32>，递归 retain ----------

#Test
fn test_copy_of_string() {
  #Mut let s1 String = "hello"
  #Mut let s2 String = copy_of(s1)
  assert_eq(s2, "hello")
  assert_eq(s1, "hello")
}

; ---------- 平凡 struct（无 RC 字段）：纯 memcpy ----------

#Test
fn test_copy_of_struct_no_rc_field() {
  #Mut let p1 CopyPair = CopyPair::make(5, 6)
  #Mut let p2 CopyPair = copy_of(p1)
  assert_eq(p2.a, 5)
  assert_eq(p2.b, 6)
}

; ---------- 含 Rc 字段的 struct：字段级 retain ----------

#Test
fn test_copy_of_struct_with_box_field() {
  #Mut let p Rc<CopyPair> = CopyPair::make(5, 6)
  #Mut let h1 Holder = Holder::make(p, 100)
  #Mut let h2 Holder = copy_of(h1)
  assert_eq(h2.tag, 100)
  assert_eq(h1.tag, 100)
  assert_eq(h2.payload.a, 5)
  assert_eq(h1.payload.a, 5)
  assert_eq(h2.payload.b, 6)
}

; ---------- 含 String 字段的 struct ----------

struct Named {
  name String
  id i32

  #Static
  fn make(name String, id i32) Named {
    ret Self {
      .name = name
      .id = id
    }
  }
}

#Test
fn test_copy_of_struct_with_string_field() {
  ; 验证：copy_of 含 String 字段的 struct 正确 retain
  #Mut let n1 Named = Named::make("alice", 1)
  #Mut let n2 Named = copy_of(n1)
  assert_eq(n2.name, "alice")
  assert_eq(n2.id, 1)
  assert_eq(n1.name, "alice")
}
