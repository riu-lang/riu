; Rc<T> 行为用例（迁自 tests/cases/box_*、var_reassign_box）
; 覆盖：基础构造与字段读、句柄复制共享、上下文驱动重赋、move-return、
;       变量重赋走 retain-then-release、自赋值。

struct BoxPair {
  a i32
  b i32
}

BoxPair {
  fn BoxPair(a i32, b i32) {
    $.a = a
    $.b = b
  }

  fn set_a(v i32) {
    $.a = v
  }

  fn sum() i32 {
    ret $.a + $.b
  }
}

struct BoxCell {
  n i32
}

BoxCell {
  fn BoxCell(n i32) {
    $.n = n
  }
}

; ---------- box_basic：构造、字段读、句柄复制共享语义 ----------

#Test
fn test_box_basic_fields() {
  #Mut let p Rc<BoxPair> = BoxPair(11i32, 22i32)
  assert_eq(p.a, 11i32)
  assert_eq(p.b, 22i32)

  ; 句柄复制：q 与 p 共享同一 Block
  #Mut let q Rc<BoxPair> = p
  assert_eq(q.a, 11i32)
  assert_eq(q.b, 22i32)
}

; ---------- box_share：通过一个句柄写穿，另一个读到 ----------

#Test
fn test_box_share_write_through() {
  #Mut let p Rc<BoxPair> = BoxPair(10i32, 20i32)
  #Mut let q Rc<BoxPair> = p
  p.set_a(100i32)
  assert_eq(q.a, 100i32)
  assert_eq(q.b, 20i32)
  assert_eq(p.sum(), 120i32)
  assert_eq(q.sum(), 120i32)
}

; ---------- box_field_write：Rc<T>.field = ... 自动 deref 写入（与读路径对称） ----------
; 回归 BUGS.md「Rc 成员写入语义层报 E3045」

#Test
fn test_box_field_write() {
  #Mut let p Rc<BoxPair> = BoxPair(1i32, 2i32)
  p.a = 100i32
  p.b = 200i32
  assert_eq(p.a, 100i32)
  assert_eq(p.b, 200i32)

  ; 复合赋值同样要走 deref
  p.a += 1i32
  assert_eq(p.a, 101i32)

  ; 共享句柄：写穿后另一句柄读到新值
  #Mut let q Rc<BoxPair> = p
  q.a = 7i32
  assert_eq(p.a, 7i32)
}

; ---------- box_reassign_ctor：Rc 上下文驱动构造 + 顶层重赋 ----------

#Test
fn test_box_reassign_ctor() {
  #Mut let b Rc<BoxPair> = BoxPair(7i32, 8i32)
  assert_eq(b.a, 7i32)
  assert_eq(b.b, 8i32)
  b = BoxPair(9i32, 10i32)
  assert_eq(b.a, 9i32)
  assert_eq(b.b, 10i32)
}

; ---------- box_return：函数返回 Rc<T> ----------

fn make_box_cell(x i32) Rc<BoxCell> {
  #Mut let c Rc<BoxCell> = BoxCell(x)
  ret c
}

#Test
fn test_box_return_move() {
  #Mut let b Rc<BoxCell> = make_box_cell(42i32)
  assert_eq(b.n, 42i32)

  #Mut let b2 Rc<BoxCell> = make_box_cell(7i32)
  assert_eq(b2.n, 7i32)
}

; ---------- var_reassign_box：变量重赋 retain-then-release & 自赋值 ----------

#Test
fn test_box_var_reassign() {
  #Mut let p Rc<BoxPair> = BoxPair(1i32, 2i32)
  #Mut let q Rc<BoxPair> = BoxPair(3i32, 4i32)
  #Mut let b Rc<BoxPair> = p
  assert_eq(b.a, 1i32)
  b = q
  assert_eq(b.a, 3i32)
  ; p 仍可读
  assert_eq(p.b, 2i32)
  assert_eq(q.a, 3i32)
  ; 自赋值
  b = b
  assert_eq(b.b, 4i32)
}

; ---------- Rc<primitive>.method()：内置类型方法 receiver 走 by-value ABI ----------
; 回归 BUGS.md「Rc<primitive>.method() 调用走错路径 / IR 签名 assert」
; 单跑会读到栈残值；与直接字面量方法共存会触发 LLVM bad signature。

#Test
fn test_box_i32_to_string() {
  let b Rc<i32> = 42i32
  let s String = b.to_string()
  assert_eq(s, "42")
}

#Test
fn test_box_i32_with_literal_method() {
  let b Rc<i32> = 42i32
  ; 字面量直接调用与 Rc 调用并存：曾触发 LLVM "Calling a function with a bad signature!"
  let s1 String = 7i32.to_string()
  let s2 String = b.to_string()
  assert_eq(s1, "7")
  assert_eq(s2, "42")
}

#Test
fn test_box_i64_to_string() {
  let b Rc<i64> = 123i64
  assert_eq(b.to_string(), "123")
}

#Test
fn test_box_bool_to_string() {
  let b Rc<bool> = true
  assert_eq(b.to_string(), "true")
}
