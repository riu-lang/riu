; yux.io：模块别名 `io.fn` 与全限定 `yux.io.fn`
; 须显式 `use yux.io`（FQ 不引入未导入的包）

use yux.io

; 验证：末段别名 io.read_file（缺文件 → NotFound）
#Test
fn test_io_alias_missing() {
  let path String = "_yux_io_alias_nope.txt"
  try {
    let _s String = io.read_file(&path)
    fail("alias missing file should error")
  } catch e io.IoErr {
    match e {
      io.IoErr::NotFound => {
      }
      io.IoErr::Eof => fail("alias missing: Eof")
      io.IoErr::AccessDenied => fail("alias missing: AccessDenied")
      io.IoErr::InvalidUtf8 => fail("alias missing: InvalidUtf8")
      io.IoErr::Other(code) => fail("alias missing: Other(${code})")
    }
  }
}

; 验证：全限定 yux.io.read_file（缺文件 → NotFound）
#Test
fn test_io_fq_missing() {
  let path String = "_yux_io_fq_nope.txt"
  try {
    let _s String = yux.io.read_file(&path)
    fail("fq missing file should error")
  } catch e io.IoErr {
    match e {
      io.IoErr::NotFound => {
      }
      io.IoErr::Eof => fail("fq missing: Eof")
      io.IoErr::AccessDenied => fail("fq missing: AccessDenied")
      io.IoErr::InvalidUtf8 => fail("fq missing: InvalidUtf8")
      io.IoErr::Other(code) => fail("fq missing: Other(${code})")
    }
  }
}
