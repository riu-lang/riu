; yux SDK - 文件 / stdin IO（v0.21 Phase A，分层文件 API）
; 路径走 CreateFileW（UTF-16）；文件内容 UTF-8；错误通道为 T ! IoErr。
; 独立包 yux.io：须 `use yux.io` / `use yux.io.*` 后才有 `io.fn` / `yux.io.fn`。

use yux.core.helper.*

extern {
  ; `_` 前缀避免本文件符号再经 sdk 通配导入后与自身构成 E6014
  #CName("CreateFileW")
  fn _CreateFileW(lpFileName Ptr, dwDesiredAccess u32, dwShareMode u32, lpSecurityAttributes Ptr, dwCreationDisposition u32, dwFlagsAndAttributes u32, hTemplateFile Ptr) Ptr
  #CName("ReadFile")
  fn _ReadFile(hFile Ptr, lpBuffer Ptr, nNumberOfBytesToRead u32, lpNumberOfBytesRead Ptr, lpOverlapped Ptr) i32
  #CName("CloseHandle")
  fn _CloseHandle(hObject Ptr) i32
  #CName("FlushFileBuffers")
  fn _FlushFileBuffers(hFile Ptr) i32
  #CName("GetLastError")
  fn _GetLastError() u32
  #CName("SetFilePointer")
  fn _SetFilePointer(hFile Ptr, lDistanceToMove i32, lpDistanceToMoveHigh Ptr, dwMoveMethod u32) u32
  #CName("GetFileAttributesW")
  fn _GetFileAttributesW(lpFileName Ptr) u32
  #CName("GetFileAttributesExW")
  fn _GetFileAttributesExW(lpFileName Ptr, fInfoLevelId u32, lpFileInformation Ptr) i32
  #CName("DeleteFileW")
  fn _DeleteFileW(lpFileName Ptr) i32
  #CName("RemoveDirectoryW")
  fn _RemoveDirectoryW(lpPathName Ptr) i32
  #CName("CreateDirectoryW")
  fn _CreateDirectoryW(lpPathName Ptr, lpSecurityAttributes Ptr) i32
  #CName("GetCurrentDirectoryW")
  fn _GetCurrentDirectoryW(nBufferLength u32, lpBuffer Ptr) u32
  #CName("GetEnvironmentVariableW")
  fn _GetEnvironmentVariableW(lpName Ptr, lpBuffer Ptr, nSize u32) u32
  #CName("FindFirstFileW")
  fn _FindFirstFileW(lpFileName Ptr, lpFindFileData Ptr) Ptr
  #CName("FindNextFileW")
  fn _FindNextFileW(hFindFile Ptr, lpFindFileData Ptr) i32
  #CName("FindClose")
  fn _FindClose(hFindFile Ptr) i32
  #CName("SetFileAttributesW")
  fn _SetFileAttributesW(lpFileName Ptr, dwFileAttributes u32) i32
  #CName("GetFullPathNameW")
  fn _GetFullPathNameW(lpFileName Ptr, nBufferLength u32, lpBuffer Ptr, lpFilePart Ptr) u32
  #CName("CreateHardLinkW")
  fn _CreateHardLinkW(lpFileName Ptr, lpExistingFileName Ptr, lpSecurityAttributes Ptr) i32
  #CName("CreateSymbolicLinkW")
  fn _CreateSymbolicLinkW(lpSymlinkFileName Ptr, lpTargetFileName Ptr, dwFlags u32) i32
  #CName("DeviceIoControl")
  fn _DeviceIoControl(hDevice Ptr, dwIoControlCode u32, lpInBuffer Ptr, nInBufferSize u32, lpOutBuffer Ptr, nOutBufferSize u32, lpBytesReturned Ptr, lpOverlapped Ptr) i32
}

; Win32 常量（文件作用域）
#Cval
let _GENERIC_READ u32 = 0x80000000u32
#Cval
let _GENERIC_WRITE u32 = 0x40000000u32
#Cval
let _FILE_SHARE_RW u32 = 3
#Cval
let _CREATE_ALWAYS u32 = 2
#Cval
let _OPEN_EXISTING u32 = 3
#Cval
let _OPEN_ALWAYS u32 = 4
#Cval
let _FILE_ATTRIBUTE_NORMAL u32 = 128
#Cval
let _FILE_END u32 = 2
#Cval
let _STD_INPUT_HANDLE i32 = -10
#Cval
let _INVALID_HANDLE u64 = 0xFFFFFFFFFFFFFFFFu64
#Cval
let _INVALID_SET_PTR u32 = 0xFFFFFFFFu32
#Cval
let _ERROR_FILE_NOT_FOUND u32 = 2
#Cval
let _ERROR_PATH_NOT_FOUND u32 = 3
#Cval
let _ERROR_ACCESS_DENIED u32 = 5
#Cval
let _ERROR_HANDLE_EOF u32 = 38
#Cval
let _INVALID_FILE_ATTRIBUTES u32 = 0xFFFFFFFFu32
#Cval
let _ERROR_NO_MORE_FILES u32 = 18
#Cval
let _ERROR_PRIVILEGE_NOT_HELD u32 = 1314
#Cval
let _FILE_ATTRIBUTE_READONLY u32 = 1
#Cval
let _FILE_ATTRIBUTE_DIRECTORY u32 = 16
#Cval
let _FILE_ATTRIBUTE_REPARSE_POINT u32 = 1024
#Cval
let _FILE_ATTRIBUTE_DEVICE u32 = 64
#Cval
let _FILE_FLAG_OPEN_REPARSE_POINT u32 = 0x00200000
#Cval
let _FILE_FLAG_BACKUP_SEMANTICS u32 = 0x02000000
#Cval
let _SYMBOLIC_LINK_DIRECTORY u32 = 1
#Cval
let _SYMBOLIC_LINK_UNPRIVILEGED u32 = 2
#Cval
let _IO_REPARSE_TAG_MOUNT_POINT u32 = 0xA0000003
#Cval
let _FSCTL_SET_REPARSE_POINT u32 = 0x000900A4

enum IoErr {
  Eof
  NotFound
  AccessDenied
  InvalidUtf8
  Closed
  Other(u32)
}

fn _bad_handle(h Ptr) bool {
  let a u64 = h.to_int()
  a == 0 || a == _INVALID_HANDLE
}

fn _map_err(code u32) IoErr {
  if code == _ERROR_FILE_NOT_FOUND || code == _ERROR_PATH_NOT_FOUND {
    ret IoErr::NotFound
  }
  if code == _ERROR_ACCESS_DENIED {
    ret IoErr::AccessDenied
  }
  if code == _ERROR_HANDLE_EOF {
    ret IoErr::Eof
  }
  ret IoErr::Other(code)
}

fn _map_last_err() IoErr {
  _map_err(_GetLastError())
}

; String 码点 → NUL 结尾 UTF-16（CreateFileW）
fn _to_wide(path String&) Array<u16> {
  #Mut let w Array<u16> = []
  loop i usize = 0 {
    if i >= path.len() {
      break;
    }
    let cp u32 = path.get(i)
    if cp < 65536 {
      w.push(cp.to_u16())
    } else {
      let u u32 = cp - 65536
      w.push((55296u32 + (u >> 10u32)).to_u16())
      w.push((56320u32 + (u & 1023u32)).to_u16())
    }
    i += 1
  }
  w.push(0u16)
  w
}

fn _from_utf8(bytes Array<u8>&) String ! IoErr {
  #Mut let cps Array<u32> = []
  #Mut let i usize = 0
  let n usize = bytes.len()
  loop {
    if i >= n {
      break;
    }
    let b0 u8 = copy_of(bytes[i])
    if b0 < 128u8 {
      cps.push(b0.to_u32())
      i += 1
    } elif b0 >= 194u8 && b0 < 224u8 {
      if i + 1 >= n {
        ret IoErr::InvalidUtf8
      }
      let b1 u8 = copy_of(bytes[i + 1])
      if b1 < 128u8 || b1 >= 192u8 {
        ret IoErr::InvalidUtf8
      }
      let cp u32 = ((b0.to_u32() - 192u32) << 6u32) + (b1.to_u32() - 128u32)
      cps.push(cp)
      i += 2
    } elif b0 >= 224u8 && b0 < 240u8 {
      if i + 2 >= n {
        ret IoErr::InvalidUtf8
      }
      let b1 u8 = copy_of(bytes[i + 1])
      let b2 u8 = copy_of(bytes[i + 2])
      if b1 < 128u8 || b1 >= 192u8 || b2 < 128u8 || b2 >= 192u8 {
        ret IoErr::InvalidUtf8
      }
      if b0 == 224u8 && b1 < 160u8 {
        ret IoErr::InvalidUtf8
      }
      if b0 == 237u8 && b1 >= 160u8 {
        ret IoErr::InvalidUtf8
      }
      let cp u32 = ((b0.to_u32() - 224u32) << 12u32) + ((b1.to_u32() - 128u32) << 6u32) + (b2.to_u32() - 128u32)
      cps.push(cp)
      i += 3
    } elif b0 >= 240u8 && b0 < 245u8 {
      if i + 3 >= n {
        ret IoErr::InvalidUtf8
      }
      let b1 u8 = copy_of(bytes[i + 1])
      let b2 u8 = copy_of(bytes[i + 2])
      let b3 u8 = copy_of(bytes[i + 3])
      if b1 < 128u8 || b1 >= 192u8 || b2 < 128u8 || b2 >= 192u8 || b3 < 128u8 || b3 >= 192u8 {
        ret IoErr::InvalidUtf8
      }
      if b0 == 240u8 && b1 < 144u8 {
        ret IoErr::InvalidUtf8
      }
      if b0 == 244u8 && b1 >= 144u8 {
        ret IoErr::InvalidUtf8
      }
      let cp u32 = ((b0.to_u32() - 240u32) << 18u32) + ((b1.to_u32() - 128u32) << 12u32) + ((b2.to_u32() - 128u32) << 6u32) + (b3.to_u32() - 128u32)
      cps.push(cp)
      i += 4
    } else {
      ret IoErr::InvalidUtf8
    }
  }
  String::from(&cps)
}

fn _open(path String&, access u32, disp u32) Ptr ! IoErr {
  #Mut let wide Array<u16> = _to_wide(path)
  let h Ptr = _CreateFileW(wide, access, _FILE_SHARE_RW, null, disp, _FILE_ATTRIBUTE_NORMAL, null)
  if _bad_handle(h) {
    ret _map_last_err()
  }
  h
}

fn _close_handle(h Ptr) ! IoErr {
  if _bad_handle(h) {
    ret;
  }
  if _CloseHandle(h) == 0 {
    ret _map_last_err()
  }
}

fn _close_best_effort(h Ptr) {
  if !_bad_handle(h) {
    _CloseHandle(h);
  }
}

; 从当前游标最多读取 max_bytes；不拥有也不关闭句柄。
fn _read_handle(h Ptr, max_bytes usize) Array<u8> ! IoErr {
  #Mut let out Array<u8> = []
  loop {
    if out.len() >= max_bytes {
      break;
    }
    #Mut let request usize = max_bytes - out.len()
    if request > 256 {
      request = 256
    }
    #Mut let chunk [u8 * 256] = [0u8 ...]
    #Mut let written u32 = 0
    let ok i32 = _ReadFile(h, &chunk, request.to_u32(), &written, null)
    if ok == 0 {
      let err u32 = _GetLastError()
      if err == _ERROR_HANDLE_EOF {
        break;
      }
      ret _map_err(err)
    }
    if written == 0 {
      break;
    }
    loop i usize = 0 {
      if i.to_u32() >= written {
        break;
      }
      out.push(copy_of(chunk[i]))
      i += 1
    }
  }
  out
}

; 从当前游标读到 EOF；不拥有也不关闭句柄。
fn _read_to_end_handle(h Ptr) Array<u8> ! IoErr {
  #Mut let out Array<u8> = []
  loop {
    #Mut let chunk [u8 * 256] = [0u8 ...]
    #Mut let written u32 = 0
    let ok i32 = _ReadFile(h, &chunk, 256, &written, null)
    if ok == 0 {
      let err u32 = _GetLastError()
      if err == _ERROR_HANDLE_EOF {
        break;
      }
      ret _map_err(err)
    }
    if written == 0 {
      break;
    }
    loop i usize = 0 {
      if i.to_u32() >= written {
        break;
      }
      out.push(copy_of(chunk[i]))
      i += 1
    }
  }
  out
}

; 循环处理短写；不拥有也不关闭句柄。
fn _write_bytes_handle(h Ptr, bytes Array<u8>&) ! IoErr {
  #Mut let offset usize = 0
  loop {
    if offset >= bytes.len() {
      break;
    }
    #Mut let request usize = bytes.len() - offset
    if request > 256 {
      request = 256
    }
    #Mut let chunk [u8 * 256] = [0u8 ...]
    loop i usize = 0 {
      if i >= request {
        break;
      }
      chunk[i] = copy_of(bytes[offset + i])
      i += 1
    }
    #Mut let written u32 = 0
    let ok i32 = WriteFile(h, &chunk, request.to_u32(), &written, null)
    if ok == 0 {
      ret _map_last_err()
    }
    if written == 0 {
      ret IoErr::Other(0u32)
    }
    offset += written.to_usize()
  }
}

fn _write_string_handle(h Ptr, content String&) ! IoErr {
  let bytes Array<u8> = content.to_bytes()
  _write_bytes_handle(h, &bytes)!
}

enum FileKind {
  Regular
  Directory
  Link
  Other
}

struct FileInfo {
  #Val
  kind FileKind
  #Val
  size u64
  #Val
  readonly bool
}

struct Path {
  ; 路径值持有自己的 String 引用，不借用构造参数。
  #Val
  _raw String

  #Static
  fn from(raw String&) Path {
    let owned String = raw.to_string()
    ret Self {
      ._raw = move(owned)
    }
  }

  #Static
  fn cwd() Path ! IoErr {
    let raw String = cwd()!
    Path::from(&raw)
  }

  fn to_string() String {
    $._raw.to_string()
  }

  fn join(child String&) Path {
    let base String = $._raw.to_string()
    let raw String = _join_path(&base, child)
    Path {
      ._raw = move(raw)
    }
  }

  fn parent() Path {
    let base String = $._raw.to_string()
    let raw String = dirname(&base)
    Path {
      ._raw = move(raw)
    }
  }

  fn name() String {
    let base String = $._raw.to_string()
    basename(&base)
  }

  fn absolute() Path ! IoErr {
    let base String = $._raw.to_string()
    let raw String = abs(&base)!
    Path {
      ._raw = move(raw)
    }
  }
}

; 按 Win32 文件属性结构的小端布局读取字段。
fn _read_u32_le(data [u8 * 36]&, offset usize) u32 {
  let b0 u32 = data[offset].to_u32()
  let b1 u32 = data[offset + 1].to_u32()
  let b2 u32 = data[offset + 2].to_u32()
  let b3 u32 = data[offset + 3].to_u32()
  b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)
}

fn _combine_file_size(high u32, low u32) u64 {
  (high.to_u64() << 32u64) | low.to_u64()
}

fn _file_info(path String&) FileInfo ! IoErr {
  #Mut let wide Array<u16> = _to_wide(path)
  #Mut let data [u8 * 36] = [0u8 ...]
  if _GetFileAttributesExW(wide, 0u32, &data) == 0 {
    ret _map_last_err()
  }
  let attrs u32 = _read_u32_le(&data, 0usize)
  #Mut let kind FileKind = FileKind::Regular
  if (attrs & _FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
    kind = FileKind::Link
  } elif (attrs & _FILE_ATTRIBUTE_DIRECTORY) != 0 {
    kind = FileKind::Directory
  } elif (attrs & _FILE_ATTRIBUTE_DEVICE) != 0 {
    kind = FileKind::Other
  }
  let high u32 = _read_u32_le(&data, 28usize)
  let low u32 = _read_u32_le(&data, 32usize)
  FileInfo {
    .kind = kind
    .size = _combine_file_size(high, low)
    .readonly = (attrs & _FILE_ATTRIBUTE_READONLY) != 0
  }
}

struct File {
  #Val
  _path Path

  #Static
  fn at(path Path&) File {
    Self {
      ._path = copy_of:<Path>(path)
    }
  }

  #Static
  fn from(raw String&) File {
    Self {
      ._path = Path::from(&raw)
    }
  }

  fn path() Path {
    copy_of:<Path>(&$._path)
  }

  fn exists() bool {
    let raw String = $._path.to_string()
    exists(&raw)
  }

  fn info() FileInfo ! IoErr {
    let raw String = $._path.to_string()
    _file_info(&raw)!
  }

  fn list() Array<File> ! IoErr {
    let parent String = $._path.to_string()
    let names Array<String> = list_dir(&parent)!
    #Mut let out Array<File> = []
    for name in names {
      let raw String = join(&parent, name)
      out.push(File::from(&raw))
    }
    ret out
  }

  fn mkdir() ! IoErr {
    let raw String = $._path.to_string()
    mkdir(&raw)!
  }

  fn remove() ! IoErr {
    let raw String = $._path.to_string()
    remove(&raw)!
  }

  fn remove_all() ! IoErr {
    let raw String = $._path.to_string()
    remove_all(&raw)!
  }
}

#NoCopy
struct FileInputStream {
  _handle Ptr

  fn ~() {
    _close_best_effort($._handle)
    $._handle = null
  }

  #Static
  fn open(path Path&) FileInputStream ! IoErr {
    let raw String = path.to_string()
    let h Ptr = _open(&raw, _GENERIC_READ, _OPEN_EXISTING)!
    Self {
      ._handle = h
    }
  }

  fn is_open() bool {
    !_bad_handle($._handle)
  }

  fn close() ! IoErr {
    let h Ptr = $._handle
    $._handle = null
    _close_handle(h)!
  }

  fn read(max_bytes usize) Array<u8> ! IoErr {
    if !$.is_open() {
      ret IoErr::Closed
    }
    _read_handle($._handle, max_bytes)!
  }

  fn read_to_end() Array<u8> ! IoErr {
    if !$.is_open() {
      ret IoErr::Closed
    }
    _read_to_end_handle($._handle)!
  }

  fn read_to_string() String ! IoErr {
    let bytes Array<u8> = $.read_to_end()!
    _from_utf8(&bytes)!
  }
}

#NoCopy
struct FileOutputStream {
  _handle Ptr

  fn ~() {
    _close_best_effort($._handle)
    $._handle = null
  }

  #Static
  fn create(path Path&) FileOutputStream ! IoErr {
    let raw String = path.to_string()
    let h Ptr = _open(&raw, _GENERIC_WRITE, _CREATE_ALWAYS)!
    Self {
      ._handle = h
    }
  }

  #Static
  fn append(path Path&) FileOutputStream ! IoErr {
    let raw String = path.to_string()
    let h Ptr = _open(&raw, _GENERIC_WRITE, _OPEN_ALWAYS)!
    let pos u32 = _SetFilePointer(h, 0, null, _FILE_END)
    if pos == _INVALID_SET_PTR {
      let err u32 = _GetLastError()
      if err != 0 {
        _close_best_effort(h)
        ret _map_err(err)
      }
    }
    Self {
      ._handle = h
    }
  }

  fn is_open() bool {
    !_bad_handle($._handle)
  }

  fn close() ! IoErr {
    let h Ptr = $._handle
    $._handle = null
    _close_handle(h)!
  }

  fn write(bytes Array<u8>&) ! IoErr {
    if !$.is_open() {
      ret IoErr::Closed
    }
    _write_bytes_handle($._handle, bytes)!
  }

  fn write_string(content String&) ! IoErr {
    if !$.is_open() {
      ret IoErr::Closed
    }
    _write_string_handle($._handle, content)!
  }

  fn flush() ! IoErr {
    if !$.is_open() {
      ret IoErr::Closed
    }
    if _FlushFileBuffers($._handle) == 0 {
      ret _map_last_err()
    }
  }
}

fn read_file(path String&) String ! IoErr {
  let p Path = Path::from(&path)
  let stream FileInputStream = try {
    FileInputStream::open(&p)
  } catch e IoErr {
    ret e
  }
  let content String = stream.read_to_string()!
  stream.close()!
  content
}

fn write_file(path String&, content String&) ! IoErr {
  let p Path = Path::from(&path)
  let stream FileOutputStream = try {
    FileOutputStream::create(&p)
  } catch e IoErr {
    ret e
  }
  stream.write_string(content)!
  stream.close()!
}

fn append_file(path String&, content String&) ! IoErr {
  let p Path = Path::from(&path)
  let stream FileOutputStream = try {
    FileOutputStream::append(&p)
  } catch e IoErr {
    ret e
  }
  stream.write_string(content)!
  stream.close()!
}

; stdin 读到换行（不含）；去掉尾随 CR。一开始就 EOF → IoErr::Eof。
fn read_line() String ! IoErr {
  #Mut let h Ptr = GetStdHandle(_STD_INPUT_HANDLE)
  if _bad_handle(h) {
    ret _map_last_err()
  }
  #Mut let raw Array<u8> = []
  loop {
    #Mut let b [u8 * 1] = [0u8]
    #Mut let written u32 = 0
    let ok i32 = _ReadFile(h, &b, 1, &written, null)
    if ok == 0 {
      if raw.is_empty() {
        ret _map_last_err()
      }
      break;
    }
    if written == 0 {
      if raw.is_empty() {
        ret IoErr::Eof
      }
      break;
    }
    let c u8 = copy_of(b[0])
    if c == 10u8 {
      break;
    }
    raw.push(c)
  }
  if !raw.is_empty() {
    let last usize = raw.len() - 1
    if copy_of(raw[last]) == 13u8 {
      raw.pop()
    }
  }
  _from_utf8(&raw)!
}

fn _is_sep(cp u32) bool {
  cp == c'/' || cp == c'\\'
}

fn _from_u16(buf Array<u16>&, n usize) String {
  #Mut let cps Array<u32> = []
  #Mut let i usize = 0
  loop {
    if i >= n {
      break;
    }
    let x u16 = copy_of(buf[i])
    if x == 0u16 {
      break;
    }
    if x >= 55296u16 && x < 56320u16 {
      i += 1
      if i >= n {
        cps.push(65533u32)
        break;
      }
      let y u16 = copy_of(buf[i])
      if y >= 56320u16 && y < 57344u16 {
        let cp u32 = 65536u32 + ((x.to_u32() - 55296u32) << 10u32) + (y.to_u32() - 56320u32)
        cps.push(cp)
        i += 1
      } else {
        cps.push(65533u32)
      }
    } else {
      cps.push(x.to_u32())
      i += 1
    }
  }
  String::from(&cps)
}

fn _cps_range(s String&, start usize, end usize) String {
  #Mut let buf Array<u32> = []
  loop i usize = start {
    if i >= end {
      break;
    }
    buf.push(s.get(i))
    i += 1
  }
  String::from(&buf)
}

fn _join_path(a String&, b String&) String {
  if a.is_empty() {
    ret b.to_string()
  }
  if b.is_empty() {
    ret a.to_string()
  }
  if _is_sep(a.get(a.len() - 1)) || _is_sep(b.get(0)) {
    ret a + b
  }
  ret a + "\\" + b
}

fn join(a String&, b String&) String {
  ret _join_path(a, b)
}

fn dirname(path String&) String {
  #Mut let end usize = path.len()
  loop {
    if end == 0 {
      break;
    }
    if !_is_sep(path.get(end - 1)) {
      break;
    }
    end -= 1
  }
  if end == 0 {
    if path.len() == 0 {
      ret "."
    }
    ret _cps_range(path, 0, 1)
  }
  #Mut let sep usize? = null
  loop i usize = 0 {
    if i >= end {
      break;
    }
    if _is_sep(path.get(i)) {
      sep = i
    }
    i += 1
  }
  if !sep.has() {
    ret "."
  }
  let s usize = sep.get()
  if s == 0 {
    ret _cps_range(path, 0, 1)
  }
  _cps_range(path, 0, s)
}

fn exists(path String&) bool {
  #Mut let wide Array<u16> = _to_wide(path)
  let attr u32 = _GetFileAttributesW(wide)
  attr != _INVALID_FILE_ATTRIBUTES
}

fn remove(path String&) ! IoErr {
  #Mut let wide Array<u16> = _to_wide(path)
  let ok i32 = _DeleteFileW(wide)
  if ok != 0 {
    ret;
  }
  let okd i32 = _RemoveDirectoryW(wide)
  if okd != 0 {
    ret;
  }
  _map_last_err()
}

fn mkdir(path String&) ! IoErr {
  #Mut let wide Array<u16> = _to_wide(path)
  let ok i32 = _CreateDirectoryW(wide, null)
  if ok == 0 {
    ret _map_last_err()
  }
}

fn cwd() String ! IoErr {
  let need u32 = _GetCurrentDirectoryW(0, null)
  if need == 0 {
    ret _map_last_err()
  }
  let n usize = need.to_usize()
  #Mut let buf Array<u16> = Array:<u16>::with_capacity(n)
  loop i usize = 0 {
    if i >= n {
      break;
    }
    buf.push(0u16)
    i += 1
  }
  let got u32 = _GetCurrentDirectoryW(need, buf)
  if got == 0 {
    ret _map_last_err()
  }
  _from_u16(&buf, got.to_usize())
}

fn env(name String&) String? {
  #Mut let wname Array<u16> = _to_wide(name)
  let need u32 = _GetEnvironmentVariableW(wname, null, 0)
  if need == 0 {
    ret null
  }
  let n usize = need.to_usize()
  #Mut let buf Array<u16> = Array:<u16>::with_capacity(n)
  loop i usize = 0 {
    if i >= n {
      break;
    }
    buf.push(0u16)
    i += 1
  }
  let got u32 = _GetEnvironmentVariableW(wname, buf, need)
  if got == 0 {
    ret null
  }
  _from_u16(&buf, got.to_usize())
}

fn _find_name(data [u8 * 592]&) String {
  #Mut let w Array<u16> = []
  #Mut let off usize = 44
  loop {
    if off + 1 >= 592 {
      break;
    }
    let lo u16 = copy_of(data[off]).to_u16()
    let hi u16 = copy_of(data[off + 1]).to_u16()
    let x u16 = lo + (hi << 8u16)
    if x == 0u16 {
      break;
    }
    w.push(x)
    off += 2
  }
  _from_u16(&w, w.len())
}

fn list_dir(path String&) Array<String> ! IoErr {
  let pattern String = join(path, "*")
  #Mut let wide Array<u16> = _to_wide(&pattern)
  #Mut let data [u8 * 592] = [0u8 ...]
  let h Ptr = _FindFirstFileW(wide, &data)
  if _bad_handle(h) {
    ret _map_last_err()
  }
  #Mut let out Array<String> = []
  loop {
    let name String = _find_name(&data)
    if name != "." && name != ".." {
      out.push(name)
    }
    let ok i32 = _FindNextFileW(h, &data)
    if ok == 0 {
      let err u32 = _GetLastError()
      if err != _ERROR_NO_MORE_FILES && err != 0 {
        _FindClose(h);
        ret _map_err(err)
      }
      break;
    }
  }
  _FindClose(h);
  out
}

fn _attrs(path String&) u32 {
  #Mut let wide Array<u16> = _to_wide(path)
  _GetFileAttributesW(wide)
}

fn _clear_readonly(path String&) {
  let attr u32 = _attrs(path)
  if attr != _INVALID_FILE_ATTRIBUTES && (attr & _FILE_ATTRIBUTE_READONLY) != 0 {
    #Mut let wide Array<u16> = _to_wide(path)
    _SetFileAttributesW(wide, attr & ~_FILE_ATTRIBUTE_READONLY);
  }
}

fn _push_u16_le(buf Array<u8>&, v u16) {
  buf.push((v & 255u16).to_u8())
  buf.push((v >> 8u16).to_u8())
}

fn _push_u32_le(buf Array<u8>&, v u32) {
  buf.push((v & 255u32).to_u8())
  buf.push(((v >> 8u32) & 255u32).to_u8())
  buf.push(((v >> 16u32) & 255u32).to_u8())
  buf.push(((v >> 24u32) & 255u32).to_u8())
}

fn _push_wide(buf Array<u8>&, w Array<u16>&) {
  loop i usize = 0 {
    if i >= w.len() {
      break;
    }
    _push_u16_le(buf, copy_of(w[i]))
    i += 1
  }
}

fn _wide_bytes(w Array<u16>&) usize {
  if w.len() == 0 {
    ret 0
  }
  (w.len() - 1) * 2
}

fn basename(path String&) String {
  #Mut let end usize = path.len()
  loop {
    if end == 0 {
      break;
    }
    if !_is_sep(path.get(end - 1)) {
      break;
    }
    end -= 1
  }
  if end == 0 {
    if path.len() == 0 {
      ret ""
    }
    ret _cps_range(path, 0, 1)
  }
  #Mut let start usize = 0
  loop i usize = 0 {
    if i >= end {
      break;
    }
    if _is_sep(path.get(i)) {
      start = i + 1
    }
    i += 1
  }
  if start >= end {
    ret path.to_string()
  }
  _cps_range(path, start, end)
}

fn is_dir(path String&) bool {
  let attr u32 = _attrs(path)
  attr != _INVALID_FILE_ATTRIBUTES && (attr & _FILE_ATTRIBUTE_DIRECTORY) != 0
}

fn is_file(path String&) bool {
  let attr u32 = _attrs(path)
  attr != _INVALID_FILE_ATTRIBUTES && (attr & _FILE_ATTRIBUTE_DIRECTORY) == 0
}

fn is_link(path String&) bool {
  let attr u32 = _attrs(path)
  attr != _INVALID_FILE_ATTRIBUTES && (attr & _FILE_ATTRIBUTE_REPARSE_POINT) != 0
}

fn abs(path String&) String ! IoErr {
  #Mut let wide Array<u16> = _to_wide(path)
  let need u32 = _GetFullPathNameW(wide, 0, null, null)
  if need == 0 {
    ret _map_last_err()
  }
  let n usize = need.to_usize()
  #Mut let buf Array<u16> = Array:<u16>::with_capacity(n)
  loop i usize = 0 {
    if i >= n {
      break;
    }
    buf.push(0u16)
    i += 1
  }
  let got u32 = _GetFullPathNameW(wide, need, buf, null)
  if got == 0 {
    ret _map_last_err()
  }
  _from_u16(&buf, got.to_usize())
}

fn remove_all(path String&) ! IoErr {
  let attr u32 = _attrs(path)
  if attr == _INVALID_FILE_ATTRIBUTES {
    let err u32 = _GetLastError()
    if err == _ERROR_FILE_NOT_FOUND || err == _ERROR_PATH_NOT_FOUND {
      ret;
    }
    ret _map_err(err)
  }
  _clear_readonly(path);
  #Mut let wide Array<u16> = _to_wide(path)
  if (attr & _FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
    #Mut let ok i32 = 0
    if (attr & _FILE_ATTRIBUTE_DIRECTORY) != 0 {
      ok = _RemoveDirectoryW(wide)
    } else {
      ok = _DeleteFileW(wide)
    }
    if ok == 0 {
      ret _map_last_err()
    }
    ret;
  }
  if (attr & _FILE_ATTRIBUTE_DIRECTORY) != 0 {
    let names Array<String> = list_dir(path)!
    for n in names {
      let child String = join(path, n)
      remove_all(&child)!
    }
    let okd i32 = _RemoveDirectoryW(wide)
    if okd == 0 {
      ret _map_last_err()
    }
    ret;
  }
  let okf i32 = _DeleteFileW(wide)
  if okf == 0 {
    ret _map_last_err()
  }
}

fn hardlink(target String&, link String&) ! IoErr {
  if is_dir(target) {
    ret IoErr::Other(1u32)
  }
  #Mut let tw Array<u16> = _to_wide(target)
  #Mut let lw Array<u16> = _to_wide(link)
  let ok i32 = _CreateHardLinkW(lw, tw, null)
  if ok == 0 {
    ret _map_last_err()
  }
}

fn symlink(target String&, link String&) ! IoErr {
  #Mut let flags u32 = _SYMBOLIC_LINK_UNPRIVILEGED
  if is_dir(target) {
    flags = flags | _SYMBOLIC_LINK_DIRECTORY
  }
  #Mut let tw Array<u16> = _to_wide(target)
  #Mut let lw Array<u16> = _to_wide(link)
  let ok i32 = _CreateSymbolicLinkW(lw, tw, flags)
  if ok == 0 {
    ret _map_last_err()
  }
}

fn _win32_absolute(path String&) String ! IoErr {
  let raw String = abs(path)!
  #Mut let buf Array<u32> = []
  loop i usize = 0 {
    if i >= raw.len() {
      break;
    }
    #Mut let cp u32 = raw.get(i)
    if cp == c'/' {
      cp = c'\\'
    }
    buf.push(cp)
    i += 1
  }
  loop {
    if buf.len() <= 3 {
      break;
    }
    let last u32 = copy_of(buf[buf.len() - 1])
    if last != c'\\' {
      break;
    }
    buf.pop()
  }
  String::from(&buf)
}

fn _write_junction(target String&, link String&) ! IoErr {
  let print0 String = _win32_absolute(target)!
  #Mut let subst String = ""
  #Mut let print String = ""
  if print0.starts_with("\\\\?\\UNC\\") {
    print = "\\\\" + _cps_range(&print0, 8, print0.len())
    subst = "\\??\\UNC\\" + _cps_range(&print, 2, print.len())
  } elif print0.starts_with("\\\\?\\") {
    print = _cps_range(&print0, 4, print0.len())
    subst = "\\??\\" + print
  } elif print0.starts_with("\\\\") {
    print = print0.to_string()
    subst = "\\??\\UNC\\" + _cps_range(&print0, 2, print0.len())
  } else {
    print = print0.to_string()
    subst = "\\??\\" + print0
  }
  #Mut let lw Array<u16> = _to_wide(link)
  let mk i32 = _CreateDirectoryW(lw, null)
  if mk == 0 {
    ret _map_last_err()
  }
  let h Ptr = _CreateFileW(lw, _GENERIC_WRITE, 0u32, null, _OPEN_EXISTING, _FILE_FLAG_BACKUP_SEMANTICS | _FILE_FLAG_OPEN_REPARSE_POINT, null)
  if _bad_handle(h) {
    let err IoErr = _map_last_err()
    _RemoveDirectoryW(lw);
    ret err
  }
  #Mut let sw Array<u16> = _to_wide(&subst)
  #Mut let pw Array<u16> = _to_wide(&print)
  let subst_bytes usize = _wide_bytes(&sw)
  let print_bytes usize = _wide_bytes(&pw)
  let path_bytes usize = subst_bytes + 2 + print_bytes + 2
  if path_bytes + 8 > 65535 {
    _CloseHandle(h);
    _RemoveDirectoryW(lw);
    ret IoErr::Other(0u32)
  }
  #Mut let buf Array<u8> = []
  _push_u32_le(&buf, _IO_REPARSE_TAG_MOUNT_POINT);
  _push_u16_le(&buf, (8 + path_bytes).to_u16());
  _push_u16_le(&buf, 0u16);
  _push_u16_le(&buf, 0u16);
  _push_u16_le(&buf, subst_bytes.to_u16());
  _push_u16_le(&buf, (subst_bytes + 2).to_u16());
  _push_u16_le(&buf, print_bytes.to_u16());
  _push_wide(&buf, &sw);
  _push_wide(&buf, &pw);
  #Mut let returned u32 = 0
  let ok i32 = _DeviceIoControl(h, _FSCTL_SET_REPARSE_POINT, buf, buf.len().to_u32(), null, 0u32, &returned, null)
  #Mut let err u32 = 0
  if ok == 0 {
    err = _GetLastError()
  }
  _CloseHandle(h);
  if ok == 0 {
    _RemoveDirectoryW(lw);
    ret _map_err(err)
  }
}

fn junction(target String&, link String&) ! IoErr {
  if !is_dir(target) {
    ret IoErr::Other(1u32)
  }
  _write_junction(target, link)!
}
