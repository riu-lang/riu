; yux SDK - 自举运行时
; 使用 Windows API 进行 I/O

; 外部 Windows 函数声明
extern {
  fn GetStdHandle(nStdHandle i32) Ptr
  fn WriteFile(hFile Ptr, lpBuffer Ptr, nNumberOfBytesToWrite u32, lpNumberOfBytesWritten Ptr, lpOverlapped Ptr) i32
}

; 全局常量
cval _STD_OUTPUT_HANDLE i32 = -11

; 内部：向 stdout 写入
fn _stdout_write(buf Ptr, off i64, len i64) {
  var hStdout Ptr = GetStdHandle(_STD_OUTPUT_HANDLE)
  var bufWithOff Ptr = ptr_from_addr(buf.to_int() + off.to_u64())
  var written u32 = 0u32
  WriteFile(hStdout, bufWithOff, len.to_u32(), &written, null);
}

#CompilerInner
fn <T> size_of() u64

