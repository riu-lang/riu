struct Array<T> {
  _data Ptr
  _len i64
  _cap i64
}

Array<T> {
  fn len() i64 {
    self._len
  }

  fn cap() i64 {
    self._cap
  }

  fn is_empty() bool {
    self._len == 0i64
  }

  fn clear() {
    self._len = 0i64
  }

  fn set_len(new_len i64) {
    self._len = new_len
  }

  #CompilerInner
  fn push(value T)

  #CompilerInner
  fn at(i i64) T

  #CompilerInner
  fn first() T

  #CompilerInner
  fn last() T

  #CompilerInner
  fn pop() T
}

; String 类型 - 内部使用 Array<u32> 存储 Unicode code points
struct String {
  data Array<u32>
}

String {
  fn ~() {
    ; Array<u32> 会自动释放
  }

  fn String() {
    self.data = []
  }

  fn String(s String) {
    self.data = s.data
  }

  fn len() i64 {
    self.data.len()
  }

  ; 清空字符串
  fn clear() {
    self.data.clear()
  }

  ; 追加一个 Unicode 码点
  fn append(cp u32) {
    self.data.push(cp)
  }

  ; 追加另一个字符串
  fn append(s String) {
    var i i64 = 0
    loop {
      if i >= s.data.len() {
        break;
      }
      self.data.push(s.data[i])
      i += 1
    }
  }

  ; 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    self.data.push(b.to_u32())
  }

  ; 取码点
  fn at(i i64) u32 {
    self.data[i]
  }

  ; 就地截取 [start, end)，修改 self
  fn sub_string(start i64, end i64) {
    var len i64 = self.data.len()
    var s i64 = start
    var e i64 = end
    if s < 0 {
      s = 0
    }
    if e > len {
      e = len
    }
    if s >= e {
      self.data.set_len(0i64)
      ret;
    }
    var i i64 = 0
    var n i64 = e - s
    loop {
      if i >= n {
        break;
      }
      self.data[i] = self.data[s + i]
      i += 1
    }
    self.data.set_len(n)
  }

  ; 转为 UTF-8 字节数组
  fn to_bytes() Array<u8> {
    var r Array<u8> = []
    var i i64 = 0
    loop {
      if i >= self.data.len() {
        break;
      }
      val cp u32 = self.data[i]
      if cp < 128u32 {
        r.push(cp.to_u8());
      } elif cp < 2048u32 {
        r.push(192u8 + ((cp >> 6u32) & 31u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } elif cp < 65536u32 {
        r.push(224u8 + ((cp >> 12u32) & 15u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      } else {
        r.push(240u8 + ((cp >> 18u32) & 7u32).to_u8())
        r.push(128u8 + ((cp >> 12u32) & 63u32).to_u8())
        r.push(128u8 + ((cp >> 6u32) & 63u32).to_u8())
        r.push(128u8 + (cp & 63u32).to_u8());
      }
      i += 1
    }
    r
  }
}

#CompilerInner
struct bool {
  ; 内部处理
}

bool {
  ; 一元运算符
  #CompilerInner
  fn not() bool

  fn to_string() String {
    var s String = String()
    if self {
      s.append("true")
    } else {
      s.append("false")
    }
    s
  }
}

fn print(s String) {
  val bytes Array<u8> = s.to_bytes()
  var i i64 = 0
  loop {
    if i >= bytes.len() {
      break;
    }
    val b [u8 * 1] = [bytes[i]]
    _stdout_write(&b, 0i64, 1i64)
    i += 1
  }
}

fn println(s String) {
  print(s)
  val nl [u8 * 1] = [10u8]
  _stdout_write(&nl, 0i64, 1i64)
}
