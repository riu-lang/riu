#CompilerInner
struct f64 {
  ; 内部处理
}

f64 {
  #CompilerInner
  fn to_i8() i8

  #CompilerInner
  fn to_u8() u8

  #CompilerInner
  fn to_i16() i16

  #CompilerInner
  fn to_u16() u16

  #CompilerInner
  fn to_i32() i32

  #CompilerInner
  fn to_u32() u32

  #CompilerInner
  fn to_u64() u64

  #CompilerInner
  fn to_f64() f64

  #CompilerInner
  fn to_f32() f32

  #CompilerInner
  fn to_bool() bool

  ; 算术运算符
  #CompilerInner
  fn plus(other f64) f64

  #CompilerInner
  fn minus(other f64) f64

  #CompilerInner
  fn mul(other f64) f64

  #CompilerInner
  fn div(other f64) f64

  #CompilerInner
  fn mod(other f64) f64

  ; 比较运算符
  #CompilerInner
  fn eq(other f64) bool

  #CompilerInner
  fn ne(other f64) bool

  #CompilerInner
  fn lt(other f64) bool

  #CompilerInner
  fn le(other f64) bool

  #CompilerInner
  fn gt(other f64) bool

  #CompilerInner
  fn ge(other f64) bool

  ; 一元运算符
  #CompilerInner
  fn neg() f64

  fn to_string() String {
    var s String = String()
    var is_neg = self < 0.0f64
    var v f64 = self
    if is_neg {
      v = 0.0f64 - self
    }
    if is_neg {
      s.append(c'-')
    }
    s.append(v.to_i64().to_string())
    s.append(c'.')
    var frac f64 = v - v.to_i64().to_f64()
    var i i64 = 0
    loop {
      if i == 6 {
        break;
      }
      frac *= 10.0f64
      var digit i64 = frac.to_i64()
      s.append((48u8 + digit.to_u8()).to_u32())
      frac -= digit.to_f64()
      i += 1
    }
    s
  }
}

