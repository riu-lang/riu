/ yux SDK - 自举运行时
/ 使用 Windows API 进行 I/O

/ 外部 Windows 函数声明
extern {
  fn GetStdHandle(nStdHandle i32) Ptr<u8>
  fn WriteFile(hFile Ptr<u8>, lpBuffer Ptr<u8>, nNumberOfBytesToWrite u32, lpNumberOfBytesWritten Ptr<u32>, lpOverlapped Ptr<u8>) i32
}

/ 全局常量
cval _STD_OUTPUT_HANDLE i32 = -11

/ 内部：向 stdout 写入
fn _stdout_write(buf Ptr<u8>, off i64, len i64) {
  var hStdout Ptr<u8> = GetStdHandle(_STD_OUTPUT_HANDLE)
  var bufWithOff Ptr<u8> = null
  bufWithOff._value = buf._value + off.to_u64()
  var written u32 = 0u32
  WriteFile(hStdout, bufWithOff, len.to_u32(), &written, null)
}

fn print(n i64) {
  var buf [u8 * 21] = [0u8 ...]
  var is_neg = n < 0i64
  var v i64 = n
  if is_neg {
    v = -n
  }
  var i i64 = 0i64
  loop {
    if v == 0i64 {
      break;
    }
    var digit i64 = v % 10i64
    buf[20i64 - i] = 48u8 + digit.to_u8()
    v = v / 10i64
    i = i + 1i64
  }
  if i == 0i64 {
    buf[20i64] = 48u8
    i = 1i64
  }
  var start i64 = 21i64 - i
  if is_neg {
    start = start - 1i64
    buf[start] = 45u8
    i = i + 1i64
  }
  val bufp Ref<[u8 * 21]> = &buf
  _stdout_write(bufp, start, i)
}

fn print(n i8) {
  print(n.to_i64())
}

fn print(n i16) {
  print(n.to_i64())
}

fn print(n i32) {
  print(n.to_i64())
}

fn print(n u8) {
  print(n.to_u64())
}

fn print(n u16) {
  print(n.to_u64())
}

fn print(n u32) {
  print(n.to_u64())
}

fn print(n u64) {
  var buf [u8 * 21] = [0u8 ...]
  var v u64 = n
  var i i64 = 0i64
  loop {
    if v == 0u64 {
      break;
    }
    var digit u64 = v % 10u64
    buf[20i64 - i] = 48u8 + digit.to_u8()
    v = v / 10u64
    i = i + 1i64
  }
  if i == 0i64 {
    buf[20i64] = 48u8
    i = 1i64
  }
  val bufp Ref<[u8 * 21]> = &buf
  _stdout_write(bufp, 21i64 - i, i)
}

fn print(n f64) {
  var is_neg = n < 0.0f64
  var v f64 = n
  if is_neg {
    v = 0.0f64 - n
  }
  if is_neg {
    val tmp [u8 * 1] = [45u8]
    _stdout_write(&tmp, 0i64, 1i64)
  }
  print(v.to_i64())
  val dot [u8 * 1] = [46u8]
  _stdout_write(&dot, 0i64, 1i64)
  var frac f64 = v - v.to_i64().to_f64()
  var i i64 = 0i64
  loop {
    if i == 6i64 {
      break;
    }
    frac = frac * 10.0f64
    var digit i64 = frac.to_i64()
    val d [u8 * 1] = [48u8 + digit.to_u8()]
    _stdout_write(&d, 0i64, 1i64)
    frac = frac - digit.to_f64()
    i = i + 1i64
  }
}

fn print(n f32) {
  print(n.to_f64())
}

fn print(b bool) {
  if b {
    val t [u8 * 4] = [116u8, 114u8, 117u8, 101u8]
    _stdout_write(&t, 0i64, 4i64)
  } else {
    val f [u8 * 5] = [102u8, 97u8, 108u8, 115u8, 101u8]
    _stdout_write(&f, 0i64, 5i64)
  }
}

fn println(n i8) {
  print(n)
  val nl [u8 * 1] = [10u8]
  _stdout_write(&nl, 0i64, 1i64)
}

