; riu SDK - Map<K, V>（v0.21 Phase B）
; 纯 riu：平行 Array 线性查找。K 须可 ==（标量或 String）；不承诺 O(1) / 哈希。
; 公开符号经 pkg `map.*` 扁平进 riu.core；类型名 `Map` 走扁平（g4 `type` 为单 ID）。
; 模块路径 `map` / `riu.core.map` 已登记，供该文件内自由函数使用。

#NoCopy
#Impl("Indexed<K>")
struct Map<K, V> {
  _keys Array<K>
  _vals Array<V>

  #Static
  fn make() Self {
    Self {
      ._keys = Array:<K>::with_capacity(0usize)
      ._vals = Array:<V>::with_capacity(0usize)
    }
  }

  fn len() usize {
    $._keys.len()
  }

  fn at(i usize) K& {
    ret &$._keys[i]
  }

  fn is_empty() bool {
    $._keys.is_empty()
  }

  ; 线性查找；未命中返回 null
  fn _index_of(key K&) usize? {
    loop i usize = 0 {
      if i >= $._keys.len() {
        break;
      }
      if $._keys[i] == key {
        ret i
      }
      i += 1
    }
    null
  }

  ; 已有键则覆盖值（旧值释放）；否则追加
  fn insert(key K, value V) {
    let i usize? = $._index_of(key)
    if i.has() {
      let idx usize = i.get()
      $._vals[idx] = value
      ret;
    }
    $._keys.push(key)
    $._vals.push(value)
  }

  fn contains(key K&) bool {
    ret $._index_of(key).has()
  }

  fn get(key K&) V? {
    let i usize? = $._index_of(key)
    if !i.has() {
      ret null
    }
    let idx usize = i.get()
    ret copy_of:<V>($._vals[idx])
  }

  fn get_or(key K&, default V) V {
    let i usize? = $._index_of(key)
    if !i.has() {
      ret default
    }
    let idx usize = i.get()
    ret copy_of:<V>($._vals[idx])
  }

  ; 命中则 copy 末项填洞 + pop，返回旧值；未命中 null
  fn remove(key K&) V? {
    let i usize? = $._index_of(key)
    if !i.has() {
      ret null
    }
    let idx usize = i.get()
    #Mut let out V = copy_of:<V>($._vals[idx])
    let last usize = $._keys.len() - 1
    if idx != last {
      $._keys[idx] = copy_of:<K>($._keys[last])
      $._vals[idx] = copy_of:<V>($._vals[last])
    }
    $._keys.pop()
    $._vals.pop()
    out
  }

  fn keys() Array<K> {
    $._keys.clone()
  }

  fn values() Array<V> {
    $._vals.clone()
  }

  fn clear() {
    $._keys.clear()
    $._vals.clear()
  }
}
