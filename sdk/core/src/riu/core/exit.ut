; riu SDK - 进程终止：exit(code) / abort()（spec §10.4.1.6）
;
; exit：业务正常终止，退出码由调用方指定，不打模板。
; abort：不变式破坏 / 越界 / OOM 等不可恢复路径；无消息、无退出码约定。
;   实施走 riurt_abort（RaiseException 0xE0AB0710）。#Test 的 SEH wrapper 可接住；
;   普通 riu build 无 handler → OS 终止。
; #NoReturn：流终止分析复用（10d-2）。

; `kernel32.ExitProcess` 点链对 #NoReturn extern 不计入流终止；这里重复声明。
extern {
  #NoReturn
  fn ExitProcess(uExitCode u32)
}

#NoReturn
fn abort() {
  riurt_abort();
}

#NoReturn
fn exit(code u32) {
  ExitProcess(code);
}
