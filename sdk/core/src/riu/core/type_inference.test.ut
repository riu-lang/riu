; 类型推断 / 字面量提升行为测试
;
; 覆盖：
;   - 字面量自动提升到目标类型（u8 / i64 / u32）
;   - u8 变量重赋值与复合赋值
;   - 函数调用时实参字面量提升（add_u8(1, 2)）
;
; 已知缺口：泛型函数类型推断见 generic_call_turbofish.test.ut；
; 多重重载消歧的类型推断未覆盖。

fn add_u8(a u8, b u8) u8 = a + b

; 验证：u8 类型字面量的算术运算结果推断为 i32
#Test
fn test_u8_promote_literal() {
  let a u8 = 1 + 2
  assert_eq(a, 3)
}

; 验证：i64 类型默认整数字面量
#Test
fn test_i64_default_int_literal() {
  let b i64 = 100 + 200
  assert_eq(b, 300)
}

; 验证：u32 类型的混合运算结果
#Test
fn test_u32_mixed() {
  let c u32 = 5 * 3 + 1
  assert_eq(c, 16)
}

; 验证：u8 类型变量的赋值和运算
#Test
fn test_u8_var_assign() {
  #Mut let x u8 = 42
  assert_eq(x, 42)
  x = 10
  assert_eq(x, 10)
  x += 5
  assert_eq(x, 15)
}

; 验证：u8 类型加法函数正确性
#Test
fn test_call_u8() {
  assert_eq(add_u8(1, 2), 3)
}

; ==================== 边界 / 扩展类型推断测试 ====================

#Test
fn test_infer_isize_literal() {
  ; 验证：isize 类型推断
  let a isize = 100
  let b isize = a + 50
  assert_eq(a, 100)
  assert_eq(b, 150)
}

#Test
fn test_infer_f32_literal() {
  ; 验证：f32 字面量推断
  let a f32 = 1.5f32
  let b f32 = a + 2.5f32
  assert_eq(a, 1.5f32)
  assert_eq(b, 4.0f32)
}

#Test
fn test_infer_u8_max_literal() {
  ; 验证：u8 边界值类型推断（255 在 u8 合法范围内）
  let a u8 = 255
  assert_eq(a, 255)
  let b u8 = a - 100
  assert_eq(b, 155)
}

#Test
fn test_infer_bool_from_expr() {
  ; 验证：从比较表达式推断 bool 类型
  let a bool = 10 > 5
  assert_true(a)
  let b bool = 3 == 7
  assert_false(b)
}

#Test
fn test_infer_chain_expr() {
  ; 验证：链式表达式类型推断（i32 默认 + 混合运算符）
  let a = 10 + 20 * 3 - 5
  assert_eq(a, 65)
}

#Test
fn test_infer_usize_literal() {
  ; 验证：usize 字面量推断
  let a usize = 0
  let b usize = 1000
  assert_eq(a, 0)
  assert_eq(b, 1000)
  assert_true(a < b)
}
