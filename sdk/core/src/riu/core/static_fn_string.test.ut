; String #Static 工厂行为测试
;
; 覆盖：
;   - String::empty() 空字符串构造
;   - String::from(&buf) 从 Array<u32> 深拷贝构造
;   - 空 buf 输入
;   - 深拷贝隔离性：构造后修改 buf 不影响已创建的 String
;
; 已知缺口：无——String 构造目前唯一通道为静态工厂（ctor 已砍）。
; String 其他行为见 string.test.ut / string_builder.test.ut。

#Test
fn test_string_static_empty() {
  let s String = String::empty()
  assert_eq(s.len(), 0)
  assert_eq(s, "")
}

; 验证：单码点工厂
#Test
fn test_string_static_from_codepoint() {
  assert_eq(String::from_codepoint(c'x'), "x")
  assert_eq(String::from_codepoint(0), "\0")
}

; 验证：String::from() 方法从缓冲区创建字符串并进行深拷贝
#Test
fn test_string_static_from_buf() {
  ; 'h''i' = 104, 105
  let buf Array<u32> = [104u32, 105u32]
  let s String = String::from(&buf)
  assert_eq(s.len(), 2)
  assert_eq(s, "hi")
  ; from() 深拷贝, buf 自身仍可独立存在
  assert_eq(buf.len(), 2)
}

; 验证：String 从空缓冲区创建时的长度和内容
#Test
fn test_string_static_from_empty_buf() {
  let buf Array<u32> = []
  let s String = String::from(&buf)
  assert_eq(s.len(), 0)
  assert_eq(s, "")
}

; 验证：String::from 深拷贝，外界修改 buf 不影响已构造的 String
#Test
fn test_string_from_defensive_copy() {
  ; 关键回归: String::from 深拷贝, 外界 mutate buf 不影响已构造的 String
  #Mut let buf Array<u32> = [104u32, 105u32]
  let s String = String::from(&buf)
  assert_eq(s, "hi")
  assert_eq(buf.len(), 2)
}
