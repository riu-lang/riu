; 复合赋值行为测试
;
; 覆盖：
;   - 算术复合赋值：+= / -= / *= / /= / %=
;
; 已知缺口：复合赋值在 Rc<T>/Heap<T> 等句柄类型上的行为未覆盖。
; 位运算无复合赋值，写 a = a.and(b) 等。

#Test
fn test_add_assign() {
  #Mut let a i32 = 10
  a += 5
  assert_eq(a, 15)
}

; 验证：SubAssign 赋值运算符行为
#Test
fn test_sub_assign() {
  #Mut let a i32 = 15
  a -= 3
  assert_eq(a, 12)
}

; 验证：整数乘法赋值运算符行为
#Test
fn test_mul_assign() {
  #Mut let a i32 = 12
  a *= 2
  assert_eq(a, 24)
}

; 验证：整数除法赋值操作
#Test
fn test_div_assign() {
  #Mut let a i32 = 24
  a /= 4
  assert_eq(a, 6)
}

; 验证：Modulo 赋值运算符行为
#Test
fn test_mod_assign() {
  #Mut let a i32 = 6
  a %= 3
  assert_eq(a, 0)
}

; ==================== 边界 / 扩展测试 ====================

#Test
fn test_f64_add_assign() {
  ; 验证：f64 += 复合赋值
  #Mut let a f64 = 1.5
  a += 2.5
  assert_eq(a, 4.0)
}

#Test
fn test_f64_mul_assign() {
  ; 验证：f64 *= 复合赋值
  #Mut let a f64 = 3.0
  a *= 2.5
  assert_eq(a, 7.5)
}

#Test
fn test_f32_compound_assign() {
  ; 验证：f32 += / *= 复合赋值
  #Mut let a f32 = 1.0f32
  a += 2.0f32
  assert_eq(a, 3.0f32)
  a *= 2.0f32
  assert_eq(a, 6.0f32)
}

#Test
fn test_add_assign_overflow_wrap() {
  ; 验证：i32 += 溢出回绕（MAX + 1 = MIN）
  #Mut let a i32 = 2147483647
  a += 1
  assert_eq(a, -2147483648)
}

#Test
fn test_sub_assign_underflow_wrap() {
  ; 验证：i32 -= 下溢回绕（MIN - 1 = MAX）
  #Mut let a i32 = -2147483648
  a -= 1
  assert_eq(a, 2147483647)
}
