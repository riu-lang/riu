; move 所有权转移行为测试
;
; 覆盖：
;   - move(i32) 标量所有权转移
;   - move(#NoCopy struct) 不可拷贝类型转移
;   - fresh 构造不触发 #NoCopy 检查
;   - #NoCopy 类型作为函数返回值
;   - elif 分支内 move + 作用域结束跳过析构（_movedVars merge）
;   - move(Rc<i32>) 句柄转移
;   - move(Array<i32>) 数组所有权转移
;   - move:<Array<T>> 显式 turbofish + [] / 嵌套 Array GEP（A5）
;   - move(String) 字符串所有权转移
;   - move(Heap<i32/f64>) 堆分配所有权转移
;   - move(x) push 到 Array 中
;   - move(String) 到 struct 字段
;
; 已知缺口：Heap<T> 不能按值 move 赋值（需 Heap<T>? 中间态，见 BUGS.md）；
; move 与 Heap<T>? 交互见 move_assign.test.ut。
; 负面诊断（E4023/E4024）见 tests/check-cases/diag_move_*。

; ---- #NoCopy struct ----

#NoCopy
struct Box {
  val i32
  fn ~() {
    ; 显式析构，自动隐含 #NoCopy
  }
}

; ---- make_box 辅助 ----

fn make_box() Box {
  ret Box {
    .val = 7
  }
}

; ---- move 基本所有权转移 (i32) ----

; 验证：基本整数所有权转移
#Test
fn test_move_i32_ownership() {
  let a i32 = 42
  let b i32 = move(a)
  assert_eq(b, 42)
}

; ---- move #NoCopy struct ----

; 验证：Move 不可复制结构体时的值转移行为
#Test
fn test_move_no_copy_struct() {
  let a Box = Box {
    .val = 10
  }
  let b Box = move(a)
  assert_eq(b.val, 10)
}

; ---- fresh 构造不触发 #NoCopy 检查 ----

; 验证：Fresh 构造不触发 #NoCopy 检查
#Test
fn test_no_copy_fresh_constructor() {
  let a Box = Box {
    .val = 1
  }
  assert_eq(a.val, 1)
}

; ---- #NoCopy 类型作为函数返回值 ----

; 验证：NoCopy 类型作为函数返回值时，不会被移动
#Test
fn test_no_copy_return() {
  let b Box = make_box()
  assert_eq(b.val, 7)
}

; ---- elif 分支 move ----

; 验证：elif 分支中移动变量后，原变量的析构在作用域退出时被跳过
#Test
fn test_move_elif_branch() {
  let a Box = Box {
    .val = 99
  }
  if false {
    let _ = 0
  } elif true {
    let b Box = move(a)
    assert_eq(b.val, 99)
  }
  ; a was moved in elif branch — scope exit skips a's dtor via _movedVars merge
}

; ---- move Rc<i32> ----

; 验证：Rc 所有权转移后引用值不变
#Test
fn test_move_rc_i32() {
  let a Rc<i32> = 100
  let v i32& = as_ref(a)
  assert_eq(v, 100)
  let b Rc<i32> = move(a)
  ; a was moved — b now owns the handle
  let w i32& = as_ref(b)
  assert_eq(w, 100)
}

; ---- move Array<i32> ----

; 验证：Move Array<i32> 后所有权转移与长度不变
#Test
fn test_move_array_i32() {
  let a Array<i32> = [1, 2, 3]
  assert_eq(a.len(), 3)
  let b Array<i32> = move(a)
  ; a was moved — b now owns
  assert_eq(b.len(), 3)
  assert_eq(b.get(0), 1)
  assert_eq(b.get(2), 3)
}

; ---- move Array<i32> A5 回归（GEP / B-3 三字段） ----

; 验证：显式 turbofish move:<Array<T>> 后下标 GEP 可读
#Test
fn test_move_array_turbofish_index() {
  let a Array<i32> = [1, 2, 3]
  let b Array<i32> = move:<Array<i32>>(a)
  assert_eq(b.len(), 3)
  assert_eq(b[0], 1)
  assert_eq(b[2], 3)
}

; 验证：空 Array move 后仍是空
#Test
fn test_move_array_empty_turbofish() {
  let a Array<i32> = []
  let b Array<i32> = move:<Array<i32>>(a)
  assert_true(b.is_empty())
  assert_eq(b.len(), 0)
}

; 验证：嵌套 Array<Array<T>> move / push 后元素 GEP
#Test
fn test_move_nested_array() {
  let inner Array<i32> = [10, 20]
  #Mut let outer Array<Array<i32>> = []
  outer.push(move(inner))
  assert_eq(outer.len(), 1)
  assert_eq(outer[0].len(), 2)
  assert_eq(outer[0][0], 10)
  assert_eq(outer[0][1], 20)
  let moved Array<Array<i32>> = move(outer)
  assert_eq(moved.len(), 1)
  assert_eq(moved[0].len(), 2)
  assert_eq(moved[0][0], 10)
  assert_eq(moved[0][1], 20)
}

; ---- move String ----

; 验证：String 移动后长度不变
#Test
fn test_move_string() {
  let s String = "hello"
  assert_eq(s.len(), 5)
  let t String = move(s)
  ; s was moved — t now owns
  assert_eq(t.len(), 5)
}

; ---- move Heap<T> ----

#Test
fn test_move_heap_i32() {
  ; 验证：move Heap<T> 转移所有权
  let a Heap<i32> = heap:<i32>(42)
  assert_true(a == 42)
  let b Heap<i32> = move(a)
  assert_true(b == 42)
}

#Test
fn test_move_heap_f64() {
  ; 验证：move Heap<f64> 转移所有权
  let a Heap<f64> = heap:<f64>(3.14f64)
  assert_true(a == 3.14f64)
  let b Heap<f64> = move(a)
  assert_true(b == 3.14f64)
}

#Test
fn test_move_rc_after_move() {
  ; 验证：move Rc 后新 owner 可正常使用
  let a Rc<i32> = 100
  let b Rc<i32> = move(a)
  assert_true(b == 100)
  ; b 仍可读
  let v i32& = as_ref(b)
  assert_eq(v, 100)
}

; ==================== move 入 Array / move Rc 入 struct（迁自 bug_hunt） ====================

#Test
fn test_move_into_array() {
  ; 验证：move(x) push 到 Array
  let x i32 = 42
  #Mut let arr Array<i32> = []
  arr.push(move(x))
  assert_eq(arr[0], 42)
}

struct MoveBox {
  val String

  #Static
  fn make(v String) Self {
    Self {
      .val = move(v)
    }
  }
}

#Test
fn test_move_of_rc_into_struct() {
  ; 验证：move(String) 到 struct 的 Rc 字段
  let s String = "hello"
  let b MoveBox = MoveBox::make(move(s))
  assert_eq(b.val, "hello")
}

; ==================== 边界测试 ====================

#Test
fn test_move_i32_zero() {
  ; 验证：move 零值标量
  let a i32 = 0
  let b i32 = move(a)
  assert_eq(b, 0)
}

#Test
fn test_move_string_empty() {
  ; 验证：move 空 String
  let s String = ""
  let t String = move(s)
  assert_eq(t.len(), 0)
}
