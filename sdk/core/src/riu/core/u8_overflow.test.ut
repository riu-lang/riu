; 整数溢出/回绕用例
; 迁自 tests/cases/u8_overflow.ut
;
; 本文件覆盖各整数类型溢出回绕行为：
; - 无符号类型：加溢出回绕到 0，减溢出回绕到 MAX
; - 有符号类型：MAX+1=MIN（补码回绕）

; ==================== u8 溢出 ====================

#Test
fn test_u8_add_overflow_wrap() {
  ; 验证：u8 加法溢出回绕
  let a = 255u8
  assert_eq(a + 1u8, 0u8)
}

#Test
fn test_u8_sub_underflow_wrap() {
  ; 验证：u8 减法下溢回绕到 255
  let a = 0u8
  assert_eq(a - 1u8, 255u8)
}

#Test
fn test_u8_mul_overflow_wrap() {
  ; 验证：u8 乘法溢出回绕
  let a = 16u8
  assert_eq(a * 16u8, 0u8)  ; 256 % 256 = 0
}

; ==================== u16 溢出 ====================

#Test
fn test_u16_add_overflow_wrap() {
  ; 验证：u16 加法溢出回绕
  let a = 65535u16
  assert_eq(a + 1u16, 0u16)
}

#Test
fn test_u16_sub_underflow_wrap() {
  ; 验证：u16 减法下溢
  let a = 0u16
  assert_eq(a - 1u16, 65535u16)
}

; ==================== u32 溢出 ====================

#Test
fn test_u32_add_overflow_wrap() {
  ; 验证：u32 加法溢出回绕
  let a u32 = 4294967295
  assert_eq(a + 1u32, 0u32)
}

#Test
fn test_u32_sub_underflow_wrap() {
  ; 验证：u32 减法下溢
  let a = 0u32
  assert_eq(a - 1u32, 4294967295u32)
}

; ==================== u64 溢出 ====================

#Test
fn test_u64_add_overflow_wrap() {
  ; 验证：u64 加法溢出回绕
  let a = 18446744073709551615u64
  assert_eq(a + 1u64, 0u64)
}

; ==================== i8 溢出 ====================

#Test
fn test_i8_add_overflow_wrap() {
  ; 验证：i8 加法溢出：MAX+1=MIN
  let a = 127i8
  assert_eq(a + 1i8, -128i8)
}

#Test
fn test_i8_sub_underflow_wrap() {
  ; 验证：i8 减法下溢：MIN-1=MAX
  let a = -128i8
  assert_eq(a - 1i8, 127i8)
}

; ==================== i16 溢出 ====================

#Test
fn test_i16_add_overflow_wrap() {
  ; 验证：i16 MAX+1=MIN
  let a = 32767i16
  assert_eq(a + 1i16, -32768i16)
}

; ==================== i32 溢出 ====================

#Test
fn test_i32_add_overflow_wrap() {
  ; 验证：i32 加法溢出：MAX+1=MIN
  let a = 2147483647i32
  assert_eq(a + 1i32, -2147483648i32)
}

#Test
fn test_i32_sub_underflow_wrap() {
  ; 验证：i32 减法下溢：MIN-1=MAX
  let a = -2147483648i32
  assert_eq(a - 1i32, 2147483647i32)
}

#Test
fn test_i32_mul_overflow_wrap() {
  ; 验证：i32 乘法溢出回绕
  let a = 65536i32
  let b = 32768i32
  ; 65536 * 32768 = 2147483648，超出 i32 MAX → 回绕
  assert_eq(a * b, -2147483648i32)
}

; ==================== i64 溢出 ====================

#Test
fn test_i64_add_overflow_wrap() {
  ; 验证：i64 加法溢出：MAX+1=MIN
  let a = 9223372036854775807i64
  assert_eq(a + 1i64, -9223372036854775808i64)
}

#Test
fn test_i64_sub_underflow_wrap() {
  ; 验证：i64 减法下溢：MIN-1=MAX
  let a = -9223372036854775808i64
  assert_eq(a - 1i64, 9223372036854775807i64)
}
