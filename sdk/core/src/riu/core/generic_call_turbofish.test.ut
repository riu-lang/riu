; 泛型函数 + turbofish 显式类型参数用例
; 迁自 tests/cases/generic_call_turbofish.ut
;
; 覆盖：泛型函数 type param 推断、turbofish :<T> 显式指定、
;       泛型 struct 方法、多类型参数

; ==================== Nullable 基本 ====================

; 验证：Nullable 类型的 turbofish 显式类型参数用法
#Test
fn test_turbofish_nullable_value() {
  #Mut let n i32? = 42
  let v i32 = n ?? -1
  assert_eq(v, 42)
}

; 验证：空值的可选类型通过 turbofish 处理
#Test
fn test_turbofish_nullable_empty() {
  #Mut let e i32? = null
  let ev i32 = e ?? -1
  assert_eq(ev, -1)
}

; ==================== 泛型 identity 函数 ====================

fn identity<T>(x T) T = x

#Test
fn test_generic_identity_i32() {
  ; 验证：泛型函数类型推断
  let a i32 = 42
  let b i32 = identity(a)
  assert_eq(b, 42)
}

#Test
fn test_generic_identity_i64() {
  ; 验证：泛型函数对不同类型工作
  let a i64 = 100
  let b i64 = identity(a)
  assert_eq(b, 100)
}

#Test
fn test_generic_identity_string() {
  ; 验证：泛型函数对 String 工作
  let s String = "hello"
  let t String = identity(s)
  assert_eq(t, "hello")
}

; ==================== 元组类型 + 泛型函数 ====================

fn pair_first<T>(p (T, T)) T = p.0

fn pair_second<T>(p (T, T)) T = p.1

#Test
fn test_generic_alias_i32() {
  ; 验证：元组形参 + turbofish
  let p (i32, i32) = (10, 20)
  assert_eq(pair_first:<i32>(p), 10)
  assert_eq(pair_second:<i32>(p), 20)
}

#Test
fn test_generic_alias_string() {
  ; 验证：元组形参对 String + turbofish
  let p (String, String) = ("hello", "world")
  assert_eq(pair_first:<String>(p), "hello")
  assert_eq(pair_second:<String>(p), "world")
}
