; 验证：Lambda 表达式作为参数显式调用
#Test
fn test_lambda_as_arg_explicit() {
  let r = apply((x i32) i32 => x + 10, 5)
  assert_eq(r, 15)
}

; 验证：Lambda 作为参数传递并进行类型推断
#Test
fn test_lambda_as_arg_inferred() {
  let r = apply((x) => x * x, 6)
  assert_eq(r, 36)
}

; ==================== lambda 作返回值测试 ====================

; 验证：Lambda 函数作为返回值使用
#Test
fn test_lambda_return() {
  #Mut let f Function<i32, i32> = make_inc()
  assert_eq(f(10), 11)
  assert_eq(f(99), 100)
}

; 验证：Lambda 返回值链式调用
#Test
fn test_lambda_return_chained() {
  let r = make_inc()(41)
  assert_eq(r, 42)
}

; 验证：Lambda 返回常量值
#Test
fn test_lambda_return_const() {
  #Mut let g Function<i32, i32> = make_const(0)
  assert_eq(g(7), 14)
}

; ==================== lambda 参数传递测试 ====================

; 验证：Lambda 参数传递与高阶函数使用
#Test
fn test_lambda_param_pass() {
  #Mut let inc Function<i32, i32> = (x i32) i32 => x + 1
  #Mut let r1 = forward(inc, 10)
  assert_eq(r1, 23)

  #Mut let r2 = forward((x i32) i32 => x * 2, 3)
  assert_eq(r2, 14)
}

; ==================== struct fn 字段测试 ====================

; 验证：Struct 方法调用与字段访问
#Test
fn test_struct_fn_field() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  assert_eq(s.run(5), 106)
  assert_eq(s.h(10), 11)
}

; 验证：Struct 方法重新赋值与调用
#Test
fn test_struct_fn_field_reassign() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  s.set((x i32) i32 => x * 3)
  assert_eq(s.h(4), 12)
}

; 验证：Struct 方法按值调用字段并修改
#Test
fn test_struct_fn_field_by_value() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  let r = call_h_by_value(s, 7)
  assert_eq(r, 8)
}

; 验证：Struct 字段整体重新赋值后方法调用
#Test
fn test_struct_fn_field_whole_reassign() {
  #Mut let s Holder = Holder::make(make_inc(), 100)
  #Mut let s2 Holder = Holder::make((x i32) i32 => x - 1, 0)
  s = s2
  assert_eq(s.h(50), 49)
}

; ==================== Array<fn> 测试 ====================

; 验证：Array 存储和调用不同行为的函数元素
#Test
fn test_array_fn_elem() {
  #Mut let arr Array<Function<i32, i32>> = []
  arr.push(make_inc())
  arr.push((x i32) i32 => x * 2)
  arr.push((x i32) i32 => x - 5)

  assert_eq(arr.len(), 3)
  assert_eq(arr[0](10), 11)
  assert_eq(arr[1](10), 20)
  assert_eq(arr[2](10), 5)
}

; 验证：Array 存储函数并按值调用
#Test
fn test_array_fn_elem_by_value() {
  #Mut let arr Array<Function<i32, i32>> = []
  arr.push(make_inc())

  let r = run_first(arr, 100)
  assert_eq(r, 101)
}

; 验证：Array 中存储的函数元素重新赋值
#Test
fn test_array_fn_elem_reassign() {
  #Mut let arr Array<Function<i32, i32>> = []
  arr.push(make_inc())

  arr[0] = (x i32) i32 => x + 1000
  assert_eq(arr[0](1), 1001)
}

; ==================== Rc<fn> 测试 ====================

; 验证：Rc<fn> 调用与闭包行为
#Test
fn test_box_fn_call() {
  #Mut let b Rc<Function<i32, i32>> = (x i32) i32 => x + 100
  assert_eq(b(5), 105)
  assert_eq(b(10), 110)
}

; 验证：Rc 复制函数后调用结果不变
#Test
fn test_box_fn_copy() {
  #Mut let b Rc<Function<i32, i32>> = (x i32) i32 => x + 100
  #Mut let b2 Rc<Function<i32, i32>> = b
  assert_eq(b2(7), 107)
}

; 验证：Rc 引用计数指针下挂的闭包重新赋值后，原有引用仍然有效
#Test
fn test_box_fn_reassign() {
  #Mut let b Rc<Function<i32, i32>> = (x i32) i32 => x + 100
  #Mut let b2 Rc<Function<i32, i32>> = b

  b = (x i32) i32 => x * 3
  assert_eq(b(4), 12)
  assert_eq(b2(20), 120)
}

