; 验证：函数类型声明与定义
#Test
fn test_fn_type_decl() {
  #Mut let a Function<()>
  #Mut let b Function<i32>
  #Mut let c Function<i32, i32>
  #Mut let d Function<i32, i32>
  #Mut let e Function<i32, i32, i32>
  #Mut let f Function<Function<i32, i32>, i32>
  #Mut let h Function<Function<i32, i32>>

  assert_true(true)
}

; 验证：函数类型别名的定义与使用
#Test
fn test_fn_type_alias() {
  #Mut let c Callback
  #Mut let pi PredI32
  #Mut let ps PredStr
  #Mut let op Op2II
  #Mut let nested PredFn

  assert_true(true)
}

; 验证：函数类型等价性检查
#Test
fn test_fn_type_equiv() {
  #Mut let x Function<String, bool>
  #Mut let c Callback = x
  #Mut let y Callback
  #Mut let z Function<String, bool> = y

  #Mut let a Function<i32, i32, i32>
  #Mut let b Function<i32, i32, i32> = a
  #Mut let d Function<i32, i32, i32> = b

  #Mut let g Function<i32, i32, i32>
  #Mut let ge Function<i32, i32, i32> = g

  #Mut let n1 Function<Function<i32, i32>, i32>
  #Mut let n2 Function<Function<i32, i32>, i32> = n1

  assert_true(true)
}

; 验证：Rc<fn> 类型的容器在多作用域析构时的行为
#Test
fn test_fn_type_container() {
  ; BUGS #4: Rc<fn> 未初始化变量 2+ 个同作用域析构时 ACCESS_VIOLATION，暂赋初值规避
  #Mut let arr Array<Function<i32>> = []
  #Mut let b Rc<Function<i32>> = () i32 => 42
  #Mut let p (Function<i32>, i32)
  #Mut let nested Array<Function<Function<i32, i32>>> = []

  assert_true(true)
}

; 验证：可选函数类型声明与赋值
#Test
fn test_fn_type_nullable() {
  #Mut let a Function<()>?
  #Mut let b Function<i32, i32>?
  #Mut let c Function<String, i32?>
  #Mut let d Function<String, i32?>?

  assert_true(true)
}

; ==================== lambda 闭包捕获测试 ====================

; 验证：闭包捕获可变变量并修改其值
#Test
fn test_closure_capture_scalar() {
  #Mut let x i32 = 10
  let f = (y i32) i32 => y + x
  assert_eq(f(1), 11)
  assert_eq(f(7), 17)

  x = 100
  assert_eq(f(1), 11)
}

; 验证：闭包捕获多个变量并进行不同操作
#Test
fn test_closure_capture_multi() {
  #Mut let a i32 = 3
  #Mut let b i32 = 7
  let sum = (x i32) i32 => a + b + x
  assert_eq(sum(0), 10)
  assert_eq(sum(5), 15)

  #Mut let pi f64 = 3.14
  let pifloor = () i32 => pi.to_i32()
  assert_eq(pifloor(), 3)

  #Mut let enabled bool = true
  let pick = (t, f i32) i32 => if enabled { t } else { f }
  assert_eq(pick(1, 2), 1)
}

; 验证：闭包捕获 Rc<Cell> 并共享其值
#Test
fn test_closure_capture_box() {
  #Mut let b Rc<Cell> = Cell::make(42)
  let f = () i32 => b.get()
  assert_eq(f(), 42)
  assert_eq(f(), 42)

  let g = () i32 => b.get()
  assert_eq(g(), 42)
}

; 验证：闭包捕获变量并返回其值
#Test
fn test_closure_capture_string() {
  #Mut let s String = "hello"
  let f = () String => s
  assert_eq(f(), "hello")
  assert_eq(f(), "hello")

  #Mut let n i32 = 7
  let g = () String => s
  let h = () i32 => n + 1
  assert_eq(g(), "hello")
  assert_eq(h(), 8)
}

; 验证：闭包捕获数组并返回第一个元素两次
#Test
fn test_closure_capture_array() {
  #Mut let arr Array<i32> = [10, 20, 30]
  let f = () i32 => first(arr)
  assert_eq(f(), 10)
  assert_eq(f(), 10)
}

; 验证：闭包传递与别名
#Test
fn test_closure_pass_around() {
  #Mut let add10 Function<i32, i32> = make_adder(10)
  assert_eq(apply(add10, 5), 15)
  assert_eq(apply(add10, 100), 110)

  #Mut let add42 Function<i32, i32> = make_adder(42)
  assert_eq(add42(8), 50)

  #Mut let alias Function<i32, i32> = add10
  assert_eq(alias(7), 17)
}

; 验证：闭包捕获自身并修改状态
#Test
fn test_closure_self_capture() {
  #Mut let c Counter = Counter::make(10)
  assert_eq(c.add_then_apply(5), 15)
  assert_eq(c.triple_apply(), 50)
}

; ==================== lambda if 表达式体 ====================

; 验证：Lambda 表达式在 if 表达式体中的使用
#Test
fn test_lambda_if_expr_body() {
  let abs1 = (x i32) i32 => if x > 0 { x } else { 0 - x }
  assert_eq(abs1(5), 5)
  assert_eq(abs1(0 - 7), 7)

  let r1 = apply((x) => if x > 10 { x + 1 } else { x }, 20)
  assert_eq(r1, 21)
}

; ==================== lambda match 表达式体 ====================

enum Color {
  Red
  Green
  Blue
}

fn classify(c Color) i32 {
  match c {
    Color::Red   => 1
    Color::Green => 2
    Color::Blue  => 3
  }
}

fn apply_color(f Function<Color, i32>, c Color) i32 {
  ret f(c)
}

; 验证：Lambda 表达式在 match 表达式中的使用和应用
#Test
fn test_lambda_match_expr_body() {
  let cl = (c Color) i32 => match c {
    Color::Red   => 1
    Color::Green => 2
    Color::Blue  => 3
  }
  assert_eq(cl(Color::Red), 1)
  assert_eq(cl(Color::Green), 2)

  let r1 = apply_color((c) => match c {
    Color::Red   => 10
    Color::Green => 20
    Color::Blue  => 30
  }, Color::Blue)
  assert_eq(r1, 30)
}

; ==================== lambda T& 捕获作为调用实参 ====================

fn use_borrow_capture(r i32&) i32 {
  #Mut let sum i32 = 0
  sum = sum + apply((x i32) i32 => r + x, 5)
  sum = sum + apply((x i32) i32 => r * x, 2)
  ret sum
}

; 验证：闭包借用捕获并调用参数
#Test
fn test_closure_borrow_capture_call_arg() {
  #Mut let n i32 = 100
  assert_eq(use_borrow_capture(&n), 305)
}

; ==================== lambda 返回静态 T&（有形参仍只允许 $rodata） ====================

let LAM_G i32 = 7

fn use_lambda_borrow_ret(f Function<i32&, i32&>) {
  ; 不调用 f，仅验证 borrow checker 接受静态根
}

; 验证：闭包返回静态借用（形参透传已收，见 diag_lambda_ret_param）
#Test
fn test_closure_ret_static_ref() {
  use_lambda_borrow_ret((r i32&) i32& => &LAM_G)
  assert_true(true)
}

; ==================== 语句体 / 尾随 / 推断 / 单行块 ====================

fn call_arr(c bool, f Function<bool, Array<i32>>) Array<i32> {
  ret f(c)
}

fn call_g<T>(x T, f Function<T, T>) T {
  ret f(x)
}

fn apply0_g<T>(f Function<T>) T {
  ret f()
}

fn wrap_opt(ok bool, f Function<i32>) i32? {
  if ok {
    ret f()
  }
  ret null
}

fn call_color(c Color, f Function<Color, i32>) i32 {
  ret f(c)
}

struct LamRunner {
  v i32

  #Static
  fn make(v i32) LamRunner {
    ret Self {
      .v = v
    }
  }

  fn run(f Function<i32, i32>) i32 {
    ret f($.v)
  }
}

fn one_line_add(a i32, b i32) i32 { ret a + b }

; 验证：返回类型由表达式体推断
#Test
fn test_lambda_ret_inferred() {
  let f = () => 42
  assert_eq(f(), 42)
  let g = (x i32) => x + 1
  assert_eq(g(41), 42)
}

; 验证：语句体 lambda
#Test
fn test_lambda_stmt_body() {
  let f = (x i32) i32 => {
    let y = x + 1
    ret y
  }
  assert_eq(f(4), 5)
}

; 验证：尾随 lambda（调用末位）
#Test
fn test_lambda_trailing() {
  let r = call_with(5){ (x) => x * 2 }
  assert_eq(r, 10)
  let r2 = apply0(){ () => 7 }
  assert_eq(r2, 7)
  let r3 = apply0 { () => 8 }
  assert_eq(r3, 8)
}

; 验证：尾随 lambda 显式形参 / 返回类型
#Test
fn test_lambda_trailing_explicit_types() {
  let r = call_with(5){ (x i32) i32 => x * 2 }
  assert_eq(r, 10)
}

; 验证：尾随 lambda 语句体（g4：`=>` 后直接 stmts，外层 `{ }` 即块）
#Test
fn test_lambda_trailing_stmt_body() {
  let r = call_with(5){ (x i32) i32 =>
    let y = x + 1
    ret y
  }
  assert_eq(r, 6)
}

; 验证：尾随 lambda + turbofish（typeArgs 替换后再编 lambda，见 compileGenericFunctionCall）
#Test
fn test_lambda_trailing_turbofish() {
  let r = call_g:<i32>(5){ (x) => x + 1 }
  assert_eq(r, 6)
  let r2 = apply0_g:<i32> { () => 42 }
  assert_eq(r2, 42)
  let r3 = apply0_g:<i32>(){ () => 7 }
  assert_eq(r3, 7)
}

; 验证：尾随 lambda 由实参推断泛型
#Test
fn test_lambda_trailing_generic_infer() {
  let r = call_g(5){ (x) => x + 1 }
  assert_eq(r, 6)
}

; 验证：尾随 lambda 体为 if 表达式（尾随块是语句体，用 ret 接表达式）
#Test
fn test_lambda_trailing_if_body() {
  let r = call_with(5){ (x) =>
    ret if x > 0 { x + 1 } else { x }
  }
  assert_eq(r, 6)
  let r2 = call_with(0 - 3){ (x) =>
    ret if x > 0 { x + 1 } else { x }
  }
  assert_eq(r2, 0 - 3)
}

; 验证：尾随 lambda 体为 match
#Test
fn test_lambda_trailing_match_body() {
  let r = call_color(Color::Blue){ (c) =>
    ret match c {
      Color::Red   => 10
      Color::Green => 20
      Color::Blue  => 30
    }
  }
  assert_eq(r, 30)
}

; 验证：lambda 表达式体 if 绑 Array（codegen 靶向）
#Test
fn test_lambda_if_array_body() {
  let pick = (c bool) Array<i32> => if c { [1] } else { [2] }
  assert_eq(pick(true)[0], 1)
  assert_eq(pick(false)[0], 2)
}

; 验证：lambda 表达式体 match 绑 Array
#Test
fn test_lambda_match_array_body() {
  let pick = (c Color) Array<i32> => match c {
    Color::Red   => [1]
    Color::Green => [2]
    Color::Blue  => [3]
  }
  assert_eq(pick(Color::Red)[0], 1)
  assert_eq(pick(Color::Blue)[0], 3)
}

; 验证：尾随 lambda if 绑 Array
#Test
fn test_lambda_trailing_if_array() {
  let a = call_arr(true){ (c) =>
    ret if c { [1] } else { [2] }
  }
  assert_eq(a[0], 1)
  let b = call_arr(false){ (c) =>
    ret if c { [] } else { [9] }
  }
  assert_eq(b[0], 9)
}

; 验证：lambda 语句体含 if + ret
#Test
fn test_lambda_stmt_body_if_ret() {
  let abs1 = (x i32) i32 => {
    if x > 0 {
      ret x
    }
    ret 0 - x
  }
  assert_eq(abs1(5), 5)
  assert_eq(abs1(0 - 7), 7)
}

; 验证：尾随 lambda 调用结果接 `??`
#Test
fn test_lambda_trailing_null_else() {
  let r i32 = wrap_opt(true){ () => 7 } ?? -1
  assert_eq(r, 7)
  let r2 i32 = wrap_opt(false){ () => 7 } ?? -1
  assert_eq(r2, -1)
}

; 验证：`?.method` 尾随 lambda（有值 / 空短路）
#Test
fn test_lambda_trailing_safe_dot() {
  #Mut let r LamRunner? = LamRunner::make(10)
  #Mut let x i32? = r?.run { (n) => n + 1 }
  assert_eq(x ?? -1, 11)

  #Mut let n LamRunner? = null
  #Mut let y i32? = n?.run { (n) => n + 1 }
  assert_eq(y ?? -1, -1)
}

; 验证：函数体 / if 可写成一行
#Test
fn test_one_line_block() {
  assert_eq(one_line_add(2, 3), 5)
  let v = if true { 1 } else { 0 }
  assert_eq(v, 1)
}

struct FnBox {
  f Function<String>
}

struct FnRefBox {
  f Function<i32&, i32>
}

fn run_fn_ref_field(h FnRefBox, x i32&) i32 {
  h.f(x)
}

; 验证：含 T& 形参的 Function 可作 struct 字段并调用
#Test
fn test_fn_ref_field_call() {
  let h FnRefBox = FnRefBox {
    .f = (r i32&) i32 => r + 1
  }
  #Mut let n i32 = 10
  assert_eq(run_fn_ref_field(h, &n), 11)
}

fn struct_fn_field_drop_scope() {
  let s String = "hello"
  let h FnBox = FnBox {
    .f = () String => s
  }
  assert_eq(h.f(), "hello")
}

#Test
fn test_struct_fn_field_drops_captures() {
  #Mut let base i64 = rc_leak_count()
  struct_fn_field_drop_scope()
  assert_eq(rc_leak_count() - base, 0)
}

fn array_fn_clone_scope() {
  let s String = "ab"
  let fs Array<Function<i32>> = [() i32 => s.len().to_i32()]
  let copy Array<Function<i32>> = fs.clone()
  assert_eq(copy[0](), 2)
  assert_eq(fs[0](), 2)
}

#Test
fn test_array_fn_clone_no_double_free() {
  #Mut let base i64 = rc_leak_count()
  array_fn_clone_scope()
  assert_eq(rc_leak_count() - base, 0)
}
