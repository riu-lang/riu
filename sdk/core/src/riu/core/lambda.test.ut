; lambda 测试套件
; 迁自 tests/cases/lambda_call_*.ut, lambda_type_*.ut, lambda_closure_*.ut
;
; 本文件包含 lambda 相关测试:
; - IIFE（立即调用 lambda）
; - lambda 作实参传给高阶 fn
; - fn 值作返回类型
; - struct 含 fn 字段
; - Array<fn> 元素调用
; - Rc<fn> 调用
; - fn 类型声明与别名
; - lambda 闭包捕获

; ==================== 类型别名 ====================

type Callback = Function<String, bool>
type PredI32 = Function<i32, bool>
type PredStr = Function<String, bool>
type Op2II = Function<i32, i32, i32>
type PredFn = Function<Function<i32>, bool>

; ==================== 辅助函数 ====================

fn apply(f Function<i32, i32>, x i32) i32 {
  ret f(x)
}

fn apply0(f Function<i32>) i32 {
  ret f()
}

fn call_with(x i32, f Function<i32, i32>) i32 {
  ret f(x)
}

fn run_twice(f Function<i32, i32>, x i32) i32 {
  ret f(x) + f(x + 1)
}

fn forward(g Function<i32, i32>, y i32) i32 {
  ret run_twice(g, y)
}

fn make_inc() Function<i32, i32> {
  ret (x i32) i32 => x + 1
}

fn make_const(v i32) Function<i32, i32> {
  ret (x i32) i32 => x * 2
}

fn make_adder(n i32) Function<i32, i32> {
  ret (x i32) i32 => x + n
}

fn run_first(a Array<Function<i32, i32>>&, x i32) i32 {
  ret a[0](x)
}

fn first(a Array<i32>&) i32 {
  ret copy_of(a[0])
}

; ==================== struct Holder ====================

struct Holder {
  h Function<i32, i32>
  base i32

  #Static
  fn make(h Function<i32, i32>, base i32) Holder {
    ret Self {
      .h = h
      .base = base
    }
  }

  fn run(x i32) i32 {
    ret $.h(x) + $.base
  }

  fn set(h Function<i32, i32>) {
    $.h = h
    ret;
  }
}

fn call_h_by_value(s Holder, x i32) i32 {
  ret s.h(x)
}

; ==================== struct Cell ====================

struct Cell {
  n i32

  #Static
  fn make(n i32) Cell {
    ret Self {
      .n = n
    }
  }
  fn get() i32 {
    ret $.n
  }
}

; ==================== struct Counter ====================

struct Counter {
  value i32

  #Static
  fn make(v i32) Counter {
    ret Self {
      .value = v
    }
  }

  fn double() i32 {
    ret $.value * 2
  }

  fn add_then_apply(x i32) i32 {
    ret apply((y i32) i32 => $.value + y, x)
  }

  fn triple_apply() i32 {
    #Mut let s i32 = 0
    s = s + apply0(() i32 => $.value)
    s = s + apply0(() i32 => $.value * 2)
    s = s + apply0(() i32 => $.double())
    ret s
  }
}

; ==================== IIFE 测试 ====================

; 验证：立即执行函数表达式（IIFE）单参数行为
#Test
fn test_iife_single_param() {
  let r = ((x i32) i32 => x + 1)(5)
  assert_eq(r, 6)
}

; 验证：立即执行函数表达式（IIFE）处理多个参数
#Test
fn test_iife_multi_param() {
  let r = ((a, b i32) i32 => a + b)(3, 4)
  assert_eq(r, 7)
}

; ==================== lambda 变量调用测试 ====================

; 验证：Lambda 表达式变量调用与计算结果
#Test
fn test_lambda_var_call() {
  #Mut let f Function<i32, i32> = (x i32) i32 => x * 2
  assert_eq(f(7), 14)
  assert_eq(f(0), 0)
  assert_eq(f(21), 42)
}

