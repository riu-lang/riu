; Phase 4.2 — Rc<T> 自动 forward draft 方法
; 覆盖 §12.6：box.m() 走 §8.6.7.3 自动解引用 + 方法分发归一，不需独立机制

#Impl(ToString)
struct Bag {
  k i64

  #Static
  fn make(k i64) Bag {
    ret Self {
      .k = k
    }
  }

  fn to_string() String {
    $.k.to_string()
  }
}

; 验证：Rc 包装的结构体转换为字符串
#Test
fn test_box_forward_to_string() {
  let b Rc<Bag> = Bag::make(31)
  assert_eq(b.to_string(), "31")
}

; 验证：Rc 转换为字符串时处理负数
#Test
fn test_box_forward_negative() {
  let b Rc<Bag> = Bag::make(-9)
  assert_eq(b.to_string(), "-9")
}
