/ String 类型 - 内部使用 Array<u32> 存储 Unicode code points
struct String {
  data Array<u32>
}

String {
  fn ~() {
    / Array<u32> 会自动释放
  }

  fn String() {
    self.data = []
  }

  fn String(s String) {
    self.data = s.data
  }

  fn len() i64 {
    self.data._len()
  }

  / 清空字符串
  fn clear() {
    self.data._clear()
  }

  / 追加一个 Unicode 码点
  fn append(cp u32) {
    self.data._push(cp)
  }

  / 追加另一个字符串
  fn append(s String) {
    var i i64 = 0
    loop {
      if i >= s.data._len() {
        break;
      }
      self.data._push(s.data[i])
      i += 1
    }
  }

  / 追加 ASCII 字节（作为 u32 码点写入）
  fn append(b u8) {
    self.data._push(b.to_u32())
  }

  / 取码点
  fn at(i i64) u32 {
    self.data[i]
  }

  / 就地截取 [start, end)，修改 self
  fn sub_string(start i64, end i64) {
    var len i64 = self.data._len()
    var s i64 = start
    var e i64 = end
    if s < 0 {
      s = 0
    }
    if e > len {
      e = len
    }
    if s >= e {
      self.data._set_len(0i64)
      ret;
    }
    var i i64 = 0
    var n i64 = e - s
    loop {
      if i >= n {
        break;
      }
      self.data[i] = self.data[s + i]
      i += 1
    }
    self.data._set_len(n)
  }
}

fn print(s String) {
  var i i64 = 0
  loop {
    if i >= s.data._len() {
      break;
    }
    val cp u32 = s.data[i]
    if cp < 128u32 {
      val b [u8 * 1] = [cp.to_u8()]
      _stdout_write(&b, 0i64, 1i64)
    } elif cp < 2048u32 {
      val b1 u8 = 192u8 + ((cp >> 6u32) & 31u32).to_u8()
      val b2 u8 = 128u8 + (cp & 63u32).to_u8()
      val buf [u8 * 2] = [b1, b2]
      _stdout_write(&buf, 0i64, 2i64)
    } elif cp < 65536u32 {
      val b1 u8 = 224u8 + ((cp >> 12u32) & 15u32).to_u8()
      val b2 u8 = 128u8 + ((cp >> 6u32) & 63u32).to_u8()
      val b3 u8 = 128u8 + (cp & 63u32).to_u8()
      val buf [u8 * 3] = [b1, b2, b3]
      _stdout_write(&buf, 0i64, 3i64)
    } else {
      val b1 u8 = 240u8 + ((cp >> 18u32) & 7u32).to_u8()
      val b2 u8 = 128u8 + ((cp >> 12u32) & 63u32).to_u8()
      val b3 u8 = 128u8 + ((cp >> 6u32) & 63u32).to_u8()
      val b4 u8 = 128u8 + (cp & 63u32).to_u8()
      val buf [u8 * 4] = [b1, b2, b3, b4]
      _stdout_write(&buf, 0i64, 4i64)
    }
    i += 1
  }
}

fn println(s String) {
  print(s)
  val nl [u8 * 1] = [10u8]
  _stdout_write(&nl, 0i64, 1i64)
}
