/ 内置类型
/ 结构体仅占位，为实际类型
/ to_数字 to_bool 函数编译器实现

struct i8 {
  / 原始类型
}

i8 {
  fn to_i8() i8 {
    self
  }

  fn to_u8() u8 {
    self
  }

  fn to_i16() i16 {
    self
  }

  fn to_u16() u16 {
    self
  }

  fn to_i32() i32 {
    self
  }

  fn to_u32() u32 {
    self
  }

  fn to_i64() i64 {
    self
  }

  fn to_u64() u64 {
    self
  }

  fn to_f64() f64 {
    self
  }

  fn to_f32() f32 {
    self
  }

  fn to_bool() bool {
    self != 0i8
  }
}

