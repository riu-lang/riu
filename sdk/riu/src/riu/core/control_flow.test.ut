; 控制流行为测试
;
; 覆盖：
;   - if-else 表达式（单行/多行）
;   - if/elif/else 链作为表达式
;   - if 作为语句（无 else）
;   - 嵌套 if-else 表达式
;   - 复杂条件（&& / || / 组合）
;   - 块内 ret 提前返回
;   - if 表达式 + 算术组合
;   - 短路求值（&& / ||）

; ==================== 基础 if-else 表达式 ====================

; 验证：基本的 if-else 表达式用于比较两个值并返回较大的那个
#Test
fn test_if_else_expr_basic() {
  let a i32 = 10
  let b i32 = 20
  let max i32 = if a > b { a } else { b }
  assert_eq(max, 20)
}

; 验证：单行 if-else 表达式是否正确返回值
#Test
fn test_if_else_expr_single_line() {
  let x i32 = 5
  let sign i32 = if x >= 0 { 1 } else { -1 }
  assert_eq(sign, 1)
}

; 验证：单行 if-else 表达式处理负数情况
#Test
fn test_if_else_expr_single_line_negative() {
  let x i32 = -3
  let sign i32 = if x >= 0 { 1 } else { -1 }
  assert_eq(sign, -1)
}

; ==================== if/elif/else 链作为表达式 ====================

; 验证：if/elif/else 链作为表达式是否正确返回值
#Test
fn test_if_elif_else_chain_expr() {
  let score i32 = 85
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } elif score >= 70 {
    3
  } else {
    4
  }
  assert_eq(grade, 2)
}

; 验证：if-elif-else 链中最后一个 else 分支的执行
#Test
fn test_if_elif_else_chain_else_branch() {
  let score i32 = 50
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } else {
    4
  }
  assert_eq(grade, 4)
}

; 验证：if-elif-else 链中第一个分支的执行
#Test
fn test_if_elif_else_chain_first_branch() {
  let score i32 = 95
  let grade i32 = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } else {
    4
  }
  assert_eq(grade, 1)
}

; ==================== if 作为语句（无 else） ====================

; 验证：if 语句作为语句时，true 条件下的赋值行为
#Test
fn test_if_statement_no_else() {
  #Mut let x i32 = 0
  if true {
    x = 1
  }
  assert_eq(x, 1)
}

; 验证：if 语句条件为假时，不执行块内代码
#Test
fn test_if_statement_condition_false() {
  #Mut let x i32 = 0
  if false {
    x = 1
  }
  assert_eq(x, 0)
}

; ==================== 嵌套 if-else ====================

; 验证：嵌套 if-else 表达式求最大值
#Test
fn test_nested_if_else_expr() {
  let a i32 = 10
  let b i32 = 20
  let c i32 = 30
  let max i32 = if a > b {
    if a > c { a } else { c }
  } else {
    if b > c { b } else { c }
  }
  assert_eq(max, 30)
}

; ==================== 复杂条件（&& / ||） ====================

; 验证：if 语句中使用 && 条件判断
#Test
fn test_if_with_and_condition() {
  let x i32 = 5
  let y i32 = 10
  let result i32 = if x > 0 && y > 0 { 1 } else { 0 }
  assert_eq(result, 1)
}

; 验证：if 语句中使用或条件
#Test
fn test_if_with_or_condition() {
  let x i32 = -1
  let y i32 = 10
  let result i32 = if x > 0 || y > 0 { 1 } else { 0 }
  assert_eq(result, 1)
}

; 验证：if 语句处理复杂条件
#Test
fn test_if_with_complex_condition() {
  let a i32 = 10
  let b i32 = 5
  let c i32 = 20
  let result i32 = if (a > b) && (c > a) { 1 } else { 0 }
  assert_eq(result, 1)
}

; ==================== 块内 ret 提前返回 ====================

fn return_early(flag bool) i32 {
  if flag {
    ret 1
  }
  ret 0
}

; 验证：当条件为真时，函数是否能提前返回值
#Test
fn test_early_return_true() {
  let v i32 = return_early(true)
  assert_eq(v, 1)
}

; 验证：早期返回 false 时的默认值
#Test
fn test_early_return_false() {
  let v i32 = return_early(false)
  assert_eq(v, 0)
}

; ==================== if 表达式 + 算术组合 ====================

; 验证：If 表达式在算术组合中的使用
#Test
fn test_if_expr_in_arithmetic() {
  let a i32 = 10
  let b i32 = 5
  let result i32 = (if a > b { a } else { b }) * 2
  assert_eq(result, 20)
}

; ==================== 短路求值行为 ====================

fn side_effect_flag() bool {
  ret true
}

; 验证：短路与逻辑运算符的行为
#Test
fn test_short_circuit_and() {
  let result bool = false && side_effect_flag()
  assert_false(result)
}

; 验证：短路或运算符的行为
#Test
fn test_short_circuit_or() {
  let result bool = true || side_effect_flag()
  assert_true(result)
}

; ==================== 边界 / 扩展测试 ====================

#Test
fn test_if_elif_all_false() {
  ; 验证：if/elif 链全部条件为 false 时走 else 分支
  let x i32 = 0
  let result i32 = if x > 0 {
    1
  } elif x > 10 {
    2
  } else {
    99
  }
  assert_eq(result, 99)
}

#Test
fn test_ternary_with_arithmetic() {
  ; 验证：单行 if-else 表达式直接参与算术运算
  let a i32 = 10
  let b i32 = 20
  let result i32 = (if a > b { a } else { b }) + 5
  assert_eq(result, 25)
}

#Test
fn test_if_else_zero_condition() {
  ; 验证：if 条件为字面量 false 和 true
  let result i32 = if false { 1 } else { 0 }
  assert_eq(result, 0)
  let result2 i32 = if true { 42 } else { 0 }
  assert_eq(result2, 42)
}

; ==================== 块作用域（§5.7.1）====================

; 验证：if 体内 let 可遮蔽外层同名；出块后仍是外层值
#Test
fn test_block_scope_if_shadow() {
  let x i32 = 1
  let inner i32 = if true {
    let x i32 = 42
    x
  } else {
    0
  }
  assert_eq(inner, 42)
  assert_eq(x, 1)
}

; 验证：loop init 变量在体内可用，并可 break 退出
#Test
fn test_block_scope_loop_init() {
  #Mut let sum i32 = 0
  loop i = 0 {
    if i >= 3 {
      break;
    }
    sum = sum + i
    i = i + 1
  }
  assert_eq(sum, 3)
}

; 验证：labeled break 跨层退出
#Test
fn test_block_scope_labeled_break() {
  #Mut let n i32 = 0
  outer: loop {
    loop i = 0 {
      if i >= 2 {
        break@outer;
      }
      n = n + 1
      i = i + 1
    }
  }
  assert_eq(n, 2)
}

; ==================== continue / continue@label ====================

; 验证：continue 跳过本轮剩余语句
#Test
fn test_continue_skips_rest() {
  #Mut let sum i32 = 0
  loop i = 0 {
    if i >= 5 {
      break;
    }
    i = i + 1
    if i == 3 {
      continue;
    }
    sum = sum + i
  }
  assert_eq(sum, 12)
}

; 验证：continue@label 跳到外层循环下一轮
#Test
fn test_continue_label_outer() {
  #Mut let i i32 = 0
  outer: loop {
    if i >= 3 {
      break;
    }
    loop {
      i = i + 1
      continue@outer;
    }
  }
  assert_eq(i, 3)
}

; ==================== for-in ====================

; 验证：for-in 遍历 Array<i32>，item 为 T&，运算符自动解包
#Test
fn test_for_in_array_sum() {
  let arr Array<i32> = [1i32, 2i32, 3i32]
  #Mut let sum i32 = 0
  for x in arr {
    sum = sum + x
  }
  assert_eq(sum, 6)
}

; 验证：定长数组 [T * N]
#Test
fn test_for_in_fixed_array() {
  let buf [i32 * 3] = [1i32, 2i32, 3i32]
  #Mut let sum i32 = 0
  for x in buf {
    sum = sum + x
  }
  assert_eq(sum, 6)
}

; 验证：空数组零轮
#Test
fn test_for_in_empty_array() {
  let arr Array<i32> = []
  #Mut let n i32 = 0
  for x in arr {
    n = n + 1
  }
  assert_eq(n, 0)
}

; 验证：Array<T>& 可迭代
#Test
fn test_for_in_array_ref() {
  let arr Array<i32> = [4i32, 5i32]
  let r Array<i32>& = &arr
  #Mut let sum i32 = 0
  for x in r {
    sum = sum + x
  }
  assert_eq(sum, 9)
}

; 验证：#Mut 数组经 for-in 的 T& 写穿
#Test
fn test_for_in_write_through() {
  #Mut let arr Array<i32> = [1i32, 2i32, 3i32]
  for x in arr {
    x = x + 10
  }
  assert_eq(arr[0], 11i32)
  assert_eq(arr[1], 12i32)
  assert_eq(arr[2], 13i32)
}

; 验证：嵌套 for，内层 break/continue 不穿外层
#Test
fn test_for_in_nested_break_continue() {
  let a Array<i32> = [1i32, 2i32]
  let b Array<i32> = [10i32, 20i32, 30i32]
  #Mut let sum i32 = 0
  for x in a {
    for y in b {
      if y == 20 {
        continue;
      }
      if y == 30 {
        break;
      }
      sum = sum + x + y
    }
  }
  ; 每轮 x 只加 y=10：1+10 与 2+10
  assert_eq(sum, 23)
}

; 验证：break@outer 穿过内层 for
#Test
fn test_for_in_break_outer() {
  let a Array<i32> = [1i32, 2i32, 3i32]
  let b Array<i32> = [1i32, 2i32]
  #Mut let n i32 = 0
  outer: for x in a {
    for y in b {
      n = n + 1
      break@outer;
    }
  }
  assert_eq(n, 1)
}

; 验证：for-in 内 continue 跳过元素
#Test
fn test_for_in_continue() {
  let arr Array<i32> = [1i32, 2i32, 3i32, 4i32]
  #Mut let sum i32 = 0
  for x in arr {
    if x == 2 {
      continue;
    }
    sum = sum + x
  }
  assert_eq(sum, 8)
}

; ==================== for-in Indexed ====================

#NoCopy
#Impl(Indexed<i32>)
struct ForInBuf {
  data Array<i32>

  #Static
  fn make(data Array<i32>) Self {
    Self {
      .data = move(data)
    }
  }

  fn len() usize {
    $.data.len()
  }

  fn at(i usize) i32& {
    let d Array<i32>& = &$.data
    ret d[i]
  }
}

; 验证：`#Impl(Indexed<U>)` 隐藏索引 loop，item 为 U&
#Test
fn test_for_in_indexed_sum() {
  let b = ForInBuf::make([1i32, 2i32, 3i32])
  #Mut let sum i32 = 0
  for x in b {
    sum = sum + x
  }
  assert_eq(sum, 6)
}

; 验证：Indexed for-in 写穿
#Test
fn test_for_in_indexed_write_through() {
  #Mut let b = ForInBuf::make([1i32, 2i32, 3i32])
  for x in b {
    x = x + 10
  }
  assert_eq(b.at(0usize), 11i32)
  assert_eq(b.at(1usize), 12i32)
  assert_eq(b.at(2usize), 13i32)
}

; 验证：Indexed 空集合零轮
#Test
fn test_for_in_indexed_empty() {
  let b = ForInBuf::make([])
  #Mut let n i32 = 0
  for x in b {
    n = n + 1
  }
  assert_eq(n, 0)
}

; ==================== for-in Iter ====================

#Impl(Iter<i32, End>)
struct ForInCounter {
  #Mut
  i i32
  end i32

  #Static
  fn make(end i32) Self {
    Self {
      .i = 0
      .end = end
    }
  }

  fn next() IterItem<i32, End> {
    if $.i >= $.end {
      ret IterItem:<i32, End>::End
    }
    #Mut let v i32 = $.i
    $.i += 1
    IterItem:<i32, End>::Item(v)
  }
}

enum ForInNetErr {
  Fail
}

#Impl(Iter<i32, ForInNetErr>)
struct ForInStream {
  #Mut
  i i32
  fail_at i32

  #Static
  fn make(fail_at i32) Self {
    Self {
      .i = 0
      .fail_at = fail_at
    }
  }

  fn next() IterItem<i32, ForInNetErr> {
    if $.i == $.fail_at {
      ret IterItem:<i32, ForInNetErr>::Error(ForInNetErr::Fail)
    }
    if $.i >= 4 {
      ret IterItem:<i32, ForInNetErr>::End
    }
    #Mut let v i32 = $.i
    $.i += 1
    IterItem:<i32, ForInNetErr>::Item(v)
  }
}

; 验证：`#Impl(Iter<U, End>)` 隐藏 next match，item 为 U 值
#Test
fn test_for_in_iter_sum() {
  #Mut let c = ForInCounter::make(4)
  #Mut let sum i32 = 0
  for x in c {
    sum = sum + x
  }
  assert_eq(sum, 6)
}

; 验证：Iter 空区间零轮
#Test
fn test_for_in_iter_empty() {
  #Mut let c = ForInCounter::make(0)
  #Mut let n i32 = 0
  for x in c {
    n = n + 1
  }
  assert_eq(n, 0)
}

; 验证：Iter for-in continue / break
#Test
fn test_for_in_iter_continue_break() {
  #Mut let c = ForInCounter::make(5)
  #Mut let sum i32 = 0
  for x in c {
    if x == 1 {
      continue;
    }
    if x == 3 {
      break;
    }
    sum = sum + x
  }
  assert_eq(sum, 2)
}

; 验证：手写 loop + match next 与 for-in 同一条 IterItem
#Test
fn test_iter_handwritten_match() {
  #Mut let it = ForInCounter::make(4)
  #Mut let sum i32 = 0
  loop {
    match it.next() {
      IterItem::Item(v) => {
        sum = sum + v
      }
      IterItem::End => {
        break;
      }
      IterItem::Error(e) => {
        break;
      }
    }
  }
  assert_eq(sum, 6)
}

; 验证：可失败 Iter 在 try 内，Error 进 catch
#Test
fn test_for_in_iter_error_try() {
  #Mut let s = ForInStream::make(1)
  let n i32 = try {
    #Mut let sum i32 = 0
    for x in s {
      sum = sum + x
    }
    sum
  } catch e ForInNetErr {
    -1
  }
  assert_eq(n, -1)
}

; 验证：可失败 Iter 同型 `!` 透传；成功走完
fn sum_ok_stream() i32 ! ForInNetErr {
  #Mut let s = ForInStream::make(9)
  #Mut let sum i32 = 0
  for x in s {
    sum = sum + x
  }
  ret sum
}

#Test
fn test_for_in_iter_error_bang_ok() {
  let n i32 = try {
    sum_ok_stream()
  } catch e ForInNetErr {
    -1
  }
  assert_eq(n, 6)
}
