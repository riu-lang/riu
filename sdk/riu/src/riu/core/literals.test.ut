; 字面量行为测试
;
; 覆盖：
;   - 整数默认类型推断（i32）、各整数类型边界值（i8 min/max、u8 max、i16 min、u16 max、i32 min、i64 min+1）
;   - 浮点默认类型推断（f64）、f32/f64 显式后缀、负浮点
;   - bool 字面量
;   - 进制字面量：十六进制（0xFF i64）、二进制（0b1010 u8）、八进制（0o77 i32）
;
; 已知缺口：usize/isize 字面量后缀见 usize_literal.test.ut；
; 各进制与类型后缀组合见 integer_bases.test.ut。

#Test
fn test_int_literal_default() {
  let a = 42
  assert_eq(a, 42)
}

; 验证：i8 类型字面量的创建与比较
#Test
fn test_i8_literal() {
  let e = 42
  assert_eq(e, 42)
}

; 验证：i8 类型的最小值和最大值
#Test
fn test_i8_min_max() {
  let lo i8 = -128
  let hi i8 = 127
  assert_eq(lo, -128)
  assert_eq(hi, 127)
}

; 验证：u8 类型的最大值
#Test
fn test_u8_max() {
  let c u8 = 255
  assert_eq(c, 255)
}

; 验证：i16 类型的最小值
#Test
fn test_i16_min() {
  let d i16 = -32768
  assert_eq(d, -32768)
}

; 验证：u16 类型的最大值是否正确
#Test
fn test_u16_max() {
  let e u16 = 65535
  assert_eq(e, 65535)
}

; 验证：i32 类型的最小值
#Test
fn test_i32_min() {
  let f i32 = -2147483648
  assert_eq(f, -2147483648)
}

; 验证：u64 类型字面量的创建与比较
#Test
fn test_u64_literal() {
  let f = 100
  assert_eq(f, 100)
}

; 验证：负整数字面量的解析与赋值
#Test
fn test_i32_negative_literal() {
  let g = -123
  assert_eq(g, -123)
}

; 验证：i64 类型的最小值加一
#Test
fn test_i64_min_plus_one() {
  let g i64 = -9223372036854775807
  assert_eq(g, -9223372036854775807)
}

; 验证：f64 类型的默认值
#Test
fn test_f64_default() {
  let h = 3.14
  assert_eq(h, 3.14)
}

; 验证：浮点数字面量的创建与比较
#Test
fn test_f32_literal() {
  let i = 2.5f32
  assert_eq(i, 2.5f32)
}

; 验证：显式浮点数字面量的创建与比较
#Test
fn test_f64_literal_explicit() {
  let j = 1.0f64
  assert_eq(j, 1.0f64)
}

; 验证：负浮点数字面量的表示与比较
#Test
fn test_f64_negative() {
  let k = -0.5
  assert_eq(k, -0.5)
}

; 验证：布尔字面量的真值判断
#Test
fn test_bool_literals() {
  assert_eq(true, true)
  assert_eq(false, false)
}

; ==================== hex / binary / octal 字面量（迁自 bug_hunt） ====================

#Test
fn test_literal_hex_i64() {
  ; 验证：十六进制 i64 字面量
  let a i64 = 0xFF
  assert_eq(a, 255)
}

#Test
fn test_literal_binary() {
  ; 验证：二进制 u8 字面量
  let a u8 = 0b1010
  assert_eq(a, 10)
}

#Test
fn test_literal_octal() {
  ; 验证：八进制 i32 字面量
  let a i32 = 0o77
  assert_eq(a, 63)
}
