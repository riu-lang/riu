; 枚举 + match 行为测试 (Phase 6)
;
; 覆盖：
;   - 零参 variant 的构造与 match
;   - tuple-payload variant 的构造、绑定与 match
;   - else 兜底
;   - 含 RC payload (String) variant 的 match 与析构
;   - 类型别名透传 C::V 路径
;   - 跨变量传递与作用域结束析构
;   - Rc<E> 枚举上堆
;   - Array<E> 枚举数组
;   - E? 可空枚举
;   - 嵌套 match 表达式
;   - match 返回复杂类型（struct、tuple）
;   - 更多 payload 类型（Rc<T>、Array<T>）

enum Color {
  Red
  Green
  Blue
}

enum Shape {
  Point
  Circle(f64)
  Rect(f64, f64)
}

enum Tagged {
  Empty
  Msg(String)
  Pair(i32, String)
}

ColorAlias = Color

; ==================== 基本枚举测试 ====================

; 验证：Enum 匹配零值变体
#Test
fn test_enum_match_zero_variant() {
  let c Color = Color::Red
  let n i32 = match c {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 1)
}

; 验证：Enum 匹配零值带括号
#Test
fn test_enum_match_zero_with_paren() {
  let c Color = Color::Green()
  let n i32 = match c {
    Color::Red => 10
    Color::Green => 20
    Color::Blue => 30
  }
  assert_eq(n, 20)
}

; 验证：Enum match 其他分支处理
#Test
fn test_enum_match_else_branch() {
  let c Color = Color::Blue
  let n i32 = match c {
    Color::Red => 1
    else => 99
  }
  assert_eq(n, 99)
}

; 验证：Enum match 匹配包含浮点数的元组负载
#Test
fn test_enum_match_tuple_payload_f64() {
  let s Shape = Shape::Circle(2.0f64)
  let area f64 = match s {
    Shape::Point => 0.0f64
    Shape::Circle(r) => 3.14f64 * r * r
    Shape::Rect(w, h) => w * h
  }
  ; 3.14 * 4.0 = 12.56
  assert_eq(area, 12.56f64)
}

; 验证：Enum 匹配带元组负载的矩形面积计算
#Test
fn test_enum_match_tuple_payload_rect() {
  let s Shape = Shape::Rect(3.0f64, 4.0f64)
  let area f64 = match s {
    Shape::Point => 0.0f64
    Shape::Circle(r) => 3.14f64 * r * r
    Shape::Rect(w, h) => w * h
  }
  assert_eq(area, 12.0f64)
}

; 验证：Enum 匹配别名并返回对应值
#Test
fn test_enum_match_alias() {
  let c ColorAlias = ColorAlias::Red
  let n i32 = match c {
    ColorAlias::Red => 7
    ColorAlias::Green => 8
    ColorAlias::Blue => 9
  }
  assert_eq(n, 7)
}

; 验证：Enum match 检查字符串负载
#Test
fn test_enum_match_string_payload_check() {
  let t Tagged = Tagged::Msg("hello")
  let flag i32 = match t {
    Tagged::Empty => 0
    Tagged::Msg(s) => 1
    Tagged::Pair(n, _unused) => 2
  }
  assert_eq(flag, 1)
}

; 验证：Enum match 匹配 Pair 类型并提取其第一个字段
#Test
fn test_enum_match_pair_payload_use_first() {
  let t Tagged = Tagged::Pair(42, "hello world")
  let n i32 = match t {
    Tagged::Empty => -1
    Tagged::Msg(_unused) => -2
    Tagged::Pair(num, _s) => num
  }
  assert_eq(n, 42)
}

; 验证：Enum match 消费拥有者载荷并按标签释放资源
#Test
fn test_enum_match_drops_owned_payload() {
  ; 直接 match 一个临时构造的含 String 的 enum：
  ; 拿 owned scrutinee → arm 取绑定为借用 → match 末按 tag dispatch dtor 释放 String
  let n i32 = match Tagged::Msg("hi") {
    Tagged::Empty => 0
    Tagged::Msg(_s) => 7
    Tagged::Pair(x, _y) => x
  }
  assert_eq(n, 7)
}

; ==================== Rc<E> 枚举上堆 ====================

; 验证：Rc 枚举匹配与解包
#Test
fn test_enum_box_basic() {
  #Mut let b Rc<Color> = Color::Red
  let n i32 = match b {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 1)
}

; 验证：Rc 包装的枚举类型处理不同变体的匹配与计算
#Test
fn test_enum_box_with_payload() {
  #Mut let b Rc<Shape> = Shape::Circle(5.0f64)
  let area f64 = match b {
    Shape::Point => 0.0f64
    Shape::Circle(r) => 3.14f64 * r * r
    Shape::Rect(w, h) => w * h
  }
  assert_eq(area, 78.5f64)
}

; 验证：Rc 引用计数枚举重新赋值
#Test
fn test_enum_box_reassign() {
  #Mut let b Rc<Color> = Color::Red
  b = Color::Blue
  let n i32 = match b {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 3)
}

; ==================== Array<E> 枚举数组 ====================

; 验证：Enum 数组基本操作，包括长度获取和元素匹配
#Test
fn test_enum_array_basic() {
  #Mut let arr Array<Color> = [Color::Red, Color::Green, Color::Blue]
  assert_eq(arr.len(), 3)
  
  let n i32 = match arr[0] {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 1)
}

; 验证：Enum 数组中不同变体的匹配与计算
#Test
fn test_enum_array_with_payload() {
  #Mut let arr Array<Shape> = [Shape::Point, Shape::Circle(2.0f64), Shape::Rect(3.0f64, 4.0f64)]
  assert_eq(arr.len(), 3)
  
  let area f64 = match arr[1] {
    Shape::Point => 0.0f64
    Shape::Circle(r) => 3.14f64 * r * r
    Shape::Rect(w, h) => w * h
  }
  assert_eq(area, 12.56f64)
}

; 验证：Enum 数组元素修改与匹配
#Test
fn test_enum_array_modify() {
  #Mut let arr Array<Color> = [Color::Red, Color::Green]
  arr[0] = Color::Blue
  
  let n i32 = match arr[0] {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 3)
}

; ==================== E? 可空枚举 ====================

; 验证：可空枚举 has_value 方法返回 true 表示有值
#Test
fn test_enum_nullable_has_value() {
  #Mut let opt Color? = Color::Red
  assert_true(opt.has())

  let n i32 = match opt.get() {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  assert_eq(n, 1)
}

; 验证：Nullable 枚举在没有值时 has 方法返回 false
#Test
fn test_enum_nullable_no_value() {
  #Mut let opt Color? = null
  assert_false(opt.has())
}

; 验证：可选枚举在有值时返回正确内容
#Test
fn test_enum_nullable_with_payload() {
  #Mut let opt Shape? = Shape::Rect(4.0f64, 5.0f64)
  assert_true(opt.has())

  let area f64 = match opt.get() {
    Shape::Point => 0.0f64
    Shape::Circle(r) => r * r
    Shape::Rect(w, h) => w * h
  }
  assert_eq(area, 20.0f64)
}

; ==================== 嵌套 match 表达式 ====================

enum Outer {
  A(i32)
  B(Color)
}

enum Inner {
  X
  Y(i32)
}

; 验证：嵌套 match 表达式处理枚举值
#Test
fn test_enum_nested_match() {
  let o Outer = Outer::B(Color::Green)
  
  let result i32 = match o {
    Outer::A(n) => n
    Outer::B(c) => match c {
      Color::Red => 10
      Color::Green => 20
      Color::Blue => 30
    }
  }
  assert_eq(result, 20)
}

; 验证：嵌套 match 表达式处理枚举值并计算结果
#Test
fn test_enum_nested_match_with_payload() {
  let o Outer = Outer::A(5)
  let i Inner = Inner::Y(10)
  
  let result i32 = match o {
    Outer::A(n) => match i {
      Inner::X => n
      Inner::Y(m) => n + m
    }
    Outer::B(_c) => 0
  }
  assert_eq(result, 15)
}

; ==================== match 返回复杂类型 ====================

struct Point {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Point {
    ret Self {
      .x = x
      .y = y
    }
  }
}

enum Geometry {
  Origin
  Coord(f64, f64)
}

; 验证：Enum match 返回结构体
#Test
fn test_enum_match_return_struct() {
  let g Geometry = Geometry::Coord(3.0f64, 4.0f64)
  
  let p Point = match g {
    Geometry::Origin => Point::make(0.0f64, 0.0f64)
    Geometry::Coord(x, y) => Point::make(x, y)
  }
  
  assert_eq(p.x, 3.0f64)
  assert_eq(p.y, 4.0f64)
}

; 验证：Enum match 匹配 Geometry 类型并返回元组
#Test
fn test_enum_match_return_tuple() {
  let g Geometry = Geometry::Coord(5.0f64, 6.0f64)
  
  let t (f64, f64) = match g {
    Geometry::Origin => (0.0f64, 0.0f64)
    Geometry::Coord(x, y) => (x, y)
  }
  
  assert_eq(t.0, 5.0f64)
  assert_eq(t.1, 6.0f64)
}

; ==================== 更多 payload 类型 ====================

enum Container {
  Empty
  Boxed(Rc<Point>)
  Listed(Array<i32>)
}

; 验证：枚举类型中 Box 包装的值的解包和求和
#Test
fn test_enum_payload_box() {
  #Mut let bp Rc<Point> = Point::make(10.0f64, 20.0f64)
  let c Container = Container::Boxed(bp)

  let result f64 = match c {
    Container::Empty => 0.0f64
    Container::Boxed(p) => p.x + p.y
    Container::Listed(_arr) => -1.0f64
  }

  assert_eq(result, 30.0f64)
}

; 验证：Enum 包含数组时，获取数组长度并返回
#Test
fn test_enum_payload_array() {
  #Mut let arr Array<i32> = [1, 2, 3, 4, 5]
  let c Container = Container::Listed(move(arr))

  let result i32 = match c {
    Container::Empty => 0
    Container::Boxed(_p) => -1
    Container::Listed(a) => a.len().to_i32()
  }

  assert_eq(result, 5)
}

; ==================== 多 payload 变体（迁自 bug_hunt） ====================

enum BHMultiPayload {
  A
  B(i32)
  C(i32, String)
  D(i32, String, f64)
}

fn bh_multi_inspect(e BHMultiPayload&) i32 {
  match e {
    BHMultiPayload::A => 0
    BHMultiPayload::B(x) => x
    BHMultiPayload::C(x, _) => x
    BHMultiPayload::D(x, _s, _d) => x
  }
}

#Test
fn test_enum_multi_payload_a() {
  ; 验证：0 字段变体 match
  let e BHMultiPayload = BHMultiPayload::A
  assert_eq(bh_multi_inspect(&e), 0)
}

#Test
fn test_enum_multi_payload_b() {
  ; 验证：1 字段变体 match
  let e BHMultiPayload = BHMultiPayload::B(42)
  assert_eq(bh_multi_inspect(&e), 42)
}

#Test
fn test_enum_multi_payload_c() {
  ; 验证：2 字段变体 match（含 String）
  let e BHMultiPayload = BHMultiPayload::C(10, "ten")
  assert_eq(bh_multi_inspect(&e), 10)
}

#Test
fn test_enum_multi_payload_d() {
  ; 验证：3 字段变体 match（含 String + f64）
  let e BHMultiPayload = BHMultiPayload::D(99, "test", 3.14f64)
  assert_eq(bh_multi_inspect(&e), 99)
}

; ==================== Enum Rc payload match（迁自 bug_hunt） ====================

enum RcPayload {
  Nothing
  Text(String)
  Num(i32)
}

#Test
fn test_enum_rc_payload_match() {
  ; 验证：match enum with String payload（Rc 字段）
  let e RcPayload = RcPayload::Text("hi")
  let s String = match e {
    RcPayload::Nothing => "none"
    RcPayload::Text(t) => t
    RcPayload::Num(n) => "not text"
  }
  assert_eq(s, "hi")
}

; ==================== match arm 块体 ====================

#Test
fn test_enum_match_block_body() {
  ; 验证：match 块体多语句，末表达式为块值
  let c Color = Color::Red
  let n i32 = match c {
    Color::Red => {
      let x = 1
      x + 1
    }
    Color::Green => 0
    Color::Blue => 0
  }
  assert_eq(n, 2)
}

#Test
fn test_enum_match_block_oneline() {
  ; 验证：match 块体单行
  let c Color = Color::Green
  let n i32 = match c {
    Color::Red => { 1 }
    Color::Green => { 2 }
    Color::Blue => { 3 }
  }
  assert_eq(n, 2)
}

#Test
fn test_enum_match_mixed_body() {
  ; 验证：match 块体与表达式体混用
  let c Color = Color::Blue
  let n i32 = match c {
    Color::Red => 1
    Color::Green => { 2 }
    Color::Blue => {
      let x = 3
      x
    }
  }
  assert_eq(n, 3)
}

#Test
fn test_enum_match_block_binding() {
  ; 验证：match 块体内使用 payload 绑定
  let s Shape = Shape::Circle(2.0f64)
  let area f64 = match s {
    Shape::Point => 0.0f64
    Shape::Circle(r) => {
      let rr = r * r
      3.14f64 * rr
    }
    Shape::Rect(w, h) => w * h
  }
  assert_eq(area, 12.56f64)
}

fn match_block_ret_helper(c Color) i32 {
  ret match c {
    Color::Red => {
      ret 10
    }
    Color::Green => 20
    Color::Blue => 30
  }
}

#Test
fn test_enum_match_block_ret() {
  ; 验证：match 块体 `ret` 流终止不参与类型合并
  let c Color = Color::Red
  let n i32 = match_block_ret_helper(c)
  assert_eq(n, 10)
}

#Test
fn test_enum_match_block_empty_stmt() {
  ; 验证：match 空块作语句（不取值）
  let c Color = Color::Red
  match c {
    Color::Red => {}
    else => {}
  }
}

; ==================== 边界测试 ====================

#Test
fn test_enum_zero_variant_match_else() {
  ; 验证：仅匹配零参 variant + else 兜底
  let c Color = Color::Green
  let r i32 = match c {
    Color::Red => 1
    else => 0
  }
  assert_eq(r, 0)
}
