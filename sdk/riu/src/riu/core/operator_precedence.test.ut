; 运算符优先级用例
; 迁自 tests/cases/operator_precedence.ut
;
; 本文件覆盖运算符优先级与结合性：
; - 算术优先级链
; - 比较 vs 逻辑
; - 一元 vs 二元
; - 左结合性
; 位运算已改为方法调用，无运算符优先级。

; ==================== 算术优先级基础 ====================

; 验证：算术运算符的优先级，乘法在加法之前执行
#Test
fn test_mul_before_add() {
  assert_eq(1 + 2 * 3, 7)
}

; 验证：括号优先级覆盖默认运算顺序
#Test
fn test_paren_overrides() {
  assert_eq((1 + 2) * 3, 9)
}

; 验证：减法的左结合性
#Test
fn test_left_assoc_sub() {
  assert_eq(10 - 2 - 3, 5)
}

; 验证：左结合性：除法和乘法的优先级相同，从左到右计算
#Test
fn test_left_assoc_div_mul() {
  assert_eq(10 / 2 * 3, 15)
}

; 验证：算术运算后的关系运算符行为
#Test
fn test_relational_after_arith() {
  assert_true((1 + 2) > 2)
  assert_true((3 * 2) == 6)
}

; ==================== 比较与算术混合（无括号） ====================

#Test
fn test_compare_after_arith_no_paren() {
  ; 验证：算术优先于比较（a + b == c 不需要括号）
  assert_true(1 + 2 == 3)
  assert_false(1 + 2 == 4)
  assert_true(2 * 3 > 5)
  assert_true(10 - 3 < 8)
}

; ==================== 比较与逻辑 ====================

#Test
fn test_logical_vs_compare() {
  ; 验证：比较优先于逻辑（a == b && c == d 不需要括号）
  assert_true(1 == 1 && 2 == 2)
  assert_false(1 == 2 && 2 == 2)
  assert_true(1 == 1 || 1 == 2)
  assert_false(1 == 2 || 2 == 3)
}

#Test
fn test_logical_short_circuit() {
  ; 验证：&& / || 短路求值
  assert_true(true || false)
  assert_false(false && false)
  assert_true(true && true)
}

; ==================== 一元与二元混合 ====================

#Test
fn test_unary_vs_binary() {
  ; 验证：一元运算符优先级高于二元
  assert_eq(-3 + 5, 2)
  assert_eq(5 + -3, 2)
  assert_eq(-3 * 4, -12)
  assert_eq(4 * -3, -12)
}

#Test
fn test_not_vs_logical() {
  ; 验证：! 优先于 && / ||
  assert_true(!false && true)
  assert_false(!true && true)
  assert_true(!false || false)
}

; ==================== 复杂组合 ====================

#Test
fn test_complex_mixed() {
  ; 验证：a + b * c == d 风格表达式
  assert_true(2 + 3 * 4 == 14)
  assert_false(2 + 3 * 4 == 20)
  assert_true(10 - 6 / 2 == 7)
}

#Test
fn test_paren_chained() {
  ; 验证：多层括号
  assert_eq(((1 + 2) * (3 + 4)) - 5, 16)
  assert_eq(1 + (2 * (3 + (4 - 5))), 5)
}

#Test
fn test_mod_precedence() {
  ; 验证：% 与 * / 同级，优先于 +
  assert_eq(10 + 7 % 3, 11)
  assert_eq(7 % 3 + 10, 11)
  assert_eq(10 - 7 % 3, 9)
}

; ==================== 结合性更多测试 ====================

#Test
fn test_left_assoc_add_sub() {
  ; 验证：加减左结合
  assert_eq(10 - 5 + 3, 8)
  assert_eq(10 + 5 - 3, 12)
}

#Test
fn test_left_assoc_mul_div_mod() {
  ; 验证：乘除模左结合
  assert_eq(12 / 3 * 2, 8)
  assert_eq(12 * 3 / 2, 18)
  assert_eq(10 % 3 * 2, 2)
}

; ==================== 边界 / 扩展优先级测试 ====================

#Test
fn test_not_vs_logical_ok() {
  let a i32 = 1
  let ok bool = !false && a == 1
  assert_true(ok)
}

#Test
fn test_compare_chain() {
  ; 验证：比较链（== 和 && 的组合优先级）
  assert_true(1 == 1 && 2 == 2 && 3 == 3)
  assert_false(1 == 1 && 2 == 0 && 3 == 3)
}
