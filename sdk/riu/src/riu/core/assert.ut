; riu SDK - 测试断言 API（spec §11.3.5）
;
; 四个 #Builtin 占位声明，由编译器在调用点合成 IR：
;   - assert_eq:<T>(actual, expected)  T ∈ i8..u64 / f32 / f64 / bool（其他类型 E6030）
;   - assert_true(actual bool)
;   - assert_false(actual bool)
;   - fail(msg String)
;
; 失败时编译器合成的 IR 调用本文件 __riu_test_assert_failed()，
; 后者触发自定义 SEH 异常码 0xE0FA17ED；riu test 的 SEH wrapper 翻译为 ASSERT_FAILED。

; `kernel32.RaiseException` 点链对无返回/#NoReturn extern 会 E3091；这里重复声明。
extern {
  #NoReturn
  fn RaiseException(dwExceptionCode u32, dwExceptionFlags u32, nNumberOfArguments u32, lpArguments Ptr<u64>)
}

#Builtin
fn assert_eq<T>(actual T, expected T)

#Builtin
fn assert_true(actual bool)

#Builtin
fn assert_false(actual bool)

#Builtin
fn fail(msg String)

; 0xE0FA17ED：客户位段（高 4 位 0xE）+ "FA17ED" 字面，便于 SEH 串号识别
fn __riu_test_assert_failed() {
  RaiseException(0xE0FA17EDu32, 0, 0, null);
}
