; Ptr/FFI builtin 功能测试
; 覆盖：ptr_of / _ptr_as_ref / _ptr_write / _ptr_offset / ptr_from_addr / to_int
;
; builtin 声明见 sdk/riu/src/riu/core/base.ut

; ---- _ptr_write + _ptr_as_ref (via Rc<i32>) ----

; 验证：Ptr 和 Rc<i32> 之间的转换与解引用
#Test
fn test_ptr_write_and_from_rc() {
  #Mut let x Rc<i32> = 42
  #Mut let p Ptr = ptr_of(x)
  ; _ptr_as_ref 将 Ptr 重新解释为 i32&
  let r i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r, 42)
}

; ---- _ptr_write 写穿 Rc<i32> payload ----

; 验证：通过指针修改 Rc<i32> 的值并读取验证
#Test
fn test_ptr_write_to_rc_payload() {
  #Mut let a Rc<i32> = 10
  #Mut let p Ptr = ptr_of(a)
  _ptr_write:<i32>(p, 77)
  ; _ptr_as_ref 读回
  let r i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r, 77)
}

; ptr_of(String) → _ptr_as_ref 验证：String 经 ptr_of 可正确 round-trip 为 String&
#Test
fn test_ptr_of_string() {
  let s String = "hello"
  #Mut let p Ptr = ptr_of(s)
  let r String& = _ptr_as_ref:<String>(p)
  assert_eq(r, "hello")
}

; ptr_of(Array<T>) → _ptr_as_ref 验证：Array 经 ptr_of 可正确 round-trip 为 Array<T>&
#Test
fn test_ptr_of_array() {
  #Mut let arr Array<i32> = [10, 20, 30]
  #Mut let p Ptr = ptr_of(arr)
  let r Array<i32>& = _ptr_as_ref:<Array<i32>>(p)
  assert_eq(r.len(), 3usize)
  assert_eq(r.get(0usize), 10)
  assert_eq(r.get(1usize), 20)
}

; ---- _ptr_write i32 via Rc（多次写入）----

#Test
fn test_ptr_write_multi() {
  ; 验证：_ptr_write 多次写入同一位置
  #Mut let a Rc<i32> = 0
  #Mut let p Ptr = ptr_of(a)
  _ptr_write:<i32>(p, 42)
  let r1 i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r1, 42)
  _ptr_write:<i32>(p, 99)
  let r2 i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r2, 99)
}

; ---- ptr_of(Rc<T>&) 借用 Rc ----

#Test
fn test_ptr_of_ref() {
  ; 验证：ptr_of 作用于 Rc<T>& 借用
  #Mut let x Rc<i32> = 42
  let r Rc<i32>& = &x
  #Mut let p Ptr = ptr_of(r)
  let r2 i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r2, 42)
}

; ---- ptr_of(T&) 普通引用 ----

#Test
fn test_ptr_of_plain_ref() {
  ; 验证：ptr_of 作用于普通 i32& 引用（非堆句柄包装）
  #Mut let x i32 = 77
  let r i32& = &x
  #Mut let p Ptr = ptr_of(r)
  let r2 i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r2, 77)
}

#Test
fn test_ptr_of_by_addr() {
  ; 验证：ptr_of 直接作用于 &x 取地址表达式
  #Mut let x i32 = 99
  #Mut let p Ptr = ptr_of(&x)
  let r i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r, 99)
}

; ---- same_ref 普通引用 ----

#Test
fn test_same_ref_plain() {
  ; 验证：same_ref 作用于两个 plain i32& 引用
  #Mut let x i32 = 55
  let r1 i32& = &x
  let r2 i32& = &x
  assert_true(same_ref(r1, r2))
}

; ---- ptr_from_addr + to_int roundtrip ----

#Test
fn test_ptr_to_int_roundtrip() {
  ; 验证：ptr_of → to_int → ptr_from_addr → _ptr_as_ref
  #Mut let x Rc<i32> = 99
  #Mut let p Ptr = ptr_of(x)
  let addr u64 = p.to_int()
  let p2 Ptr = ptr_from_addr(addr)
  let r i32& = _ptr_as_ref:<i32>(p2)
  assert_eq(r, 99)
}

; ---- _ptr_offset 基本偏移访问 ----

#Test
fn test_ptr_offset_basic() {
  ; 验证：_ptr_offset 用于相邻字段/元素
  #Mut let a Rc<i32> = 100
  #Mut let p Ptr = ptr_of(a)
  ; 无偏移读回原值
  let r i32& = _ptr_as_ref:<i32>(p)
  assert_eq(r, 100)
}

; ---- ptr_of 多类型覆盖 ----

#Test
fn test_ptr_of_f64() {
  ; 验证：ptr_of 作用于 f64
  #Mut let x Rc<f64> = 3.14f64
  #Mut let p Ptr = ptr_of(x)
  let r f64& = _ptr_as_ref:<f64>(p)
  assert_eq(r, 3.14f64)
}

#Test
fn test_ptr_of_bool() {
  ; 验证：ptr_of 作用于 bool
  #Mut let x Rc<bool> = true
  #Mut let p Ptr = ptr_of(x)
  let r bool& = _ptr_as_ref:<bool>(p)
  assert_eq(r, true)
}

; ==================== 边界测试 ====================

#Test
fn test_ptr_from_addr_zero() {
  ; 验证：ptr_from_addr(0) 生成空指针并安全转回
  let p Ptr = ptr_from_addr(0)
  let addr u64 = p.to_int()
  assert_eq(addr, 0u64)
}

; ---- c_string / from_c_chars：拷贝，不 wrap Ptr（§9.7.2.8）----

#Test
fn test_c_string_from_c_chars_roundtrip() {
  ; ptr_of(T&) 指向 Array<u8> 首字节（带 NUL）；from_c_chars 拷成 String
  #Mut let buf Array<u8> = c_string("hi")
  assert_eq(buf.len(), 3usize)
  assert_eq(buf.get(0usize), 104u8)
  assert_eq(buf.get(1usize), 105u8)
  assert_eq(buf.get(2usize), 0u8)
  let first u8& = buf[0]
  let back String = from_c_chars(ptr_of(first))
  assert_eq(back, "hi")
}

#Test
fn test_c_string_empty() {
  #Mut let buf Array<u8> = c_string("")
  assert_eq(buf.len(), 1usize)
  assert_eq(buf.get(0usize), 0u8)
  let first u8& = buf[0]
  assert_eq(from_c_chars(ptr_of(first)), "")
}

#Test
fn test_from_c_chars_null() {
  assert_eq(from_c_chars(ptr_from_addr(0)), "")
}
