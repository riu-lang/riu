; Map<K, V>：线性查找字典
;
; 覆盖：
;   - i32 → i32：insert / get / contains / remove / 覆盖
;   - String → i32：键比较走 String.eq
;   - i32 → String：值句柄复制
;   - get_or：命中复制值，未命中返回 default
;   - 空 Map、未命中 get/remove、len / is_empty
;   - keys / values / clear；直接 for-in（Indexed<K>），keys() 仍是克隆快照

#Test
fn test_map_i32_insert_get() {
  #Mut let m Map<i32, i32> = Map:<i32, i32>::make()
  assert_true(m.is_empty())
  m.insert(1, 10)
  m.insert(2, 20)
  assert_eq(m.len(), 2)
  assert_true(m.contains(1))
  assert_false(m.contains(3))
  let g1 i32? = m.get(1)
  assert_eq(g1 ?? -1, 10)
  let g2 i32? = m.get(2)
  assert_eq(g2 ?? -1, 20)
  let miss i32? = m.get(3)
  assert_false(miss.has())
  m.insert(1, 99)
  let g1b i32? = m.get(1)
  assert_eq(g1b ?? -1, 99)
  assert_eq(m.len(), 2)
  let r2 i32? = m.remove(2)
  assert_eq(r2 ?? -1, 20)
  assert_false(m.contains(2))
  assert_eq(m.len(), 1)
  let gone i32? = m.remove(2)
  assert_false(gone.has())
}

#Test
fn test_map_string_key() {
  #Mut let m Map<String, i32> = Map:<String, i32>::make()
  m.insert("a", 1)
  m.insert("b", 2)
  assert_eq(m.len(), 2)
  assert_true(m.contains("a"))
  assert_true(m.contains("b"))
  assert_false(m.contains("c"))
  m.insert("a", 9)
  let ga i32? = m.get("a")
  assert_eq(ga ?? 0, 9)
  assert_true(m.remove("b").has())
  assert_false(m.contains("b"))
  assert_eq(m.len(), 1)
}

#Test
fn test_map_string_value() {
  #Mut let m Map<i32, String> = Map:<i32, String>::make()
  m.insert(1, "one")
  m.insert(2, "two")
  let v1 String? = m.get(1)
  assert_eq(v1 ?? "", "one")
  let r2 String? = m.remove(2)
  assert_eq(r2 ?? "", "two")
  assert_false(m.contains(2))
  assert_eq(m.len(), 1)
}

#Test
fn test_map_get_or() {
  #Mut let ints Map<i32, i32> = Map:<i32, i32>::make()
  ints.insert(1, 10)
  assert_eq(ints.get_or(1, -1), 10)
  assert_eq(ints.get_or(9, -1), -1)

  #Mut let strings Map<i32, String> = Map:<i32, String>::make()
  strings.insert(1, "one")
  let fallback String = "missing"
  assert_eq(strings.get_or(1, fallback), "one")
  assert_eq(strings.get_or(9, fallback), "missing")
  assert_eq(fallback, "missing")
}

#Test
fn test_map_keys_values_clear() {
  #Mut let m Map<i32, i32> = Map:<i32, i32>::make()
  m.insert(1, 10)
  m.insert(2, 20)
  m.insert(3, 30)
  let ks Array<i32> = m.keys()
  assert_eq(ks.len(), 3)
  #Mut let sum_k i32 = 0
  for k in ks {
    sum_k = sum_k + k
  }
  assert_eq(sum_k, 6)
  let vs Array<i32> = m.values()
  assert_eq(vs.len(), 3)
  #Mut let sum_v i32 = 0
  for v in vs {
    sum_v = sum_v + v
  }
  assert_eq(sum_v, 60)
  m.clear()
  assert_true(m.is_empty())
  assert_eq(m.len(), 0)
  assert_false(m.contains(1))
}

; 验证：Map 直接 for-in（Indexed<K>），不经 keys()
#Test
fn test_map_for_in() {
  #Mut let m Map<i32, i32> = Map:<i32, i32>::make()
  m.insert(1, 10)
  m.insert(2, 20)
  m.insert(3, 30)
  #Mut let sum_k i32 = 0
  #Mut let sum_v i32 = 0
  for k in m {
    sum_k = sum_k + k
    sum_v = sum_v + m.get_or(k, 0)
  }
  assert_eq(sum_k, 6)
  assert_eq(sum_v, 60)
}

; 验证：空 Map 直接 for-in 零轮
#Test
fn test_map_for_in_empty() {
  let m Map<i32, i32> = Map:<i32, i32>::make()
  #Mut let n i32 = 0
  for k in m {
    n = n + 1
  }
  assert_eq(n, 0)
}

; 验证：Map for-in 的 item 是 K&，写穿键槽
#Test
fn test_map_for_in_write_through() {
  #Mut let m Map<i32, i32> = Map:<i32, i32>::make()
  m.insert(1, 10)
  for k in m {
    k = k + 100
  }
  assert_true(m.contains(101))
  assert_false(m.contains(1))
  assert_eq(m.get_or(101, 0), 10)
}

; 验证：String 键 Map 直接 for-in
#Test
fn test_map_for_in_string_key() {
  #Mut let m Map<String, i32> = Map:<String, i32>::make()
  m.insert("a", 1)
  m.insert("b", 2)
  #Mut let n i32 = 0
  for k in m {
    n = n + m.get_or(k, 0)
  }
  assert_eq(n, 3)
}
