; 生成，勿手改。
; 目标 x86_64-pc-windows-msvc；WINVER/_WIN32_WINNT=0x0A00；NTDDI_VERSION=0x0A00000D（Win10 CU）
; clang sizeof/alignof 对照 riu size_of / align_of

use riu.platform.windows.types.*

#Test
fn test_win32_struct_layout() {
  assert_eq(size_of:<MEMORYSTATUSEX>(), 64u64)
  assert_eq(align_of:<MEMORYSTATUSEX>(), 8u64)
  assert_eq(size_of:<GROUP_AFFINITY>(), 16u64)
  assert_eq(align_of:<GROUP_AFFINITY>(), 8u64)
  assert_eq(size_of:<SRWLOCK>(), 8u64)
  assert_eq(align_of:<SRWLOCK>(), 8u64)
  assert_eq(size_of:<OSVERSIONINFOW>(), 276u64)
  assert_eq(align_of:<OSVERSIONINFOW>(), 4u64)
  assert_eq(size_of:<PROCESSOR_NUMBER>(), 4u64)
  assert_eq(align_of:<PROCESSOR_NUMBER>(), 2u64)
  assert_eq(size_of:<FILETIME>(), 8u64)
  assert_eq(align_of:<FILETIME>(), 4u64)
  assert_eq(size_of:<WIN32_FIND_DATAW>(), 592u64)
  assert_eq(align_of:<WIN32_FIND_DATAW>(), 4u64)
  assert_eq(size_of:<MEMORY_BASIC_INFORMATION>(), 48u64)
  assert_eq(align_of:<MEMORY_BASIC_INFORMATION>(), 8u64)
  assert_eq(size_of:<SECURITY_ATTRIBUTES>(), 24u64)
  assert_eq(align_of:<SECURITY_ATTRIBUTES>(), 8u64)
  assert_eq(size_of:<CREATEFILE2_EXTENDED_PARAMETERS>(), 32u64)
  assert_eq(align_of:<CREATEFILE2_EXTENDED_PARAMETERS>(), 8u64)
  assert_eq(size_of:<BY_HANDLE_FILE_INFORMATION>(), 52u64)
  assert_eq(align_of:<BY_HANDLE_FILE_INFORMATION>(), 4u64)
  assert_eq(size_of:<PROCESS_INFORMATION>(), 24u64)
  assert_eq(align_of:<PROCESS_INFORMATION>(), 8u64)
  assert_eq(size_of:<CONDITION_VARIABLE>(), 8u64)
  assert_eq(align_of:<CONDITION_VARIABLE>(), 8u64)
  assert_eq(size_of:<OVERLAPPED>(), 32u64)
  assert_eq(align_of:<OVERLAPPED>(), 8u64)
  assert_eq(size_of:<OVERLAPPED_ENTRY>(), 32u64)
  assert_eq(align_of:<OVERLAPPED_ENTRY>(), 8u64)
  assert_eq(size_of:<SYSTEM_INFO>(), 48u64)
  assert_eq(align_of:<SYSTEM_INFO>(), 8u64)
  assert_eq(size_of:<SYSTEMTIME>(), 16u64)
  assert_eq(align_of:<SYSTEMTIME>(), 2u64)
  assert_eq(size_of:<STARTUPINFOW>(), 104u64)
  assert_eq(align_of:<STARTUPINFOW>(), 8u64)
  assert_eq(size_of:<GUID>(), 16u64)
  assert_eq(align_of:<GUID>(), 4u64)
  assert_eq(size_of:<WIN32_FILE_ATTRIBUTE_DATA>(), 36u64)
  assert_eq(align_of:<WIN32_FILE_ATTRIBUTE_DATA>(), 4u64)
  assert_eq(size_of:<CRITICAL_SECTION>(), 40u64)
  assert_eq(align_of:<CRITICAL_SECTION>(), 8u64)
  assert_eq(size_of:<WIN32_MEMORY_RANGE_ENTRY>(), 16u64)
  assert_eq(align_of:<WIN32_MEMORY_RANGE_ENTRY>(), 8u64)
  assert_eq(size_of:<LARGE_INTEGER>(), 8u64)
  assert_eq(align_of:<LARGE_INTEGER>(), 8u64)
  assert_eq(size_of:<LARGE_INTEGER_Parts>(), 8u64)
  assert_eq(align_of:<LARGE_INTEGER_Parts>(), 8u64)
  assert_eq(size_of:<ULARGE_INTEGER>(), 8u64)
  assert_eq(align_of:<ULARGE_INTEGER>(), 8u64)
  assert_eq(size_of:<ULARGE_INTEGER_Parts>(), 8u64)
  assert_eq(align_of:<ULARGE_INTEGER_Parts>(), 8u64)
}

#Test
fn test_win32_handle_ptr_size() {
  assert_eq(size_of:<HANDLE>(), 8u64)
  assert_eq(size_of:<LPCWSTR>(), 8u64)
  assert_eq(size_of:<LPDWORD>(), 8u64)
  assert_eq(size_of:<LPVOID>(), 8u64)
  #Mut let h HANDLE = null
  #Mut let p LPCWSTR = null
  #Mut let d LPDWORD = null
  assert_eq(h.to_int(), 0u64)
  assert_eq(p.to_int(), 0u64)
  assert_eq(d.to_int(), 0u64)
}

