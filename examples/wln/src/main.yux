; wln — 替代 CMD mklink。自动判断文件/目录软链；目录软链无权限时改 junction。
; 运行：cd examples/wln && yux build
;       ./build/wln.exe --help
;       ./build/wln.exe 目标路径

use yux.io.*

fn _print_help() {
  println("Auto make link")
  println("")
  println("Usage: wln.exe [OPTIONS] <PATH>")
  println("")
  println("Arguments:")
  println("  <PATH>  Target path")
  println("")
  println("Options:")
  println("  -f, --force        Delete existing link/file/directory then create")
  println("  -y, --yes          Confirm --force without prompting")
  println("  -H, --hard         Create a hard link (files only)")
  println("  -j, --junction     Create a directory junction (directories only)")
  println("  -n, --name <NAME>  Link name in the current directory (default: target file name)")
  println("  -h, --help         Print help")
  println("  -V, --version      Print version")
}

fn _die(msg String&) {
  eprintln(msg)
  exit(1)
}

fn _is_priv(e IoErr) bool {
  match e {
    IoErr::AccessDenied => true
    IoErr::Other(code) => code == 1314u32
    IoErr::Eof => false
    IoErr::NotFound => false
    IoErr::InvalidUtf8 => false
    IoErr::Closed => false
  }
}

fn _confirm(msg String&) bool {
  print("${msg}? Y/N :")
  let line String = try {
    read_line()
  } catch e IoErr {
    ret false
  }
  let t String = line.trim()
  ret t == "y" || t == "Y"
}

fn _link_file(target File&, name String?) File {
  if name.has() {
    let n String = name ?? ""
    ret File::from(&n)
  }
  let file String = target.path().name()
  if file.is_empty() || file == "." || file == ".." {
    ret copy_of:<File>(target)
  }
  File::from(&file)
}

fn _prepare(file File&, force bool, yes bool) {
  if !file.exists() {
    ret;
  }
  if !force {
    _die("Already exists: ${file} (use -f to replace)")
  }
  if !yes && !_confirm("Already exists: ${file}, delete") {
    _die("Cancelled")
  }
  try {
    file.remove_all()
  } catch e IoErr {
    _die("Cannot remove ${file}: ${io_err_text(e)}")
  }
  if !yes {
    println("Deleted: ${file}")
  }
}

struct Args {
  force bool
  yes bool
  hard bool
  junction bool
  name String?
  path Path
}

fn main() {
  let argv Array<String> = args()
  let empty String = ""
  #Mut let a Args = Args {
    .force = false
    .yes = false
    .hard = false
    .junction = false
    .name = null
    .path = Path::from(&empty)
  }
  #Mut let i usize = 1
  loop {
    if i >= argv.len() {
      break;
    }
    let s String = copy_of(argv[i])
    if s == "-h" || s == "--help" {
      _print_help()
      exit(0)
    }
    if s == "-V" || s == "--version" {
      println("wln 2.0.0")
      exit(0)
    }
    if s == "-f" || s == "--force" {
      a.force = true
      i += 1
      continue;
    }
    if s == "-y" || s == "--yes" {
      a.yes = true
      i += 1
      continue;
    }
    if s == "-H" || s == "--hard" {
      a.hard = true
      i += 1
      continue;
    }
    if s == "-j" || s == "--junction" {
      a.junction = true
      i += 1
      continue;
    }
    if s == "-n" || s == "--name" {
      i += 1
      if i >= argv.len() {
        _die("Missing value for ${s}")
      }
      a.name = copy_of(argv[i])
      i += 1
      continue;
    }
    if s.starts_with("--name=") {
      a.name = s.slice_from(7)
      i += 1
      continue;
    }
    if s.len() > 2 && s.get(0) == c'-' && s.get(1) != c'-' {
      #Mut let k usize = 1
      loop {
        if k >= s.len() {
          break;
        }
        let ch u32 = s.get(k)
        if ch == c'f' {
          a.force = true
        } elif ch == c'y' {
          a.yes = true
        } elif ch == c'H' {
          a.hard = true
        } elif ch == c'j' {
          a.junction = true
        } elif ch == c'n' {
          if k + 1 < s.len() {
            a.name = s.slice_from(k + 1)
            k = s.len()
          } else {
            i += 1
            if i >= argv.len() {
              _die("Missing value for -n")
            }
            a.name = copy_of(argv[i])
            k = s.len()
          }
        } elif ch == c'h' {
          _print_help()
          exit(0)
        } elif ch == c'V' {
          println("wln 2.0.0")
          exit(0)
        } else {
          _die("Unknown option: -${String::from_codepoint(ch)}")
        }
        k += 1
      }
      i += 1
      continue;
    }
    if s.starts_with("-") {
      _die("Unknown option: ${s}")
    }
    if !a.path.is_empty() {
      _die("Unexpected argument: ${s}")
    }
    a.path = Path::from(&s)
    i += 1
  }

  if a.path.is_empty() {
    eprintln("Missing required argument: <PATH>")
    _print_help()
    exit(1)
  }
  if a.hard && a.junction {
    _die("Cannot use --junction with --hard")
  }

  let target File = File::at(&a.path)
  if !target.exists() {
    _die("Target does not exist: ${target}")
  }

  let link File = _link_file(&target, a.name)
  if target.same_as(&link) {
    _die("Link path cannot be the target itself: ${link}")
  }

  _prepare(&link, a.force, a.yes);

  if a.hard {
    if target.is_dir() {
      _die("Hard link is only supported for files")
    }
    try {
      link.hardlink_to(&target)
    } catch e IoErr {
      _die("Create link failed: ${io_err_text(e)}")
    }
    ret;
  }
  if a.junction {
    if !target.is_dir() {
      _die("Junction is only supported for directories")
    }
    try {
      link.junction_to(&target)
    } catch e IoErr {
      _die("Create link failed: ${io_err_text(e)}")
    }
    ret;
  }
  try {
    link.symlink_to(&target)
  } catch e IoErr {
    if target.is_dir() && _is_priv(e) {
      eprintln("Directory symlink failed (${io_err_text(e)}), falling back to junction")
      if link.exists() {
        try {
          link.remove_all()
        } catch e2 IoErr {
          _die("Create link failed: ${io_err_text(e2)}")
        }
      }
      try {
        link.junction_to(&target)
      } catch e3 IoErr {
        _die("Create link failed: ${io_err_text(e3)}")
      }
      ret;
    }
    _die("Create link failed: ${io_err_text(e)}")
  }
}
