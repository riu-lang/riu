; wln — 替代 CMD mklink。自动判断文件/目录软链；目录软链无权限时改 junction。
; 运行：cd examples/wln && yux build
;       ./build/wln.exe --help
;       ./build/wln.exe 目标路径

use yux.io.*

fn _print_help() {
  println("Auto make link")
  println("")
  println("Usage: wln.exe [OPTIONS] <PATH>")
  println("")
  println("Arguments:")
  println("  <PATH>  Target path")
  println("")
  println("Options:")
  println("  -f, --force        Delete existing link/file/directory then create")
  println("  -y, --yes          Confirm --force without prompting")
  println("  -H, --hard         Create a hard link (files only)")
  println("  -j, --junction     Create a directory junction (directories only)")
  println("  -n, --name <NAME>  Link name in the current directory (default: target file name)")
  println("  -h, --help         Print help")
  println("  -V, --version      Print version")
}

fn _ch_str(cp u32) String {
  #Mut let buf Array<u32> = []
  buf.push(cp)
  ret String::from(&buf)
}

fn _slice_from(s String&, start usize) String {
  #Mut let buf Array<u32> = []
  loop i usize = start {
    if i >= s.len() {
      break;
    }
    buf.push(s.get(i))
    i += 1
  }
  ret String::from(&buf)
}

fn _err_text(e IoErr) String {
  match e {
    IoErr::Eof => "Eof"
    IoErr::NotFound => "NotFound"
    IoErr::AccessDenied => "AccessDenied"
    IoErr::InvalidUtf8 => "InvalidUtf8"
    IoErr::Other(code) => "Win32 ${code}"
  }
}

fn _die(msg String&) {
  eprintln(msg)
  exit(1)
}

fn _is_priv(e IoErr) bool {
  match e {
    IoErr::AccessDenied => true
    IoErr::Other(code) => code == 1314u32
    IoErr::Eof => false
    IoErr::NotFound => false
    IoErr::InvalidUtf8 => false
  }
}

fn _confirm(msg String&) bool {
  print("${msg}? Y/N :")
  let line String = try {
    read_line()
  } catch e IoErr {
    ret false
  }
  let t String = line.trim()
  ret t == "y" || t == "Y"
}

fn _same_path(a String&, b String&) bool {
  let na String = try {
    abs(a)
  } catch e IoErr {
    ret a.to_lower() == b.to_lower()
  }
  let nb String = try {
    abs(b)
  } catch e IoErr {
    ret a.to_lower() == b.to_lower()
  }
  ret na.to_lower() == nb.to_lower()
}

fn _link_name(target String&, has_name bool, name String&) String {
  if has_name {
    ret name.to_string()
  }
  let file String = basename(target)
  if file.is_empty() || file == "." || file == ".." {
    ret target.to_string()
  }
  ret file
}

fn _prepare(path String&, force bool, yes bool) {
  if !exists(path) {
    ret;
  }
  if !force {
    _die("Already exists: ${path} (use -f to replace)")
  }
  if !yes && !_confirm("Already exists: ${path}, delete") {
    _die("Cancelled")
  }
  try {
    remove_all(path)
  } catch e IoErr {
    _die("Cannot remove ${path}: ${_err_text(e)}")
  }
  if !yes {
    println("Deleted: ${path}")
  }
}

fn _make_symlink(target String&, link String&) {
  try {
    symlink(target, link)
  } catch e IoErr {
    if is_dir(target) && _is_priv(e) {
      eprintln("Directory symlink failed (${_err_text(e)}), falling back to junction")
      if exists(link) {
        try {
          remove_all(link)
        } catch e2 IoErr {
          _die("Create link failed: ${_err_text(e2)}")
        }
      }
      try {
        junction(target, link)
      } catch e3 IoErr {
        _die("Create link failed: ${_err_text(e3)}")
      }
      ret;
    }
    _die("Create link failed: ${_err_text(e)}")
  }
}

struct Args {
  force bool
  yes bool
  hard bool
  junction bool
  has_name bool
  name String
  path String
}

fn main() {
  let argv Array<String> = args()
  #Mut let a Args = Args {
    .force = false
    .yes = false
    .hard = false
    .junction = false
    .has_name = false
    .name = ""
    .path = ""
  }
  #Mut let i usize = 1
  loop {
    if i >= argv.len() {
      break;
    }
    let s String = copy_of(argv[i])
    if s == "-h" || s == "--help" {
      _print_help()
      exit(0)
    }
    if s == "-V" || s == "--version" {
      println("wln 2.0.0")
      exit(0)
    }
    if s == "-f" || s == "--force" {
      a.force = true
      i += 1
      continue;
    }
    if s == "-y" || s == "--yes" {
      a.yes = true
      i += 1
      continue;
    }
    if s == "-H" || s == "--hard" {
      a.hard = true
      i += 1
      continue;
    }
    if s == "-j" || s == "--junction" {
      a.junction = true
      i += 1
      continue;
    }
    if s == "-n" || s == "--name" {
      i += 1
      if i >= argv.len() {
        _die("Missing value for ${s}")
      }
      a.has_name = true
      a.name = copy_of(argv[i])
      i += 1
      continue;
    }
    if s.starts_with("--name=") {
      a.has_name = true
      a.name = _slice_from(&s, 7)
      i += 1
      continue;
    }
    if s.len() > 2 && s.get(0) == c'-' && s.get(1) != c'-' {
      #Mut let k usize = 1
      loop {
        if k >= s.len() {
          break;
        }
        let ch u32 = s.get(k)
        if ch == c'f' {
          a.force = true
        } elif ch == c'y' {
          a.yes = true
        } elif ch == c'H' {
          a.hard = true
        } elif ch == c'j' {
          a.junction = true
        } elif ch == c'n' {
          if k + 1 < s.len() {
            a.has_name = true
            a.name = _slice_from(&s, k + 1)
            k = s.len()
          } else {
            i += 1
            if i >= argv.len() {
              _die("Missing value for -n")
            }
            a.has_name = true
            a.name = copy_of(argv[i])
            k = s.len()
          }
        } elif ch == c'h' {
          _print_help()
          exit(0)
        } elif ch == c'V' {
          println("wln 2.0.0")
          exit(0)
        } else {
          _die("Unknown option: -${_ch_str(ch)}")
        }
        k += 1
      }
      i += 1
      continue;
    }
    if s.starts_with("-") {
      _die("Unknown option: ${s}")
    }
    if a.path.len() != 0 {
      _die("Unexpected argument: ${s}")
    }
    a.path = s
    i += 1
  }

  if a.path.len() == 0 {
    eprintln("Missing required argument: <PATH>")
    _print_help()
    exit(1)
  }
  if a.hard && a.junction {
    _die("Cannot use --junction with --hard")
  }
  if !exists(&a.path) {
    _die("Target does not exist: ${a.path}")
  }

  let link String = _link_name(&a.path, a.has_name, &a.name)
  if _same_path(&a.path, &link) {
    _die("Link path cannot be the target itself: ${link}")
  }

  _prepare(&link, a.force, a.yes);

  if a.hard {
    if is_dir(&a.path) {
      _die("Hard link is only supported for files")
    }
    try {
      hardlink(&a.path, &link)
    } catch e IoErr {
      _die("Create link failed: ${_err_text(e)}")
    }
    ret;
  }
  if a.junction {
    if !is_dir(&a.path) {
      _die("Junction is only supported for directories")
    }
    try {
      junction(&a.path, &link)
    } catch e IoErr {
      _die("Create link failed: ${_err_text(e)}")
    }
    ret;
  }
  _make_symlink(&a.path, &link)
}
