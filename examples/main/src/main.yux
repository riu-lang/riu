use yux.core.*

struct N {
  v i32
}

N {

  fn N(v i32) {
    self.v = v
  }

  ; 算术运算符
  fn plus(other N) N {
    N(self.v + other.v)
  }
}


fn main() {
  println("=== Nullable 烟测 ===")
  var nx i32? = 42i32
  var ny i32? = null

  ; ?? 默认值运算符
  var a i32 = nx ?? -1i32
  println(a.to_string())          ; 期望 42

  var b i32 = ny ?? -1i32
  println(b.to_string())          ; 期望 -1

  ; ?. 安全字段访问 (base 是 Nullable<N>，N 有字段 v)
  var n N = N(7)
  var maybeN N? = n
  var v1 i32? = maybeN?.v         ; 应为持值 7
  var v1d i32 = v1 ?? -1i32
  println(v1d.to_string())        ; 期望 7

  var emptyN N? = null
  var v2 i32? = emptyN?.v         ; 应为空
  var v2d i32 = v2 ?? -99i32
  println(v2d.to_string())        ; 期望 -99

  println("=== 测试完成 ===")
}
