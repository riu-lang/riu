use yux.core.*

struct N {
  v i32
}

N {

  fn N(v i32) {
    self.v = v
  }

  ; 算术运算符
  fn plus(other N) N {
    N(self.v + other.v)
  }
}


fn main() {
  println("=== 调用语法糖测试 ===")
  var n N = N(1)
  var n2 N = N(2)
  var n3 = n.plus(n2)
  println(n3.v.to_string())
  var a = 1
  println((a + 2).to_string())
  var b = a.plus(2)
  println(b.to_string())
  println("=== 测试完成 ===")
}
