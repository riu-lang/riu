; cat — 把文件内容写到 stdout（UTF-8）
; 运行：cd examples/cat && riu build && ./build/cat.exe 某文件.txt

use riu.io.*

fn main() {
  let a Array<String> = args()
  if a.len() < 2 {
    eprintln("usage: cat <file>")
    exit(1)
  }
  let path String = copy_of(a[1])
  try {
    let s String = read_file(&path)
    print(s)
  } catch e IoErr {
    eprintln("cat: cannot read file")
    exit(1)
  }
}
