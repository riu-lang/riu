; lambdas.yux — Lambda/闭包示例：四种 lambda 形态、捕获、高阶函数
; 对照 docs/Lambda与闭包.md
use yux.core.*

; ==================== 辅助类型 ====================

struct Counter {
  value i32

  #Static
  fn make(v i32) Counter {
    ret Self {
      .value = v
    }
  }

  fn inc() {
    $.value = $.value + 1
  }

  fn get() i32 {
    ret $.value
  }
}

; ==================== Lambda 形态 ====================

fn demo_lambda_forms() {
  println("=== Lambda 四种形态 ===")

  ; 1. 表达式形（多参，完整声明）
  let add = (a i32, b i32) i32 => a + b
  let sum i32 = add(3, 5)
  println("add(3, 5): ")
  println(sum)

  ; 2. 单参省括号（完整形）
  let inc = (x i32) i32 => x + 1
  println("inc(41): ")
  println(inc(41))

  ; 3. 单参裸 single（类型由上下文推断）
  ; 存入 fn(i32)i32 类型变量
  #Mut let double_fn fn(i32)i32 = x => x * 2
  println("double(21): ")
  println(double_fn(21))

  ; 4. 表达式体含 loop 的 lambda（用 = expr 省去块体换行，内部 if/loop 自成块）
  ; 注：块形 lambda `{ a, b => ... }` 的返回类型需上下文推断，无上下文时建议用表达式形
  ;     文档中块形的显式返回类型写法 `{ (a,b) i32 => ... }` 当前 parser 不接受
  let mul = (a i32, b i32) i32 => a * b
  println("mul(6, 7): ")
  println(mul(6, 7))
}

; ==================== Lambda 含 if/match 表达式体 ====================

fn demo_lambda_expr_body() {
  println("=== Lambda 含 if/match 表达式体 ===")

  ; if 表达式体
  let abs = (x i32) i32 => if x < 0 { -x } else { x }
  println("abs(-5): ")
  println(abs(-5))
  println("abs(3): ")
  println(abs(3))
}

; ==================== 闭包捕获 ====================

fn demo_closure_capture_scalar() {
  println("=== 闭包：标量值复制捕获 ===")

  ; 捕获外部标量（值复制）
  let n i32 = 10
  let add_n = (x i32) i32 => x + n
  println("add_n(5) where n=10: ")
  println(add_n(5))

  ; 捕获后修改外层不影响已捕获副本
  ; 注：lambda 内不能对捕获变量赋值（E2030）
}

fn demo_closure_capture_rc() {
  println("=== 闭包：Rc 句柄 retain 捕获 ===")

  let rc Rc<Counter> = Counter::make(0)
  ; 捕获 Rc<Counter>（retain），调用 mutator 方法
  let inc = () => rc.inc()
  inc()
  inc()
  println("counter after 2 incs (via closure): ")
  println(rc.get())
}

; ==================== 高阶函数 ====================

; 接受函数值作为参数
fn apply_i32(x i32, f fn(i32)i32) i32 {
  ret f(x)
}

fn demo_higher_order() {
  println("=== 高阶函数 ===")

  let triple i32 = apply_i32(7, x => x * 3)
  println("apply_i32(7, x => x*3): ")
  println(triple)

  ; 匿名 lambda 直接传参
  let square i32 = apply_i32(5, (x i32) i32 => x * x)
  println("apply_i32(5, square): ")
  println(square)
}

; ==================== Lambda 作为返回值 ====================

fn make_adder(n i32) fn(i32)i32 {
  ret (x i32) i32 => x + n    ; 捕获 n（值复制）
}

fn demo_returning_lambda() {
  println("=== Lambda 作为返回值 ===")

  let add5 fn(i32)i32 = make_adder(5)
  let add10 fn(i32)i32 = make_adder(10)
  println("add5(1): ")
  println(add5(1))
  println("add10(1): ")
  println(add10(1))
}

; ==================== 主入口 ====================

fn run_lambdas() {
  demo_lambda_forms()
  demo_lambda_expr_body()
  demo_closure_capture_scalar()
  demo_closure_capture_rc()
  demo_higher_order()
  demo_returning_lambda()
  println("=== lambdas 完成 ===")
}
