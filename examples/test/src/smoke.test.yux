; Phase 4a 冒烟测试：验证 #Test 收集 + 断言 API + JIT + SEH
;
; 运行：
;   cd examples/test
;   yux test smoke

#Test
fn test_pass() {
  ; 空体即视为通过
}

#Test
fn test_print() {
  println("hello from test_print")
}

#Test
fn test_assert_eq_int() {
  assert_eq(1 + 2, 3)
  assert_eq(10i64 - 5i64, 5i64)
  assert_eq(0u32, 0u32)
}

#Test
fn test_assert_eq_float() {
  assert_eq(1.0f64 + 2.0f64, 3.0f64)
}

#Test
fn test_assert_eq_bool() {
  assert_eq(true, true)
  assert_eq(false, false)
}

#Test
fn test_assert_true_false() {
  assert_true(true)
  assert_false(false)
  assert_true(1 == 1)
  assert_false(1 == 2)
}

; 失败用例：选择器精确匹配运行时单独验证
#Test
fn test_eq_fails() {
  assert_eq(1, 2)
}

#Test
fn test_true_fails() {
  assert_true(false)
}

#Test
fn test_fail_called() {
  fail("explicit fail")
}

; ==================== Phase 4b：String 断言 ====================

#Test
fn test_assert_eq_string_pass() {
  val a String = "hello"
  val b String = "hello"
  assert_eq(a, b)
  assert_eq(a, "hello")
  val empty1 String = ""
  val empty2 String = ""
  assert_eq(empty1, empty2)
}

#Test
fn test_assert_contains_pass() {
  val s String = "hello world"
  assert_contains(s, "hello")
  assert_contains(s, "world")
  assert_contains(s, "o w")
  assert_contains(s, "")
}

#Test
fn test_assert_starts_with_pass() {
  val s String = "hello world"
  assert_starts_with(s, "hello")
  assert_starts_with(s, "")
  assert_starts_with(s, "hello world")
}

; 失败用例：经过 yux 助手帧 (testFn → yux assert_eq → _yux_test_assert_failed)
; 验证 LLJIT SEH .pdata 注册修复后的跨帧 unwind

#Test
fn test_assert_eq_string_fails() {
  val a String = "foo"
  val b String = "bar"
  assert_eq(a, b)
}

#Test
fn test_assert_contains_fails() {
  val s String = "hello"
  assert_contains(s, "world")
}

#Test
fn test_assert_starts_with_fails() {
  val s String = "hello"
  assert_starts_with(s, "world")
}
