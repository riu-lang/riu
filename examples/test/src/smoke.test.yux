; smoke.test.yux — 示例项目测试
; 运行：cd examples/test && yux test

use yux.core.*

; ---- 测试用类型定义 ----

struct Vec2 {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn plus(other Vec2&) Vec2 {
    Vec2::make($.x + other.x, $.y + other.y)
  }

  fn minus(other Vec2&) Vec2 {
    Vec2::make($.x - other.x, $.y - other.y)
  }

  fn mul(scalar f64) Vec2 {
    Vec2::make($.x * scalar, $.y * scalar)
  }

  fn eq(other Vec2&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Vec2&) bool {
    !$.eq(&other)
  }
}

enum Color {
  Red
  Green
  Blue
}

struct Point {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }
}

; ==================== Vec2 运算符 ====================

#Test
fn test_vec2_add() {
  let a Vec2 = Vec2::make(1.0, 2.0)
  let b Vec2 = Vec2::make(3.0, 4.0)
  let c Vec2 = a + b
  assert_eq(c.x, 4.0)
  assert_eq(c.y, 6.0)
}

#Test
fn test_vec2_sub() {
  let a Vec2 = Vec2::make(5.0, 3.0)
  let b Vec2 = Vec2::make(2.0, 1.0)
  let c Vec2 = a - b
  assert_eq(c.x, 3.0)
  assert_eq(c.y, 2.0)
}

#Test
fn test_vec2_mul_scalar() {
  let v Vec2 = Vec2::make(2.0, 3.0)
  let w Vec2 = v * 4.0
  assert_eq(w.x, 8.0)
  assert_eq(w.y, 12.0)
}

#Test
fn test_vec2_eq_ne() {
  let a Vec2 = Vec2::make(1.0, 2.0)
  let b Vec2 = Vec2::make(1.0, 2.0)
  assert_true(a == b)
  assert_true(a != Vec2::make(3.0, 4.0))
}

; ==================== 枚举 + match ====================

fn color_name(c Color) String {
  match c {
    Color::Red   => "red"
    Color::Green => "green"
    Color::Blue  => "blue"
  }
}

#Test
fn test_enum_match() {
  assert_eq(color_name(Color::Red), "red")
  assert_eq(color_name(Color::Green), "green")
  assert_eq(color_name(Color::Blue), "blue")
}

; ==================== Array<T> ====================

#Test
fn test_array_push_len() {
  #Mut let a Array<i32> = []
  assert_eq(a.len(), 0i64)
  a.push(10)
  a.push(20)
  a.push(30)
  assert_eq(a.len(), 3i64)
}

#Test
fn test_array_at() {
  #Mut let a Array<i32> = [10, 20, 30]
  assert_eq(a.at(0), 10)
  assert_eq(a.at(1), 20)
  assert_eq(a.at(2), 30)
}

#Test
fn test_array_index() {
  #Mut let a Array<i32> = [100, 200]
  assert_eq(a[0], 100)
  assert_eq(a[1], 200)
}

; ==================== Nullable ====================

#Test
fn test_nullable_some() {
  let x i32? = 42i32
  assert_true(x.has())
  assert_eq(x.get(), 42)
}

#Test
fn test_null_coalesce() {
  let some i32? = 7i32
  assert_eq(some ?? 0i32, 7)
  let none i32? = null
  assert_eq(none ?? 99i32, 99)
}

#Test
fn test_safe_field_access() {
  let p Point = Point::make(1, 2)
  let maybe Point? = p
  let xval i32? = maybe?.x
  assert_eq(xval ?? 0i32, 1)
  let none Point? = null
  let nxval i32? = none?.x
  assert_eq(nxval ?? 99i32, 99)
}

; ==================== Move 语义 ====================

#Test
fn test_move_assign_swap() {
  #Mut let a String = "first"
  #Mut let b String = "second"
  let old String = a <- b
  assert_eq(old, "first")
  assert_eq(a, "second")
  assert_eq(b, "second")
}

#Test
fn test_move_assign_array() {
  #Mut let xs Array<i32> = [1, 2, 3]
  let old Array<i32> = xs <- []
  assert_eq(old.len(), 3i64)
  assert_eq(xs.len(), 0i64)
}

; ==================== StringBuilder ====================

#Test
fn test_stringbuilder_build() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(79u32)       ; 'O'
  sb.append(75u32)       ; 'K'
  assert_eq(sb.build(), "OK")
}

#Test
fn test_stringbuilder_empty() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.build(), "")
}

; ==================== 基本断言 ====================

#Test
fn test_assert_eq_int() {
  assert_eq(1 + 2, 3)
}

#Test
fn test_assert_eq_float() {
  assert_eq(1.5 + 2.5, 4.0)
}

#Test
fn test_assert_eq_bool() {
  assert_true(1 < 2)
  assert_false(3 < 2)
}
