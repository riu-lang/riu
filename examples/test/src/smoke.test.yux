; smoke.test.yux — 示例项目测试
; 运行：cd examples/test && yux test

use yux.core.*

; ---- 测试用类型定义 ----

struct Vec2 {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn plus(other Vec2&) Vec2 {
    Vec2::make($.x + other.x, $.y + other.y)
  }

  fn minus(other Vec2&) Vec2 {
    Vec2::make($.x - other.x, $.y - other.y)
  }

  fn mul(scalar f64) Vec2 {
    Vec2::make($.x * scalar, $.y * scalar)
  }

  fn eq(other Vec2&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Vec2&) bool {
    !$.eq(&other)
  }
}

enum Color {
  Red
  Green
  Blue
}

struct Point {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }
}

; ==================== Vec2 运算符 ====================

#Test
fn test_vec2_add() {
  let a Vec2 = Vec2::make(1.0, 2.0)
  let b Vec2 = Vec2::make(3.0, 4.0)
  let c Vec2 = a + b
  assert_eq(c.x, 4.0)
  assert_eq(c.y, 6.0)
}

#Test
fn test_vec2_sub() {
  let a Vec2 = Vec2::make(5.0, 3.0)
  let b Vec2 = Vec2::make(2.0, 1.0)
  let c Vec2 = a - b
  assert_eq(c.x, 3.0)
  assert_eq(c.y, 2.0)
}

#Test
fn test_vec2_mul_scalar() {
  let v Vec2 = Vec2::make(2.0, 3.0)
  let w Vec2 = v * 4.0
  assert_eq(w.x, 8.0)
  assert_eq(w.y, 12.0)
}

#Test
fn test_vec2_eq_ne() {
  let a Vec2 = Vec2::make(1.0, 2.0)
  let b Vec2 = Vec2::make(1.0, 2.0)
  assert_true(a == b)
  assert_true(a != Vec2::make(3.0, 4.0))
}

; ==================== 枚举 + match ====================

fn color_name(c Color) String {
  match c {
    Color::Red   => "red"
    Color::Green => "green"
    Color::Blue  => "blue"
  }
}

#Test
fn test_enum_match() {
  assert_eq(color_name(Color::Red), "red")
  assert_eq(color_name(Color::Green), "green")
  assert_eq(color_name(Color::Blue), "blue")
}

; ==================== Array<T> ====================

#Test
fn test_array_push_len() {
  #Mut let a Array<i32> = []
  assert_eq(a.len(), 0)
  a.push(10)
  a.push(20)
  a.push(30)
  assert_eq(a.len(), 3)
}

#Test
fn test_array_at() {
  #Mut let a Array<i32> = [10, 20, 30]
  assert_eq(a.get(0), 10)
  assert_eq(a.get(1), 20)
  assert_eq(a.get(2), 30)
}

#Test
fn test_array_index() {
  #Mut let a Array<i32> = [100, 200]
  assert_eq(a[0], 100)
  assert_eq(a[1], 200)
}

; ==================== Nullable ====================

#Test
fn test_nullable_some() {
  let x i32? = 42i32
  assert_true(x.has())
  assert_eq(x.get(), 42)
}

#Test
fn test_null_coalesce() {
  let some i32? = 7i32
  assert_eq(some ?? 0i32, 7)
  let none i32? = null
  assert_eq(none ?? 99i32, 99)
}

#Test
fn test_safe_field_access() {
  let p Point = Point::make(1, 2)
  let maybe Point? = p
  let xval i32? = maybe?.x
  assert_eq(xval ?? 0i32, 1)
  let none Point? = null
  let nxval i32? = none?.x
  assert_eq(nxval ?? 99i32, 99)
}

; ==================== Move 语义 ====================

#Test
fn test_move_assign_swap() {
  #Mut let a String = "first"
  #Mut let b String = "second"
  let old String = a <- b
  assert_eq(old, "first")
  assert_eq(a, "second")
  assert_eq(b, "second")
}

#Test
fn test_move_assign_array() {
  #Mut let xs Array<i32> = [1, 2, 3]
  let old Array<i32> = xs <- []
  assert_eq(old.len(), 3)
  assert_eq(xs.len(), 0)
}

; ==================== StringBuilder ====================

#Test
fn test_stringbuilder_build() {
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(79u32)       ; 'O'
  sb.append(75u32)       ; 'K'
  assert_eq(sb.build(), "OK")
}

#Test
fn test_stringbuilder_empty() {
  #Mut let sb StringBuilder = StringBuilder::make()
  assert_eq(sb.build(), "")
}

; ==================== 基本断言 ====================

#Test
fn test_assert_eq_int() {
  assert_eq(1 + 2, 3)
}

#Test
fn test_assert_eq_float() {
  assert_eq(1.5 + 2.5, 4.0)
}

#Test
fn test_assert_eq_bool() {
  assert_true(1 < 2)
  assert_false(3 < 2)
}

; ==================== 错误处理 ====================

enum MathErr {
  DivByZero
  Overflow(i32)
}

enum IoErr {
  NotFound
}

enum AppErr {
  Math(MathErr)
  Io(IoErr)
}

#Fallible(MathErr)
fn safe_divide(a i32, b i32) i32 {
  if b == 0 {
    ret MathErr::DivByZero
  }
  ret a / b
}

#Fallible(MathErr)
fn double_div(a i32, b i32) i32 {
  let v i32 = safe_divide(a, b)!
  ret v * 2
}

#Fallible(AppErr)
fn compute(a i32, b i32) i32 {
  let v i32 = try {
    safe_divide(a, b)
  } catch e MathErr {
    ret AppErr::Math(e)
  }
  ret v
}

#Test
fn test_error_try_catch_success() {
  let v i32 = try {
    safe_divide(10, 2)
  } catch e MathErr {
    -1
  }
  assert_eq(v, 5)
}

#Test
fn test_error_try_catch_div_zero() {
  let v i32 = try {
    safe_divide(10, 0)
  } catch e MathErr {
    -99
  }
  assert_eq(v, -99)
}

#Test
fn test_error_bang_propagate() {
  ; double_div(0, 0) → safe_divide(0, 0)! 透传 MathErr::DivByZero
  let v i32 = try {
    double_div(0, 0)
  } catch e MathErr {
    -1
  }
  assert_eq(v, -1)
}

#Test
fn test_error_bang_propagate_success() {
  ; double_div(6, 2) → safe_divide(6, 2)=3 → 3*2=6
  let v i32 = try {
    double_div(6, 2)
  } catch e MathErr {
    -1
  }
  assert_eq(v, 6)
}

#Test
fn test_error_cross_type_wrap() {
  ; compute(10, 0) → safe_divide 抛 MathErr::DivByZero → compute 包装为 AppErr::Math
  let tag i32 = try {
    compute(10, 0)
  } catch e AppErr {
    match e {
      AppErr::Math(_m) => 1
      AppErr::Io(_i) => 2
    }
  }
  assert_eq(tag, 1)
}

#Test
fn test_error_cross_type_success() {
  let v i32 = try {
    compute(10, 2)
  } catch e AppErr {
    -1
  }
  assert_eq(v, 5)
}

#Test
fn test_error_catch_arm_match_payload() {
  let tag i32 = try {
    safe_divide(0, 0)
  } catch e MathErr {
    match e {
      MathErr::DivByZero => 0
      MathErr::Overflow(_v) => 1
    }
  }
  assert_eq(tag, 0)
}

; ==================== 类型别名 ====================

IPair = (i32, i32)
Pair<T> = (T, T)

fn swap_pair(p IPair) IPair {
  ret (p.1, p.0)
}

#Test
fn test_type_alias_simple() {
  let p IPair = (1, 2)
  assert_eq(p.0, 1)
  assert_eq(p.1, 2)
}

#Test
fn test_type_alias_swap() {
  let q IPair = swap_pair((3, 4))
  assert_eq(q.0, 4)
  assert_eq(q.1, 3)
}

#Test
fn test_type_alias_generic() {
  let pf Pair<f64> = (1.5, 2.5)
  let x f64 = pf.0
  let y f64 = pf.1
  assert_eq(x, 1.5)
  assert_eq(y, 2.5)
}

; ==================== 元组操作 ====================

#Test
fn test_tuple_construct_and_access() {
  let t = (10, 20, 30)
  assert_eq(t.0, 10)
  assert_eq(t.1, 20)
  assert_eq(t.2, 30)
}

#Test
fn test_tuple_flat_deconstruct() {
  let (x, y, z) = (1, 2, 3)
  assert_eq(x, 1)
  assert_eq(y, 2)
  assert_eq(z, 3)
}

#Test
fn test_tuple_member_assign() {
  #Mut let t = (1, 2)
  t.0 = 10
  t.1 += 5
  assert_eq(t.0, 10)
  assert_eq(t.1, 7)
}

#Test
fn test_tuple_nested_access() {
  let nest = ((1, 2), 3)
  assert_eq(nest.0.0, 1)
  assert_eq(nest.0.1, 2)
  assert_eq(nest.1, 3)
}

#Test
fn test_tuple_mixed_types() {
  let t (i32, f64, bool) = (42, 3.14, true)
  assert_eq(t.0, 42)
  assert_eq(t.1, 3.14)
  assert_true(t.2)
}

; ==================== Heap<T> ====================

struct HeapBox {
  value i32

  #Static
  fn make(v i32) HeapBox {
    ret Self {
      .value = v
    }
  }
}

#Test
fn test_heap_ctor_and_as_ref() {
  let h Heap<HeapBox> = heap:<HeapBox>(HeapBox::make(42))
  let r HeapBox& = as_ref(h)
  assert_eq(r.value, 42)
}

#Test
fn test_heap_scalar_ctor() {
  let h Heap<i32> = heap:<i32>(7i32)
  let r i32& = as_ref(h)
  assert_eq(r, 7i32)
}

#Test
fn test_heap_mut_reassign() {
  #Mut let h Heap<i32> = heap:<i32>(1i32)
  h = heap:<i32>(99i32)
  let r i32& = as_ref(h)
  assert_eq(r, 99i32)
}

; ==================== Dyn<D> ====================

#Spec
struct Describable {
  fn describe() String
}

#Impl(Describable)
struct Named {
  name String

  #Static
  fn make(name String) Named {
    ret Self {
      .name = name
    }
  }

  fn describe() String {
    "Named: " + $.name
  }
}

#Test
fn test_dyn_describe() {
  let n Rc<Named> = Named::make("test")
  let d Dyn<Describable> = Dyn:<Describable>(n)
  assert_eq(d.describe(), "Named: test")
}

; ==================== String 模板与拼接 ====================

#Test
fn test_string_template_var() {
  let name String = "yux"
  let s String = "Hello, $name!"
  assert_eq(s, "Hello, yux!")
}

#Test
fn test_string_template_expr() {
  let x i32 = 3
  let y i32 = 4
  let s String = "$x + $y = ${x + y}"
  assert_eq(s, "3 + 4 = 7")
}

#Test
fn test_string_concat() {
  let a i32 = 10
  let s String = "val = " + a
  assert_eq(s, "val = 10")
}

; ==================== #Const fn + #Cval ====================

#Const
fn add_const(a i32, b i32) i32 = a + b

#Test
fn test_const_fn() {
  #Cval let sum i32 = add_const(3, 4)
  assert_eq(sum, 7)
}

#Test
fn test_cval_chain() {
  #Cval let base i32 = 10
  #Cval let doubled i32 = base * 2
  #Cval let flag bool = base > 0 && doubled != 0
  assert_eq(doubled, 20)
  assert_true(flag)
}

; ==================== Lambda 闭包捕获 ====================

; 用于 Rc retain 捕获演示
struct Counter {
  value i32

  #Static
  fn make(v i32) Counter {
    ret Self {
      .value = v
    }
  }

  fn inc() {
    $.value = $.value + 1
  }

  fn get_value() i32 {
    ret $.value
  }
}

#Test
fn test_lambda_capture_scalar() {
  let n i32 = 10
  let f = (x i32) i32 => x + n    ; 捕获 n（值复制）
  assert_eq(f(5), 15)
}

#Test
fn test_lambda_capture_rc_retain() {
  let rc Rc<Counter> = Counter::make(0)
  let inc = () => rc.inc()         ; 捕获 Rc<Counter>（retain）
  inc()
  inc()
  assert_eq(rc.get_value(), 2)
}
