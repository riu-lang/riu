; Phase 4a 冒烟测试：验证 #Test 收集 + 断言 API + JIT + SEH
;
; 运行：
;   cd examples/test
;   yux test smoke

#Test
fn test_pass() {
  ; 空体即视为通过
}

#Test
fn test_print() {
  println("hello from test_print")
}

#Test
fn test_assert_eq_int() {
  assert_eq(1 + 2, 3)
  assert_eq(10i64 - 5i64, 5i64)
  assert_eq(0u32, 0u32)
}

#Test
fn test_assert_eq_float() {
  assert_eq(1.0f64 + 2.0f64, 3.0f64)
}

#Test
fn test_assert_eq_bool() {
  assert_eq(true, true)
  assert_eq(false, false)
}

#Test
fn test_assert_true_false() {
  assert_true(true)
  assert_false(false)
  assert_true(1 == 1)
  assert_false(1 == 2)
}

; 失败用例：选择器精确匹配运行时单独验证
#Test
fn test_eq_fails() {
  assert_eq(1, 2)
}

#Test
fn test_true_fails() {
  assert_true(false)
}

#Test
fn test_fail_called() {
  fail("explicit fail")
}
