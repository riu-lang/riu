; basics.yux — 基础语法示例：字面量/类型/转换/运算符/变量
; 对照 docs/基础语法.md、docs/类型系统.md、docs/内置类型.md
use yux.core.*

; ==================== 整数字面量与后缀 ====================

fn demo_integer_literals() {
  ; 十进制（无后缀默认 i32，灵活推断）
  let dec i32 = 42
  println("dec = ")
  println(dec)

  ; 二进制 0b
  let bin i32 = 0b1010
  println("0b1010 = ")
  println(bin)

  ; 八进制 0o
  let oct i32 = 0o755
  println("0o755 = ")
  println(oct)

  ; 十六进制 0x
  let hex i32 = 0xFF
  println("0xFF = ")
  println(hex)

  ; 带后缀
  let a i8 = 42i8
  let b u64 = 100u64
  let c i32 = -123i32
  println("i8: ")
  println(a.to_i32())
  println("u64: ")
  println(b.to_i64())
  println("i32: ")
  println(c)
}

; ==================== 浮点字面量 ====================

fn demo_float_literals() {
  let a = 3.14           ; 默认 f64
  let b = 2.5f32         ; f32
  let c = -0.5           ; 负数
  let d = 10000000000.0  ; 大浮点数（注：docs 提到 1e10 但编译器暂不支持科学记数法）
  println("f64: ")
  println(a)
  println("f32: ")
  println(b.to_f64())
  println("-0.5: ")
  println(c)
  println("大浮点数: ")
  println(d)
}

; ==================== 布尔字面量与逻辑运算 ====================

fn demo_bool_and_logic() {
  let a = true
  let b = false

  let c = !true          ; false
  let d = a && b         ; false
  let e = a || b         ; true

  println("!true: ")
  println(c)
  println("true && false: ")
  println(d)
  println("true || false: ")
  println(e)
}

; ==================== 代码点字面量 ====================

fn demo_code_point() {
  let a u32 = c'A'       ; 65
  let b u32 = c'\n'      ; 10
  let c_cp u32 = c'中'   ; 20013
  println("c'A': ")
  println(a.to_i32())
  println("c'\\n': ")
  println(b.to_i32())
  println("c'中': ")
  println(c_cp.to_i32())
}

; ==================== 字符串字面量 ====================

fn demo_string_literals() {
  ; 普通字符串
  let s1 = "hello world"
  println(s1)

  ; 转义
  let s2 = "line1\nline2"
  println(s2)

  ; 原始字符串（r 前缀，不转义）
  let path = r"C:\path\to\file"
  println(path)
}

; ==================== 类型转换 .to_*() ====================

fn demo_type_conversions() {
  let a i32 = 10
  let b f64 = a.to_f64()      ; i32 -> f64
  let c i64 = a.to_i64()      ; i32 -> i64
  let d u8 = 100u8
  let e i32 = d.to_i32()      ; u8 -> i32
  let f bool = a.to_bool()    ; 非零 → true
  let g bool = 0i32.to_bool() ; 零 → false
  let s String = a.to_string()

  println("i32→f64: ")
  println(b)
  println("i32→i64: ")
  println(c)
  println("u8→i32: ")
  println(e)
  println("10.to_bool(): ")
  println(f)
  println("0.to_bool(): ")
  println(g)
  println("to_string(): ")
  println(s)
}

; ==================== 位运算 ====================

fn demo_bitwise_ops() {
  let a = 0xF0 & 0x0F   ; 0
  let b = 0xF0 | 0x0F   ; 255
  let c_val = 0xFF ^ 0x0F   ; 240
  let d = 1 << 4         ; 16
  let e = 16 >> 2        ; 4
  let f = ~5             ; -6（按位取反）
  println("0xF0 & 0x0F: ")
  println(a)
  println("0xF0 | 0x0F: ")
  println(b)
  println("0xFF ^ 0x0F: ")
  println(c_val)
  println("1 << 4: ")
  println(d)
  println("16 >> 2: ")
  println(e)
  println("~5: ")
  println(f)
}

; ==================== 复合赋值 ====================

fn demo_compound_assign() {
  #Mut let a i32 = 10
  a += 5
  println("10 += 5 → ")
  println(a)
  a -= 3
  println("-= 3 → ")
  println(a)
  a *= 2
  println("*= 2 → ")
  println(a)
  a /= 4
  println("/= 4 → ")
  println(a)
  a %= 4
  println("%= 4 → ")
  println(a)
}

; ==================== 变量声明形态 ====================

fn demo_variable_forms() {
  ; 默认浅不可变：带初值
  let a i32 = 10
  ; a = 20  ; 错误：不可重赋

  ; 类型推断
  let b = 123        ; i32
  let c = 3.14       ; f64
  let d = true       ; bool
  let e_str = "hi"   ; String

  ; 可变：先声明后赋值
  #Mut let x i32
  x = 42

  ; 可变：声明时赋初值
  #Mut let y i32 = 100
  y = 200

  println("a: ")
  println(a)
  println("b: ")
  println(b)
  println("c: ")
  println(c)
  println("d: ")
  println(d)
  println("e_str: ")
  println(e_str)
  println("x(延后赋值): ")
  println(x)
  println("y(重赋): ")
  println(y)
}

; ==================== 主入口 ====================

fn run_basics() {
  println("=== 整数字面量 ===")
  demo_integer_literals()

  println("=== 浮点字面量 ===")
  demo_float_literals()

  println("=== 布尔与逻辑 ===")
  demo_bool_and_logic()

  println("=== 代码点字面量 ===")
  demo_code_point()

  println("=== 字符串字面量 ===")
  demo_string_literals()

  println("=== 类型转换 ===")
  demo_type_conversions()

  println("=== 位运算 ===")
  demo_bitwise_ops()

  println("=== 复合赋值 ===")
  demo_compound_assign()

  println("=== 变量声明形态 ===")
  demo_variable_forms()

  println("=== basics 完成 ===")
}

fn main() {
  run_basics()
}
