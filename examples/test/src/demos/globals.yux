; globals.yux — 全局变量示例：val / #Mut / #Cval 三档
; 对照 docs/基础语法.md §全局变量、docs/构建注解.md §#Cval
use yux.core.*

; ==================== 全局 val：运行期初始化，浅不可变 ====================

let DEFAULT_PORT i32 = 8080

; ==================== 全局 #Mut：运行期初始化，可变 ====================

#Mut
let global_counter i64 = 0

; ==================== 全局 #Cval：编译期求值，不可变 ====================

#Cval
let MAX_SIZE i32 = 1024

#Cval
let PI f64 = 3.14159

#Cval
let DOUBLE i32 = MAX_SIZE * 2

; 私有全局（_ 前缀）
#Cval
let _INTERNAL_ID i32 = 42

; ==================== #Const fn 供 #Cval 调用 ====================

#Const
fn compute_offset(base i32, extra i32) i32 {
  ret base + extra
}

#Cval
let OFFSET i32 = compute_offset(MAX_SIZE, 10)

; ==================== 运行期全局 init 函数 ====================

fn get_default_port() i32 {
  ret 9090
}

let RUNTIME_PORT i32 = get_default_port()

; ==================== 主入口 ====================

fn run_globals() {
  println("=== 全局变量 ===")

  println("DEFAULT_PORT: ")
  println(DEFAULT_PORT)

  println("global_counter(初始): ")
  println(global_counter)
  global_counter = 100
  println("global_counter(设后): ")
  println(global_counter)

  println("MAX_SIZE: ")
  println(MAX_SIZE)
  println("PI: ")
  println(PI)
  println("DOUBLE: ")
  println(DOUBLE)
  println("OFFSET: ")
  println(OFFSET)
  println("RUNTIME_PORT: ")
  println(RUNTIME_PORT)

  println("_INTERNAL_ID: ")
  println(_INTERNAL_ID)

  println("=== globals 完成 ===")
}

fn main() {
  run_globals()
}
