; fixed_arrays.yux — 固定大小数组示例：[T*N]、填充语法、索引读写
; 对照 docs/内置类型.md §固定大小数组、docs/类型系统.md §数组类型
use yux.core.*

fn demo_fixed_arrays() {
  println("=== 固定大小数组 ===")

  ; 声明并初始化
  let arr [i32 * 5] = [1, 2, 3, 4, 5]

  ; 索引读
  println("arr[0]: ")
  println(arr[0])
  println("arr[4]: ")
  println(arr[4])

  ; 字节数组
  let bytes [u8 * 4] = [97u8, 98u8, 99u8, 100u8]
  println("bytes[0] (97='a'): ")
  println(bytes[0])

  ; ===== 数组填充语法 =====
  println("=== 数组填充 ===")

  ; 填充为 0
  #Mut let buf [u8 * 4] = [0u8 ...]
  println("buf[0] (全 0): ")
  println(buf[0])
  println("buf[3] (全 0): ")
  println(buf[3])

  ; 填充为 true
  #Mut let flags [bool * 3] = [true ...]
  println("flags[0]: ")
  println(flags[0])
  println("flags[2]: ")
  println(flags[2])

  ; 显式指定元素类型填充（带类型后缀的 …）
  #Mut let zeros [i32 * 5] = [0 ... i32]
  println("zeros[0]: ")
  println(zeros[0])
  println("zeros[4]: ")
  println(zeros[4])

  ; ===== 可变定长数组的索引写 =====
  println("=== 索引写 ===")
  #Mut let mut_arr [i32 * 3] = [10, 20, 30]
  mut_arr[0] = 100
  mut_arr[1] = 200
  println("mut_arr[0] (原10→100): ")
  println(mut_arr[0])
  println("mut_arr[1] (原20→200): ")
  println(mut_arr[1])
  println("mut_arr[2] (不变): ")
  println(mut_arr[2])

  ; ===== 数组比较（逐元素） =====
  let a1 [i32 * 2] = [1, 2]
  let a2 [i32 * 2] = [1, 2]
  let a3 [i32 * 2] = [3, 4]
  ; 注：== 对固定数组的行为由编译器决定，目前可能不支持
  ; 需要逐元素比较或使用 Array<T>
}

fn run_fixed_arrays() {
  demo_fixed_arrays()
  println("=== fixed_arrays 完成 ===")
}

fn main() {
  run_fixed_arrays()
}
