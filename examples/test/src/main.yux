use yux.core.*

enum Shape {
  Point
  Circle(f64)
  Tagged(String, i32)
}

enum NoPayload {
  A
  B
}

struct N {
  v i32
}

N {

  fn N(v i32) {
    $.v = v
  }

  ; 算术运算符
  fn plus(other N) N {
    N($.v + other.v)
  }
}


fn main() {
  println("=== Nullable 烟测 ===")
  var nx i32? = 42i32
  var ny i32? = null

  ; ?? 默认值运算符
  var a i32 = nx ?? -1i32
  println(a)          ; 期望 42

  var b i32 = ny ?? -1i32
  println(b)          ; 期望 -1

  ; ?. 安全字段访问 (base 是 Nullable<N>，N 有字段 v)
  var n N = N(7)
  var maybeN N? = n
  var v1 i32? = maybeN?.v         ; 应为持值 7
  var v1d i32 = v1 ?? -1i32
  println(v1d)        ; 期望 7

  var emptyN N? = null
  var v2 i32? = emptyN?.v         ; 应为空
  var v2d i32 = v2 ?? -99i32
  println(v2d)        ; 期望 -99

  println("=== enum Phase 5 烟测 ===")
  ; 零参 variant（含括号 / 无括号 等价）
  var s1 Shape = Shape::Point
  var s2 Shape = Shape::Point()
  var n1 NoPayload = NoPayload::A
  var n2 NoPayload = NoPayload::B()

  ; tuple-payload variant：纯 POD
  var s3 Shape = Shape::Circle(2.5f64)

  ; tuple-payload variant：含 RC 字段 (String)
  var msg String = "hello"
  var s4 Shape = Shape::Tagged(msg, 7)

  ; 把 enum 值作为函数实参传递（callee-clean 路径）
  var s5 Shape = Shape::Tagged("x", 1)

  ; 作用域结束后 s4/s5 内 String 应被正确释放，无泄漏 / 无 double-free
  println("=== 测试完成 ===")
}
