; main.yux — examples/test 入口
; 运行：cd examples/test && yux build && build/example.exe
; 测试：cd examples/test && yux test
; 各独立 demo 在 demos/ 子目录，通过改 yux.toml entry 单独运行
use yux.core.*

fn main() {
  println("yux examples/test")
  println("  主示例在 demos/ 子目录，编辑 yux.toml entry 指向对应文件即可单独运行。")
  println("  测试：yux test")
}
