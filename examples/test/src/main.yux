; main.yux — yux 语言特性综合示例（反射除外）
; 运行：cd examples/test && yux build && build/example.exe

use yux.core.*

; ==================== 类型定义 ====================

; ---- 枚举：形状 ----
enum Shape {
  Point
  Circle(f64)
  Rect(f64, f64)
}

; ---- 结构体：二维向量（演示运算符重载） ----
struct Vec2 {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 加法：Vec2 + Vec2（推荐 Self& 形参，调用点自动取址）
  fn plus(other Vec2&) Vec2 {
    Vec2::make($.x + other.x, $.y + other.y)
  }

  ; 减法
  fn minus(other Vec2&) Vec2 {
    Vec2::make($.x - other.x, $.y - other.y)
  }

  ; 标量乘法：Vec2 * f64（跨类型重载）
  fn mul(scalar f64) Vec2 {
    Vec2::make($.x * scalar, $.y * scalar)
  }

  ; 比较
  fn eq(other Vec2&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Vec2&) bool {
    !$.eq(&other)
  }

  ; to_string（直接传 .to_string() 给 append）
  fn to_string() String {
    #Mut let sb StringBuilder = StringBuilder::make()
    sb.append("Vec2(")
    sb.append($.x.to_string())
    sb.append(", ")
    sb.append($.y.to_string())
    sb.append(")")
    sb.build()
  }
}

; ---- 带静态计数器的标签 ----
struct Label {
  name String

  #Mut
  #Static
  COUNT i64 = 0

  #Static
  fn make(name String) Label {
    Label::COUNT = Label::COUNT + 1
    ret Self {
      .name = name
    }
  }
}

; ---- 含 Nullable 字段 ----
struct Contact {
  name  String
  email String?

  #Static
  fn make(name String) Contact {
    ret Self {
      .name = name
      .email = null
    }
  }
}

; ==================== 主入口 ====================

fn main() {
  ; ========== 1. 运算符重载 ==========
  println("=== 1. 运算符重载（Vec2） ===")
  let v1 Vec2 = Vec2::make(3.0, 4.0)
  let v2 Vec2 = Vec2::make(1.0, 2.0)

  let sum  Vec2 = v1 + v2       ; plus(Self&)
  let diff Vec2 = v1 - v2       ; minus(Self&)
  let scaled Vec2 = v1 * 2.0    ; mul(f64) → 跨类型按值

  println("sum.x: ")
  println(sum.x)
  println("scaled.x: ")
  println(scaled.x)
  println("Vec2: ")
  println(sum.to_string())

  let eq_val bool = v1 == v2
  let ne_val bool = v1 != v2
  println("v1==v2: ")
  println(eq_val)
  println("v1!=v2: ")
  println(ne_val)

  ; ========== 2. 枚举 + match ==========
  println("=== 2. 枚举 + match ===")
  let point Shape = Shape::Point
  let circ  Shape = Shape::Circle(5.0)
  let rect  Shape = Shape::Rect(3.0, 4.0)

  println(describe(point))
  println(describe(circ))
  println(describe(rect))

  ; ========== 3. Array<T> 操作 ==========
  println("=== 3. Array<i32> 操作 ===")
  #Mut let xs Array<i32> = []
  xs.push(10)
  xs.push(20)
  xs.push(30)

  let n i64 = xs.len()
  println("len: ")
  println(n)
  let v0 i32 = copy_of:<i32>(xs[0])
  println("at(0): ")
  println(v0)
  let idx1 i32 = copy_of:<i32>(xs[1])
  println("xs[1]: ")
  println(idx1)

  ; ========== 4. Nullable：?? 与 ?. ==========
  println("=== 4. Nullable ===")

  let some_name String? = "Alice"
  let no_name String? = null
  println("some: ")
  println(some_name ?? "no name")
  println("null: ")
  println(no_name ?? "no name")

  ; ?. 安全字段访问
  let c1 Contact = Contact::make("Alice")
  let maybe Contact? = c1
  let name1 String? = maybe?.name
  println("field from some: ")
  println(name1 ?? "null")
  let none Contact? = null
  let name2 String? = none?.name
  println("field from null: ")
  println(name2 ?? "null")

  ; ========== 5. Move 语义 a <- b ==========
  println("=== 5. Move 语义 ===")
  #Mut let a String = "hello"
  #Mut let b String = "world"
  ; a <- b：a 旧值移出返回，b 移入 a；零 RC 开销
  let old String = a <- b
  println("old(a): ")
  println(old)
  println("new(a): ")
  println(a)

  ; ========== 6. StringBuilder ==========
  println("=== 6. StringBuilder ===")
  #Mut let sb StringBuilder = StringBuilder::make()
  sb.append(72u32)       ; 'H'
  sb.append(105u32)      ; 'i'
  sb.append(33u32)       ; '!'
  sb.append(32u32)       ; ' '
  sb.append("yux")
  ; 测试直接传  给 append（不通过 let 暂存）
  sb.append(scaled.x.to_string())
  let msg String = sb.build()
  println(msg)

  ; ========== 7. 静态可变字段 ==========
  println("=== 7. 静态可变字段 ===")
  let c0_i64 i64 = Label::COUNT
  println("初始 COUNT: ")
  println(c0_i64)
  let l1 Label = Label::make("A")
  let l2 Label = Label::make("B")
  let c2_i64 i64 = Label::COUNT
  println("构造 2 个后: ")
  println(c2_i64)

  ; ========== 8. Lambda / 闭包 ==========
  println("=== 8. Lambda ===")
  let square = (x i32) i32 => x * x
  let sq3 i32 = square(3)
  let sq3_str String = sq3.to_string()
  println("square(3): ")
  println(sq3_str)

  ; 高阶函数：Array<i32> 逐元素 * 2
  let doubled Array<i32> = map_i32(xs, (x i32) i32 => x * 2)
  let d0 i32 = copy_of:<i32>(doubled[0])
  let d0_str String = d0.to_string()
  println("map *2 at(0): ")
  println(d0_str)

  ; ========== 9. loop + break ==========
  println("=== 9. loop + break ===")
  let f5 i64 = factorial(5)
  let f5_str String = f5.to_string()
  println("5! = ")
  println(f5_str)

  ; ========== 10. 错误处理 ==========
  println("=== 10. 错误处理 ===")

  ; 10a. try-catch：捕获可失败函数的错误
  let r1 i32 = try {
    safe_divide(10, 2)          ; 成功路径
  } catch e MathErr {
    -1                           ; 错误降级
  }
  let r2 i32 = try {
    safe_divide(10, 0)          ; 触发除零错误
  } catch e MathErr {
    -1                           ; 返回降级值
  }
  println("10/2 = ")
  println(r1)
  println("10/0 → ")
  println(r2)

  ; 10b. `!` 传播：同类型错误自动向上抛（try 块内无需 `!`）
  let r3 i32 = try {
    double_div(15, 3)            ; 15/3=5 → *2=10
  } catch e MathErr {
    -9
  }
  println("double_div(15, 3): ")
  println(r3)

  ; 10c. catch arm 内 match 解构 payload
  ; 注意：safe_divide(5, 0) 触发 DivByZero → catch arm 命中
  let r4 i32 = try {
    safe_divide(5, 0)
  } catch e MathErr {
    match e {
      MathErr::DivByZero => -1
      MathErr::Overflow(_v) => -2
    }
  }
  println("5/0 error code: ")
  println(r4)

  ; 10d. 跨类型错误包装
  let r5 i32 = try {
    compute(10, 2)               ; 成功
  } catch e AppErr {
    -1
  }
  let r6 i32 = try {
    compute(10, 0)               ; MathErr::DivByZero → AppErr::Math
  } catch e AppErr {
    -1
  }
  println("compute(10, 2): ")
  println(r5)
  println("compute(10, 0): ")
  println(r6)

  ; ========== 11. 类型别名 ==========
  println("=== 11. 类型别名 ===")

  ; IPair 是 (i32, i32) 的透明别名
  let p IPair = (1, 2)
  let q IPair = swap_pair(p)             ; swap_pair 接受 IPair、返回 IPair
  println("swap((1, 2)) = ")
  println(q.0)
  println(q.1)

  ; Pair<f64> 是 (f64, f64) 的泛型别名
  let pf Pair<f64> = (1.5, 2.5)
  let pf_val f64 = pf.0
  println("Pair<f64>.0: ")
  println(pf_val)

  ; ========== 12. 元组操作 ==========
  println("=== 12. 元组操作 ===")

  ; 构造
  let t1 = (10, 20, 30)
  let t2 (i32, f64, bool) = (42, 3.14, true)

  ; 成员访问
  println("t1.0 = ")
  println(t1.0)
  println("t2.1 = ")
  println(t2.1)

  ; 平铺解构
  let (x, y, z) = t1
  println("解构 t1 → x, y, z: ")
  println(x)
  println(y)
  println(z)

  ; 成员赋值（需可变）
  #Mut let mt = (1, 2)
  mt.0 = 10
  mt.1 += 5
  println("mt 赋值后: ")
  println(mt.0)
  println(mt.1)

  ; 嵌套元组
  let nest = ((1, 2), 3)
  println("nest.0.1 = ")
  println(nest.0.1)

  ; ========== 13. Heap<T> 单所有者堆句柄 ==========
  println("=== 13. Heap<T> ===")

  ; 构造：Heap:<T>(value)
  let h Heap<HeapBox> = Heap:<HeapBox>(HeapBox::make(42))
  ; as_ref 借用内层值
  let r HeapBox& = as_ref(h)
  println("Heap value: ")
  println(r.value)

  ; #Mut 重赋新 Heap
  #Mut let h2 Heap<i32> = Heap:<i32>(1i32)
  h2 = Heap:<i32>(99i32)
  let r2 i32& = as_ref(h2)
  println("Heap reassign: ")
  println(r2)

  ; ========== 14. Dyn<D> 运行时多态 ==========
  println("=== 14. Dyn<D> ===")

  ; 构造 Rc<Named>，再包成 Dyn<Describable>
  let named Rc<Named> = Named::make("yux")
  let dd Dyn<Describable> = Dyn:<Describable>(named)
  println("Dyn describe: ")
  println(dd.describe())

  ; ========== 15. 字段注解 ==========
  println("=== 15. 字段注解（#Val / #Frozen） ===")

  ; Resource 有 #Val（浅不可变）和 #Frozen（深不可变）字段
  let res Resource = Resource::make(100, 200)
  ; 可以读
  println("res.counter = ")
  println(res.counter)
  println("res.payload = ")
  println(res.payload)
  ; res.counter = 999     ; ❌ 编译错 E3109：#Val 字段构造后不可写
  ; res.payload = 888     ; ❌ 编译错 E3109：#Frozen 字段不可写

  ; ========== 16. String 模板与拼接 ==========
  println("=== 16. String 模板与拼接 ===")

  ; 标识符插值：$name
  let name String = "yux"
  let s1 String = "Hello, $name!"
  println("模板: ")
  println(s1)

  ; 表达式插值：${expr}
  let x1 i32 = 10
  let x2 i32 = 20
  let s2 String = "$x1 + $x2 = ${x1 + x2}"
  println("表达式插值: ")
  println(s2)

  ; + 连接（自动走 StringBuilder）
  let s3 String = "sum = " + x1 + ", diff = " + (x2 - x1)
  println("+ 连接: ")
  println(s3)

  ; ========== 17. Python 风格三元表达式 ==========
  println("=== 17. 三元表达式 ===")

  let score i32 = 85
  let grade String = "A" if score >= 90 else "B" if score >= 80 else "C"
  println("score=85 → grade: ")
  println(grade)

  let val i32 = -5
  let sign i32 = 1 if val >= 0 else -1
  println("sign(-5): ")
  println(sign)

  ; ========== 18. #Const fn + #Cval 编译期常量 ==========
  println("=== 18. #Const fn + #Cval ===")

  ; 局部 #Cval：编译期求值
  #Cval let SIZE i32 = add_const(3, 4)
  println("add_const(3, 4) = ")
  println(SIZE)

  ; 引用已有 #Cval
  #Cval let DOUBLE i32 = SIZE * 2
  println("SIZE * 2 = ")
  println(DOUBLE)

  ; ========== 19. Lambda 闭包捕获 ==========
  println("=== 19. Lambda 闭包 ===")

  ; 标量值复制捕获
  let base_val i32 = 10
  let add_n = (x i32) i32 => x + base_val  ; 捕获 base_val（值复制）
  let r19 i32 = add_n(5)
  println("add_n(5) where base=10 → ")
  println(r19)

  ; Rc<T> 句柄 retain 捕获
  #Mut let rc_counter Rc<Counter> = Counter::make(0)
  let inc = () => rc_counter.inc()         ; 捕获 Rc<Counter>（retain）
  inc()
  inc()
  println("counter after 2 incs: ")
  println(rc_counter.get_value())

  println("=== 全部 19 节完成 ===")
}

; ==================== String / 常量 / Lambda 类型定义 ====================

; #Const fn：编译期可求值
#Const
fn add_const(a i32, b i32) i32 = a + b

; Counter：Lambda 闭包捕获演示（Rc retain）
struct Counter {
  value i32

  #Static
  fn make(v i32) Counter {
    ret Self {
      .value = v
    }
  }

  fn inc() {
    $.value = $.value + 1
  }

  fn get_value() i32 {
    ret $.value
  }
}

; ==================== 字段注解 类型定义 ====================

; #Val（浅不可变）、#Frozen（深不可变）字段注解
struct Resource {
  #Val
  counter i32        ; 构造后不可重赋
  #Frozen
  payload i32        ; 构造后自身及子字段不可写

  #Static
  fn make(c i32, p i32) Resource {
    ret Self {
      .counter = c
      .payload = p
    }
  }
}

; ==================== Heap / Dyn 类型定义 ====================

; ---- Heap<T> 演示用结构体 ----
struct HeapBox {
  value i32

  #Static
  fn make(v i32) HeapBox {
    ret Self {
      .value = v
    }
  }
}

; ---- Dyn<D> 演示用 spec + impl ----
#Spec
struct Describable {
  fn describe() String
}

#Impl(Describable)
struct Named {
  name String

  #Static
  fn make(name String) Named {
    ret Self {
      .name = name
    }
  }

  fn describe() String {
    "Named: " + $.name
  }
}

; ==================== 类型别名 ====================

IPair = (i32, i32)
Pair<T> = (T, T)

; 使用别名作为参数/返回类型
fn swap_pair(p IPair) IPair {
  ret (p.1, p.0)
}

; ==================== 错误处理：类型定义与函数 ====================

enum MathErr {
  DivByZero
  Overflow(i32)
}

enum AppErr {
  Math(MathErr)
}

; 可失败函数：安全除法
#Fallible(MathErr)
fn safe_divide(a i32, b i32) i32 {
  if b == 0 {
    ret MathErr::DivByZero
  }
  ret a / b
}

; `!` 同类型传播
#Fallible(MathErr)
fn double_div(a i32, b i32) i32 {
  let v i32 = safe_divide(a, b)!    ; 错误自动向上抛
  ret v * 2
}

; 跨类型包装
#Fallible(AppErr)
fn compute(a i32, b i32) i32 {
  let v i32 = try {
    safe_divide(a, b)
  } catch e MathErr {
    ret AppErr::Math(e)              ; 跨类型显式包装
  }
  ret v
}

; ==================== 辅助函数 ====================

; match 描述形状（保持简单，只用字面量）
fn describe(s Shape) String {
  match s {
    Shape::Point        => "a point"
    Shape::Circle(r)    => "a circle"
    Shape::Rect(w, h)   => "a rect"
  }
}

; 阶乘
fn factorial(n i64) i64 {
  #Mut let result i64 = 1
  #Mut let i i64 = n
  loop {
    if i <= 1 {
      break;
    }
    result = result * i
    i = i - 1
  }
  result
}

; 高阶函数：Array<i32> 逐元素变换
fn map_i32(xs Array<i32>, f fn(i32)i32) Array<i32> {
  #Mut let r Array<i32> = []
  #Mut let i i64 = 0
  loop {
    if i >= xs.len() {
      break;
    }
    r.push(f(copy_of:<i32>(xs[i])))
    i = i + 1
  }
  r
}
