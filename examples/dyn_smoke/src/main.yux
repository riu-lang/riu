use yux.core.*

; Phase 1b 冒烟：Dyn<D> 在类型位置能否解析
; 暂不构造、不调用，仅看类型 + 形参语法走通

draft Greet {
    fn hi()
}

struct G { }

G {
    fn G() {
    }
}

G : Greet {
    fn hi() {
        println("hi")
    }
}

fn take(d Dyn<Greet>) {
}

fn take_ref(d Dyn<Greet&>) {
}

; Phase 1c：Dyn<D>(box) 构造表达式编译验证（turbofish 形 `T:<...>`）
; vtable / 对象安全留 Phase 2/3；此处只看类型 + IR 走通
fn make_dyn(b Box<G>) Dyn<Greet> {
    ret Dyn:<Greet>(b)
}

; Phase 3e 冒烟：非平凡 U（含 String 字段，需调 dtor）
struct H {
    label String
}

H {
    fn H(l String) {
        $.label = l
    }
}

H : Greet {
    fn hi() {
        println($.label)
    }
}

fn main() {
    val b Box<G> = G()
    take(Dyn:<Greet>(b))

    ; Phase 3d 冒烟：Dyn 方法调用 — 走 vtable 间接调用
    val b2 Box<G> = G()
    val d Dyn<Greet> = Dyn:<Greet>(b2)
    d.hi();

    ; Phase 3e 冒烟：含 RC 字段的 U，dyn release 必须调 H 的 dtor
    val bh Box<H> = H("from H")
    val dh Dyn<Greet> = Dyn:<Greet>(bh)
    dh.hi();
}
