import("//build/version.gni")

declare_args() {
  is_debug = true

  # LLVM GN 输出目录（绝对路径，正斜杠）。空则用 $root_out_dir/llvm
  llvm_build_dir = ""

  # 注入 YUX_VERSION，由 build.ps1 写成 v<version>-<date>
  yux_version_str = "v$yux_version"
}

is_win = true
is_linux = false
is_mac = false
current_os = "win"
current_cpu = "x64"
host_os = "win"
host_cpu = "x64"
target_os = "win"
target_cpu = "x64"

set_default_toolchain("//build/toolchain:win_clang_x64")

_default_configs = [
  "//build/config:compiler",
  "//build/config:runtime",
  "//build/config:language_cxx",
]

set_defaults("source_set") {
  configs = _default_configs
}

set_defaults("static_library") {
  configs = _default_configs
}

set_defaults("executable") {
  configs = _default_configs + [ "//build/config:executable" ]
}

set_defaults("shared_library") {
  configs = _default_configs + [ "//build/config:executable" ]
}
