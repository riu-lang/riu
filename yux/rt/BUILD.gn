config("yuxrt_public") {
  include_dirs = [ "." ]
}

static_library("yuxrt") {
  output_name = "yuxrt"
  output_dir = "$root_out_dir/lib"
  public_configs = [ ":yuxrt_public" ]
  configs -= [ "//build/config:language_cxx" ]
  configs += [
    "//build/config:language_c99",
    "//build/config:no_autolink",
  ]
  sources = [
    "port/win32.c",
    "mem/alloc.c",
    "mem/ops.c",
    "math/__cos.c",
    "math/__expo2.c",
    "math/__math_divzero.c",
    "math/__math_invalid.c",
    "math/__math_oflow.c",
    "math/__math_uflow.c",
    "math/__math_xflow.c",
    "math/__rem_pio2.c",
    "math/__rem_pio2_large.c",
    "math/__sin.c",
    "math/__tan.c",
    "math/acos.c",
    "math/asin.c",
    "math/atan.c",
    "math/atan2.c",
    "math/cbrt.c",
    "math/ceil.c",
    "math/cos.c",
    "math/cosh.c",
    "math/exp.c",
    "math/exp_data.c",
    "math/expm1.c",
    "math/fabs.c",
    "math/floor.c",
    "math/fmod.c",
    "math/hypot.c",
    "math/log.c",
    "math/log1p.c",
    "math/log10.c",
    "math/log2.c",
    "math/log2_data.c",
    "math/log_data.c",
    "math/pow.c",
    "math/pow_data.c",
    "math/round.c",
    "math/scalbn.c",
    "math/sin.c",
    "math/sinh.c",
    "math/sqrt.c",
    "math/sqrt_data.c",
    "math/tan.c",
    "math/tanh.c",
    "math/trunc.c",
  ]
}
