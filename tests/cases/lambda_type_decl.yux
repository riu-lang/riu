; Phase 1 §3.3：函数类型字面量在 var / 形参 / 返回值位置可声明
; 紧凑形 [#16][#23]：fn 与 ( 之间无空格；) 与 retType 之间无空格

fn main() {
  ; 0 参 / void
  #Mut let a fn()
  ; 0 参带返回
  #Mut let b fn()i32
  ; 单参
  #Mut let c fn(i32)i32
  ; 命名参（仅文档作用）
  #Mut let d fn(x i32)i32
  ; 多参 + 组糖（§3.4(5)）
  #Mut let e fn(a, b i32)i32
  ; 高阶：fn 类型作 fn 类型形参 / 返回值
  #Mut let f fn(g fn(i32)i32)i32
  #Mut let h fn()fn(i32)i32

  println("ok")
  ret;
}
