; Phase 1 §3.3：函数类型字面量在 var / 形参 / 返回值位置可声明
; 紧凑形 [#16][#23]：fn 与 ( 之间无空格；) 与 retType 之间无空格

fn main() {
  ; 0 参 / void
  var a fn()
  ; 0 参带返回
  var b fn()i32
  ; 单参
  var c fn(i32)i32
  ; 命名参（仅文档作用）
  var d fn(x i32)i32
  ; 多参 + 组糖（§3.4(5)）
  var e fn(a, b i32)i32
  ; 高阶：fn 类型作 fn 类型形参 / 返回值
  var f fn(g fn(i32)i32)i32
  var h fn()fn(i32)i32

  println("ok")
  ret;
}
