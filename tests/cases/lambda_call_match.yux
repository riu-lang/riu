; Phase 2c §4.4：lambda 单表达式体可含 match 表达式

enum Color {
  Red
  Green
  Blue
}

fn apply(f fn(Color)i32, c Color) i32 {
  ret f(c)
}

fn main() {
  val classify = (c Color) i32 => match c {
    Color::Red => 1
    Color::Green => 2
    Color::Blue => 3
  }
  println(classify(Color::Red).to_string())
  println(classify(Color::Green).to_string())

  ; 实参反推 + match（裸单参形式：返回类型亦由上下文反推）
  val r1 i32 = apply(c => match c {
    Color::Red => 10
    Color::Green => 20
    Color::Blue => 30
  }, Color::Blue)
  println(r1.to_string())
  ret;
}
