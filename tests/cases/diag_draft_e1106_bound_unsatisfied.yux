; §6.4.4.4 / §12.4 边界单态化未命中
#Spec
struct Show {
    fn show() i32
}

struct Counter {
    n i32

    #Static
    fn make(n i32) Counter {
        ret Self {
            .n = n
        }
    }
}

fn say<T : Show>(x T) {
    let s = x.show()
}

fn main() {
    let c Counter = Counter::make(0i32)
    say(c)
}
