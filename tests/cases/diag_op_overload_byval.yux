struct Point {
  x i32
  y i32
}

Point {
  fn Point(x i32, y i32) {
    $.x = x
    $.y = y
  }

  ; 按值参数（与文档表格一致，但与注意事项 #2 冲突）
  fn plus(other Point) Point {
    Point($.x + other.x, $.y + other.y)
  }
}

fn main() {
  let p1 = Point(1i32, 2i32)
  let p2 = Point(3i32, 4i32)
  let p3 = p1 + p2
  println(p3.x)
}
