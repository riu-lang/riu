; 用户结构体的 ==/!= 运算符重载（spec §7.2.3）：形参 Self&，运算符位置自动取址

struct Pt {
  x i32
  y i32
}

Pt {
  fn Pt(x i32, y i32) {
    $.x = x
    $.y = y
  }

  fn eq(other Pt&) bool {
    $.x == other.x && $.y == other.y
  }

  fn ne(other Pt&) bool {
    !$.eq(&other)
  }
}

fn main() {
  val a Pt = Pt(1, 2)
  val b Pt = Pt(1, 2)
  val c Pt = Pt(1, 9)
  val d Pt = Pt(9, 2)
  println((a == b).to_string())
  println((a == c).to_string())
  println((a == d).to_string())
  println((a != b).to_string())
  println((a != c).to_string())
  println((a != d).to_string())
}
