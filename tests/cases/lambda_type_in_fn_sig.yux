; Phase 1 §3.1：fn 类型可在函数声明形参 / 返回值位（任意嵌套）出现
; 不调用，仅声明面通过编译

fn op(f fn(i32)i32) i32 {
  ret 0
}

fn make_adder(n i32) fn(i32)i32 {
  ; 占位返回——未实现 lambda；用未初始化变量收尾
  var r fn(i32)i32
  ret r
}

; 嵌套：fn 类型作另一 fn 类型的形参
fn higher(f fn(g fn(i32)i32)i32) i32 {
  ret 0
}

fn main() {
  println("ok")
  ret;
}
