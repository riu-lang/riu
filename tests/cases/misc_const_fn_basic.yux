; P1-5: #Const fn 注解 (DRAFT-const-mut §4)
; - 自由 #Const fn 体内可读参数 / 全局 cval / 局部 var/val/cval
; - #Const fn 可调用其它 #Const fn
; - 非 #Const fn 调用 #Const fn 不受限

#Cval
let LIMIT i32 = 1000

#Const
fn add(a i32, b i32) i32 = a + b

#Const
fn clamp(x i32) i32 {
    #Cval let base i32 = 0
    #Mut let hi i32 = LIMIT
    ret add(x, base) + hi - hi
}

fn main() {
    println(add(2, 3).to_string())
    println(clamp(7).to_string())
    ret;
}
