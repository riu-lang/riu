; DRAFT-let-unify P1.a 验证：let 局部 / 全局形态可解析、可编译、可运行。
; 默认 let → val（不可重赋）；#Mut → var；#Cval → cval；#Frozen → val + frozen
; 全局 #Cval let → 与 globalConst 同义。

#Cval
let G_MAX i32 = 100

fn main() {
  let a = 1
  let b i32 = 2
  #Mut let c i32 = 3
  c = c + 10
  #Cval let LOCAL_MAX i32 = 50

  println((a + b + c + LOCAL_MAX + G_MAX).to_string())
}
