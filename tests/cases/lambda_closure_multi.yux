; Phase 4a §6.1 / §6.2：多个标量捕获 + 不同 builtin 类型混捕

fn main() {
  #Mut let a i32 = 3
  #Mut let b i32 = 7
  let sum = (x i32) i32 => a + b + x
  println(sum(0))     ; 10
  println(sum(5))     ; 15

  #Mut let pi f64 = 3.14
  let pifloor = () i32 => pi.to_i32()
  println(pifloor())  ; 3

  #Mut let enabled bool = true
  let pick = (t, f i32) i32 => if enabled { t } else { f }
  println(pick(1, 2)) ; 1

  ret;
}
