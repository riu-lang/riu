; DRAFT-const-eval Phase 5: 全局 #Cval 初始化器含 TypeName{...} struct 字面量

struct Point {
  x i32
  y i32
}

#Cval
let ORIGIN Point = Point {
  .x = 0
  .y = 0
}

#Cval
let P Point = Point {
  .x = 3 + 4
  .y = 10 * 2
}

fn main() {
  println(ORIGIN.x.to_string())
  println(ORIGIN.y.to_string())
  println(P.x.to_string())
  println(P.y.to_string())
}
