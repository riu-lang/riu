fn main() {
  val a i8 = -128
  println(a.to_string())
  val b i8 = 127
  println(b.to_string())
  val c u8 = 255
  println(c.to_string())
  val d i16 = -32768
  println(d.to_string())
  val e u16 = 65535
  println(e.to_string())
  val f i32 = -2147483648
  println(f.to_string())
  val g i64 = -9223372036854775807i64
  println(g.to_string())
  val h f32 = 3.14159f32
  println(h.to_string())
  val i f64 = 2.718281828459045
  println(i.to_string())
}
