; DRAFT-spec-reflect Phase 3a/3b: __yux_reflect_type:<T>() intrinsic 端到端跑通.
; Type 节点 emit 到 .rodata, name 字段读到类型名字符串.
; fields 数据通过 Counter::fields 静态路径访问 ([Field& * N]&).

struct Counter {
  n i32
  total i32
}

fn main() {
  let t Type = __yux_reflect_type:<Counter>()
  println(t.name)
  let f0 Field& = Counter::fields[0]
  println(f0.name)
  let f1 Field& = Counter::fields[1]
  println(f1.name)
}
