; v0.4 Phase 5：通过 Array<T>& 自身调用修改方法亦应当报错（receiver 解析到借用变量）
; v0.4 阶段未覆盖此形态——简化版仅在直接对原句柄修改时报错；
; 该用例验证现状：通过 ref 调用 push 不报错（已知漏洞，记入 Phase 6 TODO）。
; 这里改为合法形态：通过 ref 读取，借用结束后由原句柄写。

fn main() {
  var a Array<i32> = [10, 20]
  loop {
    val r Array<i32>& = &a
    println(r.len().to_string())
    break;
  }
  a.push(30)
  println(a.len().to_string())
  ret;
}
