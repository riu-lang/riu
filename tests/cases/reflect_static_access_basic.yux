; DRAFT-spec-reflect Phase 4: `<Struct>::type` / `<Struct>::fields` 静态路径访问.
; 走草案 §2 的公开形态, fields 返回 [Field& * N]& 引用数组.

struct Counter {
  n i32
  total i32
}

fn main() {
  let t Type = Counter::type
  println(t.name)
  let fs [Field& * 2]& = Counter::fields
  let f0 Field& = fs[0]
  println(f0.name)
  let f1 Field& = fs[1]
  println(f1.name)
}
