fn ret_i32() i32 {
  42
}

fn ret_i64() i64 {
  123456789
}

fn ret_f64() f64 {
  3.14
}

fn ret_bool() bool {
  true
}

fn ret_expr() i32 {
  val x = 10
  x + 5
}

fn ret_inferred() i64 {
  999
}

fn main() {
  println(ret_i32().to_string())
  println(ret_i64().to_string())
  println(ret_f64().to_string())
  println(ret_bool().to_string())
  println(ret_expr().to_string())
  println(ret_inferred().to_string())
}
