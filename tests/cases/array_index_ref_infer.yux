; D.4: [] 返回 T& 后类型推断与 T& 语义验证
; 验证 let x = arr[0] 推断为 T&，写穿行为，及 copy_of 取值

fn modify_by_ref(r i32&) {
  r = 99
}

fn read_ref(r i32&) i32 {
  ret copy_of:<i32>(r)
}

fn main() {
  ; --- 类型推断：let x = arr[0] 推断为 T& ---
  #Mut let arr Array<i32> = [10, 20, 30]
  let r = arr[0]            ; 推断 r: i32&
  ; r 是 T&，通过 r 写穿 arr
  modify_by_ref(r)
  println(arr[0].to_i64())            ; 99
  println(arr[1].to_i64())            ; 20（未修改）

  ; --- 函数参数：传 T& 到 T& 参数 ---
  #Mut let arr2 Array<i32> = [5, 15, 25]
  let v i32 = read_ref(arr2[1])
  println(v.to_i64())                 ; 15

  ; --- [T * N] 固定数组 T& 推断 ---
  #Mut let buf [i32 * 3] = [1i32, 2i32, 3i32]
  let b = buf[0]             ; 推断 b: i32&
  modify_by_ref(b)
  println(buf[0].to_i64())            ; 99
  println(buf[1].to_i64())            ; 2（未修改）

  ret;
}
