fn main() {
  val a = 42
  println(a.to_string())
  val e = 42i8
  println(e.to_string())
  val f = 100u64
  println(f.to_string())
  val g = -123i32
  println(g.to_string())
  val h = 3.14
  println(h.to_string())
  val i = 2.5f32
  println(i.to_string())
  val j = 1.0f64
  println(j.to_string())
  val k = -0.5
  println(k.to_string())
  val l = true
  println(l.to_string())
  val m = false
  println(m.to_string())
}
