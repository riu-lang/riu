; P2-8 回归：嵌套成员赋值 a.b.c = ...
; 之前在 compiler_stmt.cpp 中段直接抛 E3046；现支持 RC-free 纯 struct 链。

struct Inner {
  count i32
}

Inner {
  #Static
  fn make(c i32) Inner {
    ret Self {
      .count = c
    }
  }
}

struct Mid {
  inner Inner
}

Mid {
  #Static
  fn make(i Inner) Mid {
    ret Self {
      .inner = i
    }
  }
}

struct Outer {
  state Mid
}

Outer {
  #Static
  fn make(m Mid) Outer {
    ret Self {
      .state = m
    }
  }
}

fn main() {
  #Mut let o Outer = Outer::make(Mid::make(Inner::make(10i32)))
  ; 两段嵌套写
  o.state.inner.count = o.state.inner.count + 5i32
  println(o.state.inner.count)
  ; 复合赋值
  o.state.inner.count += 7i32
  println(o.state.inner.count)
}
