; Phase 3a §5.3 / §7.4：fn 值作高阶 fn 的形参 —— 调用站点 retain captures，callee 出口 release
; 零捕获场景下 captures = null，IR retain/release 走 null guard，runtime no-op
; 多次跨函数边界传递不应崩溃（验 RC 配平）

fn run_twice(f fn(i32)i32, x i32) i32 {
  ret f(x) + f(x + 1)
}

fn forward(g fn(i32)i32, y i32) i32 {
  ; 把 g 再传给 run_twice，验函数值二次跨函数边界
  ret run_twice(g, y)
}

fn main() {
  var inc fn(i32)i32 = (x i32) i32 => x + 1
  var r1 i32 = forward(inc, 10)
  println(r1)     ; (10+1) + (11+1) = 23

  var r2 i32 = forward((x i32) i32 => x * 2, 3)
  println(r2)     ; (3*2) + (4*2) = 14
  ret;
}
