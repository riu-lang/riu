; Phase 4a: T& 借用最小用例 —— 标量参数借用 + 局部 T& 变量 + &x 取址
; 仅测读路径（自动 deref），不测写改被引（4b）

fn add(a i32&, b i32&) i32 {
  ret a + b
}

fn sum_three(x i32&, y i32&, z i32&) i32 {
  ret x + y + z
}

fn main() {
  var x i32 = 10
  var y i32 = 20
  var z i32 = 30

  ; 实参取址显式
  println(add(&x, &y).to_string())

  ; 局部 T& 变量绑定
  var rx i32& = &x
  println(rx.to_string())

  ; T& 拷贝绑定（不写 &）
  var rx2 i32& = rx
  println(rx2.to_string())

  ; 多个 T& 参数
  println(sum_three(&x, &y, &z).to_string())
}
