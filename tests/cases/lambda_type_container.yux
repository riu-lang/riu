; Phase 1 §3.7 / §5.5：Array<fn> / Rc<fn> / 元组 / 借用合法
; Weak<fn> 禁见 lambda_type_weak_fn

fn main() {
  ; Array<fn> 合法
  #Mut let arr Array<fn()i32> = []

  ; Rc<fn> 合法
  #Mut let b Rc<fn()i32>

  ; 元组成员位
  #Mut let p (fn()i32, i32)

  ; 借用一个 fn 值（紧贴 retType 末尾的 &）
  #Mut let fr fn(i32)i32&

  ; 嵌套 Array<fn(...) fn(i32)i32>
  #Mut let nested Array<fn()fn(i32)i32> = []

  println("ok")
  ret;
}
