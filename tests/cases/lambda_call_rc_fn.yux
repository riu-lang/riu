; Phase 3c §7.4：Rc<fn(...)R> —— Rc 内层是 fat-ptr 16 字节；callee Rc<fn> 自动解引 + 调用
; payload = handle + 8 字节，其上存放 { fn_ptr, captures }；零捕获 captures = null。
; 句柄复制 + retain，析构时 _box_release 释放 fat-ptr 占用的 box，captures 字段顺带 release。

fn main() {
  ; 直接构造 + 调用
  var b Rc<fn(i32)i32> = (x i32) i32 => x + 100
  println(b(5))               ; 105
  println(b(10))              ; 110

  ; 句柄复制：b 与 b2 共享同一 box，调用结果相同
  var b2 Rc<fn(i32)i32> = b
  println(b2(7))              ; 107

  ; 重赋：旧 box release，新 box +1
  b = (x i32) i32 => x * 3
  println(b(4))               ; 12

  ; 通过原句柄 b2 仍可调旧 box（共享语义）
  println(b2(20))             ; 120
  ret;
}
