; Phase 3d 验证：Array<Box<T>> 元素赋值走 retain-then-release
; arr[0] = q：retain q.handle，release 旧 arr[0].handle（旧值 p 仍由 main 的 p 持有）

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn main() {
  var p Box<Pair> = Pair(10i32, 20i32)
  var q Box<Pair> = Pair(30i32, 40i32)
  var arr Array<Box<Pair>> = [p]
  println(arr[0].a.to_string())
  arr[0] = q
  println(arr[0].a.to_string())
  println(p.a.to_string())
  println(q.b.to_string())
}
