; Phase 2d：在 Dyn<D> 上调 D 没有的方法 → 未定义方法错 (E6016)
draft Greet {
  fn hi()
}

struct G {
  pad i32
}

G {
  #Static
  fn make() G {
    ret Self {
      .pad = 0i32
    }
  }
}

G : Greet {
  fn hi() {
  }
}

fn main() {
  let b Rc<G> = G::make()
  let d Dyn<Greet> = Dyn:<Greet>(b)
  d.bye();
  ret;
}
