; Phase 4b：Dyn<D> 跨函数 by-value 传递，调用站点 vtable 间接调度
; （Dyn<D&> 借用形态待 ast_builder 解锁 Dyn:<D&>(...) 后再补）

#Spec
struct Shape {
  fn area() i64
  fn name() String
}

#Impl(Shape)
struct Square {
  side i64

  #Static
  fn make(s i64) Square {
    ret Self {
      .side = s
    }
  }

  fn area() i64 {
    $.side * $.side
  }
  fn name() String {
    "square"
  }
}

#Impl(Shape)
struct Rect {
  w i64
  h i64

  #Static
  fn make(w i64, h i64) Rect {
    ret Self {
      .w = w
      .h = h
    }
  }

  fn area() i64 {
    $.w * $.h
  }
  fn name() String {
    "rect"
  }
}

fn describe(d Dyn<Shape>) {
  println(d.name())
  println(d.area())
}

fn main() {
  let bs Rc<Square> = Square::make(5i64)
  describe(Dyn:<Shape>(bs))

  let br Rc<Rect> = Rect::make(3i64, 7i64)
  describe(Dyn:<Shape>(br))
}
