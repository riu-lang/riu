struct Vec2 {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 跨类型重载：标量乘法 Vec2 * f64（形参按值）
  fn mul(scalar f64) Vec2 {
    ret Vec2::make($.x * scalar, $.y * scalar)
  }

  ; Self& 形参（仍推荐，与其它 Vec2 运算一致）
  fn plus(other Vec2&) Vec2 {
    ret Vec2::make($.x + other.x, $.y + other.y)
  }
}

fn main() {
  let v = Vec2::make(2.0, 3.0)
  let w = Vec2::make(1.0, 1.0)
  ; Vec2 + Vec2（Ref 形参，自动取址）
  let s = v + w
  ; Vec2 * f64（按值标量形参）
  let t = v * 5.0
  println(s.x)
  println(t.x)
}
