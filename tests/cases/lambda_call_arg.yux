; Phase 2b §4 / §5：lambda 作实参传给高阶 fn
; apply 形参为 fn(i32)i32，body 内对 f 直接调用

fn apply(f fn(i32)i32, x i32) i32 {
  ret f(x)
}

fn main() {
  ; 显式标注的 lambda
  var r1 i32 = apply((x i32) i32 => x + 10, 5)
  println(r1.to_string())

  ; lambda 形参类型从 callee 反推
  var r2 i32 = apply((x) => x * x, 6)
  println(r2.to_string())

  ret;
}
