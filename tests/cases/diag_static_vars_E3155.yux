; DRAFT-static-vars §6: 全局 init 含 try/catch → E3155

; 定义一个错误 enum 供 try/catch 使用
enum E {
  Oops
}

fn fallible_fn() i32 {
  ret 0
}

fn main() {
  ; 这个测试应该通过 AST builder 阶段就报错（编译时拦截）
  ; 全局 let init 含 try/catch
}

; 全局 val init 含 try/catch → E3155
let G i32 = try {
  fallible_fn()
} catch e E {
  0
}
