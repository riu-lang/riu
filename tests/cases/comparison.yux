fn main() {
  println(10 == 5.to_string())
  println(10 == 10.to_string())
  println(10 != 5.to_string())
  println(10 != 10.to_string())
  println(10 > 5.to_string())
  println(10 > 15.to_string())
  println(10 >= 5.to_string())
  println(10 >= 10.to_string())
  println(10 < 5.to_string())
  println(10 < 15.to_string())
  println(10 <= 5.to_string())
  println(10 <= 10.to_string())
}
