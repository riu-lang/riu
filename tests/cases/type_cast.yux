fn main() {
  val a i32 = 10
  val b f64 = a.to_f64()
  println(b.to_string())
  val c i64 = a.to_i64()
  println(c.to_string())
  val d u8 = 100u8
  val e i32 = d.to_i32()
  println(e.to_string())
  val f f64 = 3.7
  val g i32 = f.to_i32()
  println(g.to_string())
  val h i64 = -123i64
  val i i32 = h.to_i32()
  println(i.to_string())
}
