; Phase 8d.3: 分支表达式（if-else / ?? / 一行 if-else）作为 RC 句柄结果时
; 各分支必须用子帧吸收中间临时；结果 phi 由调用方归一为 +1 后登记外层 statement frame。
; 测试覆盖：fresh/fresh、fresh/borrow（混合）、borrow/borrow、`??` 走默认值。

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn make_box(a i32, b i32) Box<Pair> {
  var x Box<Pair> = Pair(a, b)
  ret x
}

; 两支均 fresh：phi 直接是 +1
fn pick_ff(c bool) Box<Pair> {
  ret if c {
    make_box(1i32, 2i32)
  } else {
    make_box(3i32, 4i32)
  }
}

; 一支 fresh、一支 borrow：borrow 支需 retain 归一为 +1
fn pick_fb(c bool, b Box<Pair>) Box<Pair> {
  ret if c {
    make_box(7i32, 8i32)
  } else {
    b
  }
}

; 两支都是 borrow：均需 retain 归一为 +1
fn pick_bb(c bool, b1 Box<Pair>, b2 Box<Pair>) Box<Pair> {
  ret if c {
    b1
  } else {
    b2
  }
}

fn main() {
  ; fresh/fresh
  var p1 Box<Pair> = pick_ff(true)
  println(p1.a.to_string())   ; 1
  var p2 Box<Pair> = pick_ff(false)
  println(p2.a.to_string())   ; 3

  ; fresh/borrow
  var orig Box<Pair> = Pair(11i32, 22i32)
  var p3 Box<Pair> = pick_fb(true, orig)
  println(p3.a.to_string())   ; 7
  var p4 Box<Pair> = pick_fb(false, orig)
  println(p4.a.to_string())   ; 11
  println(orig.a.to_string()) ; 11 —— orig 仍然活

  ; borrow/borrow
  var b1 Box<Pair> = Pair(33i32, 44i32)
  var b2 Box<Pair> = Pair(55i32, 66i32)
  var p5 Box<Pair> = pick_bb(true, b1, b2)
  println(p5.a.to_string())   ; 33
  var p6 Box<Pair> = pick_bb(false, b1, b2)
  println(p6.a.to_string())   ; 55
  println(b1.a.to_string())   ; 33 —— 借用源仍活
  println(b2.a.to_string())   ; 55
}
