; 测试 Box 重赋为构造函数表达式
; 覆盖：Box 上下文驱动构造 + 顶层重赋

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn main() {
  var b Box<Pair> = Pair(7, 8)
  println(b.a.to_string())
  println(b.b.to_string())

  ; 重赋为构造函数表达式（上下文驱动构造）
  b = Pair(9, 10)
  println(b.a.to_string())
  println(b.b.to_string())
}
