fn main() {
  val arr [i32 * 5] = [1, 2, 3, 4, 5]
  println(arr[0].to_string())
  println(arr[4].to_string())
  val bytes [u8 * 4] = [97u8, 98u8, 99u8, 100u8]
  println(bytes[0].to_string())
  println(bytes[3].to_string())
  val bools [bool * 3] = [true, false, true]
  println(bools[0].to_string())
  println(bools[1].to_string())
}
