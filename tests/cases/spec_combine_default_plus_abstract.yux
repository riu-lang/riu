; DRAFT-spec-default-body Phase 4: 一个 spec 默认体 + 另一个纯抽象同 (name, arity) → 默认体顶上, 不冲突.

#Spec
struct A {
  fn act() i32
  fn run() i32 = 42
}

#Spec
struct B {
  fn other() i32
  fn run() i32
}

#Impl(A)
#Impl(B)
struct K {
  v i32

  #Static
  fn make(v i32) K {
    ret Self {
      .v = v
    }
  }

  fn act() i32 {
    $.v
  }

  fn other() i32 {
    $.v + 1
  }
}

fn main() {
  let k K = K::make(7)
  if k.run() == 42 {
    println("ok")
  } else {
    println("bad")
  }
}
