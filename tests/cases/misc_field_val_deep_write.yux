; P1-4: #Val 字段深写允许 (浅不可变 — 仅禁字段本身重赋, 子字段可写)
; 与 diag_field_frozen_deep_write 形成对照: 同样形态 #Frozen 会拒收

struct Config {
    x i32
}

Config {
    #Static
    fn make(x i32) Config {
        ret Self {
            .x = x
        }
    }
}

struct Outer {
    #Val
    cfg Config
}

Outer {
    #Static
    fn make(c Config) Outer {
        ret Self {
            .cfg = c
        }
    }

    fn bump() {
        $.cfg.x = $.cfg.x + 1
    }

    fn show() {
        println($.cfg.x.to_string())
    }
}

fn main() {
    #Mut let c = Config::make(10)
    #Mut let o = Outer::make(c)
    o.show()
    o.bump()
    o.show()
    ret;
}
