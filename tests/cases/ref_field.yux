; Phase 4c: & 扩展到 &$.field / &box.field / RC 字段链
; - &p.field（结构体局部，已有，做回归保护）
; - &$.field（方法内 self 字段借用）
; - &box.field（Box 自动解引用到 payload 字段）
; - &h.inner.x（RC 字段链：Holder.inner 是 Box<P>）

struct P {
  x i32
  y i32
}

P {
  fn P(x i32, y i32) {
    $.x = x
    $.y = y
  }
  fn bump_x() {
    add1(&$.x)
  }
}

struct Holder {
  inner Box<P>
}

Holder {
  fn Holder(inner Box<P>) {
    $.inner = inner
  }
}

fn add1(r i32&) {
  r = r + 1
}

fn main() {
  ; &p.field（普通局部 struct）
  var p P = P(10i32, 20i32)
  add1(&p.x)
  println(p.x.to_string())   ; 11
  println(p.y.to_string())   ; 20

  ; &box.field（Box 自动 deref）
  var b Box<P> = P(100i32, 200i32)
  add1(&b.x)
  println(b.x.to_string())   ; 101
  println(b.y.to_string())   ; 200

  ; RC 字段链：&h.inner.x —— h 是栈上 Holder，inner 是 Box<P>
  var h Holder = Holder(b)
  add1(&h.inner.x)
  println(b.x.to_string())   ; 102（共享同 block）

  ; &$.field（方法内）
  p.bump_x()
  println(p.x.to_string())   ; 12
}
