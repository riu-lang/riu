;
; 原意: Holder 形参 Rc<CopyPair>, 实参传 CopyPair → 无匹配构造器
;
; struct CopyPair { a i32  b i32 }
; CopyPair {
;   #Static fn make(a i32, b i32) CopyPair {
;     ret Self { .a = a  .b = b }
;   }
; }
; struct Holder { payload Rc<CopyPair>  tag i32 }
; Holder {
;   #Static fn make(p Rc<CopyPair>, t i32) Holder {
;     ret Self { .payload = p  .tag = t }
;   }
; }
; fn main() {
;   #Mut let h Holder = Holder::make(CopyPair::make(5i32, 6i32), 100i32)
; }

