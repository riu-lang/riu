; #Static fn 调用站点实参类型不匹配 → E3131
; (Phase 6E 恢复; 6D 删 E6033 ctor 路径后由 #Static fn 调用点接管)

struct CopyPair {
  a i32
  b i32

  #Static
  fn make(a i32, b i32) CopyPair {
    ret Self {
      .a = a
      .b = b
    }
  }
}

struct Holder {
  payload Rc<CopyPair>
  tag i32

  #Static
  fn make(p Rc<CopyPair>, t i32) Holder {
    ret Self {
      .payload = p
      .tag = t
    }
  }
}

fn main() {
  ; 实参 CopyPair (栈值) 喂给形参 Rc<CopyPair> (堆句柄) → 类型不匹配
  #Mut let h Holder = Holder::make(CopyPair::make(5i32, 6i32), 100i32)
}
