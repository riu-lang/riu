; Phase 6: 构造函数定性赋值分析 (DAA) 正例
; 覆盖：顺序写、RHS 引用前字段、分支全赋、嵌套字段写入

struct Point {
  x i32
  y i32
}

Point {
  fn Point(x i32, y i32) {
    $.x = x
    ; RHS 读已 Init 字段
    $.y = $.x + y
  }
}

struct Tagged {
  tag i32
  bx Box<Point>
}

Tagged {
  fn Tagged(t i32, p Box<Point>) {
    $.tag = t
    $.bx = p
  }
}

struct Branchy {
  v i32
  w i32
}

Branchy {
  ; 分支全赋：if/else 都写 $.v 和 $.w
  fn Branchy(c bool, a i32, b i32) {
    if c {
      $.v = a
      $.w = a + 1i32
    } else {
      $.v = b
      $.w = b - 1i32
    }
  }
}

fn main() {
  val p = Point(10i32, 5i32)
  println(p.x.to_string())
  println(p.y.to_string())

  var bp Box<Point> = Point(100i32, 200i32)
  val tg = Tagged(7i32, bp)
  println(tg.tag.to_string())
  println(tg.bx.x.to_string())

  val b1 = Branchy(true, 3i32, 0i32)
  println(b1.v.to_string())
  println(b1.w.to_string())

  val b2 = Branchy(false, 0i32, 50i32)
  println(b2.v.to_string())
  println(b2.w.to_string())
}
