; Phase 5 验证：Weak upgrade 失败路径
; make_weak 内 box 在 fn 结束时 strong--=0 → payload 析构；返回的 weak 持 weak block
; caller 调 upgrade(w) → null；?.field 短路；?? -1 拿到 fallback
; 同步对比成功路径：活 box 同帧 upgrade → Some，?.field → 真值

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn make_weak() Weak<Pair> {
  var b Box<Pair> = Pair(11i32, 22i32)
  var w Weak<Pair> = b
  ret w
}

fn main() {
  ; 失败路径：box 已死
  var w Weak<Pair> = make_weak()
  var maybe Box<Pair>? = upgrade(w)
  var v i32? = maybe?.a
  println((v ?? -1i32).to_string())

  ; 成功路径：box 还活着
  var b2 Box<Pair> = Pair(33i32, 44i32)
  var w2 Weak<Pair> = b2
  var maybe2 Box<Pair>? = upgrade(w2)
  var v2 i32? = maybe2?.a
  println((v2 ?? -1i32).to_string())
}
