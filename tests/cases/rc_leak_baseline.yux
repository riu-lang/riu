; Phase 8a：用 rc_leak_count() 量化各路径的 RC Block 泄漏。
; 每个测试块结束后，调用 rc_leak_count() 打印当前未释放的 Block 数。
; 期望（理想）：每行都是 0。当前实际值由 8a 量化输出固定下来；8b/8c/8d 修复后逐项归零。

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn make_box() Box<Pair> {
  var b Box<Pair> = Pair(1, 2)
  ret b
}

fn make_array() Array<i32> {
  var a Array<i32> = [10, 20, 30]
  ret a
}

fn pass_box(b Box<Pair>) {
  println(b.a.to_string())
}

fn block_box() {
  var b Box<Pair> = Pair(7, 8)
  println(b.a.to_string())
}

fn block_box_from_call() {
  var b Box<Pair> = make_box()
  println(b.a.to_string())
}

fn block_box_copy() {
  var b1 Box<Pair> = Pair(3, 4)
  var b2 Box<Pair> = b1
  println(b2.a.to_string())
}

fn block_array_literal() {
  var a Array<i32> = [1, 2, 3]
  println(a.len().to_string())
}

fn block_array_from_call() {
  var a Array<i32> = make_array()
  println(a.len().to_string())
}

fn block_array_copy() {
  var a1 Array<i32> = [5, 6, 7]
  var a2 Array<i32> = a1
  println(a2.len().to_string())
}

fn block_pass_box_temp() {
  pass_box(make_box())
}

fn block_pass_box_var() {
  var b Box<Pair> = Pair(11, 11)
  pass_box(b)
}

fn main() {
  println("== baseline ==")
  println(rc_leak_count().to_string())

  block_box()
  println("after block_box:")
  println(rc_leak_count().to_string())

  block_box_from_call()
  println("after block_box_from_call:")
  println(rc_leak_count().to_string())

  block_box_copy()
  println("after block_box_copy:")
  println(rc_leak_count().to_string())

  block_array_literal()
  println("after block_array_literal:")
  println(rc_leak_count().to_string())

  block_array_from_call()
  println("after block_array_from_call:")
  println(rc_leak_count().to_string())

  block_array_copy()
  println("after block_array_copy:")
  println(rc_leak_count().to_string())

  block_pass_box_temp()
  println("after block_pass_box_temp:")
  println(rc_leak_count().to_string())

  block_pass_box_var()
  println("after block_pass_box_var:")
  println(rc_leak_count().to_string())
}
