; Phase 1 §3.5：fn 类型走 §3.9 透明类型别名，无新机制
; 别名 / 泛型别名展开后与字面写出的 fn 类型等同

Callback = fn(s String)bool
Pred<T> = fn(x T)bool
Op2<A, B> = fn(a A, b B)A

fn main() {
  #Mut let c Callback
  #Mut let pi Pred<i32>
  #Mut let ps Pred<String>
  #Mut let op Op2<i32, i32>
  ; 嵌套：Pred<T> 内 T 替换为 fn 类型
  #Mut let nested Pred<fn()i32>
  println("ok")
  ret;
}
