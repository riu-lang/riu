; Phase 1d.1 验证：Weak<T> 基础生命周期
; 覆盖：Weak<T> 从 Box<T> 构造、weak++、Weak 析构 _weak_release
; 析构序列（FILO）：w 先析构 → weak-- = 1，block 留存
;                    b 后析构 → strong-- = 0，weak-- = 0，block free
; 没有 leak / 双 free 时程序正常打印并退出 0

fn main() {
  var b Box<i64> = 42i64
  var w Weak<i64> = b
  println("ok")
}
