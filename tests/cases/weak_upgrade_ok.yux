; Phase 1d.2 验证：upgrade 成功路径
; b 仍存活时 upgrade(w) 返回 Some(Box{handle})；strong 加 1
; 析构序列（FILO）：
;   maybe Box?  → strong--（has=true 时）  // 当前未实现 Nullable 析构 → TODO Phase 3
;   w Weak     → weak--
;   b Box      → strong--（=1 → 仍 >0，不 free）
; 注：本用例只验证 upgrade 编译 + 运行不崩；正确 RC 收尾依赖 Phase 3 Nullable 析构

fn main() {
  var b Box<i64> = 42i64
  var w Weak<i64> = b
  var maybe Box<i64>? = upgrade(w)
  println("upgraded")
}
