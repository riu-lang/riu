; Phase 5 验证：&box → Box<T>& 句柄借用
; 覆盖：实参 &box 透传 Box<T>& 形参；callee 用 b.field / b.method() 自动 deref
;       通过句柄借用修改 payload，caller 端可见

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }

  fn set_a(v i32) {
    $.a = v
  }

  fn sum() i32 {
    ret $.a + $.b
  }
}

fn show(b Box<Pair>&) {
  println(b.a.to_string())
  println(b.sum().to_string())
}

fn bump(b Box<Pair>&) {
  b.set_a(99i32)
}

fn main() {
  var p Box<Pair> = Pair(10i32, 20i32)
  show(&p)
  bump(&p)
  println(p.a.to_string())
  show(&p)
}
