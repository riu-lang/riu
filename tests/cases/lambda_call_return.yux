; Phase 3a §5.3：fn 值作返回类型 —— callee 在 ret 处构造 fat-ptr，按 §8.5 callee-clean 交出所有权
; 零捕获场景：返回的 fat-ptr captures = null；caller 接收后多次调用并最终析构

fn make_inc() fn(i32)i32 {
  ret (x i32) i32 => x + 1
}

fn make_const(v i32) fn(i32)i32 {
  ; 注意：v 当前是捕获 → Phase 4 才支持；这里仅返回零捕获 lambda
  ret (x i32) i32 => x * 2
}

fn main() {
  #Mut let f fn(i32)i32 = make_inc()
  println(f(10))   ; 11
  println(f(99))   ; 100

  #Mut let g fn(i32)i32 = make_const(0)
  println(g(7))    ; 14

  ; 直接调用返回值（链式）
  println(make_inc()(41))   ; 42
  ret;
}
