; DRAFT-spec-reflect §6: Field.value 读路径回归
; 使用 [N] 索引 (新 [Field& * N]& 类型)

struct Point {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }

  fn sum() i32 {
    ret Point::fields[0].value + Point::fields[1].value
  }
}

fn main() {
  let p Point = Point::make(3, 5)
  println(p.sum().to_string())
}
