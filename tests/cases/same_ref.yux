; Phase 7a 验证：same_ref:<T>(a, b) bool —— 地址相等
; 覆盖：Box / Weak / Array / String 各源类型；句柄共享 vs 独立分配
; 注：T& 源类型暂未覆盖——genericDef 当前用 type 而非 typeWithRef，turbofish 不支持 `<i32&>`
; 注：避开 BUGS.md "Array 声明拷贝漏 retain" 已知缺陷——Array 共享改用同一变量传两次

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn yes_no(b bool) String {
  ret if b {
    "yes"
  } else {
    "no"
  }
}

fn main() {
  ; Box：句柄复制共享 vs 独立 Box
  var p Box<Pair> = Pair(1i32, 2i32)
  var q Box<Pair> = p
  var r Box<Pair> = Pair(1i32, 2i32)
  println(yes_no(same_ref:<Box<Pair>>(p, q)))
  println(yes_no(same_ref:<Box<Pair>>(p, r)))

  ; Weak：从同一 Box 派生 vs 不同 Box 派生
  var w1 Weak<Pair> = p
  var w2 Weak<Pair> = q
  var w3 Weak<Pair> = r
  println(yes_no(same_ref:<Weak<Pair>>(w1, w2)))
  println(yes_no(same_ref:<Weak<Pair>>(w1, w3)))

  ; Array：同变量自比 vs 独立分配（避开 var a2=a1 共享路径的已知 bug）
  var a1 Array<i32> = [1i32, 2i32, 3i32]
  var a3 Array<i32> = [1i32, 2i32, 3i32]
  println(yes_no(same_ref:<Array<i32>>(a1, a1)))
  println(yes_no(same_ref:<Array<i32>>(a1, a3)))

  ; String：同变量自比 (字面量 sentinel block 共享) vs 不同字面量
  var s1 String = "hi"
  println(yes_no(same_ref:<String>(s1, s1)))
}
