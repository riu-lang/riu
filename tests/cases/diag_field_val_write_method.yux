; P1-4: #Val 字段构造期外禁写 (DRAFT-const-mut §6.2)

struct Outer {
    #Val
    tag i32
    extra i32
}

Outer {
    #Static
    fn make(t i32) Outer {
        ret Self {
            .tag = t
            .extra = 0
        }
    }

    fn rename() {
        $.tag = 99
    }
}

fn main() {
    #Mut let o = Outer::make(7)
    o.rename()
    ret;
}
