; DRAFT-spec-default-body Phase 3: 实现者未覆盖带默认体的 spec 方法
; → 默认体 fall-through 编入该类型方法表; 调用按默认体逻辑执行.
; 实现者仅写 cmp; lt 走默认体 `$.cmp(other) < 0`.

#Spec
struct Ord {
  fn cmp(other Self&) i32
  fn lt(other Self&) bool = $.cmp(&other) < 0
}

#Impl(Ord)
struct N {
  v i32

  #Static
  fn make(v i32) N {
    ret Self {
      .v = v
    }
  }

  fn cmp(other N&) i32 {
    $.v - other.v
  }
}

fn main() {
  let a N = N::make(3)
  let b N = N::make(7)
  if a.lt(&b) {
    println("ok")
  } else {
    println("bad")
  }
}
