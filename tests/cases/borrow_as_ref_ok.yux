; v0.4 Phase 5：as_ref 合法用例 —— 取 Box<T> payload 的 T& 借用
; 寿命由 box 局部承担，借用消亡后 box 被释放

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn read_a(p Pair&) i32 {
  ret p.a
}

fn main() {
  var b Box<Pair> = Pair(7, 8)
  val r Pair& = as_ref(b)
  println(r.a.to_string())
  println(read_a(as_ref(b)).to_string())
  ret;
}
