fn main() {
  var buf [u8 * 5] = [0u8 ...]
  println(buf[0].to_string())
  println(buf[4].to_string())
  var arr [i32 * 3] = [0 ... i32]
  println(arr[0].to_string())
  println(arr[2].to_string())
  var flags [bool * 3] = [true, true, true]
  println(flags[0].to_string())
  println(flags[2].to_string())
}
