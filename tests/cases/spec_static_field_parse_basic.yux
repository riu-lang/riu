; DRAFT-spec-reflect Phase 1: spec body 内允许 #Static 字段段 (type-bound 契约).
; 与 fn 签名 / 带默认体 fn 共存; 本用例仅验 parse + AST 接受,
; 不 #Impl 该 spec, 不访问静态字段 (Phase 3 / Phase 4 起才会拉通).

#Spec
struct Bounded {
  #Static
  MIN i32
  #Static
  #Frozen
  MAX i32
  fn span() i32
  fn ok() bool = $.span() > 0
}

fn main() {
  println("ok")
}
