; Phase 5 验证：Box<T> 多句柄共享 payload
; 覆盖：box.field 自动 deref 读、box.method() 自动 deref（receiver = payload）
;       多句柄共享同一 Block（句柄复制 retain，无重复分配）；通过 method 写穿，另一句柄可读

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }

  fn set_a(v i32) {
    $.a = v
  }

  fn sum() i32 {
    ret $.a + $.b
  }
}

fn main() {
  var p Box<Pair> = Pair(10i32, 20i32)
  var q Box<Pair> = p

  ; 句柄共享：q 与 p 指向同一 Block；通过 p.set_a 写，q 看到
  p.set_a(100i32)
  println(q.a.to_string())
  println(q.b.to_string())

  ; 自动 deref：method 调用 receiver = payload
  println(p.sum().to_string())
  println(q.sum().to_string())
}
