; DRAFT-spec-reflect: Field (仅 name) 通过 Type.fields 静态路径访问端到端验证.

struct Point {
  x i32
  y i32
}

struct Rect {
  top_left Point
  size i32
}

fn main() {
  ; Rect::fields → [Field& * 2]&, 遍历取 Field.name
  let fs [Field& * 2]& = Rect::fields
  let f0 Field& = fs[0]
  println(f0.name)
  let f1 Field& = fs[1]
  println(f1.name)
}
