; Phase 4b：Array<Dyn<D>> 收集多个不同 U 的实现，遍历调用同一方法

draft Shape {
  fn area() i64
}

struct Square {
  side i64
}

Square {
  fn Square(s i64) {
    $.side = s
  }
}

Square : Shape {
  fn area() i64 {
    $.side * $.side
  }
}

struct Rect {
  w i64
  h i64
}

Rect {
  fn Rect(w i64, h i64) {
    $.w = w
    $.h = h
  }
}

Rect : Shape {
  fn area() i64 {
    $.w * $.h
  }
}

fn main() {
  var arr Array<Dyn<Shape>> = []
  val b1 Rc<Square> = Square(3i64)
  val b2 Rc<Rect> = Rect(4i64, 5i64)
  val b3 Rc<Square> = Square(6i64)
  arr.push(Dyn:<Shape>(b1))
  arr.push(Dyn:<Shape>(b2))
  arr.push(Dyn:<Shape>(b3))
  println(arr.len())            ; 3
  println(arr[0].area())        ; 9
  println(arr[1].area())        ; 20
  println(arr[2].area())        ; 36
}
