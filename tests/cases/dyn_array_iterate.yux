; Phase 4b：Array<Dyn<D>> 收集多个不同 U 的实现，遍历调用同一方法

#Spec
struct Shape {
  fn area() i64
}

#Impl(Shape)
struct Square {
  side i64

  #Static
  fn make(s i64) Square {
    ret Self {
      .side = s
    }
  }

  fn area() i64 {
    $.side * $.side
  }
}

#Impl(Shape)
struct Rect {
  w i64
  h i64

  #Static
  fn make(w i64, h i64) Rect {
    ret Self {
      .w = w
      .h = h
    }
  }

  fn area() i64 {
    $.w * $.h
  }
}

fn main() {
  #Mut let arr Array<Dyn<Shape>> = []
  let b1 Rc<Square> = Square::make(3i64)
  let b2 Rc<Rect> = Rect::make(4i64, 5i64)
  let b3 Rc<Square> = Square::make(6i64)
  arr.push(Dyn:<Shape>(b1))
  arr.push(Dyn:<Shape>(b2))
  arr.push(Dyn:<Shape>(b3))
  println(arr.len())            ; 3
  println(arr[0].area())        ; 9
  println(arr[1].area())        ; 20
  println(arr[2].area())        ; 36
}
