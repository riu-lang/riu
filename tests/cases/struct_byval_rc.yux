; Phase 3c.2.a 验证：含 RC 句柄字段的非平凡 struct 按 LLVM by-value 传参
; 调用点对每个 RC 字段 retain，callee 末尾 struct 析构释放，引用计数平衡
; observe 内 h.bx 与 caller p 共享同一 Block；observe 返回后 h 与 p 均可继续访问

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

struct Holder {
  bx Box<Pair>
  tag i32
}

Holder {
  fn Holder(bx Box<Pair>, tag i32) {
    $.bx = bx
    $.tag = tag
  }
}

fn observe(h Holder) {
  println(h.bx.a.to_string())
  println(h.bx.b.to_string())
  println(h.tag.to_string())
}

fn main() {
  var p Box<Pair> = Pair(11i32, 22i32)
  var h Holder = Holder(p, 7i32)
  observe(h)
  println(h.bx.a.to_string())
  println(p.b.to_string())
  println(h.tag.to_string())
}
