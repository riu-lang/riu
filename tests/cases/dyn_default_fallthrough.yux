; BUGS.md「Dyn<D> 上调用 spec 默认体 fall-through 方法」回归
; U 未显式实现 m, 但 spec D 提供默认体, SpecImplChecker 登记 fall-through;
; 经 Dyn<D> vtable 派发调用 m, 槽必须指向合成的 U.m, 不能留 null.

#Spec
struct Sign {
  fn raw() i32
  fn is_pos() bool = $.raw() > 0
}

#Impl(Sign)
struct N {
  v i32

  #Static
  fn make(v i32) N {
    ret Self {
      .v = v
    }
  }

  fn raw() i32 {
    $.v
  }
}

fn check(d Dyn<Sign>) {
  if d.is_pos() {
    println("pos")
  } else {
    println("nonpos")
  }
}

fn main() {
  let ra Rc<N> = N::make(3)
  check(Dyn:<Sign>(ra))
  let rb Rc<N> = N::make(0)
  check(Dyn:<Sign>(rb))
  let rc Rc<N> = N::make(0 - 5)
  check(Dyn:<Sign>(rc))
}
