; DRAFT-spec-disambig-at [#1.C]: `$.m@SpecA()` 即便 S 覆盖了 m, 仍 escape 到 spec 默认体.

#Spec
struct A {
  fn m() i32 = 10
}

#Impl(A)
struct S {
  v i32

  #Static
  fn make() S {
    ret Self {
      .v = 0
    }
  }

  fn m() i32 = 99

  fn override_call() i32 {
    $.m()
  }

  fn delegate_call() i32 {
    $.m@A()
  }
}

fn main() {
  let s S = S::make()
  println(s.override_call())
  println(s.delegate_call())
}
