; Bug B 回归: struct 方法体内构造 Dyn:<D>(...) 应正确解析 draft（之前 E1131）

#Spec
struct Greet {
  fn hi() i64
}

#Impl(Greet)
struct G {
  v i64

  #Static
  fn make(v i64) G {
    ret Self {
      .v = v
    }
  }

  fn hi() i64 {
    $.v
  }
}

struct Caller {
  base i64

  #Static
  fn make(b i64) Caller {
    ret Self {
      .base = b
    }
  }

  fn run() {
    let bg Rc<G> = G::make(40i64)
    let d Dyn<Greet> = Dyn:<Greet>(bg)
    println(d.hi() + $.base)
  }
}

fn main() {
  let c Caller = Caller::make(2i64)
  c.run()
}
