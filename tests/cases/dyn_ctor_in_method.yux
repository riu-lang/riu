; Bug B 回归: struct 方法体内构造 Dyn:<D>(...) 应正确解析 draft（之前 E1131）

draft Greet {
  fn hi() i64
}

struct G {
  v i64
}

G {
  fn G(v i64) {
    $.v = v
  }
}

G : Greet {
  fn hi() i64 {
    $.v
  }
}

struct Caller {
  base i64
}

Caller {
  fn Caller(b i64) {
    $.base = b
  }

  fn run() {
    val bg Box<G> = G(40i64)
    val d Dyn<Greet> = Dyn:<Greet>(bg)
    println(d.hi() + $.base)
  }
}

fn main() {
  val c Caller = Caller(2i64)
  c.run()
}
