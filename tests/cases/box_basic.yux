; Phase 1a 验证：Box 单 handle 布局 + 双计数 RC 协议
; 覆盖：Box 构造、Box 字段读、Box 句柄复制（共享语义）、作用域析构

struct Pair {
  a i32
  b i32
}

Pair {
  fn Pair(a i32, b i32) {
    $.a = a
    $.b = b
  }
}

fn main() {
  var p Box<Pair> = Pair(11, 22)
  println(p.a.to_string())
  println(p.b.to_string())

  ; 句柄复制：q 与 p 指向同一 Block（retain 句柄）
  var q Box<Pair> = p
  println(q.a.to_string())
  println(q.b.to_string())
}
