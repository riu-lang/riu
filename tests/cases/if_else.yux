fn main() {
  val a = 10
  val b = 20
  val max = if a > b {
    a
  } else {
    b
  }
  println(max.to_string())
  val score = 85
  val grade = if score >= 90 {
    1
  } elif score >= 80 {
    2
  } elif score >= 70 {
    3
  } else {
    4
  }
  println(grade.to_string())
  if a > 0 {
    println(a.to_string());
  }
}
