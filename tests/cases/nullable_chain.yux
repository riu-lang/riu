struct N {
  v i32
}

N {
  fn N(v i32) {
    self.v = v
  }
}

fn main() {
  var n N = N(7)
  var maybeN N? = n
  var v1 i32? = maybeN?.v
  var v1d i32 = v1 ?? -1i32
  println(v1d.to_string())

  var emptyN N? = null
  var v2 i32? = emptyN?.v
  var v2d i32 = v2 ?? -99i32
  println(v2d.to_string())
}
