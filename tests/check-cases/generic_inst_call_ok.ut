; 泛型调用签名实例化：显式 typeArgs / #Static turbofish / 实例方法（Phase C）
fn id<T>(x T) T {
  x
}

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn set_val(v T) {
    $.val = v
  }
}

fn main() {
  let a i32 = id:<i32>(1)
  #Mut let s Slot<i32> = Slot:<i32>::make(2)
  s.set_val(3)
  ret;
}
