; P1-4: #Frozen 字段构造期外禁写 (DRAFT-const-mut §6.2)

struct Outer {
    #Frozen
    name String
    extra i32

    #Static
    fn make(n String, e i32) Outer {
        ret Self {
            .name = n
            .extra = e
        }
    }

    fn rename(n String) {
        $.name = n  ; check: E3109
    }
}

fn main() {
    #Mut let o = Outer::make("hi", 1)
    o.rename("ho")
    ret;
}
