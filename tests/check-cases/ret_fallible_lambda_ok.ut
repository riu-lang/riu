; F7: fallible lambda 签名 + Function<..., T ! E> 赋值 sema 通过
enum ParseErr {
  Empty
}

fn parse_int(n i32) i32 ! ParseErr {
  if n == 0 {
    ret ParseErr::Empty
  }
  ret n
}

fn main() {
  let f Function<i32, i32 ! ParseErr> = (x i32) i32 ! ParseErr => parse_int(x)!
  let g Function<i32, i32 ! ParseErr> = f
  ret;
}
