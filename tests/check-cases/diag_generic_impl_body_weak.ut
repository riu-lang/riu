; 泛型 impl 体：写出 Slot<i32> 后 Weak<T> 不能从字段值构造 → E3016（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn as_weak() {
    let w Weak<T> = $.val  ; check: E3016
    ret;
  }
}

fn main() {
  let s Slot<i32> = Slot:<i32>::make(1)
  s.as_weak()
  ret;
}
