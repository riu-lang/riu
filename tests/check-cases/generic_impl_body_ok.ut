; 泛型 impl 体：T 实例化为 i32 时 ret / 赋值合法（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  #Static
  fn wrap(v T) Self = Self::make(v)

  fn as_i32() i32 {
    $.val
  }

  fn set_i32(v i32) {
    $.val = v
  }
}

fn main() {
  #Mut let s Slot<i32> = Slot:<i32>::make(1)
  let w Slot<i32> = Slot:<i32>::wrap(3)
  let n i32 = s.as_i32()
  s.set_i32(2)
  ret;
}
