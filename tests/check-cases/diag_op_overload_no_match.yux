struct Point {
  x i32
  y i32

  #Static
  fn make(x i32, y i32) Point {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 方法存在但形参类型不匹配（String ≠ Point），运算符 + 应触发 E3073
  fn plus(other String) Point {
    ret $.clone()
  }

  fn clone() Point {
    ret Point::make($.x, $.y)
  }
}

fn main() {
  let p1 = Point::make(1i32, 2i32)
  let p2 = Point::make(3i32, 4i32)
  let p3 = p1 + p2  ; check: E3073
  println(p3.x)
}
