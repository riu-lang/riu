; 泛型 impl 体：`Self::make` 实例化为 Slot<i32> 后实参类型不符 → E3131
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn bad() {
    let x = Self::make(true)  ; check: E3131
    ret;
  }
}

fn main() {
  #Mut let s Slot<i32> = Slot:<i32>::make(1)
  s.bad()
  ret;
}
