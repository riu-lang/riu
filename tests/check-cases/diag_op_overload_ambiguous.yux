struct Vec2 {
  x f64
  y f64

  #Static
  fn make(x f64, y f64) Vec2 {
    ret Self {
      .x = x
      .y = y
    }
  }

  ; 两个 mul 候选都在同一优先级（按值），造成歧义
  fn mul(scalar f64) Vec2 {
    ret Vec2::make($.x * scalar, $.y * scalar)
  }

  fn mul(factor f64) Vec2 {
    ret Vec2::make($.x * factor, $.y * factor)
  }
}

fn main() {
  let v = Vec2::make(2.0, 3.0)
  let t = v * 5.0  ; check: E6014
  println(t.x)
}
