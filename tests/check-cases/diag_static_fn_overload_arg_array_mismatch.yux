; require-sdk
; #Static fn 同 arity 重载在约定形参上带靶向类型（Phase C E3009）

struct Maker {
  rows Array<Array<i32>>

  #Static
  fn of(tag i32, rows Array<Array<i32>>) Maker {
    ret Self {
      .rows = rows
    }
  }

  #Static
  fn of(tag str, rows Array<Array<i32>>) Maker {
    ret Self {
      .rows = rows
    }
  }
}

fn main() {
  Maker::of(1, [[1, 2], [3, "x"]])  ; check: E3009
}
