; 泛型 impl 体：写出 Slot<Point> 后捕获形参 T → E2029（Phase C）
struct Point {
  x i32
}

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn wrap(x T) {
    let f = () => x  ; check: E2029
    ret;
  }
}

fn main() {
  let p = Point {
    .x = 1
  }
  let s Slot<Point> = Slot:<Point>::make(p)
  s.wrap(p)
  ret;
}
