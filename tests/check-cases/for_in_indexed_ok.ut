; require-sdk
; #2 2.1：`#Impl("Indexed<U>")` 可 for-in，item 为 U&
#Impl("Indexed<i32>")
struct Pair {
    #Mut
    a i32
    #Mut
    b i32

    fn len() usize = 2usize

    fn at(i usize) i32& {
        if i == 0usize {
            ret &$.a
        }
        ret &$.b
    }
}

fn main() {
    #Mut let p = Pair {
        .a = 1
        .b = 2
    }
    #Mut let sum i32 = 0
    for x in p {
        sum = sum + x
        x = x + 10
    }
    ret;
}
