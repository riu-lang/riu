; 泛型 impl 体：写出 Slot<IPair> 后 $.val.2 越界 → E3100（Phase C）
type IPair = (i32, i32)

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn peek() {
    $.val.2  ; check: E3100
    ret;
  }
}

fn main() {
  let p IPair = (1, 2)
  let s Slot<IPair> = Slot:<IPair>::make(p)
  s.peek()
  ret;
}
