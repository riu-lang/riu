; 泛型 impl 体：写出 Slot<S> 后 "${$.val}" → E3026（Phase C）
struct S {
  n i32
}

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn peek() {
    "${$.val}"  ; check: E3026
    ret;
  }
}

fn main() {
  let s Slot<S> = Slot:<S>::make(S {
    .n = 1
  })
  s.peek()
  ret;
}
