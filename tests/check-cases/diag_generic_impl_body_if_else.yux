; 泛型 impl 体：写出 Slot<i32> 后 if 分支 i32 vs String → E3005（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn pick() {
    if true {  ; check: E3005
      $.val
    } else {
      "hello"
    }
    ret;
  }
}

fn main() {
  let s Slot<i32> = Slot:<i32>::make(1)
  s.pick()
  ret;
}
