; F7: Function<..., T ! E> 形参裸调 → E7006
enum ParseErr {
  Empty
}

fn parse_int(n i32) i32 ! ParseErr {
  if n == 0 {
    ret ParseErr::Empty
  }
  ret n
}

fn run(f Function<i32, i32 ! ParseErr>) i32 {
  #Mut let x i32 = f(1)  ; check: E7006
  ret x
}

fn main() {
  let f Function<i32, i32 ! ParseErr> = (x i32) i32 ! ParseErr => parse_int(x)!
  run(f)
  ret;
}
