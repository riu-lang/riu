; 泛型 impl 体：写出 Slot<i32> 后 match $.val → E2022（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn peek() {
    match $.val {  ; check: E2022
      else => 0
    }
    ret;
  }
}

fn main() {
  let s Slot<i32> = Slot:<i32>::make(1)
  s.peek()
  ret;
}
