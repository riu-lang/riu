; require-sdk
; Iter<U, E> 且 E 非 SDK End：不在 try / 无同型 ! → E7006
enum NetErr {
    Fail
}

#Impl("Iter<i32, NetErr>")
struct Stream {
    _n i32

    fn next() IterItem<i32, NetErr> {
        ret IterItem:<i32, NetErr>::End
    }
}

fn main() {
    let s = Stream {
        ._n = 0
    }
    for x in s { ; check: E7006
        break;
    }
    ret;
}
