; 泛型 impl 体：写出 Slot<i32> 后 $.val == / < 合法（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn eq_val(other T) bool {
    ret $.val == other
  }

  fn lt_val(other T) bool {
    ret $.val < other
  }
}

fn main() {
  let s Slot<i32> = Slot:<i32>::make(1)
  s.eq_val(2)
  s.lt_val(2)
  ret;
}
