; 泛型 impl 体：写出 Slot<Weak<i32>> 后 $.val == other → E3078（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn eq_val(other T) {
    $.val == other  ; check: E3078
    ret;
  }
}

fn main() {
  #Mut let b Rc<i32> = 10i32
  #Mut let w Weak<i32> = b
  let s Slot<Weak<i32>> = Slot:<Weak<i32>>::make(w)
  s.eq_val(w)
  ret;
}
