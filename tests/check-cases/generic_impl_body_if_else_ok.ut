; 泛型 impl 体：写出 Slot<i32> 后 if 两臂同为 T 合法（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn pick(other T) T {
    ret if true {
      $.val
    } else {
      other
    }
  }
}

fn main() {
  let s Slot<i32> = Slot:<i32>::make(1)
  s.pick(2)
  ret;
}
