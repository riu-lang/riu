; 3.6: T ! E 的 E 是完整类型；Box<i32> 与 Box<i64> 分得开
enum Box<T> {
  V(T)
}

fn parse_i32() i32 ! Box<i32> {
  if true {
    ret 1
  }
  ret Box:<i32>::V(0)
}

fn parse_i64() i32 ! Box<i64> {
  ret Box:<i64>::V(2)
}

fn wrap_i32() i32 ! Box<i32> {
  ret parse_i32()!
}

fn main() {
  let a i32 = try {
    parse_i32()
  } catch e Box<i32> {
    match e {
      Box::V(v) => v
    }
  }
  let b i32 = try {
    parse_i64()
  } catch e Box<i64> {
    match e {
      Box::V(v) => 0
    }
  }
  let c i32 = try {
    wrap_i32()
  } catch e Box<i32> {
    0
  }
  ret;
}
