; 泛型 impl 体：写出 Slot<Color> 后 match $.val 合法（Phase C）
enum Color {
  Red
  Green
}

struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn as_i32() i32 {
    ret match $.val {
      Color::Red => 1
      Color::Green => 2
    }
  }
}

fn main() {
  let s Slot<Color> = Slot:<Color>::make(Color::Red)
  s.as_i32()
  ret;
}
