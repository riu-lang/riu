; require-sdk
; 泛型 impl 体：写出 Slot<Ptr> 后 $.val < other → E3073（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn lt_val(other T) {
    $.val < other  ; check: E3073
    ret;
  }
}

fn main() {
  let s Slot<Ptr> = Slot:<Ptr>::make(ptr_from_addr(1u64))
  s.lt_val(ptr_from_addr(2u64))
  ret;
}
