; 泛型 impl 体：写出 Slot<bool> 后 $.val && / || 合法（Phase C）
struct Slot<T> {
  val T

  #Static
  fn make(v T) Self {
    Self {
      .val = v
    }
  }

  fn and_val(other T) bool {
    ret $.val && other
  }

  fn or_val(other T) bool {
    ret $.val || other
  }
}

fn main() {
  let s Slot<bool> = Slot:<bool>::make(true)
  s.and_val(false)
  s.or_val(false)
  ret;
}
