; require-sdk
; §4.9.1.4 / §4.9.3.5 / §4.12.2.3：#NoReturn 臂流终止，不参与类型合并

enum Color {
  Red
  Green
}

enum Boom {
  X
}

fn give() String ! Boom {
  ret "ok"
}

#NoReturn
fn die() {
  abort()
}

fn main() {
  let a String = if true { "a" } else { abort() }
  let b String = if true { "b" } else { die() }
  let c String = if true {
    "c"
  } else {
    abort();
  }
  let k Color = Color::Red
  let d String = match k {
    Color::Red => "d"
    Color::Green => abort()
  }
  let e String = match k {
    Color::Red => "e"
    Color::Green => {
      die();
    }
  }
  let f String = try {
    give()
  } catch e Boom {
    abort()
  }
  println(a)
  println(b)
  println(c)
  println(d)
  println(e)
  println(f)
  ret;
}
