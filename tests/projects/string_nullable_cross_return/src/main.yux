use yux.core.*
use codec.*

fn _churn() {
  loop i usize = 0 {
    if i >= 64 {
      break;
    }
    let _junk String = String::from_codepoint(c'x')
    i += 1
  }
}

fn main() {
  let hi String = "hi"
  let hb Array<u8> = hi.to_bytes()
  let back String? = decode(&hb)
  _churn()
  println(back.get())

  let z String = "z"
  let zb Array<u8> = z.to_bytes()
  let zback String? = decode(&zb)
  _churn()
  println(zback.get())

  let w String? = wrap_cp(c'z')
  _churn()
  println(w.get())
}
