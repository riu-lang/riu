; #NoReturn 臂作 if / match / try 表达式值：不参与类型合并，不写 dummy

enum Color {
  Red
  Green
}

enum Boom {
  X
}

fn give() String ! Boom {
  ret "ok"
}

#NoReturn
fn die() {
  exit(1)
}

fn main() {
  let a String = if true { "a" } else { exit(1) }
  println(a)
  let b String = if false { die() } else { "b" }
  println(b)
  let c String = if true {
    "c"
  } else {
    exit(1);
  }
  println(c)
  let k Color = Color::Red
  let d String = match k {
    Color::Red => "d"
    Color::Green => exit(1)
  }
  println(d)
  let e String = match k {
    Color::Red => "e"
    Color::Green => {
      panic("no")
    }
  }
  println(e)
  let f String = try {
    give()
  } catch err Boom {
    exit(1)
  }
  println(f)
}
