use yux.core.*

; §12.6 Box<T> 自动 forward 已实现 draft：等价于 §8.6.7.3 自动解引用 + 方法分发归一。
; 验证 Box<Counter>.show() 自动解引用到 Counter 的 Show 实现。

draft Show {
    fn show() String
}

struct Counter {
    n i32
}

Counter {
    fn Counter(n i32) {
        $.n = n
    }
}

Counter : Show {
    fn show() String {
        $.n.to_string()
    }
}

fn main() {
    var b Box<Counter> = Counter(7i32)
    val s = b.show()
    println(s)
}
