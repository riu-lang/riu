use yux.core.*

draft Show {
    fn show() String
}

struct Counter {
    n i32
}

Counter {
    #Static
    fn make(n i32) Counter {
        ret Self {
            .n = n
        }
    }
}

Counter : Show {
    fn show() String {
        $.n.to_string()
    }
}

struct Greeter {
    msg String
}

Greeter {
    #Static
    fn make(msg String) Greeter {
        ret Self {
            .msg = msg
        }
    }
}

Greeter : Show {
    fn show() String {
        $.msg
    }
}

fn say<T : Show>(x T) {
    let s = x.show()
    println(s)
}

fn main() {
    let c = Counter::make(42)
    say(c)
    let g = Greeter::make("hi")
    say(g)
}
