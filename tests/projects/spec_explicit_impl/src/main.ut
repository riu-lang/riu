use riu.core.*

#Spec
struct Show {
    fn show() String
}

#Impl(Show)
struct Counter {
    n i32

    #Static
    fn make(n i32) Counter {
        ret Self {
            .n = n
        }
    }

    fn show() String {
        $.n.to_string()
    }
}

#Impl(Show)
struct Greeter {
    msg String

    #Static
    fn make(msg String) Greeter {
        ret Self {
            .msg = msg
        }
    }

    fn show() String {
        $.msg
    }
}

fn say<T : Show>(x T) {
    let s = x.show()
    println(s)
}

fn main() {
    let c = Counter::make(42)
    say(c)
    let g = Greeter::make("hi")
    say(g)
}
