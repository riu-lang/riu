; 用户项目：`use yux.io` 命中 SDK 已加载模块；全限定不靠扁平

use yux.io

fn show_missing(tag String, e io.IoErr) {
  match e {
    io.IoErr::NotFound => println(tag)
    io.IoErr::Eof => println("eof")
    io.IoErr::AccessDenied => println("denied")
    io.IoErr::InvalidUtf8 => println("utf8")
    io.IoErr::Other(code) => println("other")
  }
}

fn main() {
  let aliasPath String = "_yux_proj_alias_nope.txt"
  try {
    io.read_file(&aliasPath)
    println("unexpected-alias")
  } catch e io.IoErr {
    show_missing("ok-alias", e)
  }
  let fqPath String = "_yux_proj_fq_nope.txt"
  try {
    yux.io.read_file(&fqPath)
    println("unexpected-fq")
  } catch e io.IoErr {
    show_missing("ok-fq", e)
  }
  println(yux.core.math.abs(-4))
}
