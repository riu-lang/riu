; 本文件 enum IoErr 盖住裸名；SDK IoErr 走路径（含 match variant）
use yux.core.*
use yux.io.*

enum IoErr {
  Mine
}

fn show(e IoErr) {
  match e {
    IoErr::Mine => println(1)
  }
}

fn show_sdk(e io.IoErr) {
  match e {
    io.IoErr::NotFound => println(2)
    io.IoErr::Eof => println(3)
    io.IoErr::AccessDenied => println(4)
    io.IoErr::InvalidUtf8 => println(5)
    io.IoErr::Closed => println(6)
    io.IoErr::Other(code) => println(code)
  }
}

fn take_sdk(e io.IoErr) {
}

fn main() {
  show(IoErr::Mine)
  show_sdk(io.IoErr::NotFound)
}
