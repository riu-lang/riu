use yux.core.*

; 回归：非泛型 struct 的泛型方法只在调用时按方法类型实参单态化。
struct GenericMethodHost {
    marker i32

    fn accept<T : ToString>(value T) {
        let rendered String = value.to_string()
    }
}

fn main() {
    let host = GenericMethodHost {
        .marker = 7
    }
    host.accept:<i32>(42)
    host.accept(99i64)
    println(host.marker)
}
