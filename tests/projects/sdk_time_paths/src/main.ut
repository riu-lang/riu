; 用户项目：`use riu.time` 命中 SDK 已加载模块；全限定不靠扁平

use riu.time

fn main() {
  let d time.Duration = time.Duration::from_ms(1500)
  println(d.as_secs())
  println(time.Duration::from_secs(90).to_string())
  let opt time.DateTime? = time.DateTime::from_ymd_hms(2026, 9, 12, 0, 0, 0)
  if opt.has() {
    println(opt.get().to_string())
  }
  let a time.Instant = time.Instant::now()
  let b time.Instant = riu.time.Instant::now()
  if b.duration_since(&a).as_ns() >= 0i64 {
    println("ok-mono")
  }
}
