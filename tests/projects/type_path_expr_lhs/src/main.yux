use yux.core.*
use geom

fn main() {
    let p = geom.Point {
        .x = 3
        .y = 4
    }
    println(p.sum())
    let o = geom.Point::origin()
    println(o.sum())
    let c = geom.Color::Red
    let n = match c {
        geom.Color::Red => 1
        geom.Color::Blue => 2
    }
    println(n)
    println(geom.Counter::TOTAL)
    geom.Counter::TOTAL = 7
    println(geom.Counter::TOTAL)
}
