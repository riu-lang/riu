{
  "name": "yux-vscode",
  "displayName": "yux-vscode",
  "description": "Yux language support for VS Code (LSP client)",
  "version": "0.5.1",
  "author": "yux-lang",
  "repository": "https://github.com/yux-lang/yux",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yux"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Yux",
      "properties": {
        "yux.executablePath": {
          "type": "string",
          "default": "",
          "description": "yux 语言服务可执行文件路径。留空则使用 PATH 中的 `yux-lsp`（Windows 为 `yux-lsp.exe`）。"
        }
      }
    },
    "configurationDefaults": {
      "[yux]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "languages": [
      {
        "id": "yux",
        "aliases": [
          "yux",
          "Yux"
        ],
        "extensions": [
          ".yux"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yux",
        "scopeName": "source.yux",
        "path": "./syntaxes/yux.tmLanguage.json"
      },
      {
        "scopeName": "markdown.yux.codeblock",
        "path": "./syntaxes/yux.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yux": "yux"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
