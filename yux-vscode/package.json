{
  "name": "yux-vscode",
  "displayName": "yux-vscode",
  "description": "Yux language support for VS Code",
  "version": "0.1.1",
  "author": "yux-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "capabilities": {
    "definitionProvider": true,
    "documentSymbolProvider": true,
    "referencesProvider": true,
    "completionProvider": {
      "resolveProvider": false,
      "triggerCharacters": [".", " ", "(", "{"]
    }
  },
  "activationEvents": [
    "onLanguage:yux"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yux",
        "aliases": [
          "yux",
          "Yux"
        ],
        "extensions": [
          ".yux"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yux",
        "scopeName": "source.yux",
        "path": "./syntaxes/yux.tmLanguage.json"
      },
      {
        "scopeName": "markdown.yux.codeblock",
        "path": "./syntaxes/yux.markdown.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.yux": "yux"
        }
      }
    ],
    "commands": [
      {
        "command": "yux-vscode.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
