{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "yux",
  "scopeName": "source.yux",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#codepoints" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#generics" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.yux",
          "begin": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "support.type.user-defined.yux" },
            "2": { "name": "punctuation.definition.generic.begin.yux" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.yux" }
          },
          "patterns": [
            { "include": "#types" },
            { "include": "#generics" },
            {
              "name": "punctuation.separator.comma.yux",
              "match": ","
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.yux",
          "match": "^\\s*/[^\\r\\n]*"
        },
        {
          "name": "comment.line.end.yux",
          "match": "\\s;[^\\r\\n]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.yux",
          "match": "\\b(if|elif|else)\\b"
        },
        {
          "name": "keyword.control.loop.yux",
          "match": "\\b(loop|break)\\b"
        },
        {
          "name": "keyword.control.flow.yux",
          "match": "\\bret\\b"
        },
        {
          "name": "keyword.declaration.yux",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.other.struct.yux",
          "match": "\\bstruct\\b"
        },
        {
          "name": "keyword.other.extern.yux",
          "match": "\\bextern\\b"
        },
        {
          "name": "constant.language.boolean.yux",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.yux",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.yux",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.modifier.yux",
          "match": "\\b(var|val|cval)\\b"
        }
      ]
    },
    "codepoints": {
      "patterns": [
        {
          "name": "constant.character.codepoint.yux",
          "match": "c'(?:\\\\[nrtvb0\\\\'\"]|[^\\\\'])'",
          "captures": {
            "0": { "name": "constant.character.codepoint.yux" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.yux",
          "match": "r\"[^\"]*\""
        },
        {
          "name": "string.quoted.double.yux",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yux",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.yux",
          "match": "[-+]?(?:\\d[\\d_]*\\.[\\d_]+(?:[eE][-+]?[\\d_]+)?[fF](?:32|64)?|\\d[\\d_]*\\.[\\d_]+[eE][-+]?[\\d_]+[fF]?(?:32|64)?)"
        },
        {
          "name": "constant.numeric.hex.yux",
          "match": "[-+]?0[xX][\\da-fA-F_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.octal.yux",
          "match": "[-+]?0[oO][0-7_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.binary.yux",
          "match": "[-+]?0[bB][01_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.integer.yux",
          "match": "[-+]?\\d[\\d_]*[iu]?(?:8|16|32|64)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.yux",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.compound.yux",
          "match": "(\\+=|-=|\\*=|/=|%=|>>=|<<=)"
        },
        {
          "name": "keyword.operator.arithmetic.yux",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.yux",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.assignment.yux",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.yux",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.yux",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.other.yux",
          "match": "[!?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.yux",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.yux",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.yux",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.yux",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.yux",
          "match": "\\."
        },
        {
          "name": "punctuation.terminator.semicolon.yux",
          "match": ";"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.yux",
          "match": "\\b(bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b"
        },
        {
          "name": "support.type.generic.yux",
          "match": "\\b(Ref|Box|Ptr|Array)\\b"
        },
        {
          "name": "support.type.user-defined.yux",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.yux",
          "match": "\\bfn\\s+([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.yux" }
          }
        },
        {
          "name": "entity.name.function.call.yux",
          "match": "\\b([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.yux",
          "match": "\\b[a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*\\b"
        }
      ]
    }
  }
}
