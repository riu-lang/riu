config("riu_ast_public") {
  include_dirs = [
    "//riu",
    "//riu/include",
    "//riu/ast/gen",
    "//third_party/toml11/single_include",
    "//third_party/utfcpp/source",
  ]
}

static_library("riu_ast") {
  public_configs = [ ":riu_ast_public" ]
  public_deps = [ "//build/third_party:antlr4_static" ]

  sources = [
    "ast_builder.cpp",
    "ast_builder_decl.cpp",
    "ast_builder_struct.cpp",
    "ast_builder_fn.cpp",
    "ast_builder_stmt.cpp",
    "ast_builder_expr.cpp",
    "ast_builder_type.cpp",
    "diagnostic.cpp",
    "mangler.cpp",
    "mod_decl.cpp",
    "name_lookup.cpp",
    "parse_program.cpp",
    "riu.cpp",
    "syntax_diag.cpp",
    "syntax_error_listener.cpp",
    "type_path.cpp",
    "node/ast_visitor.cpp",
    "node/expr_node.cpp",
    "node/file_node.cpp",
    "node/fn_node.cpp",
    "node/global_const_node.cpp",
    "node/global_var_node.cpp",
    "node/literal_node.cpp",
    "node/node.cpp",
    "node/statement_node.cpp",
    "node/struct_node.cpp",
    "node/type_node.cpp",
    "gen/riu/riuLexer.cpp",
    "gen/riu/riuParser.cpp",
    "gen/riu/riuParserBaseVisitor.cpp",
    "gen/riu/riuParserVisitor.cpp",
  ]
}

# 手写词法 / FlatAst（只给 riu-ast dump；不进 riu / riu-check 主路）
config("riu_rd_public") {
  include_dirs = [ "//riu" ]
}

static_library("riu_rd") {
  public_configs = [ ":riu_rd_public" ]
  sources = [
    "rd/dump.cpp",
    "rd/flat.cpp",
    "rd/parser.cpp",
    "rd/scanner.cpp",
    "rd/token.cpp",
  ]
}

executable("riu-ast") {
  output_dir = "$root_out_dir/bin"
  defines = [ "RIU_VERSION=\"$riu_version_str\"" ]
  deps = [
    ":riu_rd",
    "//riu/frontend:riu_frontend",
  ]
  include_dirs = [ "//third_party/cli11/include" ]
  sources = [ "ast_main.cpp" ]
}
