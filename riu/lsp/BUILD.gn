config("riu_lsp_public") {
  include_dirs = [ "//riu" ]
}

executable("riu-lsp") {
  output_dir = "$root_out_dir/bin"
  defines = [ "RIU_VERSION=\"$riu_version_str\"" ]
  configs += [ ":riu_lsp_public" ]
  deps = [ "//riu/frontend:riu_frontend" ]
  sources = [
    "completion.cpp",
    "document.cpp",
    "lsp_io.cpp",
    "lsp_main.cpp",
    "lsp_server.cpp",
    "position.cpp",
    "semantic_tokens.cpp",
    "symbol_lookup.cpp",
    "workspace.cpp",
  ]
}
