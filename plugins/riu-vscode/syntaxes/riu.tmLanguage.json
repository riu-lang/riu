{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "riu",
  "scopeName": "source.riu",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#codepoints" },
    { "include": "#strings" },
    { "include": "#enum-ctor" },
    { "include": "#tuple-member" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#generics" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.riu",
          "match": "(#)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.riu" },
            "2": { "name": "meta.annotation.name.riu" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.riu",
          "match": "\\b(use)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)(\\.\\*)?",
          "captures": {
            "1": { "name": "keyword.other.import.riu" },
            "2": { "name": "entity.name.module.riu" },
            "3": { "name": "keyword.operator.wildcard.riu" }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.type.riu",
          "begin": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "support.type.user-defined.riu" },
            "2": { "name": "punctuation.definition.generic.begin.riu" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.riu" }
          },
          "patterns": [
            { "include": "#types" },
            { "include": "#generics" },
            {
              "name": "punctuation.separator.comma.riu",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.generic.function.riu",
          "begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)\\s*(<)(?=[^>]*>\\s*\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.function.riu" },
            "2": { "name": "punctuation.definition.generic.turbofish.riu" },
            "3": { "name": "punctuation.definition.generic.begin.riu" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.riu" }
          },
          "patterns": [
            { "include": "#types" },
            { "include": "#generics" },
            {
              "name": "punctuation.separator.comma.riu",
              "match": ","
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.riu",
          "match": "^\\s*;[^\\r\\n]*"
        },
        {
          "name": "comment.line.end.riu",
          "match": "\\s;[^\\r\\n]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.riu",
          "match": "\\b(if|elif|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.riu",
          "match": "\\b(loop|break|continue|for|in)\\b"
        },
        {
          "name": "keyword.control.flow.riu",
          "match": "\\bret\\b"
        },
        {
          "name": "keyword.control.exception.riu",
          "match": "\\b(try|catch)\\b"
        },
        {
          "name": "keyword.declaration.riu",
          "match": "\\b(fn|let|type)\\b"
        },
        {
          "name": "keyword.other.struct.riu",
          "match": "\\b(struct|enum)\\b"
        },
        {
          "name": "keyword.other.extern.riu",
          "match": "\\bextern\\b"
        },
        {
          "name": "keyword.other.self-type.riu",
          "match": "\\bSelf\\b"
        },
        {
          "name": "constant.language.boolean.riu",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.riu",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.riu",
          "match": "\\$"
        }
      ]
    },
    "codepoints": {
      "patterns": [
        {
          "name": "constant.character.codepoint.riu",
          "match": "c'(?:\\\\[nrtvb0\\\\'\"]|[^\\\\'])'",
          "captures": {
            "0": { "name": "constant.character.codepoint.riu" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.riu",
          "match": "r\"[^\"]*\""
        },
        {
          "name": "string.quoted.double.riu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.riu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "enum-ctor": {
      "patterns": [
        {
          "comment": "枚举构造 / 模式：E::V，左侧染枚举名，右侧染 variant",
          "name": "meta.enum.constructor.riu",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.riu" },
            "2": { "name": "punctuation.accessor.path.riu" },
            "3": { "name": "variable.other.enummember.riu" }
          }
        }
      ]
    },
    "tuple-member": {
      "patterns": [
        {
          "name": "meta.tuple.member.riu",
          "match": "(\\.)(\\d+)",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.riu" },
            "2": { "name": "variable.other.tuple-member.riu" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.riu",
          "match": "[-+]?(?:\\d[\\d_]*\\.[\\d_]+(?:[eE][-+]?[\\d_]+)?[fF](?:32|64)?|\\d[\\d_]*\\.[\\d_]+[eE][-+]?[\\d_]+[fF]?(?:32|64)?)"
        },
        {
          "name": "constant.numeric.hex.riu",
          "match": "[-+]?0[xX][\\da-fA-F_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.octal.riu",
          "match": "[-+]?0[oO][0-7_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.binary.riu",
          "match": "[-+]?0[bB][01_]+[iu]?(?:8|16|32|64)?"
        },
        {
          "name": "constant.numeric.integer.riu",
          "match": "[-+]?\\d[\\d_]*[iu]?(?:8|16|32|64)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nullable.coalesce.riu",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.nullable.access.riu",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.move-assign.riu",
          "match": "<-"
        },
        {
          "name": "keyword.operator.match-arrow.riu",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.riu",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.compound.riu",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.riu",
          "match": "[+\\-*/%]"
        },
        {
          "comment": "& 取址 / T&；~ 析构 fn ~()。位运算改走 .and/.or/.xor/.shl/.shr/.inv",
          "name": "keyword.operator.bitwise.riu",
          "match": "[&~]"
        },
        {
          "name": "keyword.operator.assignment.riu",
          "match": "="
        },
        {
          "comment": "错误传播 e()! —— 单独命名以便配色",
          "name": "keyword.operator.error-propagate.riu",
          "match": "(?<=[\\w\\)\\]])!"
        },
        {
          "name": "keyword.operator.other.riu",
          "match": "[!?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.riu",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.riu",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.riu",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.riu",
          "match": ","
        },
        {
          "name": "punctuation.accessor.path.riu",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.dot.riu",
          "match": "\\."
        },
        {
          "name": "punctuation.terminator.semicolon.riu",
          "match": ";"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.riu",
          "match": "\\b(bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|isize|usize)\\b"
        },
        {
          "name": "support.type.generic.riu",
          "match": "\\b(Rc|Heap|Arc|Ptr|Array|Weak|Dyn|String|Self)\\b"
        },
        {
          "name": "support.type.user-defined.riu",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.generic.declaration.riu",
          "begin": "\\bfn\\s+(<)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.generic.begin.riu" }
          },
          "end": "(>)\\s*([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\b",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.riu" },
            "2": { "name": "entity.name.function.riu" }
          },
          "patterns": [
            {
              "name": "variable.parameter.type.riu",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.riu",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.function.declaration.riu",
          "match": "\\bfn\\s+([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.riu" }
          }
        },
        {
          "name": "meta.function.parameters.riu",
          "begin": "(?<=\\()",
          "end": "\\)",
          "patterns": [
            { "include": "#function-params" },
            { "include": "#types" },
            {
              "name": "punctuation.separator.comma.riu",
              "match": ","
            }
          ]
        },
        {
          "name": "entity.name.function.call.riu",
          "match": "\\b([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\s*(?=\\()"
        }
      ]
    },
    "function-params": {
      "patterns": [
        {
          "name": "meta.function.param-group.riu",
          "begin": "\\b([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\b",
          "beginCaptures": {
            "1": { "name": "variable.parameter.riu" }
          },
          "end": "(?=[,)])",
          "patterns": [
            {
              "name": "variable.parameter.riu",
              "match": "\\b([a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*)\\b"
            },
            {
              "name": "punctuation.separator.comma.riu",
              "match": ","
            },
            { "include": "#types" },
            { "include": "#generics" }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.riu",
          "match": "\\b[a-zA-Z_\\p{L}][a-zA-Z0-9_\\p{L}]*\\b"
        }
      ]
    }
  }
}
