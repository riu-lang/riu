<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.yux.lang</id>

    <name>Yux Language</name>

    <vendor url="https://github.com/yjl/yux-lang">yux-lang</vendor>

    <description><![CDATA[
        IntelliJ IDEA support for the <b>yux</b> programming language:
        diagnostics, completion, navigation and hover backed by the
        official <code>yux-lsp</code> server.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Yux File"
                  language="yux"
                  extensions="yux"
                  implementationClass="org.yux.lang.ide.YuxFileType"
                  fieldName="INSTANCE"/>
        <lang.parserDefinition language="yux"
                               implementationClass="org.yux.lang.ide.parser.YuxParserDefinition"/>
        <lang.syntaxHighlighterFactory language="yux"
                                       implementationClass="org.yux.lang.ide.highlighter.YuxSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="org.yux.lang.ide.highlighter.YuxColorSettingsPage"/>
        <langCodeStyleSettingsProvider
                implementation="org.yux.lang.ide.formatter.YuxLanguageCodeStyleSettingsProvider"/>
        <projectConfigurable parentId="language"
                             id="org.yux.lang.ide.settings.YuxConfigurable"
                             displayName="Yux"
                             instance="org.yux.lang.ide.settings.YuxConfigurable"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="yuxLanguageServer"
                name="Yux Language Server"
                factoryClass="org.yux.lang.ide.lsp.YuxLanguageServerFactory"/>
        <languageMapping language="yux"
                         serverId="yuxLanguageServer"/>
    </extensions>

</idea-plugin>
