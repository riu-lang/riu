fn arr() {
  / 测试空数组
  var empty Array<i32> = []
  val arr Array<i32> = [10]
  var x = arr[0]
  println(x)
  x = 10 + 5
  println(x)
  x += 5
  println(x)
}

fn main() {
  / 打印
  val n N = N(1.5)
  val a = n.n - -2.to_f64()
  println(a)
  arr()
  val str String = "hello world"
  println(str)
}

struct N {
  n f64
}

N {
  / 构造函数，同结构体名
  fn N(n f64) {
    self.n = n
  }
}
