fn p(a i32) {
  val arr [i32 * 1] = [1]
  println(a + arr[0])
}

fn aa() {
  / 测试空数组
  var empty Array<i32> = []
  println(0)
  val arr Array<i32> = [10]
  var x = arr[0]
  println(x)
  x = 20
  println(x)
  x = x + 5
  println(x)
}

fn main() {
  / 打印
  val n N = N(1.5)
  val a = n.n - -2.to_f64()
  println(a)
  aa()
  p(123)
}

struct N {
  n f64
}

N {
  / 构造函数，同结构体名
  fn N(n f64) {
    self.n = n
  }
}
